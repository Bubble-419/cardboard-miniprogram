@import "../styles/common.wxss";

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  /* 底栏 fixed，给主内容留空，避免被遮 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.header-section {
  padding-bottom: 12rpx;
}

.title-block {
  gap: 6rpx;
  margin-top: 4rpx;
}

.page-intro {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

/* 当前玩家 / 快捷入口 / 玩法说明：统一 16rpx 间距 */
.section-players {
  margin: 0 40rpx 16rpx;
  padding: 22rpx 24rpx;
}

.section-players .section-title {
  margin-bottom: 10rpx;
}

.member-list-wrap {
  margin-top: 8rpx;
}

.players-hint {
  margin-top: 12rpx;
}

.body-spacer {
  flex: 1;
  min-height: 16rpx;
}

.secondary-actions {
  margin: 0 40rpx 16rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-shrink: 0;
}

.secondary-btn {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin-top: 0;
  height: auto;
  min-height: 0;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(148, 163, 184, 0.25);
  color: inherit;
  font-size: inherit;
  justify-content: flex-start;
  box-sizing: border-box;
}

.secondary-btn:active {
  opacity: 0.85;
}

.secondary-btn-disabled {
  opacity: 0.55;
}

.secondary-btn-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.secondary-btn-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.secondary-btn-sub {
  font-size: 20rpx;
  color: #94a3b8;
}

.deck-icon {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.deck-layer {
  position: absolute;
  width: 40rpx;
  height: 52rpx;
  border-radius: 8rpx;
  background: #3aae34;
  border: 2rpx solid #ffffff;
  box-sizing: border-box;
}

.deck-l3 {
  left: 12rpx;
  top: 0;
  opacity: 0.35;
  transform: rotate(12deg);
  background: #94a3b8;
}

.deck-l2 {
  left: 6rpx;
  top: 2rpx;
  opacity: 0.55;
  transform: rotate(6deg);
  background: #64748b;
}

.deck-l1 {
  left: 0;
  top: 4rpx;
  background: linear-gradient(160deg, #4ec948 0%, #2f9a2a 100%);
}

.deck-icon-muted .deck-layer {
  background: #94a3b8;
}

.rules-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #eef2f7;
  color: #64748b;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* scroll-view 默认按父级 100% 宽，叠加 .section 左右 margin 会撑出视口导致右侧截断 */
.section-rules {
  flex: 1;
  min-width: 0;
  min-height: 0;
  width: calc(100% - 80rpx);
  margin: 0 40rpx 0;
  padding: 18rpx 22rpx;
  height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.section-rules .section-title {
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.rules-content {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

/* 六点规则尽量一屏排开，避免依赖滚动 */
.section-rules .rules-list {
  gap: 6rpx;
}

.section-rules .rules-item {
  font-size: 24rpx;
  line-height: 1.4;
}

.footer {
  padding-top: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 非房主底栏：与主按钮同高的等待条，占满主操作位 */
.wait-host-bar {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: rgba(94, 193, 89, 0.12);
  border: 2rpx solid rgba(94, 193, 89, 0.28);
  box-sizing: border-box;
}

.wait-host-bar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.3;
  text-align: center;
  letter-spacing: 1rpx;
}

@import "../styles/common.wxss";

.circle-wrap {
  position: relative;
  width: 640rpx;
  height: 640rpx;
  margin: 12rpx auto 8rpx;
}

.deco-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 2rpx solid rgba(94, 193, 89, 0.18);
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.deco-ring-1 { width: 96%; height: 96%; }
.deco-ring-2 { width: 72%; height: 72%; }
.deco-ring-3 { width: 48%; height: 48%; }
.deco-ring-inner {
  width: 22%;
  height: 22%;
  background: rgba(94, 193, 89, 0.08);
  border: none;
}

.avatar-slot {
  position: absolute;
  width: 120rpx;
  margin-left: -60rpx;
  margin-top: -70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-slot.selected .avatar-img {
  box-shadow: 0 0 0 6rpx #5EC159;
}

.avatar-slot.is-tied .avatar-img {
  box-shadow: 0 0 0 6rpx #E08A1E;
}

.avatar-slot.is-tied.selected .avatar-img {
  box-shadow: 0 0 0 6rpx #5EC159, 0 0 0 12rpx rgba(224, 138, 30, 0.45);
}

.avatar-slot.voted .avatar-badge {
  opacity: 1;
}

.avatar-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #E8F8E6;
}

.avatar-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #545454;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

.avatar-badge {
  position: absolute;
  top: -4rpx;
  right: 4rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #5EC159;
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
}

.tally-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EEF2F0;
  font-size: 26rpx;
  color: #545454;
}

.tally-row:last-child {
  border-bottom: none;
}

.vote-actions {
  margin: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.abstain-link {
  font-size: 24rpx;
  color: #9ca3af;
  padding: 6rpx 16rpx;
}

.abstain-link:active {
  opacity: 0.7;
}

.tie-subtitle {
  display: block;
  color: #e08a1e;
  font-weight: 600;
}

.tie-banner {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FFF6E8;
  border: 2rpx solid #F0C48A;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tie-banner-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: #C46A12;
  letter-spacing: 2rpx;
}

.tie-banner-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #8A4B00;
  line-height: 1.3;
}

.tie-banner-names {
  font-size: 26rpx;
  color: #8A4B00;
  line-height: 1.5;
}

.voted-wait {
  text-align: center;
  color: #3AAE34;
  font-size: 28rpx;
  font-weight: 600;
  margin: 24rpx 40rpx;
}

.vote-progress-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6F6F6F;
}

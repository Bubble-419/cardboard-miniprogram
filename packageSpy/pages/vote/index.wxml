<view class="container">
  <!-- 顶栏贴页顶：左缘与下方标题同为 48rpx，行高与微信胶囊垂直居中对齐 -->
  <player-top-bar
    avatarList="{{avatarList}}"
    maxVisible="{{5}}"
    padLeftRpx="{{48}}"
    compactAvatars="{{true}}"
    bind:goroom="handleGoRoom"
  />
  <view class="header-section">
    <view class="title-block">
      <text class="page-title">匿名投票</text>
      <text class="page-subtitle">
        {{eliminated ? '你已出局，等待本轮投票结束' : (hasVoted ? '已提交，等待全员投完后统一公布' : '点选你怀疑的人（不可投自己）')}}
      </text>
    </view>
    <view class="tie-banner" wx:if="{{showTieBanner}}">
      <text class="tie-banner-kicker">平票加时</text>
      <text class="tie-banner-title">{{tieBannerTitle}}</text>
      <text class="tie-banner-names" wx:if="{{tiedNamesText}}">{{tiedNamesText}}</text>
    </view>
  </view>

  <view class="section">
    <view class="countdown">{{countdownText}}</view>
    <view class="countdown-label">投票倒计时</view>
    <view class="vote-progress-hint">已投票 {{votedCount}} / {{totalVoters}}</view>
  </view>

  <!-- 圆环始终展示在场玩家：出局者只读（不可点选），仍可看到当前存活玩家 -->
  <view class="circle-wrap">
    <view class="deco-ring deco-ring-1"></view>
    <view class="deco-ring deco-ring-2"></view>
    <view class="deco-ring deco-ring-3"></view>
    <view class="deco-ring deco-ring-inner"></view>
    <view
      class="avatar-slot {{selectedIndex === item.playerIndex ? 'selected' : ''}} {{item.isMe ? 'is-me' : ''}} {{item.isTied ? 'is-tied' : ''}} {{tieBreak && !item.isTied ? 'is-disabled' : ''}}"
      wx:for="{{circleSlots}}"
      wx:key="playerIndex"
      style="left: {{item.left}}%; top: {{item.top}}%;"
      data-index="{{item.playerIndex}}"
      bindtap="onSelectTarget"
    >
      <image class="avatar-img" src="{{item.avatarImage}}" mode="aspectFill" />
      <text class="avatar-name">{{item.name}}{{item.isMe ? '（我）' : ''}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{eliminated}}">
    <view class="section-body" style="text-align: center">你已出局，本轮无需投票，请等待结果公布</view>
  </view>

  <!-- 底栏对齐合伙人：左侧近正方形「进行提问」+ 右侧绿色主按钮「确认投票」 -->
  <view class="vote-actions" wx:if="{{(!eliminated && !hasVoted) || canStartQuestion}}">
    <view class="vote-bottom-row">
      <view
        wx:if="{{canStartQuestion}}"
        class="question-btn-wrap {{eliminated || hasVoted ? 'question-btn-wrap-alone' : ''}}"
      >
        <view class="question-btn {{acting ? 'dimmed' : ''}}" bindtap="onStartQuestion">
          <text class="question-btn-line">进行</text>
          <text class="question-btn-line">提问</text>
        </view>
      </view>
      <view class="vote-bottom-gap" wx:if="{{canStartQuestion && !eliminated && !hasVoted}}"></view>
      <view class="confirm-btn-wrap" wx:if="{{!eliminated && !hasVoted}}">
        <view
          class="confirm-btn {{selectedIndex && !acting ? 'confirm-btn-enabled' : 'confirm-btn-disabled'}}"
          bindtap="onConfirmVote"
        >确认投票</view>
      </view>
    </view>
    <text class="abstain-link" wx:if="{{!eliminated && !hasVoted}}" bindtap="onAbstain">弃票</text>
    <view class="voted-wait" wx:elif="{{!eliminated && hasVoted}}">投票已提交，不可修改</view>
  </view>

  <view class="voted-wait" wx:elif="{{!eliminated && hasVoted}}">投票已提交，不可修改</view>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

<view class="container">
  <player-top-bar
    maxVisible="{{5}}"
    padLeftRpx="{{48}}"
    bind:goroom="handleGoRoom"
  />
  <view class="header-section">
    <view class="title-block">
      <text class="page-title">谁是卧底牌库</text>
      <text class="page-subtitle">共 {{groupCount}} 组词语卡 · 分四类浏览，不参与本局分词</text>
    </view>
  </view>

  <!-- 牌库也可挂在 disableScroll 的 owner 中，列表不能依赖原生页面滚动。 -->
  <scroll-view class="category-list" scroll-y="{{!viewerOpen}}">
    <view
      class="category-block {{group.collapsed ? 'is-collapsed' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      wx:for-item="group"
    >
      <view
        class="category-heading"
        data-id="{{group.id}}"
        bindtap="onToggleCategory"
        role="button"
        aria-expanded="{{!group.collapsed}}"
        aria-label="{{group.collapsed ? '展开' : '收起'}}{{group.title}}"
      >
        <view class="category-mark"></view>
        <text class="category-title">{{group.title}}</text>
        <text class="category-count">{{group.count}}种</text>
        <text class="category-chevron">{{group.collapsed ? '›' : '⌄'}}</text>
      </view>
      <view class="card-grid" wx:if="{{!group.collapsed}}">
        <view
          class="card-tile"
          wx:for="{{group.cards}}"
          wx:key="word"
          wx:for-item="item"
          data-word="{{item.word}}"
          bindtap="onTapCard"
        >
          <view class="tile-stack">
            <image class="tile-cover" src="{{item.coverSrc}}" mode="aspectFit" />
          </view>
          <view class="tile-meta">
            <text class="tile-no">{{item.no}}</text>
            <text class="tile-name">{{item.displayName}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 翻阅面板：词语 ↔ 词语1（不展示背面） -->
  <view class="viewer-mask" wx:if="{{viewerOpen}}" catchtouchmove="noop" bindtap="onCloseViewer">
    <view class="viewer-sheet" catchtap="noop">
      <view class="viewer-head">
        <text class="viewer-title">{{selectedCard.displayName || selectedWord}}</text>
        <view class="viewer-close" bindtap="onCloseViewer">关闭</view>
      </view>
      <text class="viewer-hint">点击或上下滑动翻页；双击横屏全屏</text>
      <flip-word-card
        wx:if="{{selectedCard}}"
        word="{{selectedCard.word}}"
        skipBack="{{true}}"
        fullscreenOnAssigned="{{true}}"
        bind:fullscreen="onOpenCardFullscreen"
        assignedWordSrc="{{selectedCard.assignedWordSrc}}"
        assignedWordFallbackSrc="{{selectedCard.assignedWordFallbackSrc}}"
        word1Src="{{selectedCard.word1Src}}"
        word1FallbackSrc="{{selectedCard.word1FallbackSrc}}"
      />
      <text class="viewer-blurb" wx:if="{{selectedCard.blurb}}">{{selectedCard.blurb}}</text>
    </view>
  </view>

  <view
    class="card-fullscreen-mask"
    wx:if="{{cardFullscreenOpen && cardFullscreen}}"
    catchtouchmove="noop"
    bindtap="onCloseCardFullscreen"
  >
    <view class="card-fullscreen-stage" catchtap="noop">
      <view
        class="card-fullscreen-close"
        bindtap="onCloseCardFullscreen"
        role="button"
        aria-label="关闭卡牌全屏"
      >关闭</view>
      <view class="card-fullscreen-card">
        <flip-word-card
          word="{{cardFullscreen.word}}"
          skipBack="{{true}}"
          initialCardState="{{cardFullscreen.initialCardState}}"
          landscapeGestures="{{true}}"
          assignedWordSrc="{{cardFullscreen.assignedWordSrc}}"
          assignedWordFallbackSrc="{{cardFullscreen.assignedWordFallbackSrc}}"
          word1Src="{{cardFullscreen.word1Src}}"
          word1FallbackSrc="{{cardFullscreen.word1FallbackSrc}}"
        />
      </view>
    </view>
  </view>

  <page-footer extClass="footer" showPrimary="{{false}}" bind:prev="handleGoBack"></page-footer>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

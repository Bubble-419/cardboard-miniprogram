@import "../styles/common.wxss";

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* 牌库底栏：加高渐变叠底层，列表滚过时自然淡出 */
.footer {
  padding-top: 72rpx;
}

.container > player-top-bar,
.header-section {
  flex-shrink: 0;
}

.category-list {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
}

.category-block {
  margin-bottom: 28rpx;
}

.category-block:last-child {
  margin-bottom: 0;
}

.category-heading {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx 16rpx;
}

.category-block.is-collapsed .category-heading {
  padding-bottom: 0;
}

.category-mark {
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #5ec159;
  flex-shrink: 0;
}

.category-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #334155;
  line-height: 40rpx;
}

.category-count {
  font-size: 22rpx;
  font-weight: 500;
  color: #94a3b8;
  line-height: 40rpx;
}

.category-chevron {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 600;
  color: #94a3b8;
  line-height: 40rpx;
}

.card-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: 0 -12rpx;
  box-sizing: border-box;
}

.card-tile {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.card-tile:active {
  opacity: 0.88;
}

.tile-stack {
  position: relative;
  width: 100%;
  /* 609/876 ≈ 69.5%，贴合卡面资源比例 */
  padding-top: 69.52%;
  background: transparent;
  border-radius: 16rpx;
  overflow: hidden;
}

.tile-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: transparent;
}

.tile-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 0 4rpx;
}

.tile-no {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.2;
}

.tile-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.viewer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 20, 30, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.viewer-sheet {
  width: 100%;
  max-height: 88vh;
  background: #f7f9fb;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.viewer-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.viewer-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.viewer-close {
  font-size: 26rpx;
  color: #3aae34;
  padding: 8rpx 12rpx;
}

.viewer-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 20rpx;
}

.viewer-card-frame {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  aspect-ratio: 876 / 609;
  background: transparent;
  border-radius: 18rpx;
  overflow: hidden;
}

.viewer-card-frame flip-word-card {
  width: 100%;
  height: 100%;
}

.viewer-blurb {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6f6f6f;
  line-height: 1.55;
}

.card-fullscreen-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  background: rgba(10, 18, 28, 0.92);
}

.card-fullscreen-stage {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100vh;
  height: 100vw;
  box-sizing: border-box;
  padding: 48px 32px 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%) rotate(90deg);
  transform-origin: center center;
}

.card-fullscreen-card {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 自定义组件宿主不会自动继承父级的尺寸；未指定时内部 100% 高度会塌缩。 */
.card-fullscreen-card flip-word-card {
  width: 100%;
  height: 100%;
}

.card-fullscreen-close {
  position: absolute;
  right: 32px;
  top: 8px;
  min-width: 64px;
  height: 40px;
  padding: 0 14px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  font-size: 16px;
}

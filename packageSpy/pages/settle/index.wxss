@import "../styles/common.wxss";

/* 结算底栏：「结束」按内容收缩，补足内边距，避免二字贴边 */
.footer .secondary-btn {
  flex: 0 0 auto;
  width: auto;
  min-width: 160rpx;
  height: 96rpx;
  margin-top: 0;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.footer .primary-btn {
  flex: 1;
  min-width: 0;
}

.winner-banner {
  text-align: center;
  padding: 12rpx 0 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #3AAE34;
}

.winner-banner.spy {
  color: #E07A5F;
}

.pair-summary {
  text-align: center;
  margin-top: 12rpx;
}

.player-row {
  align-items: flex-start;
}

.player-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
  padding-right: 16rpx;
}

.player-meta {
  padding-top: 4rpx;
}

.player-word {
  font-size: 34rpx;
  font-weight: 700;
  color: #334155;
  text-align: left;
  line-height: 1.35;
}

.word-link {
  font-size: 36rpx;
  font-weight: 700;
  color: #3AAE34;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.viewer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 20, 30, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.viewer-sheet {
  width: 100%;
  max-width: 750rpx;
  max-height: 88vh;
  background: #f7f9fb;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.viewer-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.viewer-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.viewer-close {
  font-size: 26rpx;
  color: #3aae34;
  padding: 8rpx 12rpx;
}

.viewer-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.viewer-pair-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.viewer-pair-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #3AAE34;
}

.viewer-pair-tag.spy {
  color: #E07A5F;
}

.viewer-pair-index {
  font-size: 22rpx;
  color: #94a3b8;
}

.viewer-card-frame {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  aspect-ratio: 876 / 609;
  background: transparent;
  border-radius: 18rpx;
  overflow: hidden;
}

.viewer-card-frame flip-word-card {
  width: 100%;
  height: 100%;
}

.viewer-blurb {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6f6f6f;
  line-height: 1.55;
}

.card-fullscreen-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1100;
  background: rgba(10, 18, 28, 0.92);
}

.card-fullscreen-stage {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100vh;
  height: 100vw;
  box-sizing: border-box;
  padding: 48px 32px 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(-50%, -50%) rotate(90deg);
  transform-origin: center center;
}

.card-fullscreen-card {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-fullscreen-card flip-word-card {
  width: 100%;
  height: 100%;
}

.card-fullscreen-close {
  position: absolute;
  right: 32px;
  top: 8px;
  min-width: 64px;
  height: 40px;
  padding: 0 14px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
}

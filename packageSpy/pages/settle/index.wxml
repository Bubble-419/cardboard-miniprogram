<view class="container">
  <view class="header-section">
    <player-top-bar
      avatarList="{{avatarList}}"
      maxVisible="{{5}}"
      bind:goroom="handleGoRoom"
    />
    <view class="title-block">
      <text class="page-title">游戏结算</text>
      <text class="page-subtitle">本局结束，揭晓全部身份</text>
    </view>
  </view>

  <view class="section">
    <view class="winner-banner {{winnerSide === 'spy' ? 'spy' : ''}}">{{winnerText}}</view>
    <view class="section-body" style="text-align: center; margin-top: 12rpx">
      平民词：{{civilianWord}}　卧底词：{{spyWord}}
    </view>
  </view>

  <view class="section">
    <view class="section-title">全员身份</view>
    <view class="player-row" wx:for="{{revealPlayers}}" wx:key="playerIndex">
      <view>
        <view class="player-name">{{item.name}}</view>
        <view class="player-meta">{{item.word}}</view>
      </view>
      <view class="player-meta">{{item.roleLabel}}{{item.alive ? '' : ' · 已出局'}}</view>
    </view>
  </view>

  <page-footer extClass="footer" showPrev="{{false}}">
    <block wx:if="{{isHost}}">
      <view class="secondary-btn {{acting ? 'dimmed' : ''}}" bindtap="onFinishSession">结束并返回房间</view>
      <view class="primary-btn {{acting ? 'dimmed' : ''}}" bindtap="onRestart">再来一局</view>
    </block>
    <view wx:else class="page-subtitle">等待房主选择下一步</view>
  </page-footer>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

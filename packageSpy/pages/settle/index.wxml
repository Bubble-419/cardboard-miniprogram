<view class="container">
  <player-top-bar
    avatarList="{{avatarList}}"
    maxVisible="{{5}}"
    padLeftRpx="{{48}}"
    compactAvatars="{{true}}"
    bind:goroom="handleGoRoom"
  />
  <view class="header-section">
    <view class="title-block">
      <text class="page-title">游戏结算</text>
      <text class="page-subtitle">本局结束，揭晓全部身份</text>
    </view>
  </view>

  <view class="section">
    <view class="winner-banner {{winnerSide === 'spy' ? 'spy' : ''}}">{{winnerText}}</view>
    <view class="section-body pair-summary">
      <text>平民词：</text>
      <text
        class="word-link"
        data-word="{{civilianWord}}"
        catchtap="onTapRevealWord"
      >{{civilianWord}}</text>
      <text class="pair-summary-gap">　</text>
      <text>卧底词：</text>
      <text
        class="word-link"
        data-word="{{spyWord}}"
        catchtap="onTapRevealWord"
      >{{spyWord}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">全员身份与词语</view>
    <view wx:if="{{!revealPlayers.length}}" class="section-body">正在揭晓身份…</view>
    <view class="player-row" wx:for="{{revealPlayers}}" wx:key="memberId">
      <view class="player-main">
        <text class="player-name">{{item.name}}</text>
        <text class="player-word">{{item.word}}</text>
      </view>
      <view class="player-meta">{{item.roleLabel}}{{item.alive ? '' : ' · 已出局'}}</view>
    </view>
  </view>

  <page-footer extClass="footer" showPrev="{{false}}">
    <block wx:if="{{isHost}}">
      <view class="secondary-btn {{acting ? 'dimmed' : ''}}" bindtap="onFinishSession">结束</view>
      <view class="primary-btn {{acting ? 'dimmed' : ''}}" bindtap="onRestart">再来一局</view>
    </block>
    <view wx:else class="page-subtitle">等待房主选择下一步</view>
  </page-footer>
</view>

<!-- 本局词对翻阅：上下翻面，左右切换平民词/卧底词，双击横屏全屏 -->
<view class="viewer-mask" wx:if="{{viewerOpen}}" catchtouchmove="noop" bindtap="onCloseViewer">
  <view class="viewer-sheet" catchtap="noop">
    <view class="viewer-head">
      <text class="viewer-title">{{selectedCard.displayName || selectedCard.word}}</text>
      <view class="viewer-close" bindtap="onCloseViewer">关闭</view>
    </view>
    <text class="viewer-hint">点击或上下滑动翻页；左右滑动切换本局两词；双击横屏全屏</text>
    <view class="viewer-pair-meta" wx:if="{{selectedCard.roleTag}}">
      <text class="viewer-pair-tag {{selectedCard.roleTag === '卧底词' ? 'spy' : ''}}">{{selectedCard.roleTag}}</text>
      <text class="viewer-pair-index">{{selectedCardIndex + 1}} / {{gamePairCards.length}}</text>
    </view>
    <view class="viewer-card-frame">
      <flip-word-card
        wx:if="{{selectedCard}}"
        word="{{selectedCard.word}}"
        skipBack="{{true}}"
        fullscreenOnAssigned="{{true}}"
        enableHorizontalSwipe="{{true}}"
        bind:fullscreen="onOpenCardFullscreen"
        bind:horizontalswipe="onViewerHorizontalSwipe"
        assignedWordSrc="{{selectedCard.assignedWordSrc}}"
        assignedWordFallbackSrc="{{selectedCard.assignedWordFallbackSrc}}"
        word1Src="{{selectedCard.word1Src}}"
        word1FallbackSrc="{{selectedCard.word1FallbackSrc}}"
      />
    </view>
  </view>
</view>

<view
  class="card-fullscreen-mask"
  wx:if="{{cardFullscreenOpen && cardFullscreen}}"
  catchtouchmove="noop"
  bindtap="onCloseCardFullscreen"
>
  <view class="card-fullscreen-stage" catchtap="noop">
    <view
      class="card-fullscreen-close"
      bindtap="onCloseCardFullscreen"
      role="button"
      aria-label="关闭卡牌全屏"
    >关闭</view>
    <view class="card-fullscreen-card">
      <flip-word-card
        word="{{cardFullscreen.word}}"
        skipBack="{{true}}"
        initialCardState="{{cardFullscreen.initialCardState}}"
        landscapeGestures="{{true}}"
        assignedWordSrc="{{cardFullscreen.assignedWordSrc}}"
        assignedWordFallbackSrc="{{cardFullscreen.assignedWordFallbackSrc}}"
        word1Src="{{cardFullscreen.word1Src}}"
        word1FallbackSrc="{{cardFullscreen.word1FallbackSrc}}"
      />
    </view>
  </view>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

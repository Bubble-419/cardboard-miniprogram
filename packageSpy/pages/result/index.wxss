@import "../styles/common.wxss";

.result-hero {
  text-align: center;
  padding: 24rpx 0;
}

.result-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.result-role {
  font-size: 32rpx;
  color: #3AAE34;
  font-weight: 600;
}

.result-role.spy {
  color: #E07A5F;
}

.tally-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EEF2F0;
  font-size: 26rpx;
  color: #545454;
}

.tally-row:last-child {
  border-bottom: none;
}

<view class="container">
  <view class="header-section">
    <player-top-bar
      avatarList="{{avatarList}}"
      maxVisible="{{5}}"
      bind:goroom="handleGoRoom"
    />
    <view class="title-block">
      <text class="page-title">公布结果</text>
      <text class="page-subtitle">第 {{round}} 轮 · 匿名计票</text>
    </view>
  </view>

  <view class="section">
    <view class="result-hero" wx:if="{{hasElimination}}">
      <view class="result-name">{{eliminatedName}}</view>
      <view class="result-role {{eliminatedRole === 'spy' ? 'spy' : ''}}">身份：{{eliminatedRoleLabel}}</view>
      <view class="section-body" style="margin-top: 20rpx">得票 {{maxVotes}}</view>
    </view>
    <view class="result-hero" wx:else>
      <view class="result-name">本轮无人出局</view>
      <view class="section-body">{{tied ? '最高票并列，将进入加时陈述' : '有效票不足'}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">得票统计（不公开投票人）</view>
    <view class="tally-row" wx:for="{{tallyList}}" wx:key="playerIndex">
      <text>{{item.name}}</text>
      <text>{{item.votes}} 票</text>
    </view>
    <view class="section-body" wx:if="{{!tallyList.length}}">本轮无有效选票</view>
  </view>

  <view class="section">
    <view class="section-title">存活玩家</view>
    <view class="player-row" wx:for="{{alivePlayers}}" wx:key="playerIndex">
      <view class="player-name">{{item.name}}</view>
      <view class="player-meta">仍在场</view>
    </view>
  </view>

  <page-footer extClass="footer" showPrev="{{false}}">
    <view class="primary-btn {{acting ? 'dimmed' : ''}}" bindtap="onContinue">进入下一轮</view>
  </page-footer>
</view>

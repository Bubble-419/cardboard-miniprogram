<view class="page {{compactMode ? 'is-compact' : ''}} {{singleCol ? 'is-single-col' : ''}}">
  <!-- 顶部固定区 -->
  <view class="fixed-header">
    <view class="page-shell">
      <player-top-bar
        avatarList="{{avatarList}}"
        maxVisible="{{5}}"
        padLeftRpx="{{0}}"
        compactAvatars="{{true}}"
        bind:goroom="handleGoRoom"
      />

      <view class="title-block">
        <text class="page-title">{{phaseTitle}}</text>
        <view class="tie-banner" wx:if="{{questionRound}}">
          <text class="tie-banner-kicker">补充提问</text>
          <text class="tie-banner-title">每人最多向一个人提出一个问题，对方可以不回答</text>
        </view>
        <view class="tie-banner" wx:elif="{{tieBreak}}">
          <text class="tie-banner-kicker">平票加时</text>
          <text class="tie-banner-title">并列玩家重新陈述</text>
          <text class="tie-banner-names" wx:if="{{tiedNamesText}}">{{tiedNamesText}}</text>
        </view>
      </view>

      <view class="my-word-card-wrap {{myCardCollapsed ? 'is-collapsed' : ''}}">
        <view class="my-word-card-heading">
          <text class="my-word-label">我的交互模板卡</text>
          <view
            class="my-word-collapse-btn"
            role="button"
            aria-label="{{myCardCollapsed ? '展开我的交互模板卡' : '收起我的交互模板卡'}}"
            bindtap="onToggleMyCard"
          >{{myCardCollapsed ? '展开' : '收起'}}</view>
        </view>
        <view class="my-word-card-frame" wx:if="{{!myCardCollapsed}}">
          <flip-word-card
            wx:if="{{cardReady}}"
            word="{{myWord}}"
            fullscreenOnAssigned="{{true}}"
            bind:fullscreen="onOpenIdentityCardFullscreen"
            backSrc="{{cardBackSrc}}"
            assignedWordSrc="{{assignedWordSrc}}"
            assignedWordFallbackSrc="{{assignedWordFallbackSrc}}"
            word1Src="{{word1Src}}"
            word1FallbackSrc="{{word1FallbackSrc}}"
          />
          <view class="my-word-card-loading" wx:else>词语加载中…</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 中部弹性区：标签 + 滚动内容 -->
  <view class="content-section">
    <view class="page-shell content-section-inner">
      <view class="content-tabs">
        <view
          class="content-tab {{contentTab === 0 ? 'content-tab-active' : ''}}"
          data-tab="0"
          bindtap="onTapContentTab"
        >
          <text class="content-tab-text">牌库（{{libraryGroupCount}}）</text>
        </view>
        <view
          class="content-tab {{contentTab === 1 ? 'content-tab-active' : ''}}"
          data-tab="1"
          bindtap="onTapContentTab"
        >
          <text class="content-tab-text">玩法说明</text>
        </view>
      </view>

      <scroll-view
        class="card-scroll"
        scroll-y="{{panelScrollY}}"
        enhanced
        bounces="{{panelScrollY}}"
        show-scrollbar="{{false}}"
        bindtouchstart="onPanelTouchStart"
        bindtouchend="onPanelTouchEnd"
        bindtouchcancel="onPanelTouchEnd"
      >
        <view class="panel panel-visible" wx:if="{{contentTab === 0}}">
          <view
            class="library-category {{group.collapsed ? 'is-collapsed' : ''}}"
            wx:for="{{libraryCategories}}"
            wx:key="id"
            wx:for-item="group"
          >
            <view
              class="library-category-heading"
              data-id="{{group.id}}"
              bindtap="onToggleLibraryCategory"
              role="button"
              aria-expanded="{{!group.collapsed}}"
              aria-label="{{group.collapsed ? '展开' : '收起'}}{{group.title}}"
            >
              <view class="library-category-mark"></view>
              <text class="library-category-title">{{group.title}}</text>
              <text class="library-category-count">{{group.count}}种</text>
              <text class="library-category-chevron">{{group.collapsed ? '›' : '⌄'}}</text>
            </view>
            <view class="card-grid" wx:if="{{!group.collapsed}}">
              <view
                class="card-tile"
                wx:for="{{group.cards}}"
                wx:key="word"
                wx:for-item="item"
                data-word="{{item.word}}"
                bindtap="onTapLibraryCard"
              >
                <view class="tile-stack">
                  <image
                    class="tile-cover"
                    src="{{item.coverSrc}}"
                    mode="aspectFit"
                    lazy-load
                  />
                </view>
                <view class="tile-meta">
                  <text class="tile-no">{{item.no}}</text>
                  <text class="tile-name">{{item.displayName}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="panel panel-visible" id="rulesPanel" wx:else>
          <view class="rules-panel">
            <view class="rules-list">
              <text class="rules-item">1. 系统为每位玩家随机分配词语，多数人词相同，卧底词相近但不同。</text>
              <text class="rules-item">2. 每人只能看到自己的词语，按顺序口头描述。<text class="rules-emphasis">不能撒谎</text>，也不要直接念出词名。</text>
              <text class="rules-item">3. 发言阶段可翻看自己的词语卡；全员完成发言后系统自动进入投票。</text>
              <text class="rules-item">4. 若信息不足，房主可在投票页开启一轮提问，每人最多提出一个问题。</text>
              <text class="rules-item">5. 进入匿名投票后，投出你怀疑的人（不可投自己）。</text>
              <text class="rules-item">6. 全员投完后统一公布票数与淘汰结果；平票则并列玩家再陈述后，由其余玩家重投（并列者本人不参与）。</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 牌库翻阅弹层 -->
  <view class="viewer-mask" wx:if="{{viewerOpen}}" catchtouchmove="noop" bindtap="onCloseViewer">
    <view class="viewer-sheet" catchtap="noop">
      <view class="viewer-head">
        <text class="viewer-title">{{selectedCard.displayName || selectedWord}}</text>
        <view class="viewer-close" bindtap="onCloseViewer">关闭</view>
      </view>
      <text class="viewer-hint">点击或上下滑动翻页；双击横屏全屏</text>
      <view class="viewer-card-frame">
        <flip-word-card
          wx:if="{{selectedCard}}"
          word="{{selectedCard.word}}"
          skipBack="{{true}}"
          fullscreenOnAssigned="{{true}}"
          bind:fullscreen="onOpenLibraryCardFullscreen"
          assignedWordSrc="{{selectedCard.assignedWordSrc}}"
          assignedWordFallbackSrc="{{selectedCard.assignedWordFallbackSrc}}"
          word1Src="{{selectedCard.word1Src}}"
          word1FallbackSrc="{{selectedCard.word1FallbackSrc}}"
        />
      </view>
    </view>
  </view>

  <!-- 底部固定操作区（参与 flex，不 position:fixed） -->
  <view class="bottom-action" wx:if="{{isCurrentSpeaker || currentSpeakerName}}">
    <view class="page-shell">
      <view
        wx:if="{{isCurrentSpeaker}}"
        class="primary-btn {{acting ? 'dimmed' : ''}}"
        bindtap="onFinishSpeak"
      >{{finishActionText}}</view>
      <view class="action-hint" wx:if="{{!isCurrentSpeaker && currentSpeakerName}}">
        <text class="action-hint-label">{{waitingHintPrefix}}</text>
        <image
          wx:if="{{currentSpeakerAvatar}}"
          class="action-hint-avatar"
          src="{{currentSpeakerAvatar}}"
          mode="aspectFill"
        />
        <text class="action-hint-name">{{currentSpeakerName}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 身份/牌库卡横屏全屏：纯本地叠层，可点击/滑动翻面，不创建新 Route 或远端状态。 -->
<view
  class="identity-card-fullscreen-mask"
  wx:if="{{identityCardFullscreenOpen && identityCardFullscreen}}"
  catchtouchmove="noop"
  bindtap="onCloseIdentityCardFullscreen"
>
  <view class="identity-card-fullscreen-stage" catchtap="noop">
    <view
      class="identity-card-fullscreen-close"
      bindtap="onCloseIdentityCardFullscreen"
      role="button"
      aria-label="关闭卡牌全屏"
    >关闭</view>
    <view class="identity-card-fullscreen-card">
      <flip-word-card
        word="{{identityCardFullscreen.word}}"
        skipBack="{{identityCardFullscreen.skipBack}}"
        initialCardState="{{identityCardFullscreen.initialCardState}}"
        landscapeGestures="{{true}}"
        backSrc="{{identityCardFullscreen.backSrc}}"
        assignedWordSrc="{{identityCardFullscreen.assignedWordSrc}}"
        assignedWordFallbackSrc="{{identityCardFullscreen.assignedWordFallbackSrc}}"
        word1Src="{{identityCardFullscreen.word1Src}}"
        word1FallbackSrc="{{identityCardFullscreen.word1FallbackSrc}}"
      />
    </view>
  </view>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

<view class="page {{compactMode ? 'is-compact' : ''}} {{singleCol ? 'is-single-col' : ''}}">
  <!-- 顶部固定区 -->
  <view class="fixed-header">
    <view class="page-shell">
      <player-top-bar
        avatarList="{{avatarList}}"
        maxVisible="{{5}}"
        bind:goroom="handleGoRoom"
      />

      <view class="title-block">
        <text class="page-title">发言阶段</text>
        <text class="page-subtitle" wx:if="{{tieBreak}}">平票加时：并列玩家重新陈述</text>
      </view>

      <view class="my-word-card-wrap">
        <view class="my-word-label">我的词语卡</view>
        <view class="my-word-card-frame">
          <flip-word-card
            wx:if="{{cardReady}}"
            word="{{myWord}}"
            twoFaceOnly="{{true}}"
            backSrc="{{cardBackSrc}}"
            assignedWordSrc="{{assignedWordSrc}}"
            assignedWordFallbackSrc="{{assignedWordFallbackSrc}}"
            word1Src="{{word1Src}}"
            word1FallbackSrc="{{word1FallbackSrc}}"
          />
          <view class="my-word-card-loading" wx:else>词语加载中…</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 中部弹性区：标签 + 滚动内容 -->
  <view class="content-section">
    <view class="page-shell content-section-inner">
      <view class="content-tabs">
        <view
          class="content-tab {{contentTab === 0 ? 'content-tab-active' : ''}}"
          data-tab="0"
          bindtap="onTapContentTab"
        >
          <text class="content-tab-text">牌库（{{libraryGroupCount}}）</text>
        </view>
        <view
          class="content-tab {{contentTab === 1 ? 'content-tab-active' : ''}}"
          data-tab="1"
          bindtap="onTapContentTab"
        >
          <text class="content-tab-text">玩法说明</text>
        </view>
      </view>

      <scroll-view
        class="card-scroll"
        scroll-y="{{panelScrollY}}"
        enhanced
        bounces="{{panelScrollY}}"
        show-scrollbar="{{false}}"
        bindtouchstart="onPanelTouchStart"
        bindtouchend="onPanelTouchEnd"
        bindtouchcancel="onPanelTouchEnd"
      >
        <view class="panel panel-visible" wx:if="{{contentTab === 0}}">
          <view class="card-grid">
            <view
              class="card-tile"
              wx:for="{{libraryCards}}"
              wx:key="word"
              data-word="{{item.word}}"
              bindtap="onTapLibraryCard"
            >
              <view class="tile-stack">
                <image
                  class="tile-cover"
                  src="{{item.coverSrc}}"
                  mode="aspectFit"
                  lazy-load
                />
              </view>
            </view>
          </view>
        </view>

        <view class="panel panel-visible" id="rulesPanel" wx:else>
          <view class="rules-panel">
            <view class="rules-list">
              <text class="rules-item">1. 系统为每位玩家随机分配词语，多数人词相同，卧底词相近但不同。</text>
              <text class="rules-item">2. 每人只能看到自己的词语，按顺序口头描述，不要直接念出词名。</text>
              <text class="rules-item">3. 发言阶段可翻看自己的词语卡；房主在合适时机点击「开始投票」。</text>
              <text class="rules-item">4. 进入匿名投票后，投出你怀疑的人（不可投自己）。</text>
              <text class="rules-item">5. 全员投完后统一公布票数与淘汰结果；平票则并列玩家再陈述后重投。</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 牌库翻阅弹层 -->
  <view class="viewer-mask" wx:if="{{viewerOpen}}" catchtouchmove="noop" bindtap="onCloseViewer">
    <view class="viewer-sheet" catchtap="noop">
      <view class="viewer-head">
        <text class="viewer-title">{{selectedWord}}</text>
        <view class="viewer-close" bindtap="onCloseViewer">关闭</view>
      </view>
      <text class="viewer-hint">点击卡牌：词语 → 词语1 → 词语，可循环翻看</text>
      <view class="viewer-card-frame">
        <flip-word-card
          wx:if="{{selectedCard}}"
          word="{{selectedCard.word}}"
          skipBack="{{true}}"
          assignedWordSrc="{{selectedCard.assignedWordSrc}}"
          assignedWordFallbackSrc="{{selectedCard.assignedWordFallbackSrc}}"
          word1Src="{{selectedCard.word1Src}}"
          word1FallbackSrc="{{selectedCard.word1FallbackSrc}}"
        />
      </view>
      <text class="viewer-blurb" wx:if="{{selectedCard.blurb}}">{{selectedCard.blurb}}</text>
    </view>
  </view>

  <!-- 底部固定操作区（参与 flex，不 position:fixed） -->
  <view class="bottom-action" wx:if="{{isHost}}">
    <view class="page-shell">
      <view class="primary-btn {{acting ? 'dimmed' : ''}}" bindtap="onStartVote">开始投票</view>
    </view>
  </view>
</view>

.flip-scene {
  position: relative;
  width: 100%;
  height: 100%;
  aspect-ratio: 876 / 609;
  box-sizing: border-box;
  background: transparent;
  /* 吃掉卡面手势，避免竖滑/斜滑冒泡到页面触发返回 */
  touch-action: none;
}

.flip-scene.is-landscape {
  aspect-ratio: auto;
  max-width: 100%;
  max-height: 100%;
}

.flip-stage {
  position: relative;
  width: 100%;
  height: 100%;
  perspective: 1200px;
  -webkit-perspective: 1200px;
  box-sizing: border-box;
}

.flip-stage.is-pressed {
  opacity: 0.92;
  transform: scale(0.98);
}

.flip-stage.is-animating {
  pointer-events: none;
}

.flip-card {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transform-origin: center center;
  background: transparent;
  transform: rotateX(0deg);
  -webkit-transform: rotateX(0deg);
  box-sizing: border-box;
}

/* 上滑 / 点击：向上翻（与手指同向） */
.flip-card.flip-out-up {
  transition: transform 300ms ease-in-out;
  -webkit-transition: -webkit-transform 300ms ease-in-out;
  transform: rotateX(90deg);
  -webkit-transform: rotateX(90deg);
}

.flip-card.flip-in-start-up {
  transition: none;
  -webkit-transition: none;
  transform: rotateX(-90deg);
  -webkit-transform: rotateX(-90deg);
}

/* 下滑：向下翻（与手指同向） */
.flip-card.flip-out-down {
  transition: transform 300ms ease-in-out;
  -webkit-transition: -webkit-transform 300ms ease-in-out;
  transform: rotateX(-90deg);
  -webkit-transform: rotateX(-90deg);
}

.flip-card.flip-in-start-down {
  transition: none;
  -webkit-transition: none;
  transform: rotateX(90deg);
  -webkit-transform: rotateX(90deg);
}

.flip-card.flip-in {
  transition: transform 300ms ease-in-out;
  -webkit-transition: -webkit-transform 300ms ease-in-out;
  transform: rotateX(0deg);
  -webkit-transform: rotateX(0deg);
}

.flip-face {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  overflow: hidden;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.flip-img {
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  background: transparent;
  object-fit: contain;
}

.flip-scene.is-cover .flip-img {
  object-fit: cover;
}

.flip-back-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #1f2430 0%, #3a4254 55%, #2a3140 100%);
  position: relative;
  pointer-events: none;
  border-radius: 24rpx;
}

.flip-back-pattern {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  bottom: 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.22);
  background:
    repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.04) 0,
      rgba(255, 255, 255, 0.04) 12rpx,
      transparent 12rpx,
      transparent 24rpx
    );
}

.flip-back-title {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.flip-back-hint {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
}

.flip-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  pointer-events: none;
}

.flip-placeholder-text {
  color: #8a91a0;
  font-size: 26rpx;
}

.flip-expand-btn {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  z-index: 20;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.28);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flip-expand-btn:active {
  opacity: 0.82;
  transform: scale(0.96);
}

.flip-expand-arrow {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  box-sizing: border-box;
  border-color: rgba(255, 255, 255, 0.98);
  border-style: solid;
}

.flip-expand-arrow.is-tl {
  top: 20rpx;
  left: 20rpx;
  border-width: 4rpx 0 0 4rpx;
}

.flip-expand-arrow.is-tr {
  top: 20rpx;
  right: 20rpx;
  border-width: 4rpx 4rpx 0 0;
}

.flip-expand-arrow.is-bl {
  bottom: 20rpx;
  left: 20rpx;
  border-width: 0 0 4rpx 4rpx;
}

.flip-expand-arrow.is-br {
  bottom: 20rpx;
  right: 20rpx;
  border-width: 0 4rpx 4rpx 0;
}

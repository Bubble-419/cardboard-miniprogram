<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        />
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="page-body">
    <view class="top-bar">
      <view class="room-entry" bindtap="handleGoRoom">
        <image class="room-entry-icon" src="/assets/icons/add-icon.png" mode="aspectFit" />
      </view>
      <view class="problem-chip">
        <image class="problem-icon" src="/assets/icons/question-mark.png" mode="aspectFit" />
        <text class="problem-text {{selectedProblemText ? '' : 'problem-text-empty'}}">{{selectedProblemText || '暂无设计问题'}}</text>
      </view>
    </view>

    <view class="user-section">
      <user-list
        avatarList="{{avatarList}}"
        currentUser="{{currentPlayerIndex}}"
        enableAdd="{{false}}"
        isFold="{{true}}"
        showName="{{false}}"
        showActingFrame="{{true}}"
      />
    </view>

    <view class="divider-line"></view>

    <!-- 选择特殊行动 -->
    <view class="main-content" wx:if="{{viewMode === 'wheel'}}">
      <view class="section-head">
        <image class="section-back" src="/assets/icons/miniprogram-btn.png" mode="aspectFit" bindtap="handleGoBack" />
        <text class="section-title">选择特殊行动</text>
      </view>

      <view class="wheel-wrap">
        <view class="wheel">
          <view
            class="wheel-slice"
            wx:for="{{wheelPieces}}"
            wx:key="id"
            style="transform: rotate({{item.rotate}}deg);"
            data-id="{{item.id}}"
            bindtap="onSelectAction"
          >
            <view class="wheel-slice-bg {{selectedAction === item.id ? 'wheel-slice-bg-active' : ''}}"></view>
          </view>

          <view class="wheel-diagonal wheel-diagonal-1"></view>
          <view class="wheel-diagonal wheel-diagonal-2"></view>

          <view class="wheel-label wheel-label-top {{selectedAction === 'master' ? 'wheel-label-active' : ''}}" data-id="master" bindtap="onSelectAction">
            <text class="wheel-label-sub">开启</text>
            <text class="wheel-label-main">MASTER</text>
            <text class="wheel-label-sub">模式</text>
          </view>
          <view class="wheel-label wheel-label-left {{selectedAction === 'helpLuck' ? 'wheel-label-active' : ''}}" data-id="helpLuck" bindtap="onSelectAction">
            <text class="wheel-label-vertical">求助AI或运气</text>
          </view>
          <view class="wheel-label wheel-label-right {{selectedAction === 'silent' ? 'wheel-label-active' : ''}}" data-id="silent" bindtap="onSelectAction">
            <text class="wheel-label-vertical">全场静默</text>
          </view>
          <view class="wheel-label wheel-label-bottom {{selectedAction === 'closing' ? 'wheel-label-active' : ''}}" data-id="closing" bindtap="onSelectAction">
            <text class="wheel-label-sub">进入</text>
            <text class="wheel-label-main wheel-label-main-sm">收尾阶段</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 反面随机拼：单卡预览 -->
    <view class="main-content main-content-fill" wx:elif="{{viewMode === 'reverseRandom'}}">
      <view class="section-head">
        <image class="section-back" src="/assets/icons/miniprogram-btn.png" mode="aspectFit" bindtap="handleGoBack" />
        <text class="section-title">反面随机拼</text>
      </view>

      <view class="card-area">
        <swiper
          class="card-swiper"
          current="{{0}}"
          previous-margin="40rpx"
          next-margin="40rpx"
          easing-function="easeOutCubic"
        >
          <swiper-item class="card-swiper-item">
            <view class="game-card game-card-active">
              <view class="action-card-body">
                <text class="action-title">反面随机拼</text>
                <text class="action-desc">将卡牌置于反面，随机拼成卡组</text>
                <view class="action-divider"></view>
                <view class="action-grid">
                  <view class="action-cell action-cell-filled action-cell-reverse" wx:for="{{randomDeckCards}}" wx:key="*this">
                    <view class="reverse-card-illus"></view>
                    <text class="action-cell-label">卡牌 {{item}}</text>
                  </view>
                </view>
              </view>
            </view>
          </swiper-item>
        </swiper>
      </view>
    </view>

    <!-- 全场静默 -->
    <view class="main-content main-content-fill silent-main" wx:elif="{{viewMode === 'silent'}}">
      <view class="card-area">
        <view class="game-card game-card-active silent-card">
          <view class="silent-badge">静默模式</view>
          <view class="silent-card-body">
            <text class="silent-timer">{{silentTimerText}}</text>
            <text class="silent-main-title">保持分贝低于40dB</text>
            <text class="silent-desc">您可以进行1—3次行动，1 次行动可以是以下任意一种</text>
            <view class="action-divider"></view>
            <view class="action-grid">
              <view class="action-cell action-cell-muted">
                <text class="action-cell-label">出 1 张卡牌</text>
              </view>
              <view class="action-cell action-cell-muted">
                <text class="action-cell-label">删 1 张卡牌</text>
              </view>
              <view class="action-cell action-cell-muted">
                <text class="action-cell-label">调整 1 张卡牌</text>
              </view>
              <view class="action-cell action-cell-muted">
                <text class="action-cell-label">交换 2 张卡牌</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="inspiration-bar">
        <view class="inspiration-badge-wrap">
          <text class="inspiration-badge">💡</text>
        </view>
        <view class="inspiration-input-fake">
          <text class="inspiration-placeholder">记录您的灵感...</text>
        </view>
        <view class="inspiration-submit">
          <image class="inspiration-arrow" src="/assets/icons/submit-arrow.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="page-footer">
    <view class="help-method-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'helpLuck'}}">
      <text class="help-method-label">选择求助方式</text>
      <view class="help-method-list">
        <view
          class="help-method-card {{helpMethod === item.id ? 'help-method-card-selected' : ''}}"
          wx:for="{{helpMethodOptions}}"
          wx:key="id"
          data-method="{{item.id}}"
          bindtap="onSelectHelpMethod"
        >
          <view class="help-method-radio">
            <view class="radio-outer {{helpMethod === item.id ? 'selected' : ''}}">
              <view class="radio-inner" wx:if="{{helpMethod === item.id}}"></view>
            </view>
          </view>
          <text class="help-method-title">{{item.title}}</text>
          <text class="help-method-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'silent'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{silentHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'master'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{masterHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'closing'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{closingHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="bottom-actions" wx:if="{{viewMode === 'reverseRandom'}}">
      <button class="cancel-adopt-btn" bindtap="handleCancelAdopt">取消采用</button>
      <button class="adopt-btn" bindtap="handleAdoptDeck">采用卡组</button>
    </view>
    <view class="bottom-actions" wx:elif="{{viewMode === 'silent'}}">
      <button class="end-silent-btn" bindtap="handleEndSilent">结束静默</button>
    </view>
    <view class="bottom-actions" wx:else>
      <button class="confirm-btn" bindtap="handleConfirm">确认</button>
    </view>
  </view>

  <!-- AI 对话浮层 -->
  <view class="chat-mask" wx:if="{{showChat}}" catchtouchmove="true">
    <view class="chat-panel">
      <view class="chat-header">
        <view class="chat-close" bindtap="handleCloseChat">
          <view class="chat-close-icon"></view>
          <text class="chat-close-text">结束</text>
        </view>
        <view class="chat-expand-icon"></view>
      </view>

      <scroll-view class="chat-body" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{chatScrollInto}}">
        <view class="chat-welcome" wx:if="{{chatMessages.length <= 1}}">
          <text class="chat-welcome-title">有什么可以帮您？</text>
          <text class="chat-welcome-sub">您仅能提问三次</text>
        </view>

        <view class="chat-suggestions" wx:if="{{chatMessages.length <= 1}}">
          <view
            class="chat-chip"
            wx:for="{{suggestedQuestions}}"
            wx:key="*this"
            data-text="{{item}}"
            bindtap="onTapSuggestion"
          >{{item}}</view>
        </view>

        <view
          class="chat-msg {{item.role === 'user' ? 'chat-msg-user' : 'chat-msg-assistant'}}"
          wx:for="{{chatMessages}}"
          wx:key="id"
          id="msg-{{item.id}}"
        >
          <text class="chat-msg-text">{{item.text}}</text>
        </view>
      </scroll-view>

      <view class="chat-input-bar">
        <input
          class="chat-input"
          value="{{chatInput}}"
          placeholder="输入您的问题..."
          placeholder-class="chat-input-placeholder"
          confirm-type="send"
          bindinput="onChatInput"
          bindconfirm="handleSendChat"
        />
        <view class="chat-send" bindtap="handleSendChat">
          <image class="chat-send-icon" src="/assets/icons/submit-arrow.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>
</view>

<view class="container">
  <view class="page-body">
    <!-- 顶部：房间入口 + 头像（与胶囊对齐） -->
    <player-top-bar
      avatarList="{{avatarList}}"
      maxVisible="{{5}}"
      roomIcon="/assets/partnerMode/icon-room-entry-gp.svg"
      actingUser="{{currentPlayerIndex}}"
      showActingFrame="{{true}}"
      bind:goroom="handleGoRoom"
    />

    <!-- 设计问题 chip（顶栏下方） -->
    <view class="problem-chip-row">
      <view
        class="problem-chip {{problemExpanded ? 'problem-chip-expanded' : ''}} {{problemTextOverflow || problemExpanded ? 'problem-chip-tappable' : ''}}"
        bindtap="handleToggleProblemExpand"
      >
        <image class="problem-icon" src="/assets/partnerMode/icon-problem-chip.svg" mode="aspectFit" />
        <view class="problem-text-wrap">
          <text
            id="problemText"
            class="problem-text {{selectedProblemText ? '' : 'problem-text-empty'}} {{problemExpanded ? 'problem-text-expanded' : ''}}"
          >{{selectedProblemText || '暂无设计问题'}}</text>
          <text wx:if="{{selectedProblemText && !problemExpanded}}" id="problemTextMeasure" class="problem-text-measure">{{selectedProblemText}}</text>
        </view>
      </view>
    </view>

    <view class="divider-line"></view>

    <!-- 选择特殊行动 -->
    <view class="main-content" wx:if="{{viewMode === 'wheel'}}">
      <view class="section-head">
        <image class="section-back" src="/assets/partnerMode/icon-special-back.svg" mode="aspectFit" bindtap="handleGoBack" />
        <text class="section-title">选择特殊行动</text>
        <view class="section-head-spacer"></view>
      </view>

      <view class="wheel-wrap">
        <view class="wheel">
          <view
            class="wheel-slice wheel-slice-{{item.zone}} {{selectedAction === item.id ? 'wheel-slice-active' : ''}}"
            wx:for="{{wheelPieces}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onSelectAction"
          ></view>

          <image class="wheel-cross" src="/assets/partnerMode/special-wheel-cross.svg" mode="aspectFit" />

          <view class="wheel-label wheel-label-top {{selectedAction === 'master' ? 'wheel-label-active' : ''}}" data-id="master" bindtap="onSelectAction">
            <text class="wheel-label-sub">开启</text>
            <view class="wheel-label-quoted">
              <text class="wheel-label-quote">“</text>
              <text class="wheel-label-main">MASTER</text>
              <text class="wheel-label-quote">”</text>
            </view>
            <text class="wheel-label-sub">模式</text>
          </view>
          <view class="wheel-label wheel-label-left {{selectedAction === 'helpLuck' ? 'wheel-label-active' : ''}}" data-id="helpLuck" bindtap="onSelectAction">
            <!-- AI_TEMP_DISABLED: 恢复 AI 后改回「求助AI或运气」 -->
            <text class="wheel-label-vertical">{{aiFeatureEnabled ? '求助AI或运气' : '求助运气'}}</text>
            <view class="wheel-side-icon wheel-help-icon">
              <image class="wheel-help-arrows" src="/assets/partnerMode/special-wheel-help-arrows.svg" mode="aspectFit" />
              <image class="wheel-help-text" src="/assets/partnerMode/special-wheel-help-text.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="wheel-label wheel-label-right {{selectedAction === 'silent' ? 'wheel-label-active' : ''}}" data-id="silent" bindtap="onSelectAction">
            <image class="wheel-side-icon wheel-silent-icon" src="/assets/partnerMode/special-wheel-silent-icon.svg" mode="aspectFit" />
            <text class="wheel-label-vertical">全场静默</text>
          </view>
          <view class="wheel-label wheel-label-bottom {{selectedAction === 'closing' ? 'wheel-label-active' : ''}}" data-id="closing" bindtap="onSelectAction">
            <text class="wheel-label-sub">进入</text>
            <view class="wheel-label-quoted">
              <text class="wheel-label-quote">“</text>
              <text class="wheel-label-main wheel-label-main-sm">收尾阶段</text>
              <text class="wheel-label-quote">”</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 反面随机拼 Figma #5938:8587 -->
    <view class="main-content main-content-fill reverse-main" wx:elif="{{viewMode === 'reverseRandom'}}">
      <view class="card-area reverse-card-area">
        <swiper
          class="card-swiper"
          current="{{0}}"
          previous-margin="56rpx"
          next-margin="56rpx"
          easing-function="easeOutCubic"
        >
          <swiper-item class="card-swiper-item">
            <view class="game-card game-card-active">
              <scroll-view class="reverse-card-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                <view class="reverse-card-inner">
                  <text class="reverse-title">反面随机拼</text>
                  <text class="reverse-desc">请根据以下操作提示，进行反面随机拼</text>
                  <view class="action-divider reverse-divider"></view>
                  <view class="reverse-step-grid">
                    <view class="reverse-step-cell" wx:for="{{reverseSteps}}" wx:key="label">
                      <view class="reverse-step-illus"></view>
                      <text class="reverse-step-label">{{item.label}}</text>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </view>
          </swiper-item>
        </swiper>

        <view class="card-pagination">
          <view class="pagination-dots">
            <view class="dot dot-active"></view>
          </view>
        </view>
      </view>

      <!-- 勿绑 focus=false：真机会锁死原生聚焦 -->
      <view class="inspiration-bar" style="{{inspirationLiftStyle}}">
        <view class="insp-icon-wrap" catchtap="handleGoInspirationCenter">
          <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
        </view>
        <view class="inspiration-composer">
          <view class="inspiration-row">
            <input
              class="inspiration-textarea"
              type="text"
              value="{{inspirationDraftText}}"
              maxlength="200"
              adjust-position="{{false}}"
              placeholder="记录您的灵感..."
              placeholder-class="inspiration-placeholder"
              bindinput="onInspirationInput"
              bindfocus="onInspirationFocus"
              bindblur="onInspirationBlur"
              bindkeyboardheightchange="onInspirationKeyboardHeightChange"
              confirm-type="done"
              cursor-spacing="12"
            />
            <view class="inspiration-action" catchtap="onInspirationActionTap">
              <image
                wx:if="{{inspirationHasText}}"
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-send.svg"
                mode="aspectFit"
              />
              <image
                wx:else
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-plus.svg"
                mode="aspectFit"
              />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 全场静默 Figma #5938:8587 -->
    <view class="main-content main-content-fill silent-main" wx:elif="{{viewMode === 'silent'}}">
      <view class="card-area silent-card-area">
        <swiper
          class="card-swiper"
          current="{{0}}"
          previous-margin="56rpx"
          next-margin="56rpx"
          easing-function="easeOutCubic"
        >
          <swiper-item class="card-swiper-item">
            <game-card-timer
              startedAt="{{silentStartedAt}}"
              timerActive="{{silentTimerActive}}"
              durationSec="{{silentDurationSec}}"
              loop="{{false}}"
              bind:timerexpire="handleSilentTimerExpire"
            >
              <scroll-view class="silent-card-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                <view class="silent-card-inner">
                  <view class="silent-header">
                    <view class="silent-badge">静默模式</view>
                    <text class="silent-main-title">保持分贝低于40dB</text>
                  </view>
                  <text class="silent-desc">您可以进行1—3次行动，1 次行动可以是以下任意一种</text>
                  <view class="action-divider silent-divider"></view>
                  <view class="silent-action-grid">
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">出 1 张卡牌</text>
                    </view>
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">删 1 张卡牌</text>
                    </view>
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">调整 1 张卡牌</text>
                    </view>
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">交换 2 张卡牌</text>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </game-card-timer>
          </swiper-item>
        </swiper>

        <view class="card-pagination">
          <view class="pagination-dots">
            <view class="dot dot-active"></view>
          </view>
          <text class="pagination-text">1/1</text>
        </view>
      </view>

      <view class="inspiration-bar" style="{{inspirationLiftStyle}}">
        <view class="insp-icon-wrap" catchtap="handleGoInspirationCenter">
          <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
        </view>
        <view class="inspiration-composer">
          <view class="inspiration-row">
            <input
              class="inspiration-textarea"
              type="text"
              value="{{inspirationDraftText}}"
              maxlength="200"
              adjust-position="{{false}}"
              placeholder="记录您的灵感..."
              placeholder-class="inspiration-placeholder"
              bindinput="onInspirationInput"
              bindfocus="onInspirationFocus"
              bindblur="onInspirationBlur"
              bindkeyboardheightchange="onInspirationKeyboardHeightChange"
              confirm-type="done"
              cursor-spacing="12"
            />
            <view class="inspiration-action" catchtap="onInspirationActionTap">
              <image
                wx:if="{{inspirationHasText}}"
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-send.svg"
                mode="aspectFit"
              />
              <image
                wx:else
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-plus.svg"
                mode="aspectFit"
              />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮：键盘升起时留在底部被输入法盖住 -->
  <view class="page-footer {{inspirationKeyboardHeight > 0 ? 'page-footer-insp-hidden' : ''}}">
    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'silent'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{silentHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'master'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{masterHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'closing'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{closingHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="bottom-actions reverse-bottom-actions" wx:if="{{viewMode === 'reverseRandom'}}">
      <button class="cancel-adopt-btn" hover-class="none" bindtap="handleCancelAdopt">
        <text class="cancel-adopt-line">取消</text>
        <text class="cancel-adopt-line">采用</text>
      </button>
      <view class="reverse-bottom-gap"></view>
      <button class="adopt-btn" hover-class="none" bindtap="handleAdoptDeck">采用卡组</button>
    </view>
    <view class="bottom-actions" wx:elif="{{viewMode === 'silent'}}">
      <button class="end-silent-btn" bindtap="handleEndSilent">结束静默</button>
    </view>
    <view class="bottom-actions" wx:else>
      <button class="confirm-btn {{selectedAction ? 'confirm-btn-ready' : ''}}" bindtap="handleConfirm">确认</button>
    </view>
  </view>

  <!-- AI_TEMP_DISABLED: 恢复 AI 时去掉外层 wx:if="{{aiFeatureEnabled}}" 即可显示对话浮层 -->
  <view class="chat-mask" wx:if="{{aiFeatureEnabled && showChat}}" catchtouchmove="true">
    <view class="chat-panel">
      <view class="chat-header">
        <view class="chat-close" bindtap="handleCloseChat">
          <view class="chat-close-icon"></view>
          <text class="chat-close-text">结束</text>
        </view>
        <view class="chat-expand-icon"></view>
      </view>

      <scroll-view class="chat-body" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{chatScrollInto}}">
        <view class="chat-welcome" wx:if="{{chatMessages.length <= 1}}">
          <text class="chat-welcome-title">有什么可以帮您？</text>
          <text class="chat-welcome-sub">您仅能提问三次</text>
        </view>

        <view class="chat-suggestions" wx:if="{{chatMessages.length <= 1}}">
          <view
            class="chat-chip"
            wx:for="{{suggestedQuestions}}"
            wx:key="*this"
            data-text="{{item}}"
            bindtap="onTapSuggestion"
          >{{item}}</view>
        </view>

        <view
          class="chat-msg {{item.role === 'user' ? 'chat-msg-user' : 'chat-msg-assistant'}}"
          wx:for="{{chatMessages}}"
          wx:key="id"
          id="msg-{{item.id}}"
        >
          <text class="chat-msg-text">{{item.text}}</text>
        </view>
      </scroll-view>

      <view class="chat-input-bar">
        <input
          class="chat-input"
          value="{{chatInput}}"
          placeholder="输入您的问题..."
          placeholder-class="chat-input-placeholder"
          confirm-type="send"
          bindinput="onChatInput"
          bindconfirm="handleSendChat"
        />
        <view class="chat-send" bindtap="handleSendChat">
          <image class="chat-send-icon" src="/assets/icons/submit-arrow.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>
</view>

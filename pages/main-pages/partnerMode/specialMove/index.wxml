<view class="container">
  <view class="page-body">
    <!-- 顶部：房间入口 + 设计问题（与微信胶囊垂直齐平） -->
    <view
      class="top-bar"
      style="padding-top: {{topBarPadTop}}px; padding-right: {{topBarPaddingRight}}px;"
    >
      <view
        class="top-bar-inner"
        style="height: {{topBarHeight}}px;"
      >
        <view
          class="room-entry"
          style="width: {{topBarIconSize}}px; height: {{topBarIconSize}}px;"
          bindtap="handleGoRoom"
        >
          <image class="room-entry-icon" src="/assets/partnerMode/icon-room-entry-gp.svg" mode="aspectFit" />
        </view>
        <view
          class="problem-chip {{problemExpanded ? 'problem-chip-expanded' : ''}} {{selectedProblemText ? 'problem-chip-tappable' : ''}}"
          style="min-height: {{topBarIconSize}}px;"
          bindtap="handleViewSituation"
        >
          <image class="problem-icon" src="/assets/partnerMode/icon-problem-chip.svg" mode="aspectFit" />
          <view class="problem-text-wrap">
            <text
              id="problemText"
              class="problem-text {{selectedProblemText ? '' : 'problem-text-empty'}} {{problemExpanded ? 'problem-text-expanded' : ''}}"
            >{{selectedProblemText || '暂无设计问题'}}</text>
            <text wx:if="{{selectedProblemText && !problemExpanded}}" id="problemTextMeasure" class="problem-text-measure">{{selectedProblemText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 玩家列表：与出牌页一致，独立一行，避免顶栏堆叠挤压 -->
    <view class="user-section">
      <user-list
        avatarList="{{avatarList}}"
        actingUser="{{currentPlayerIndex}}"
        indicatorUser="{{indicatorPlayerIndex}}"
        enableAdd="{{false}}"
        isFold="{{true}}"
        showName="{{false}}"
        visualMode="partner-game"
        onActionPage="{{viewMode === 'wheel' || cardIndex >= displayRoundSummaries.length}}"
        specialMoveActive="{{true}}"
        showActingFrame="{{true}}"
        roundStartedAt="{{avatarRoundStartedAt}}"
        roundTimerActive="{{roundTimerActive}}"
        roundTimerKey="{{roundTimerKey}}"
        bind:timerexpire="handleRoundTimerExpire"
      />
    </view>

    <view class="divider-line"></view>

    <!-- 选择特殊行动：不展示历史卡片 -->
    <view class="main-content" wx:if="{{viewMode === 'wheel'}}">
      <view class="section-head">
        <view class="section-back" hover-class="back-icon-hover" hover-stay-time="80" bindtap="handleGoBack">
          <image class="section-back-icon" src="/assets/icons/icon-nav-back.svg" mode="aspectFit" />
        </view>
        <text class="section-title">选择特殊行动</text>
        <view class="section-head-spacer"></view>
      </view>
      <view class="wheel-wrap">
        <view class="wheel">
          <view
            class="wheel-slice wheel-slice-{{item.zone}} {{selectedAction === item.id ? 'wheel-slice-active' : ''}}"
            wx:for="{{wheelPieces}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onSelectAction"
          ></view>
          <image class="wheel-cross" src="/assets/partnerMode/special-wheel-cross.svg" mode="aspectFit" />
          <view class="wheel-label wheel-label-top {{selectedAction === 'master' ? 'wheel-label-active' : ''}}" data-id="master" bindtap="onSelectAction">
            <text class="wheel-label-sub">开启</text>
            <view class="wheel-label-quoted">
              <text class="wheel-label-quote">“</text>
              <text class="wheel-label-main">MASTER</text>
              <text class="wheel-label-quote">”</text>
            </view>
            <text class="wheel-label-sub">模式</text>
          </view>
          <view class="wheel-label wheel-label-left {{selectedAction === 'helpLuck' ? 'wheel-label-active' : ''}}" data-id="helpLuck" bindtap="onSelectAction">
            <!-- AI_TEMP_DISABLED: 恢复 AI 后改回「求助AI或运气」 -->
            <text class="wheel-label-vertical">{{aiFeatureEnabled ? '求助AI或运气' : '求助运气'}}</text>
            <view class="wheel-side-icon wheel-help-icon">
              <image class="wheel-help-arrows" src="/assets/partnerMode/special-wheel-help-arrows.svg" mode="aspectFit" />
              <image class="wheel-help-text" src="/assets/partnerMode/special-wheel-help-text.svg" mode="aspectFit" />
            </view>
          </view>
          <view class="wheel-label wheel-label-right {{selectedAction === 'silent' ? 'wheel-label-active' : ''}}" data-id="silent" bindtap="onSelectAction">
            <image class="wheel-side-icon wheel-silent-icon" src="/assets/partnerMode/special-wheel-silent-icon.svg" mode="aspectFit" />
            <text class="wheel-label-vertical">全场静默</text>
          </view>
          <view class="wheel-label wheel-label-bottom {{selectedAction === 'closing' ? 'wheel-label-active' : ''}}" data-id="closing" bindtap="onSelectAction">
            <text class="wheel-label-sub">进入</text>
            <view class="wheel-label-quoted">
              <text class="wheel-label-quote">“</text>
              <text class="wheel-label-main wheel-label-main-sm">收尾阶段</text>
              <text class="wheel-label-quote">”</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 反面随机拼 / 全场静默：可左右滑看历史卡片 -->
    <view class="main-content main-content-fill {{viewMode === 'reverseRandom' ? 'reverse-main' : ''}} {{viewMode === 'silent' ? 'silent-main' : ''}}" wx:else>
      <view class="card-area {{viewMode === 'reverseRandom' ? 'reverse-card-area' : ''}} {{viewMode === 'silent' ? 'silent-card-area' : ''}}">
        <swiper
          class="card-swiper"
          current="{{cardIndex}}"
          disable-touch="{{innerScrollLocked}}"
          bindchange="onCardSwiperChange"
          previous-margin="24rpx"
          next-margin="24rpx"
          easing-function="easeOutCubic"
        >
          <swiper-item
            class="card-swiper-item"
            wx:for="{{cardSlides}}"
            wx:key="slideKey"
          >
            <view class="game-card game-card-muted" wx:if="{{item.slideType === 'history'}}">
              <view class="card-header-row">
                <text class="card-section-title card-section-title-inline">{{item.playerName}} · 第{{item.round}}轮-文字纪要</text>
              </view>
              <scroll-view
                class="card-scroll"
                scroll-y
                enhanced
                show-scrollbar="{{true}}"
                bindtouchstart="onInnerScrollTouchStart"
                bindtouchend="onInnerScrollTouchEnd"
                bindtouchcancel="onInnerScrollTouchEnd"
              >
                <view class="card-scroll-inner">
                  <text class="card-section-title">出牌解释</text>
                  <view class="card-section-flow">
                    <block wx:if="{{item.privateNote.playBlocks && item.privateNote.playBlocks.length}}">
                      <block wx:for="{{item.privateNote.playBlocks}}" wx:for-item="block" wx:key="key">
                        <view wx:if="{{block.type === 'text'}}" class="card-bullet">· {{block.text}}</view>
                        <image
                          wx:elif="{{block.type === 'image'}}"
                          class="card-media-thumb card-media-thumb-flow"
                          src="{{block.url}}"
                          mode="aspectFill"
                          data-url="{{block.url}}"
                          bindtap="onRoundHistoryPreview"
                        />
                      </block>
                    </block>
                    <block wx:else>
                      <view class="card-bullet-list">
                        <view
                          class="card-bullet"
                          wx:for="{{item.privateNote.playHistory}}"
                          wx:for-item="line"
                          wx:key="*this"
                        >· {{line}}</view>
                        <view
                          class="card-bullet card-bullet-empty"
                          wx:if="{{!(item.privateNote.playHistory && item.privateNote.playHistory.length)}}"
                        >· 暂无记录</view>
                      </view>
                      <view class="card-media-grid" wx:if="{{item.privateNote.playImages && item.privateNote.playImages.length}}">
                        <image
                          class="card-media-thumb"
                          wx:for="{{item.privateNote.playImages}}"
                          wx:for-item="img"
                          wx:key="*this"
                          src="{{img}}"
                          mode="aspectFill"
                          data-url="{{img}}"
                          bindtap="onRoundHistoryPreview"
                        />
                      </view>
                    </block>
                  </view>
                  <text class="card-section-title card-section-title-gap">疑问讨论</text>
                  <view class="card-section-flow">
                    <block wx:if="{{item.privateNote.discussionBlocks && item.privateNote.discussionBlocks.length}}">
                      <block wx:for="{{item.privateNote.discussionBlocks}}" wx:for-item="block" wx:key="key">
                        <view wx:if="{{block.type === 'text'}}" class="card-bullet">· {{block.text}}</view>
                        <view
                          wx:elif="{{block.type === 'image'}}"
                          class="card-media-flow-fit"
                          data-url="{{block.url}}"
                          bindtap="onRoundHistoryPreview"
                        >
                          <image
                            class="card-media-flow-fit-img"
                            src="{{block.url}}"
                            mode="widthFix"
                          />
                        </view>
                      </block>
                    </block>
                    <block wx:else>
                      <view class="card-bullet-list">
                        <view
                          class="card-bullet"
                          wx:for="{{item.privateNote.discussionNotes}}"
                          wx:for-item="line"
                          wx:key="*this"
                        >· {{line}}</view>
                        <view
                          class="card-bullet card-bullet-empty"
                          wx:if="{{!(item.privateNote.discussionNotes && item.privateNote.discussionNotes.length)}}"
                        >· 暂无记录</view>
                      </view>
                      <view class="card-media-grid" wx:if="{{item.privateNote.discussionImages && item.privateNote.discussionImages.length}}">
                        <image
                          class="card-media-thumb"
                          wx:for="{{item.privateNote.discussionImages}}"
                          wx:for-item="img"
                          wx:key="*this"
                          src="{{img}}"
                          mode="aspectFill"
                          data-url="{{img}}"
                          bindtap="onRoundHistoryPreview"
                        />
                      </view>
                    </block>
                  </view>
                  <text class="card-section-title card-section-title-gap">语音纪要</text>
                  <view class="card-bullet-list">
                    <view
                      class="card-bullet"
                      wx:for="{{item.voiceLines}}"
                      wx:for-item="voiceLine"
                      wx:key="at"
                    >· {{voiceLine.text}}</view>
                    <view class="card-bullet card-bullet-empty" wx:if="{{!item.voiceLines || !item.voiceLines.length}}">· 暂无记录</view>
                  </view>
                  <text class="card-section-title card-section-title-gap">表态记录</text>
                  <view class="card-bullet-list">
                    <view
                      class="card-bullet"
                      wx:for="{{item.turnRecords}}"
                      wx:for-item="turn"
                      wx:for-index="turnIdx"
                      wx:key="turnIdx"
                    >· {{turn.statementLabel || '未记录'}}</view>
                    <view class="card-bullet card-bullet-empty" wx:if="{{!item.turnRecords || !item.turnRecords.length}}">· 暂无记录</view>
                  </view>
                </view>
              </scroll-view>
            </view>

            <view class="game-card game-card-active" wx:elif="{{item.slideType === 'reverse'}}">
              <scroll-view class="reverse-card-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                <view class="reverse-card-inner">
                  <view class="special-action-header">
                    <view class="special-mode-badge">反面随机拼</view>
                    <text class="special-action-title">请根据以下提示操作</text>
                  </view>
                  <view class="action-divider reverse-divider"></view>
                  <view class="reverse-step-grid">
                    <view class="reverse-step-cell" wx:for="{{reverseSteps}}" wx:key="label">
                      <view class="reverse-step-illus"></view>
                      <text class="reverse-step-label">{{item.label}}</text>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </view>

            <game-card-timer
              wx:elif="{{item.slideType === 'silent'}}"
              startedAt="{{silentStartedAt}}"
              timerActive="{{false}}"
              durationSec="{{silentDurationSec}}"
              loop="{{false}}"
              borderVariant="sound"
              soundLevel="{{soundLevel}}"
              bind:timerexpire="handleSilentTimerExpire"
            >
              <scroll-view class="silent-card-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                <view class="silent-card-inner">
                  <view class="special-action-header">
                    <view class="special-mode-badge">静默模式</view>
                    <text class="special-action-title">保持分贝低于40dB</text>
                  </view>
                  <text class="silent-desc">每轮行动 1–3 次，可新开方案，也可延续他人想法。每次行动后，简要说明你的想法。</text>
                  <view class="action-divider silent-divider"></view>
                  <view class="silent-action-grid">
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">出 1 张卡牌</text>
                    </view>
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">删 1 张卡牌</text>
                    </view>
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">调整 1 张卡牌</text>
                    </view>
                    <view class="silent-action-cell">
                      <view class="silent-action-illus"></view>
                      <text class="silent-action-label">交换 2 张卡牌</text>
                    </view>
                  </view>
                </view>
              </scroll-view>
            </game-card-timer>
          </swiper-item>
        </swiper>

        <view class="card-pagination">
          <view class="pagination-dots">
            <view
              wx:for="{{paginationDots}}"
              wx:for-item="dot"
              wx:key="key"
              class="dot {{dot.sizeClass}} {{dot.active ? 'dot-active' : ''}}"
            ></view>
          </view>
          <text class="pagination-text">{{cardIndex + 1}}/{{cardCount}}</text>
        </view>
      </view>

      <view class="inspiration-bar" wx:if="{{viewMode === 'reverseRandom' || viewMode === 'silent'}}" style="{{inspirationLiftStyle}}">
        <view class="insp-icon-wrap" catchtap="handleGoInspirationCenter">
          <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
        </view>
        <view class="inspiration-composer">
          <view class="inspiration-row">
            <input
              class="inspiration-textarea"
              type="text"
              value="{{inspirationDraftText}}"
              maxlength="200"
              adjust-position="{{false}}"
              placeholder="记录您的灵感..."
              placeholder-class="inspiration-placeholder"
              bindinput="onInspirationInput"
              bindfocus="onInspirationFocus"
              bindblur="onInspirationBlur"
              bindkeyboardheightchange="onInspirationKeyboardHeightChange"
              confirm-type="done"
              cursor-spacing="24"
            />
            <view class="inspiration-action" catchtap="onInspirationActionTap">
              <image
                wx:if="{{inspirationHasText}}"
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-send.svg"
                mode="aspectFit"
              />
              <image
                wx:else
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-plus.svg"
                mode="aspectFit"
              />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 键盘升起时收起底部按钮占位，让灵感输入栏紧贴键盘 -->
  <view class="page-footer {{inspirationKeyboardHeight > 0 ? 'page-footer-insp-hidden' : ''}}">
    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'silent'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{silentHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'master'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{masterHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="silent-hint-section" wx:if="{{viewMode === 'wheel' && selectedAction === 'closing'}}">
      <text
        class="silent-hint-line {{index === 0 ? 'silent-hint-title' : ''}}"
        wx:for="{{closingHintLines}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <view class="bottom-actions reverse-bottom-actions" wx:if="{{viewMode === 'reverseRandom'}}">
      <button class="cancel-adopt-btn" hover-class="none" bindtap="handleCancelAdopt">
        <text class="cancel-adopt-line">取消</text>
        <text class="cancel-adopt-line">采用</text>
      </button>
      <view class="reverse-bottom-gap"></view>
      <button class="adopt-btn" hover-class="none" bindtap="handleAdoptDeck">采用卡组</button>
    </view>
    <view class="bottom-actions" wx:elif="{{viewMode === 'silent'}}">
      <button wx:if="{{canEndSilent}}" class="end-silent-btn" bindtap="handleEndSilent">结束静默</button>
    </view>
    <view class="bottom-actions" wx:else>
      <button class="confirm-btn {{selectedAction ? 'confirm-btn-ready' : ''}}" bindtap="handleConfirm">确认</button>
    </view>
  </view>

  <!-- AI_TEMP_DISABLED: 恢复 AI 时去掉外层 wx:if="{{aiFeatureEnabled}}" 即可显示对话浮层 -->
  <view class="chat-mask" wx:if="{{aiFeatureEnabled && showChat}}" catchtouchmove="true">
    <view class="chat-panel">
      <view class="chat-header">
        <view class="chat-close" bindtap="handleCloseChat">
          <view class="chat-close-icon"></view>
          <text class="chat-close-text">结束</text>
        </view>
        <view class="chat-expand-icon"></view>
      </view>

      <scroll-view class="chat-body" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{chatScrollInto}}">
        <view class="chat-welcome" wx:if="{{chatMessages.length <= 1}}">
          <text class="chat-welcome-title">有什么可以帮您？</text>
          <text class="chat-welcome-sub">您仅能提问三次</text>
        </view>

        <view class="chat-suggestions" wx:if="{{chatMessages.length <= 1}}">
          <view
            class="chat-chip"
            wx:for="{{suggestedQuestions}}"
            wx:key="*this"
            data-text="{{item}}"
            bindtap="onTapSuggestion"
          >{{item}}</view>
        </view>

        <view
          class="chat-msg {{item.role === 'user' ? 'chat-msg-user' : 'chat-msg-assistant'}}"
          wx:for="{{chatMessages}}"
          wx:key="id"
          id="msg-{{item.id}}"
        >
          <text class="chat-msg-text">{{item.text}}</text>
        </view>
      </scroll-view>

      <view class="chat-input-bar" style="{{chatInputLiftStyle}}">
        <input
          class="chat-input"
          value="{{chatInput}}"
          placeholder="输入您的问题..."
          placeholder-class="chat-input-placeholder"
          confirm-type="send"
          bindinput="onChatInput"
          bindconfirm="handleSendChat"
          bindfocus="onChatInputFocus"
          bindblur="onChatInputBlur"
          bindkeyboardheightchange="onChatKeyboardHeightChange"
          adjust-position="{{false}}"
          cursor-spacing="24"
        />
        <view class="chat-send" bindtap="handleSendChat">
          <image class="chat-send-icon" src="/assets/icons/submit-arrow.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

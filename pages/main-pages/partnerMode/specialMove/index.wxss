.container {
  height: 100vh;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.custom-navbar {
  background: #fafafa;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.page-footer {
  flex-shrink: 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.top-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 30rpx 12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.room-entry {
  width: 74rpx;
  height: 74rpx;
  border-radius: 9999rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

.problem-chip {
  flex: 0 1 auto;
  max-width: 432rpx;
  min-width: 0;
  min-height: 74rpx;
  padding: 14rpx 20rpx;
  background: #e9f5e9;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  box-sizing: border-box;
  z-index: 2;
}

.problem-chip-expanded {
  align-items: flex-start;
  z-index: 20;
}

.problem-chip-tappable {
  cursor: pointer;
}

.problem-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.problem-text-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
}

.problem-text {
  display: -webkit-box;
  width: 100%;
  font-size: 24rpx;
  color: #747474;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.problem-text-expanded {
  display: block;
  overflow: visible;
  text-overflow: unset;
  -webkit-line-clamp: unset;
  white-space: normal;
}

.problem-text-measure {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  font-size: 24rpx;
  line-height: 1.2;
  word-break: break-all;
  white-space: normal;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}

.problem-text-empty {
  color: #a8c9a6;
}

.user-section {
  padding: 10rpx 30rpx 0;
  flex-shrink: 0;
}

.divider-line {
  height: 2rpx;
  margin: 10rpx 30rpx 8rpx;
  background: #f1f1f1;
  flex-shrink: 0;
}

.main-content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 30rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.main-content-fill {
  overflow: hidden;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 40rpx;
  flex-shrink: 0;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.section-back {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.section-title {
  flex: 1;
  text-align: center;
  font-size: 44rpx;
  font-weight: 500;
  color: #5ec159;
  line-height: 1;
}

.section-head-spacer {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

/* 非等分扇形转盘：上下 68° / 左右 112°（对齐 Figma #5929:20023） */
.wheel-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 8rpx 0 16rpx;
  box-sizing: border-box;
}

.wheel {
  position: relative;
  width: 640rpx;
  height: 640rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
  border: 2rpx solid #d3d3d3;
  flex-shrink: 0;
  box-sizing: border-box;
}

.wheel-slice {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: transparent;
}

.wheel-slice-active {
  background: #5ec159;
}

/* 分割线偏垂直 ±34°：外顶点取圆心外 2R，由 wheel overflow 裁成圆弧 */
.wheel-slice-top {
  clip-path: polygon(50% 50%, -5.92% -32.9%, 105.92% -32.9%);
  -webkit-clip-path: polygon(50% 50%, -5.92% -32.9%, 105.92% -32.9%);
}

.wheel-slice-right {
  clip-path: polygon(50% 50%, 105.92% -32.9%, 105.92% 132.9%);
  -webkit-clip-path: polygon(50% 50%, 105.92% -32.9%, 105.92% 132.9%);
}

.wheel-slice-bottom {
  clip-path: polygon(50% 50%, 105.92% 132.9%, -5.92% 132.9%);
  -webkit-clip-path: polygon(50% 50%, 105.92% 132.9%, -5.92% 132.9%);
}

.wheel-slice-left {
  clip-path: polygon(50% 50%, -5.92% 132.9%, -5.92% -32.9%);
  -webkit-clip-path: polygon(50% 50%, -5.92% 132.9%, -5.92% -32.9%);
}

/* 斜向分割线（Figma 渐变十字装饰） */
.wheel-cross {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 432rpx;
  height: 644rpx;
  transform: translate(-50%, -50%);
  z-index: 2;
  pointer-events: none;
}

.wheel-label {
  position: absolute;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  pointer-events: auto;
}

.wheel-label-top {
  top: 6%;
  left: 50%;
  transform: translateX(-50%);
  width: 48%;
}

.wheel-label-left {
  left: 3%;
  top: 50%;
  transform: translateY(-50%);
  width: 46%;
  height: 56%;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
}

.wheel-label-right {
  right: 3%;
  top: 50%;
  transform: translateY(-50%);
  width: 46%;
  height: 56%;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.wheel-label-bottom {
  bottom: 8%;
  left: 50%;
  transform: translateX(-50%);
  width: 48%;
}

.wheel-side-icon {
  flex-shrink: 0;
  pointer-events: none;
}

.wheel-help-icon {
  position: relative;
  width: 156rpx;
  height: 172rpx;
}

.wheel-help-arrows {
  position: absolute;
  left: 0;
  top: 0;
  width: 156rpx;
  height: 172rpx;
}

.wheel-help-text {
  position: absolute;
  left: 60rpx;
  top: 24rpx;
  width: 36rpx;
  height: 122rpx;
}

.wheel-silent-icon {
  width: 142rpx;
  height: 104rpx;
}

.wheel-label-quoted {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.wheel-label-quote {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.8);
  line-height: 1;
}

.wheel-label-main {
  font-size: 44rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1;
}

.wheel-label-main-sm {
  font-size: 42rpx;
  font-weight: 500;
}

.wheel-label-sub {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.8);
  line-height: 1.4;
}

.wheel-label-vertical {
  writing-mode: vertical-rl;
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.8);
  line-height: 1.4;
  letter-spacing: 4rpx;
  flex-shrink: 0;
}

.wheel-label-active .wheel-label-main,
.wheel-label-active .wheel-label-sub,
.wheel-label-active .wheel-label-quote,
.wheel-label-active .wheel-label-vertical {
  color: #fff;
}

.wheel-label-active .wheel-help-arrows,
.wheel-label-active .wheel-help-text,
.wheel-label-active .wheel-silent-icon {
  filter: brightness(0) invert(1);
}

/* 求助方式单选 */
.help-method-section {
  padding: 0 30rpx 20rpx;
}

.help-method-label {
  display: block;
  text-align: center;
  font-size: 32rpx;
  color: #383838;
  margin-bottom: 20rpx;
}

.help-method-list {
  display: flex;
  gap: 20rpx;
}

.help-method-card {
  flex: 1;
  min-width: 0;
  min-height: 148rpx;
  padding: 16rpx 20rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  position: relative;
}

.help-method-card-selected {
  border-color: #5ec159;
}

.help-method-radio {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8rpx;
}

.radio-outer {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #5ec159;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-sizing: border-box;
}

.radio-inner {
  width: 18rpx;
  height: 18rpx;
  background: #5ec159;
  border-radius: 50%;
}

.help-method-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5ec159;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.help-method-desc {
  display: block;
  font-size: 20rpx;
  color: #565656;
  line-height: 1.4;
}

/* 全场静默：转盘底部提示 */
.silent-hint-section {
  padding: 0 40rpx 20rpx;
  text-align: center;
}

.silent-hint-line {
  display: block;
  font-size: 28rpx;
  color: #565656;
  line-height: 1.6;
}

.silent-hint-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #383838;
  margin-bottom: 4rpx;
}

/* 全场静默：进行中页面 */
.silent-main {
  padding: 0 20rpx;
}

.silent-card {
  position: relative;
}

.silent-badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  z-index: 2;
  padding: 8rpx 24rpx;
  background: #5ec159;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.silent-card-body {
  flex: 1;
  height: 0;
  padding: 88rpx 24rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.silent-timer {
  font-size: 40rpx;
  font-weight: 600;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.silent-main-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  text-align: center;
  line-height: 1.3;
  margin-bottom: 20rpx;
}

.silent-desc {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: center;
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.action-cell-muted {

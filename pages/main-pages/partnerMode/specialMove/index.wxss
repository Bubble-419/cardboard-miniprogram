  background: #ececec;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-cell {
  width: calc(50% - 8rpx);
  border-radius: 8rpx;
  min-height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 16rpx;
  box-sizing: border-box;
}

.action-cell-filled {

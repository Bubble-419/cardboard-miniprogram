}

.action-cell-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.reverse-card-illus {
  flex: 1;
  width: 72rpx;
  height: 100rpx;
  margin: 24rpx auto 12rpx;
  border-radius: 8rpx;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  background: linear-gradient(180deg, #f6fcfd 0%, #d4eef5 100%);
  transform: rotate(180deg);
}

/* 底部按钮 */
.bottom-actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 0 30rpx;
}

.confirm-btn {
  flex: 1;
  height: 112rpx;
  margin: 0;

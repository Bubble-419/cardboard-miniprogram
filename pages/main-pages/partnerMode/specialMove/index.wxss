}

/* AI 对话浮层 */
.chat-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 0 0 calc(env(safe-area-inset-bottom));
}

.chat-panel {
  height: 78vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  border: 6rpx solid #b0e0ae;
  border-bottom: none;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.chat-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
}

.chat-close {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chat-close-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid #5ec159;
  border-bottom: 4rpx solid #5ec159;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.chat-close-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #5ec159;
}

.chat-expand-icon {
  width: 36rpx;
  height: 20rpx;
  border: 3rpx solid #ccc;
  border-radius: 4rpx;
}

.chat-body {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx 16rpx;
  box-sizing: border-box;
}

.chat-welcome {
  padding: 48rpx 0 32rpx;
  text-align: center;
}

.chat-welcome-title {
  display: block;
  font-size: 48rpx;
  color: #1c1c1c;
  margin-bottom: 16rpx;
}

.chat-welcome-sub {
  display: block;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
}

.chat-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 32rpx;
}

.chat-chip {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: #e9f5e9;
  border: 2rpx solid #5ec159;
  font-size: 28rpx;
  color: #5ec159;
}

.chat-msg {
  margin-bottom: 20rpx;
  max-width: 85%;
}

.chat-msg-assistant {
  align-self: flex-start;
}

.chat-msg-user {
  margin-left: auto;
  text-align: right;
}

.chat-msg-text {
  display: inline-block;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: left;
}

.chat-msg-assistant .chat-msg-text {
  background: #f3f3f3;
  color: #333;
}

.chat-msg-user .chat-msg-text {
  background: #e9f5e9;
  color: #2d6b2a;
}

.chat-input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 24rpx;
  border-top: 2rpx solid #ececec;
  background: #fafafa;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 2rpx solid #d7d7d7;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #333;
}

.chat-input-placeholder {
  color: #aeaeae;
}

.chat-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #5ec159;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chat-send-icon {
  width: 32rpx;
  height: 32rpx;
}

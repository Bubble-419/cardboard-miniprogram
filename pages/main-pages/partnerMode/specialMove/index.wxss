  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #5ec159;
  color: #fff;
  font-size: 48rpx;
  letter-spacing: 4rpx;
  line-height: 112rpx;
}

.end-silent-btn::after {
  border: none;
}

.card-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 4rpx;
}

.card-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.card-swiper-item {
  box-sizing: border-box;
  padding: 0 8rpx;
  height: 100%;
}

.game-card {
  height: 100%;
  border-radius: 28rpx;
  background: #fff;
  border: 4rpx solid #5ec159;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.game-card-active {
  border-width: 8rpx;
  border-color: #b0e0ae;
}

.action-card-body {
  flex: 1;
  height: 0;
  padding: 28rpx 24rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.action-title {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.action-desc {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.action-divider {

}

.inspiration-submit {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #5ec159;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.inspiration-arrow {

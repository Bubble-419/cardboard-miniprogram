.container {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  flex-shrink: 0;
  width: 100%;
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.wait-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.wait-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.wait-desc {
  font-size: 28rpx;
  color: #9ca3af;
}

.instruction-section {
  flex-shrink: 0;
  padding: 36rpx 54rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.instruction-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  text-align: center;
}

.instruction-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
}

.content-area {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
}

.main-stage {
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  padding: 0 54rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

.circle-wrap {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  overflow: visible;
}

.deco-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 1rpx solid rgba(94, 193, 89, 0.15);
  transform: translate(-50%, -50%);
  animation: deco-ring-pulse 4s ease-in-out infinite;
  z-index: 0;
}

.deco-ring-1 { width: 520rpx; height: 520rpx; animation-delay: 0s; }
.deco-ring-2 { width: 440rpx; height: 440rpx; animation-delay: 0.5s; border-color: rgba(94, 193, 89, 0.12); }
.deco-ring-3 { width: 360rpx; height: 360rpx; animation-delay: 1s; border-color: rgba(94, 193, 89, 0.1); }
.deco-ring-inner {
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(94, 193, 89, 0.08);
  animation: deco-ring-rotate 8s linear infinite;
}

.deco-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 240rpx;
  height: 240rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(94, 193, 89, 0.06) 0%, rgba(94, 193, 89, 0.02) 50%, transparent 70%);
  border-radius: 50%;
  animation: deco-glow-breathe 3s ease-in-out infinite;
  z-index: 0;
}

.deco-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: rgba(94, 193, 89, 0.4);
  border-radius: 50%;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  animation: deco-particle-float 5s ease-in-out infinite;
  box-shadow: 0 0 12rpx rgba(94, 193, 89, 0.3);
  z-index: 0;
}

.deco-particle-1 { animation-delay: 0s; margin-left: 180rpx; margin-top: -120rpx; }
.deco-particle-2 { animation-delay: 0.8s; margin-left: -200rpx; margin-top: -80rpx; }
.deco-particle-3 { animation-delay: 1.6s; margin-left: 220rpx; margin-top: 60rpx; }
.deco-particle-4 { animation-delay: 2.4s; margin-left: -160rpx; margin-top: 140rpx; }
.deco-particle-5 { animation-delay: 3.2s; margin-left: 0; margin-top: -220rpx; }
.deco-particle-6 { animation-delay: 4s; margin-left: 100rpx; margin-top: 200rpx; }

@keyframes deco-ring-pulse {
  0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(0.98); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.02); }
}

@keyframes deco-ring-rotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes deco-glow-breathe {
  0%, 100% { opacity: 0.8; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
}

@keyframes deco-particle-float {
  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
  50% { opacity: 0.9; transform: translate(-50%, -50%) scale(1.3); }
}

.avatar-slot {
  position: absolute;
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  transition: transform 0.18s ease;
}

.avatar-slot-selected .avatar-img {
  border: 4rpx solid #5ec159;
  box-shadow: 0 0 24rpx rgba(94, 193, 89, 0.5), 0 0 48rpx rgba(94, 193, 89, 0.2);
  transform: scale(1.12);
}

.avatar-slot-me {
  position: relative;
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: block;
  object-fit: cover;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.avatar-circle-glow {
  animation: avatar-breathe 2.5s ease-in-out infinite;
  box-shadow: 0 0 20rpx rgba(94, 193, 89, 0.25), 0 0 40rpx rgba(94, 193, 89, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

.avatar-img.avatar-me {
  border: 4rpx solid #5ec159;
  box-shadow: 0 0 24rpx rgba(94, 193, 89, 0.5), 0 0 48rpx rgba(94, 193, 89, 0.2);
}

@keyframes avatar-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.avatar-slot-selected .avatar-img.avatar-me {
  transform: scale(1.12);
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx dashed #d1d5db;
  background: #f3f4f6;
}

.avatar-placeholder-animate {
  animation: placeholder-breathe 2.5s ease-in-out infinite;
}

@keyframes placeholder-breathe {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.avatar-name-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  max-width: 120rpx;
}

.avatar-name {
  font-size: 24rpx;
  color: #374151;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-me-label {
  color: #5ec159;
  flex-shrink: 0;
}

.placeholder-name {
  margin-top: 8rpx;
  color: #9ca3af;
}

.footer {
  flex-shrink: 0;
  padding: 24rpx 54rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  background-color: #c0c0c0;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 44rpx;
  font-weight: 400;
  border: none;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.enabled {
  background-color: #5ec159;
}

.confirm-btn.enabled:active {
  opacity: 0.9;
}

<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        ></image>
      </view>
      <view class="navbar-title">合伙人模式</view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 成员：等待房主 -->
  <view class="wait-wrap" wx:if="{{!isHost || isWaiting}}">
    <view class="title-section">
      <text class="main-title">合伙人模式</text>
      <text class="sub-title wait-hint">等待房主选择情境</text>
    </view>
    <view class="empty-state">
      <text class="empty-state-text">等待房主选择情境</text>
    </view>
  </view>

  <!-- 房主：情境卡片列表 -->
  <block wx:else>
    <view class="header-section">
      <text class="page-title">合伙人模式</text>
      <text class="page-subtitle">请选择情境类型</text>
    </view>

    <scroll-view class="scenario-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="scenario-grid">
        <view
          class="scenario-card {{selectedScenarioId === item.id ? 'selected' : ''}}"
          wx:for="{{scenarios}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapScenario"
        >
          <view class="scenario-card-badge {{item.type === 'case' ? 'badge-case' : 'badge-history'}}">
            <text>{{item.type === 'case' ? '案例' : '历史'}}</text>
          </view>
          <text class="scenario-card-title">{{item.title}}</text>
          <text class="scenario-card-summary">{{item.summary}}</text>
          <view class="scenario-tags" wx:if="{{item.bg}}">
            <text class="scenario-tag" wx:if="{{item.bg.scene}}">{{item.bg.scene}}</text>
            <text class="scenario-tag" wx:if="{{item.bg.user}}">{{item.bg.user}}</text>
            <text class="scenario-tag" wx:if="{{item.bg.platform}}">{{item.bg.platform}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="footer">
      <button
        class="footer-btn {{actionMode === 'select' ? 'footer-btn-select' : 'footer-btn-add'}}"
        bindtap="handleFooterAction"
      >
        <text wx:if="{{actionMode === 'select'}}">选择</text>
        <text wx:else>新增 +</text>
      </button>
    </view>
  </block>
</view>

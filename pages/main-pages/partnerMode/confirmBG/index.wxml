<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar" style="padding-top: {{navbarPaddingTop}}px">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        ></image>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 成员等待视图 -->
  <view class="wait-wrap" wx:if="{{!isHost || isWaiting}}">
    <text class="wait-title">确认情境</text>
    <text class="wait-desc">等待房主确认情境…</text>
  </view>

  <!-- 房主确认视图 -->
  <block wx:else>
    <!-- 卡片叠放区：纯 CSS 百分比布局，无滚动，自适应屏幕高度 -->
    <view class="deck-outer">
      <view class="deck-container">
        <!--
          4 张卡叠放：step=22%，card-slot height=34%，3×22+34=100
          透视感：deck-container 开启 perspective，每张卡用 rotateX 递减倾斜
          水印改为纯文字，避免 <image> 百分比高度在小程序中失效
        -->
        <view
          class="deck-slot"
          wx:for="{{cards}}"
          wx:key="type"
          style="top: {{index * 22}}%; z-index: {{index + 1}};"
        >
          <view class="deck-card deck-card-{{index}}">
            <view class="deck-bg"></view>
            <image class="deck-frame" src="/assets/bgCard/union-green.svg" mode="scaleToFill" />
            <text class="deck-label">{{item.label}}</text>
            <text class="deck-watermark-text">IxDL</text>
            <text class="deck-value">{{item.value}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 确认按钮 -->
    <view class="footer">
      <button
        class="confirm-btn {{canConfirm ? 'enabled' : ''}}"
        disabled="{{!canConfirm}}"
        bindtap="handleConfirm"
      >确认情境</button>
    </view>
  </block>
</view>

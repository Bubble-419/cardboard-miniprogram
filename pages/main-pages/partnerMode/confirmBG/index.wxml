<view class="container {{isGameDetail ? 'container-game-detail' : ''}}">
  <!-- 顶部：游戏详情展示返回图标，其余流程展示房间入口 -->
  <player-top-bar
    showAvatars="{{false}}"
    showRoomEntry="{{!isGameDetail}}"
    showBack="{{isGameDetail}}"
    bind:goroom="handleGoRoom"
    bind:back="handleGoBack"
  />

  <!-- 成员等待视图（回看情境时不展示） -->
  <view class="wait-wrap" wx:if="{{!fromGameView && (!isHost || isWaiting)}}">
    <text class="wait-title">确认情境</text>
    <text class="wait-desc">等待房主确认情境…</text>
  </view>
  <page-footer
    wx:if="{{!fromGameView && (!isHost || isWaiting)}}"
    extClass="footer"
    showPrimary="{{false}}"
    bind:prev="handleGoBack"
  ></page-footer>

  <!-- 游戏页进入：完整设计问题 + 情境四张叠卡 -->
  <block wx:elif="{{isGameDetail}}">
    <scroll-view class="game-detail-body" scroll-y enhanced show-scrollbar="{{false}}">
      <!-- 完整设计问题：结构/排版与「选择设计问题」选中卡一致（text 须单行紧贴，避免空白行盒） -->
      <view class="design-problem-block">
        <view class="design-problem-indicator"></view>
        <view class="design-problem-text-wrap">
          <text class="design-problem-text {{fullProblemText ? '' : 'design-problem-text-empty'}}">{{fullProblemText || '暂无设计问题'}}</text>
        </view>
      </view>

      <view class="cards-area cards-area-game-detail">
        <view class="cards-deck" style="height: {{deckHeightRpx}}rpx;">
          <view
            class="deck-slot"
            wx:for="{{cards}}"
            wx:key="type"
            style="top: {{index * deckStepRpx}}rpx; z-index: {{index + 1}}; animation-delay: {{index * 120}}ms"
            data-index="{{index}}"
            bindtap="handleCardTap"
          >
            <view class="deck-card">
              <view class="deck-bg"></view>
              <image class="deck-frame" src="/assets/bgCard/union-green.svg" mode="scaleToFill" />
              <image class="deck-watermark" src="/assets/bgCard/icon-center-confirm.svg" mode="aspectFit" />
              <text class="deck-value">{{item.value}}</text>
            </view>
            <text class="deck-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

  </block>

  <!-- 提交页回看 / 房主确认：原比例叠卡 -->
  <block wx:elif="{{fromGameView || (isHost && !isWaiting)}}">
    <view class="cards-area">
      <view class="cards-deck" style="height: {{deckHeightRpx}}rpx;">
        <view
          class="deck-slot"
          wx:for="{{cards}}"
          wx:key="type"
          style="top: {{index * deckStepRpx}}rpx; z-index: {{index + 1}}; animation-delay: {{index * 120}}ms"
          data-index="{{index}}"
          bindtap="handleCardTap"
        >
          <view class="deck-card">
            <view class="deck-bg"></view>
            <image class="deck-frame" src="/assets/bgCard/union-green.svg" mode="scaleToFill" />
            <image class="deck-watermark" src="/assets/bgCard/icon-center-confirm.svg" mode="aspectFit" />
            <text class="deck-value">{{item.value}}</text>
          </view>
          <text class="deck-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <page-footer
      wx:if="{{fromGameView}}"
      extClass="footer"
      showPrev="{{false}}"
    >
      <button class="confirm-btn enabled" bindtap="handleReturnToGame">{{returnBtnText}}</button>
    </page-footer>
    <page-footer
      wx:else
      extClass="footer"
      showPrev="{{true}}"
      bind:prev="handleGoBack"
    >
      <button
        class="confirm-btn {{canConfirm ? 'enabled' : ''}}"
        disabled="{{!canConfirm}}"
        bindtap="handleConfirm"
      >
        确认情境
      </button>
    </page-footer>
  </block>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar" style="padding-top: {{navbarPaddingTop}}px">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        ></image>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 成员等待视图 -->
  <view class="wait-wrap" wx:if="{{!isHost || isWaiting}}">
    <text class="wait-title">确认情境</text>
    <text class="wait-desc">等待房主确认情境…</text>
  </view>

  <!-- 房主确认视图 -->
  <block wx:else>
    <!-- 卡片堆叠区 -->
    <view class="cards-area">
      <view class="cards-deck">
        <!--
          绝对定位叠放：top = index × step(260rpx)
          animation-delay 逐张级联，营造卡片依次落下效果
        -->
        <view
          class="deck-slot"
          wx:for="{{cards}}"
          wx:key="type"
          style="top: {{index * 255}}rpx; z-index: {{index + 1}}; animation-delay: {{index * 120}}ms"
          data-index="{{index}}"
          bindtap="handleCardTap"
        >
          <view class="deck-card">
            <view class="deck-bg"></view>
            <image class="deck-frame" src="/assets/bgCard/union-green.svg" mode="scaleToFill" />
            <image class="deck-watermark" src="/assets/bgCard/icon-center-confirm.svg" mode="aspectFit" />
            <text class="deck-value">{{item.value}}</text>
            <!-- 点击提示角标 -->
            <view class="deck-edit-hint">
              <text class="deck-edit-text">点击修改</text>
            </view>
          </view>
          <text class="deck-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 确认按钮 -->
    <view class="footer">
      <button
        class="confirm-btn {{canConfirm ? 'enabled' : ''}}"
        disabled="{{!canConfirm}}"
        bindtap="handleConfirm"
      >
        确认情境
      </button>
    </view>
  </block>
</view>

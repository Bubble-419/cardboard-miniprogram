<view class="container {{isGameDetail ? 'container-game-detail' : ''}}">
  <!-- 顶部：房间入口 + 堆叠头像（与胶囊水平居中对齐） -->
  <player-top-bar
    avatarList="{{avatarList}}"
    maxVisible="{{5}}"
    bind:goroom="handleGoRoom"
  />

  <!-- 成员等待视图（回看情境时不展示） -->
  <view class="wait-wrap" wx:if="{{!fromGameView && (!isHost || isWaiting)}}">
    <text class="wait-title">确认情境</text>
    <text class="wait-desc">等待房主确认情境…</text>
  </view>
  <page-footer
    wx:if="{{!fromGameView && (!isHost || isWaiting)}}"
    extClass="footer"
    showPrimary="{{false}}"
    bind:prev="handleGoBack"
  ></page-footer>

  <!-- 游戏页进入：设计问题置顶（Figma #6028:3383）+ 情境 2×2 格，一屏不滚动 -->
  <block wx:elif="{{isGameDetail}}">
    <view class="game-detail-body">
      <!-- 完整设计问题：与「选择设计问题」选中卡同款展示 -->
      <view class="design-problem-block">
        <view class="design-problem-indicator"></view>
        <view class="design-problem-text-wrap">
          <text class="design-problem-text {{fullProblemText ? '' : 'design-problem-text-empty'}}">
            {{fullProblemText || '暂无设计问题'}}
          </text>
        </view>
      </view>

      <!-- 情境四格：与选择/提交设计问题页 context-display 一致 -->
      <view class="detail-context-wrap">
        <context-display items="{{categories}}" />
      </view>
    </view>

    <page-footer extClass="footer footer-compact" showPrev="{{false}}">
      <button class="confirm-btn enabled" bindtap="handleReturnToGame">{{returnBtnText}}</button>
    </page-footer>
  </block>

  <!-- 提交页回看 / 房主确认：原比例叠卡 -->
  <block wx:elif="{{fromGameView || (isHost && !isWaiting)}}">
    <view class="cards-area">
      <view class="cards-deck">
        <view
          class="deck-slot"
          wx:for="{{cards}}"
          wx:key="type"
          style="top: {{index * 255}}rpx; z-index: {{index + 1}}; animation-delay: {{index * 120}}ms"
          data-index="{{index}}"
          bindtap="handleCardTap"
        >
          <view class="deck-card">
            <view class="deck-bg"></view>
            <image class="deck-frame" src="/assets/bgCard/union-green.svg" mode="scaleToFill" />
            <image class="deck-watermark" src="/assets/bgCard/icon-center-confirm.svg" mode="aspectFit" />
            <text class="deck-value">{{item.value}}</text>
            <view class="deck-edit-hint" wx:if="{{!fromGameView}}">
              <text class="deck-edit-text">点击修改</text>
            </view>
          </view>
          <text class="deck-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <page-footer
      wx:if="{{fromGameView}}"
      extClass="footer"
      showPrev="{{false}}"
    >
      <button class="confirm-btn enabled" bindtap="handleReturnToGame">{{returnBtnText}}</button>
    </page-footer>
    <page-footer
      wx:else
      extClass="footer"
      showPrev="{{true}}"
      bind:prev="handleGoBack"
    >
      <button
        class="confirm-btn {{canConfirm ? 'enabled' : ''}}"
        disabled="{{!canConfirm}}"
        bindtap="handleConfirm"
      >
        确认情境
      </button>
    </page-footer>
  </block>
</view>

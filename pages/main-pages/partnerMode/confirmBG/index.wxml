<view class="container">
  <!-- 顶部：房间入口 + 堆叠头像 -->
  <player-top-bar
    avatarList="{{avatarList}}"
    maxVisible="{{5}}"
    bind:goroom="handleGoRoom"
  />

  <!-- 成员等待视图（从游戏回看情境时不展示） -->
  <view class="wait-wrap" wx:if="{{!fromGameView && (!isHost || isWaiting)}}">
    <text class="wait-title">确认情境</text>
    <text class="wait-desc">等待房主确认情境…</text>
  </view>
  <page-footer
    wx:if="{{!fromGameView && (!isHost || isWaiting)}}"
    extClass="footer"
    showPrimary="{{false}}"
    bind:prev="handleGoBack"
  ></page-footer>

  <!-- 房主确认 / 游戏中回看情境 -->
  <block wx:elif="{{fromGameView || (isHost && !isWaiting)}}">
    <!-- 卡片堆叠区 -->
    <view class="cards-area">
      <view class="cards-deck">
        <!--
          绝对定位叠放：top = index × step(260rpx)
          animation-delay 逐张级联，营造卡片依次落下效果
        -->
        <view
          class="deck-slot"
          wx:for="{{cards}}"
          wx:key="type"
          style="top: {{index * 255}}rpx; z-index: {{index + 1}}; animation-delay: {{index * 120}}ms"
          data-index="{{index}}"
          bindtap="handleCardTap"
        >
          <view class="deck-card">
            <view class="deck-bg"></view>
            <image class="deck-frame" src="/assets/bgCard/union-green.svg" mode="scaleToFill" />
            <image class="deck-watermark" src="/assets/bgCard/icon-center-confirm.svg" mode="aspectFit" />
            <text class="deck-value">{{item.value}}</text>
            <!-- 点击提示角标（游戏中回看只读，不显示修改） -->
            <view class="deck-edit-hint" wx:if="{{!fromGameView}}">
              <text class="deck-edit-text">点击修改</text>
            </view>
          </view>
          <text class="deck-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 确认 / 返回游戏 -->
    <page-footer
      extClass="footer"
      showPrev="{{!fromGameView}}"
      bind:prev="handleGoBack"
    >
      <button
        wx:if="{{fromGameView}}"
        class="confirm-btn enabled"
        bindtap="handleReturnToGame"
      >
        返回游戏
      </button>
      <button
        wx:else
        class="confirm-btn {{canConfirm ? 'enabled' : ''}}"
        disabled="{{!canConfirm}}"
        bindtap="handleConfirm"
      >
        确认情境
      </button>
    </page-footer>
  </block>
</view>

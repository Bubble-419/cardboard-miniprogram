/* ===== 容器 ===== */
.container {
  height: 100vh;
  background-color: #f8fbfa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 导航栏 ===== */
.custom-navbar {
  background-color: transparent;
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.navbar-title { flex: 1; }
.navbar-right { width: 80rpx; }

/* ===== 等待视图 ===== */
.wait-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 40rpx;
}

.wait-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #5ec159;
}

.wait-desc {
  font-size: 28rpx;
  color: #9ca3af;
}

/* ===== 卡片叠放区外层 ===== */
.deck-outer {
  flex: 1;
  min-height: 0;
  padding: 20rpx 44rpx 0;
  box-sizing: border-box;
}

/*
  perspective 在这里开启，让子卡片的 rotateX 产生真实 3D 透视效果
*/
.deck-container {
  position: relative;
  width: 100%;
  height: 100%;
  perspective: 1400rpx;
  perspective-origin: 50% 0%;
}

/*
  step=22%，card-slot height=34%，3×22+34=100，四张恰好铺满容器
*/
.deck-slot {
  position: absolute;
  left: 0;
  right: 0;
  height: 34%;
}

/* ===== 卡片本体 ===== */
/*
  3D 透视感：最底层卡倾斜角最大，最前层卡不倾斜
  transform-origin: top center → 顶边固定，底边向后旋转，产生近大远小感
  box-shadow 随层级递增，强化层次感
*/
.deck-card {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 25rpx;
  overflow: hidden;
  transform-origin: top center;
}

.deck-card-0 {
  transform: rotateX(6deg);
  box-shadow: 0 4rpx 14rpx rgba(94, 193, 89, 0.12);
}
.deck-card-1 {
  transform: rotateX(4deg);
  box-shadow: 0 8rpx 20rpx rgba(94, 193, 89, 0.16);
}
.deck-card-2 {
  transform: rotateX(2deg);
  box-shadow: 0 12rpx 28rpx rgba(94, 193, 89, 0.20);
}
.deck-card-3 {
  transform: rotateX(0deg);
  box-shadow: 0 16rpx 36rpx rgba(94, 193, 89, 0.26);
}

/* 纯白底板，撑满卡片 */
.deck-bg {
  position: absolute;
  inset: 0;
  background: #ffffff;
}

/* Union 绿色框架，铺满整张卡 */
.deck-frame {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/*
  右上角标签：Figma 精确比例
    label x=258.13, card_w=305.61 → right = (305.61-258.13-29)/305.61 ≈ 6%
    label y=4.28, card_h=211      → top ≈ 2%
*/
.deck-label {
  position: absolute;
  top: 4%;
  right: 6%;
  font-size: 26rpx;
  font-weight: 400;
  color: #ffffff;
  z-index: 3;
  letter-spacing: 2rpx;
}

/*
  IxDL 水印文字：替代 <image>，避免百分比 height 在小程序失效
  Figma 水印位置：x=69.45/305.61≈22.7%，y=68.19/211≈32.3%
*/
.deck-watermark-text {
  position: absolute;
  left: 22%;
  top: 32%;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  color: rgba(242, 242, 242, 0.7);
  z-index: 2;
  pointer-events: none;
  line-height: 1;
}

/*
  已填写的值：Figma 中心在 (59.13+93.5, 92.47+13.5)=(152.6,105.97)
    left: 59.13/305.61=19.3%
    top:  92.47/211=43.8%
    width: 187/305.61=61.2%
*/
.deck-value {
  position: absolute;
  left: 19%;
  width: 62%;
  top: 44%;
  font-size: 48rpx;
  font-weight: 600;
  color: #5ec159;
  text-align: center;
  line-height: 1.25;
  z-index: 3;
  word-break: break-all;
}

/* ===== 底部确认按钮 ===== */
.footer {
  flex-shrink: 0;
  padding: 20rpx 54rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(248, 251, 250, 1) 60%, transparent);
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  /* 按钮文字上下居中：line-height = height，同时清除默认 padding */
  line-height: 96rpx;
  padding: 0;
  background-color: #d0e8d0;
  color: #9ec89e;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  letter-spacing: 4rpx;
  text-align: center;
}

.confirm-btn::after { border: none; }

.confirm-btn.enabled {
  background: linear-gradient(135deg, #5ec159, #4db84a);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(94, 193, 89, 0.35);
}

.confirm-btn.enabled:active { opacity: 0.9; }

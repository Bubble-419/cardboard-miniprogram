.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.wait-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.wait-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.wait-desc {
  font-size: 28rpx;
  color: #9ca3af;
}

.cards-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 42rpx 0;
  box-sizing: border-box;
}

.cards-stack {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding-bottom: 32rpx;
}

.confirm-card {
  width: 100%;
}

.confirm-card-inner {
  position: relative;
  min-height: 200rpx;
  background-color: #ffffff;
  border: 8rpx solid #5ec159;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx 36rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(94, 193, 89, 0.12);
}

.type-badge {
  position: absolute;
  right: 24rpx;
  top: -4rpx;
  padding: 10rpx 20rpx;
  background-color: #5ec159;
  border-radius: 16rpx;
  z-index: 1;
}

.type-badge-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
  line-height: 1.2;
}

.card-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #5ec159;
  text-align: center;
  line-height: 1.35;
  word-break: break-all;
  padding: 0 16rpx;
}

.footer {
  flex-shrink: 0;
  padding: 24rpx 54rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: transparent;
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  background-color: #c0c0c0;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 44rpx;
  font-weight: 400;
  border: none;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.enabled {
  background-color: #5ec159;
}

.confirm-btn.enabled:active {
  opacity: 0.9;
}

<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        />
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="waiting-content" wx:if="{{isWaiting}}">
    <view class="empty-state">
      <image
        class="empty-illus"
        src="/assets/partnerMode/statement-empty-illus.svg"
        mode="aspectFit"
      />
      <view class="empty-text-group">
        <text class="empty-text">请用实体表态卡进行表态</text>
        <text class="empty-subtext">等待主屏操作...</text>
      </view>
    </view>
  </view>

  <view class="host-content" wx:else>
    <view class="instruction">
      <text class="instruction-line">使用表态卡对玩家{{currentPlayerName}}的行动表态</text>
      <text class="instruction-line">选择表态统计结果</text>
    </view>

    <view class="statement-progress" wx:if="{{passCount !== null}}">
      <text class="statement-progress-text">已表态：{{passCount}}/{{memberCount}}</text>
    </view>

    <view class="result-stack {{isSubmitting ? 'result-stack-disabled' : ''}}">
      <view
        class="result-item"
        catchtap="handleStatementResult"
        data-result="allPass"
      >
        <view class="result-circle result-circle-pass">
          <text class="result-label">全部通过</text>
        </view>
      </view>

      <view
        class="result-item"
        catchtap="handleStatementResult"
        data-result="partialPass"
      >
        <view class="result-circle result-circle-partial">
          <text class="result-label">部分通过</text>
        </view>
      </view>

      <view
        class="result-item"
        catchtap="handleStatementResult"
        data-result="allQuestion"
      >
        <view class="result-circle result-circle-question">
          <text class="result-label">全部疑问</text>
        </view>
      </view>
    </view>
  </view>
</view>

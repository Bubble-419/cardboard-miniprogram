.container {
  min-height: 100vh;
  background-color: #fafafa;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.host-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #fafafa;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-chevron {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  flex: 1;
  text-align: center;
}

.navbar-right {
  width: 80rpx;
}

.instruction {
  padding: 72rpx 40rpx 44rpx;
  text-align: center;
}

.instruction-line {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  color: #5EC159;
  line-height: 1.6;
}

.statement-buttons {
  width: 100%;
  max-width: 560rpx;
  margin: 72rpx auto 0;
  padding: 0 24rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.statement-loading {
  width: 100%;
  margin: 72rpx auto 0;
  text-align: center;
  font-size: 30rpx;
  color: #9ab69a;
}

.statement-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 78rpx;
  font-weight: 700;
  color: #5EC159;
  box-sizing: border-box;
  background-color: #E3FAE2;
  border: 2rpx solid #5EC159;
  box-shadow: 0 8rpx 20rpx rgba(94, 193, 89, 0.16);
}

.statement-btn-active {
  background-color: #5EC159;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(0, 212, 104, 0.28);
  transform: scale(1.03);
}

.confirm-wrap {
  margin-top: auto;
  padding: 28rpx 56rpx calc(24rpx + env(safe-area-inset-bottom));
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 16rpx;
  background-color: #5EC159;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn-disabled {
  background-color: #BFD9BE;
  color: #FFFFFF;
}

.confirm-btn::after {
  border: none;
}

.waiting-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.character-container {
  margin-bottom: 40rpx;
}

.character-bg {
  width: 438rpx;
  height: 294rpx;
  background-color: rgba(31, 177, 213, 0.15);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.character-icon {
  width: 128rpx;
  height: 120rpx;
  background-color: #4fc8e7;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.character-face {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye {
  width: 26rpx;
  height: 26rpx;
  background-color: #000000;
  border-radius: 50%;
  position: absolute;
  top: 40%;
}

.eye-left { left: 25%; transform: translate(-50%, -50%); }
.eye-right { right: 25%; transform: translate(50%, -50%); }

.mouth {
  width: 18rpx;
  height: 9rpx;
  border: 2rpx solid #000000;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  position: absolute;
  bottom: 30%;
  left: 50%;
  transform: translateX(-50%);
}

.foot {
  width: 34rpx;
  height: 32rpx;
  background-color: #000000;
  border-radius: 4rpx;
  position: absolute;
  bottom: 10%;
}

.foot-left { left: 20%; }
.foot-right { right: 20%; }

.main-text {
  font-size: 56rpx;
  color: #16a6ca;
  text-align: center;
  margin-bottom: 20rpx;
  font-weight: 500;
  line-height: 1.5;
}

.sub-text {
  font-size: 36rpx;
  color: #9a9a9a;
  text-align: center;
  line-height: 1.33;
}

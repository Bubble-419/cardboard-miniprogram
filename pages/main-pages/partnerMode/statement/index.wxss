.container {
  min-height: 100vh;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
}

.custom-navbar {
  background: #fafafa;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

/* ===== 房主表态统计 Figma #5915:52821 ===== */
.host-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 80rpx 0;
  box-sizing: border-box;
}

.instruction {
  width: 100%;
  padding: 40rpx 0 36rpx;
  text-align: center;
}

.instruction-line {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.5;
  text-align: center;
}

.statement-progress {
  width: 100%;
  text-align: center;
  padding-bottom: 16rpx;
}

.statement-progress-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #909090;
}

.result-stack {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 32rpx;
  padding: 8rpx 0 72rpx;
  box-sizing: border-box;
}

.result-stack-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.result-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-item:active .result-circle {
  opacity: 0.88;
  transform: scale(0.98);
}

/* 约 150px → 300rpx（较稿面略缩） */
.result-circle {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.result-circle-pass {
  background: #5ec159;
}

.result-circle-partial {
  background: #979797;
}

.result-circle-question {
  background: #000000;
}

.result-label {
  font-size: 42rpx;
  font-weight: 400;
  color: #ffffff;
  letter-spacing: 0.0714em;
  text-align: center;
  line-height: 1.5;
}

/* ===== 副屏等待：与其他空状态页保持一致 Figma #5912:50988 ===== */
.waiting-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.empty-state {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 44rpx;
  padding: 40rpx 20rpx;
  box-sizing: border-box;
}

.empty-illus {
  width: 376rpx;
  height: 280rpx;
}

.empty-text-group {
  width: 100%;
  max-width: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-text {
  width: 100%;
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.5;
  text-align: center;
}

.empty-subtext {
  width: 100%;
  font-size: 32rpx;
  font-weight: 400;
  color: #909090;
  line-height: 1.5;
  text-align: center;
}

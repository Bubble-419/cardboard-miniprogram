.container {
  height: 100vh;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.custom-navbar {
  background: #fafafa;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.page-footer {
  flex-shrink: 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.top-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 30rpx 18rpx;
  flex-shrink: 0;
}

.room-entry {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry-icon {
  width: 100rpx;
  height: 100rpx;
}

.problem-chip {
  flex: 1;
  min-width: 0;
  max-width: calc((100% - 138rpx) * 2 / 3);
  height: 100rpx;
  padding: 0 28rpx 0 56rpx;
  background: #e9f5e9;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

.problem-icon {
  width: 41rpx;
  height: 41rpx;
  flex-shrink: 0;
  position: absolute;
  left: 14rpx;
  top: 50%;
  transform: translateY(-50%);
}

.problem-text {
  flex: 1;
  font-size: 24rpx;
  color: #747474;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.problem-text-empty {
  color: #a8c9a6;
}

.user-section {
  padding: 0 40rpx 8rpx;
  flex-shrink: 0;
}

/* partner-avatar 滚动行：左缘与主卡片对齐（swiper 40rpx + item 8rpx - avatar 8rpx padding） */
.player-avatar-scroll {
  width: 100%;
}

.player-avatar-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 0;
  padding: 2rpx 0;
  box-sizing: border-box;
  white-space: nowrap;
}

.divider-line {
  height: 2rpx;
  margin: 0 30rpx 12rpx;
  background: #f1f1f1;
  flex-shrink: 0;
}

.card-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 4rpx;
}

.card-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.card-swiper-item {
  box-sizing: border-box;
  padding: 0 8rpx;
  height: 100%;
}

.game-card {
  height: 100%;
  border-radius: 28rpx;
  background: #fff;
  border: 4rpx solid #5ec159;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.game-card-active {
  border-width: 4rpx;
  border-color: #b0e0ae;
}

.card-header-row {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.card-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.card-section-title-inline {
  margin-bottom: 0;
}

.card-section-title-gap {
  margin-top: 28rpx;
}

.insert-image-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 4rpx 0;
}

.insert-image-icon {
  width: 32rpx;
  height: 28rpx;
  position: relative;
  box-sizing: border-box;
}

.insert-image-icon::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 28rpx;
  height: 20rpx;
  border: 2rpx solid #5ec159;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.insert-image-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 0;
  width: 12rpx;
  height: 8rpx;
  border: 2rpx solid #5ec159;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

.insert-image-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.3;
}

.card-scroll {
  flex: 1;
  height: 0;
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
}

.card-bullet-list {
  margin-bottom: 20rpx;
}

.card-bullet {
  font-size: 28rpx;
  color: #5f5f5f;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.card-photo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0 24rpx;
}

.card-photo {
  width: 200rpx;
  height: 300rpx;
  border-radius: 8rpx;
  border: 12rpx solid #fff;
  box-shadow: 0 0 12rpx rgba(0, 0, 0, 0.25);
  background: #e7e7e7;
}

.action-card-scroll {
  flex: 1;
  height: 0;
  width: 100%;
}

.action-card-inner {
  padding: 50rpx 30rpx 16rpx;
  box-sizing: border-box;
}

.action-title-row {
  display: flex;
  justify-content: center;
  margin-bottom: 12rpx;
}

.master-mode-badge {
  padding: 8rpx 24rpx;
  background: #5ec159;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.action-title {
  display: block;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #5ec159;
  line-height: 1.3;
  letter-spacing: -0.06em;
  margin-bottom: 34rpx;
}

.action-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
  line-height: 1.3;
  letter-spacing: -0.06em;
  margin-bottom: 16rpx;
}

.action-divider {
  height: 2rpx;
  margin: 0 0 16rpx;
  background: #f1f1f1;
}

.action-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 16rpx;
  width: 100%;
}

.action-cell {
  width: 48%;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  overflow: hidden;
  box-sizing: border-box;
}

.action-illus-box {
  width: 100%;
  position: relative;
  flex-shrink: 0;
}

.action-illus-box::after {
  content: '';
  display: block;
  padding-bottom: 100%;
}

.action-illus {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: #e7e7e7;
}

.action-cell-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: center;
  padding: 2rpx 0 0;
  line-height: 1.3;
  letter-spacing: -0.06em;
}

.score-panel {
  flex-shrink: 0;
  margin: 0 20rpx 20rpx;
  padding: 6rpx 14rpx 10rpx;
  background: #fff;
  border: 1rpx solid #f1f5f1;
  border-radius: 28rpx;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.2);
}

.score-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
  padding: 0 4rpx;
}

.score-label,
.score-progress {
  font-size: 24rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.5;
}

.score-buttons {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 12rpx;
}

.score-btn {
  flex: 1;
  width: 0;
  min-width: 0;
  position: relative;
  border-radius: 21rpx;
  background: #e3fae2;
  box-sizing: border-box;
  overflow: hidden;
}

.score-btn::after {
  content: '';
  display: block;
  padding-bottom: 100%;
}

.score-btn-content {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 6rpx;
  box-sizing: border-box;
  line-height: 1;
}

.score-btn-active {
  background: #5ec159;
}

.score-btn-disabled {
  opacity: 0.45;
}

.score-num {
  font-size: 76rpx;
  font-weight: 600;
  line-height: 0.75;
}

.score-unit {
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
  margin-left: 0;
  margin-bottom: 10rpx;
}

.score-btn:not(.score-btn-active) .score-num,
.score-btn:not(.score-btn-active) .score-unit {
  color: #5ec159;
}

.score-btn-active .score-num,
.score-btn-active .score-unit {
  color: #fff;
}

.card-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 8rpx 0 4rpx;
  position: relative;
  flex-shrink: 0;
}

.pagination-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d9d9d9;
  flex-shrink: 0;
}

.dot-active {
  background: #5ec159;
}

.pagination-text {
  position: absolute;
  right: 40rpx;
  font-size: 32rpx;
  color: #5ec159;
}

.inspiration-bar {
  margin: 6rpx 48rpx 8rpx;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  position: relative;
  height: 100rpx;
}

.insp-icon-wrap {
  width: 98rpx;
  height: 100rpx;
  position: relative;
  flex-shrink: 0;
  z-index: 2;
}

.insp-icon-img {
  width: 92rpx;
  height: 92rpx;
  margin-top: 8rpx;
}

.insp-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #5ec159;
  position: absolute;
  right: 0;
  top: 0;
}

.inspiration-input-fake {
  flex: 1;
  height: 92rpx;
  margin-left: -40rpx;
  padding: 0 24rpx 0 56rpx;
  background: #fff;
  border: 1rpx solid #d7d7d7;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.inspiration-placeholder {
  flex: 1;
  font-size: 32rpx;
  color: #aeaeae;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inspiration-arrow {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.bottom-actions {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
  padding: 0 48rpx;
}

.special-btn-wrap {
  flex: none;
  width: calc((100% - 16rpx) * 4 / 17);
}

.statement-btn-wrap {
  flex: none;
  width: calc((100% - 16rpx) * 13 / 17);
}

.special-btn {
  width: 100%;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #e9f5e9;
  color: #5ec159;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.06em;
  letter-spacing: 0.1em;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.special-btn-line {
  display: block;
  line-height: 1.1;
}

.special-btn::after {
  border: none;
}

.special-btn-disabled,
.special-btn[disabled] {
  background: #e7e7e7 !important;
  color: #c1c1c1 !important;
  opacity: 1 !important;
}

.statement-btn {
  width: 100%;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #c0c0c0;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 400;
  letter-spacing: 0.0667em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.statement-btn::after {
  border: none;
}

.statement-btn[disabled] {
  background: #c0c0c0 !important;
  color: #ffffff !important;
  opacity: 1 !important;
}

.statement-btn-enabled {
  background: #5ec159 !important;
  color: #fff !important;
  opacity: 1 !important;
}

.statement-btn-enabled:active {
  opacity: 0.9 !important;
}

.discussion-card-body {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.discussion-title {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.discussion-divider {
  height: 2rpx;
  background: #ececec;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.discussion-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.discussion-photo-placeholder {
  width: 200rpx;
  height: 150rpx;
  margin: 24rpx auto;
  border: 2rpx dashed #adadad;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.discussion-photo-icon {
  width: 48rpx;
  height: 40rpx;
  position: relative;
}

.discussion-photo-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  width: 40rpx;
  height: 28rpx;
  border: 2rpx solid #b0b0b0;
  border-radius: 6rpx;
}

.discussion-photo-icon::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 2rpx;
  width: 16rpx;
  height: 10rpx;
  border: 2rpx solid #b0b0b0;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

.discussion-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #b4b4b4;
  line-height: 1.4;
  margin: 16rpx 0 24rpx;
}

.discussion-report-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 16rpx;
}

.discussion-report-title {
  font-size: 26rpx;
  color: #909090;
}

.discussion-report-sub {
  font-size: 22rpx;
  color: #909090;
}

.end-discussion-btn {
  flex: 1;
  width: 100%;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #5ec159;
  color: #fff;
  font-size: 44rpx;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.end-discussion-btn::after {
  border: none;
}

.end-discussion-btn:active {
  opacity: 0.9;
}

.end-discussion-btn-disabled {
  background: #c1c1c1;
}

/* 收尾阶段 */
.closing-card {
  position: relative;
}

.closing-badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  z-index: 2;
  padding: 8rpx 24rpx;
  background: #5ec159;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.closing-card-body {
  flex: 1;
  height: 0;
  padding: 88rpx 24rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.closing-card-title {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  margin-bottom: 12rpx;
}

.closing-card-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
  margin-bottom: 16rpx;
}

.closing-divider {
  height: 2rpx;
  background: #ececec;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.closing-rune-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.closing-rune-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.closing-rune-slot {
  background: #e7e7e7;
  border-radius: 8rpx;
  min-height: 120rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.closing-rune-slot-top {
  min-height: 100rpx;
}

.closing-rune-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: center;
}

.closing-scroll {
  flex: 1;
  height: 0;
}

.closing-photo-hint {
  margin: 0 0 16rpx;
  padding: 16rpx 24rpx;
  background: #d9d9d9;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
  flex-shrink: 0;
}

.closing-photo-placeholder {
  width: 200rpx;
  height: 150rpx;
  margin: 24rpx auto;
  border: 2rpx dashed #adadad;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.closing-next-btn,
.end-brainstorm-btn {
  flex: 1;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #5ec159;
  color: #fff;
  font-size: 44rpx;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.closing-next-btn::after,
.end-brainstorm-btn::after {
  border: none;
}

.closing-btn-disabled {
  background: #c1c1c1;
}

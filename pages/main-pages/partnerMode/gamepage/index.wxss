  align-items: center;
  justify-content: center;
}

.closing-review-empty-text {
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.35);
}

.closing-photo-placeholder {
  width: 280rpx;
  height: 228rpx;
  margin: 24rpx auto;
  border: none;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  box-sizing: border-box;
  padding: 0;
}

.closing-next-btn,
.end-brainstorm-btn {
  flex: 1;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #5ec159;
  color: #fff;
  font-size: 44rpx;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.closing-next-btn::after,
.end-brainstorm-btn::after {
  border: none;
}

.closing-btn-disabled {
  background: #c1c1c1;
}

/* ---- 卡片插入文字/图片 ---- */
.action-title-main {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.action-title-main-master {
  justify-content: flex-start;
  text-align: left;
  padding-right: 12rpx;
  box-sizing: border-box;
}

.action-title-main .action-title {
  width: auto;
  text-align: center;
}

.action-title-main .action-title-row {
  justify-content: center;
  width: auto;
}

.action-title-main-master .action-title-row {
  justify-content: flex-start;
  width: 100%;
}

.express-fab-btn {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #5ec159;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 10rpx;
}

.express-fab-btn .express-fab-bubble {
  width: 40rpx;
  height: 40rpx;
}

.express-btn {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 8rpx;
}

.express-btn-icon {
  width: 56rpx;
  height: 56rpx;
}

.express-btn-label {
  font-size: 20rpx;
  color: #5ec159;
  line-height: 1.2;
}

.card-media-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.card-media-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
}

.card-insert-panel {
  margin-top: 28rpx;
  padding: 20rpx;
  background: #f7f8f9;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.card-insert-toolbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-insert-photos {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.card-insert-photo-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.card-insert-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #e5e7eb;
}

.card-insert-photo-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.7);
  color: #fff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.card-insert-row {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 12rpx;
}

.card-insert-textarea {
  flex: 1;
  min-height: 64rpx;
  max-height: 200rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.4;
  box-sizing: border-box;
}

.card-insert-placeholder {
  color: #9ca3af;
}

.card-insert-send {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-insert-send-disabled {
  opacity: 0.4;
}

.card-insert-send-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ---- 出牌玩家匿名聊天面板 ---- */
.express-chat-panel {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: #fff;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.express-chat-panel-head {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 20rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  border-bottom: 2rpx solid #f1f1f1;
  box-sizing: border-box;
}

.express-chat-panel-back {
  width: 64rpx;
  font-size: 56rpx;
  color: #333;
  line-height: 1;
  text-align: left;
}

.express-chat-panel-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.express-chat-panel-head-spacer {
  width: 64rpx;
}

.express-chat-panel-list {
  flex: 1;
  height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.express-chat-panel-foot {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f1f1f1;
  box-sizing: border-box;
}

.express-chat-panel-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f2f2f2;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.express-chat-panel-locked {
  flex-shrink: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f1f1f1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.express-chat-panel-locked-text {
  font-size: 26rpx;
  color: #aeaeae;
}

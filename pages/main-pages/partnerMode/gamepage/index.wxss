.container {
  height: 100vh;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* Figma #5848:3368 — 顶部内容避开微信胶囊 */
.page-footer {
  flex-shrink: 0;
  padding: 18rpx 0 calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-left: 30rpx;
  padding-bottom: 12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.top-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.room-entry {
  border-radius: 9999rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.room-entry-icon {
  width: 100%;
  height: 100%;
  display: block;
}

.problem-chip {
  flex: none;
  width: 432rpx;
  max-width: 432rpx;
  min-width: 0;
  min-height: 64rpx;
  padding: 10rpx 20rpx;
  background: #e9f5e9;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  box-sizing: border-box;
  z-index: 2;
}

.problem-chip-expanded {
  align-items: flex-start;
  z-index: 20;
}

.problem-chip-tappable {
  cursor: pointer;
}

.problem-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.problem-text-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
}

.problem-text {
  display: -webkit-box;
  width: 100%;
  font-size: 24rpx;
  color: #747474;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.problem-text-expanded {
  display: block;
  overflow: visible;
  text-overflow: unset;
  -webkit-line-clamp: unset;
  white-space: normal;
}

.problem-text-measure {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  font-size: 24rpx;
  line-height: 1.2;
  word-break: break-all;
  white-space: normal;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}

.problem-text-empty {
  color: #a8c9a6;
}

.user-section {
  padding: 10rpx 30rpx 0;
  flex-shrink: 0;
}

/* partner-avatar 滚动行：左缘与主卡片对齐（swiper 40rpx + item 8rpx - avatar 8rpx padding） */
.player-avatar-scroll {
  width: 100%;
}

.player-avatar-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 0;
  padding: 2rpx 0;
  box-sizing: border-box;
  white-space: nowrap;
}

.divider-line {
  height: 2rpx;
  margin: 10rpx 30rpx 8rpx;
  background: #f1f1f1;
  flex-shrink: 0;
}

.card-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-bottom: 0;
  overflow: hidden;
}

.card-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.card-swiper-item {
  box-sizing: border-box;
  padding: 0 6rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.card-swiper-item > .game-card,
.card-swiper-item > game-card-timer {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.game-card {
  height: 100%;
  border-radius: 28rpx;
  background: #fff;
  border: 4rpx solid #5ec159;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.game-card-active {
  border-width: 4rpx;
  border-color: #b0e0ae;
}

.game-card-muted {
  border: 4rpx solid #d4e0d4;
  background: #f7faf7;
}

.game-card-no-border {
  border: none;
}

.card-bullet-empty {
  color: #b0b0b0;
}

.card-bullet-empty-tap {
  width: 100%;
  min-height: 56rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
  line-height: 1.5;
}

.card-bullet-empty-tap-hover {
  opacity: 0.65;
}

.action-voice-list {
  padding: 0 0 8rpx;
}

.action-card-wrap {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.action-card-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
}

.action-card-inner {
  padding: 50rpx 30rpx 40rpx;
  box-sizing: border-box;
}

.action-card-inner-express {
  padding-bottom: 100rpx;
}

/* 卡片右下角表达入口（出牌玩家 / 讨论阶段） */
.card-express-corner {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 6;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  max-width: calc(100% - 32rpx);
  box-sizing: border-box;
}

.card-express-corner-open {
  left: 16rpx;
  right: 16rpx;
}

/* 出牌阶段旁观：表达钮随打分抽屉高度上移，且不受 clip overflow 影响 */
.spectator-play-express-corner {
  bottom: 80px;
  transition: bottom 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.action-card-inner-spectator {
  padding: 50rpx 30rpx 220rpx;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.action-title-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  gap: 8rpx;
  min-width: 0;
  box-sizing: border-box;
}

.master-mode-badge {
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  height: 56rpx;
  padding: 0 16rpx;
  background: #5ec159;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  letter-spacing: -0.06em;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
  white-space: nowrap;
}

/* Figma #5848:3395 — title + desc gap 17px */
.action-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 34rpx;
  width: 100%;
  margin-bottom: 16rpx;
  min-width: 0;
  box-sizing: border-box;
}

/* Figma #5933:8003 — MASTER：徽章+标题同行，与说明间距 7px */
.action-header-master {
  gap: 14rpx;
  align-items: stretch;
}

.action-title {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #5ec159;
  line-height: 1.3;
  letter-spacing: -0.06em;
}

.action-title-master {
  flex: 1;
  min-width: 0;
  width: auto;
  font-size: 36rpx;
  font-weight: 700;
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
  letter-spacing: 0.01em;
}

.action-desc {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
  line-height: 1.3;
  letter-spacing: -0.06em;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.action-header-master .action-desc {
  font-size: 24rpx;
  text-align: left;
}

.action-divider {
  height: 2rpx;
  margin: 0 0 16rpx;
  background: #f1f1f1;
}

.action-divider-gap {
  margin-top: 24rpx;
}

/* Figma #5848:3399 — 2×2 grid, gap 8px 10px */
.action-rules-block {
  width: 100%;
  flex-shrink: 0;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
  width: 100%;
}

.action-cell {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 2rpx;
  min-width: 0;
  box-sizing: border-box;
}

.action-illus {
  width: 100%;
  aspect-ratio: 1;
  background: #e7e7e7;
  border-radius: 0;
  flex-shrink: 0;
}

.action-cell-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: center;
  line-height: 1.3;
  letter-spacing: -0.06em;
  padding-top: 4rpx;
}

/* 非出牌玩家：匿名聊天 + 打分抽屉（Figma 5960/5964） */
.spectator-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  padding: 36rpx 28rpx 0;
  /* 允许底部打分抽屉向上展开，不裁切 */
  overflow: visible;
}

.spectator-bottom-stack {
  position: relative;
  flex-shrink: 0;
  align-self: stretch;
  margin-left: -28rpx;
  margin-right: -28rpx;
  z-index: 5;
  overflow: visible;
}

.score-sheet-spacer {
  width: 100%;
  flex-shrink: 0;
  pointer-events: none;
}

/* 裁剪窗：高度与 translateY 同步变化，按钮逐渐露出/藏入 */
.score-sheet-clip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  overflow: hidden;
  pointer-events: auto;
  transition: none;
  will-change: height;
}

.score-sheet-clip-animating {
  transition: height 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.score-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 16rpx 20rpx;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -2rpx 16rpx rgba(113, 142, 111, 0.4);
  box-sizing: border-box;
  will-change: transform;
  /* 拖动时跟手：无过渡；吸附时加 .score-sheet-animating */
  transition: none;
}

.score-sheet-animating {
  transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.score-sheet-handle-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0 10rpx;
}

.score-sheet-handle {
  width: 68rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #aeaeae;
}

.score-sheet-head {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 8rpx;
  box-sizing: border-box;
}

.score-sheet .score-buttons {
  width: 100%;
  margin-top: 4rpx;
  position: relative;
  z-index: 2;
}

.spectator-card-head {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
}

.spectator-card-title {
  display: block;
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #5ec159;
  line-height: 1.3;
  letter-spacing: -0.06em;
}

.spectator-card-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
  line-height: 1.3;
  letter-spacing: -0.06em;
}

.spectator-chat {
  flex: 1;
  min-height: 0;
  width: 100%;
  margin-top: 8rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.spectator-chat-empty {
  padding: 80rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spectator-chat-empty-text {
  font-size: 26rpx;
  color: #aeaeae;
}

.spectator-chat-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-right: 80rpx;
  box-sizing: border-box;
}

.spectator-chat-avatar-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.spectator-chat-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: block;
  background: #ededed;
}

.spectator-chat-avatar-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 2rpx solid #ffffff;
  box-sizing: border-box;
}

.spectator-chat-bubble {
  flex: 0 1 auto;
  max-width: 100%;
  min-width: 0;
  padding: 16rpx 20rpx;
  background: #f2f2f2;
  border-radius: 4rpx 18rpx 18rpx 18rpx;
  box-sizing: border-box;
}

.spectator-chat-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  word-break: break-word;
}

.summary-express-list {
  margin-top: 8rpx;
  padding-right: 24rpx;
  box-sizing: border-box;
}

.spectator-express-dock {
  position: absolute;
  right: 16rpx;
  bottom: 100%;
  margin-bottom: 16rpx;
  z-index: 6;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  /* 不参与抽屉拖拽，避免误触 */
  pointer-events: auto;
}

.spectator-express-dock-open {
  left: 16rpx;
  right: 16rpx;
}

.spectator-express-fab {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: #5ec159;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 10rpx;
}

.express-fab-bubble,
.spectator-express-fab-bubble {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.action-express-chat-body {
  flex: 1;
  min-height: 360rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.action-express-chat {
  flex: 1;
  height: 100%;
  min-height: 280rpx;
  max-height: 520rpx;
  width: 100%;
  box-sizing: border-box;
}

.action-express-chat-foot {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #f1f1f1;
  box-sizing: border-box;
}

.action-express-chat-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 20rpx;
  background: #f2f2f2;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.action-express-chat-locked {
  flex-shrink: 0;
  margin-top: 16rpx;
  padding: 16rpx 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 2rpx solid #f1f1f1;
}

.action-express-chat-locked-text {
  font-size: 26rpx;
  color: #aeaeae;
}

.discussion-card-body .action-express-chat-body {
  flex: 1;
  min-height: 0;
  height: 100%;
}

.discussion-card-body .action-express-chat {
  max-height: none;
}

.discussion-express-list {
  margin-top: 8rpx;
  box-sizing: border-box;
}

.discussion-express-foot {
  flex-shrink: 0;
  margin: 12rpx 28rpx 0;
  padding-top: 16rpx;
  border-top: 2rpx solid #f1f1f1;
}

.spectator-express-fab-icon {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
}

.spectator-express-composer {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.spectator-express-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  padding: 0 24rpx;
  background: #f2f2f2;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.spectator-express-placeholder {
  color: #aeaeae;
}

.spectator-express-send {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spectator-express-send-disabled {
  opacity: 0.45;
}

.spectator-express-send-icon {
  width: 60rpx;
  height: 60rpx;
}

.score-panel {
  flex-shrink: 0;
  margin: 8rpx 0 0;
  padding: 6rpx 14rpx 10rpx;
  background: #fff;
  border: 1rpx solid #f1f5f1;
  border-radius: 28rpx;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.12);
}

/* 浮在出牌并解释面板底部上方 */
.score-panel-float {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  margin: 0;
  z-index: 5;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.14);
}

game-card-timer {
  display: block;
  height: 100%;
}

.card-header-row {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.card-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.card-section-title-inline {
  margin-bottom: 0;
}

.card-player-round {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #7a9a78;
  margin-bottom: 8rpx;
}

.card-section-title-gap {
  margin-top: 28rpx;
}

.card-section-block {
  padding: 4rpx 0 8rpx;
  box-sizing: border-box;
}

.card-section-block-gap {
  margin-top: 28rpx;
}

.card-section-flow {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.card-section-flow .card-bullet {
  margin: 0;
}

.card-media-thumb-flow {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.card-section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.card-section-head .card-section-title {
  margin-bottom: 0;
  flex: 1;
  min-width: 0;
}

.card-section-title-tap {
  padding: 4rpx 0;
}

.card-section-add {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-section-add-icon {
  width: 40rpx;
  height: 40rpx;
}

.card-inline-textarea {
  display: block;
  width: 100%;
  min-height: 88rpx;
  max-height: 360rpx;
  margin: 0;
  padding: 16rpx 0;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
  color: #5f5f5f;
  /* 微信 textarea 用倍数行高易裁切，改用固定行高 */
  line-height: 44rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.card-inline-textarea-wrap {
  flex-shrink: 0;
  width: 100%;
  min-height: 88rpx;
  margin: 0 0 16rpx;
  box-sizing: border-box;
}

.card-inline-textarea-hint {
  min-height: 88rpx;
  padding: 16rpx 0;
}

.card-inline-textarea-active {
  min-height: 96rpx;
  padding: 16rpx 20rpx;
  background: #f7f8f9;
  border-radius: 16rpx;
  color: #111827;
}

.card-record-placeholder {
  color: #b0b0b0;
  font-size: 28rpx;
  line-height: 44rpx;
}

.card-record-placeholder-active {
  color: #d4d4d4;
  font-size: 28rpx;
  line-height: 44rpx;
}

.insert-image-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 4rpx 0;
}

.insert-image-icon {
  width: 32rpx;
  height: 28rpx;
  position: relative;
  box-sizing: border-box;
}

.insert-image-icon::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 28rpx;
  height: 20rpx;
  border: 2rpx solid #5ec159;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.insert-image-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 0;
  width: 12rpx;
  height: 8rpx;
  border: 2rpx solid #5ec159;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

.insert-image-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.3;
}

.card-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
}

.card-scroll-inner {
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
}

.card-bullet-list {
  margin-bottom: 20rpx;
}

.card-bullet {
  font-size: 28rpx;
  color: #5f5f5f;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.card-photo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0 24rpx;
}

.card-photo {
  width: 200rpx;
  height: 300rpx;
  border-radius: 8rpx;
  border: 12rpx solid #fff;
  box-shadow: 0 0 12rpx rgba(0, 0, 0, 0.25);
  background: #e7e7e7;
}

.score-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
  padding: 0 4rpx;
}

.score-label,
.score-progress {
  font-size: 24rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.5;
}

.score-buttons {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 12rpx;
}

.score-btn {
  flex: 1;
  width: 0;
  min-width: 0;
  position: relative;
  border-radius: 21rpx;
  background: #e3fae2;
  box-sizing: border-box;
  overflow: hidden;
}

.score-btn::after {
  content: '';
  display: block;
  padding-bottom: 100%;
}

.score-btn-content {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 6rpx;
  box-sizing: border-box;
  line-height: 1;
  text-align: center;
}

.score-btn-active {
  background: #5ec159;
}

.score-btn-disabled {
  opacity: 0.45;
}

.score-num {
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.score-unit {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  margin-left: 0;
  margin-bottom: 8rpx;
  flex-shrink: 0;
}

.score-btn:not(.score-btn-active) .score-num,
.score-btn:not(.score-btn-active) .score-unit {
  color: #5ec159;
}

.score-btn-active .score-num,
.score-btn-active .score-unit {
  color: #fff;
}

.card-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  min-height: 40rpx;
  padding: 4rpx 30rpx;
  position: relative;
  flex-shrink: 0;
  box-sizing: border-box;
  /* 页码绝对定位不撑高；须高于字号，避免被 .card-area overflow:hidden 裁切 */
  overflow: visible;
}

.pagination-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 18rpx;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d9d9d9;
  flex-shrink: 0;
}

.dot-lg {
  width: 18rpx;
  height: 18rpx;
}

.dot-md {
  width: 14rpx;
  height: 14rpx;
}

.dot-sm {
  width: 10rpx;
  height: 10rpx;
  opacity: 0.7;
}

.dot-xs {
  width: 8rpx;
  height: 8rpx;
  opacity: 0.5;
}

.dot-active {
  background: #5ec159;
  opacity: 1;
}

.pagination-text {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  line-height: 1.2;
  color: rgba(94, 193, 89, 0.72);
}

/* Figma #5926:2116 — icon / 输入框同高 92rpx，垂直居中对齐 */
.inspiration-bar {
  margin: 18rpx 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 60;
  min-height: 92rpx;
  box-sizing: border-box;
}

.insp-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  position: relative;
  flex-shrink: 0;
  z-index: 2;
}

.insp-icon-img {
  width: 92rpx;
  height: 92rpx;
}

.insp-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #5ec159;
  position: absolute;
  right: 0;
  top: 0;
}

/* Figma #5848:3431 — 灵感数量角标 */
.insp-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 6rpx;
  border-radius: 50%;
  background: #5ec159;
  position: absolute;
  right: 0;
  top: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.insp-badge-num {
  font-size: 20rpx;
  font-weight: 500;
  color: #ffffff;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.inspiration-composer {
  flex: 1;
  min-width: 0;
  height: 92rpx;
  min-height: 92rpx;
  padding: 0 24rpx;
  background: #fff;
  border: 1rpx solid #d7d7d7;
  border-radius: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.inspiration-composer-with-photos {
  height: auto;
  min-height: 92rpx;
  padding: 16rpx 24rpx;
}

.inspiration-composer-focused {
  border-color: #d7d7d7;
}

.inspiration-photo-strip {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.inspiration-photo-strip-inner {
  display: inline-flex;
  gap: 12rpx;
}

.inspiration-photo-thumb-wrap {
  position: relative;
  width: 96rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.inspiration-photo-thumb {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #eee;
}

.inspiration-photo-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

/* Figma #5928:13308 — 文案与右侧 icon 左右排布 */
.inspiration-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.inspiration-textarea {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 48rpx;
  letter-spacing: -0.02em;
  padding: 0;
}

.inspiration-placeholder {
  font-size: 30rpx;
  color: #aeaeae;
  line-height: 48rpx;
  letter-spacing: -0.02em;
}

/* Figma：常态加号 / 输入态上箭头，均在输入框内 22px → 44rpx */
.inspiration-action {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inspiration-action-disabled {
  opacity: 0.55;
}

.inspiration-action-icon {
  width: 44rpx;
  height: 44rpx;
}

/* 键盘弹起时隐藏底栏按钮（保留占位，避免回流打断聚焦） */
.page-footer-insp-hidden {
  opacity: 0;
  pointer-events: none;
}

/* 房主首次进入：透明热区 + 单行气泡（无视觉蒙版） */
.host-statement-tip-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: transparent;
}

.host-statement-tip-bubble {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  padding: 14rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(94, 193, 89, 0.28);
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(20, 40, 28, 0.14);
  z-index: 1002;
}

.host-statement-tip-text {
  display: block;
  font-size: 22rpx;
  line-height: 1.3;
  color: #3a4a40;
  text-align: center;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.host-statement-tip-arrow {
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  background: #ffffff;
  border-right: 1rpx solid rgba(94, 193, 89, 0.28);
  border-bottom: 1rpx solid rgba(94, 193, 89, 0.28);
  transform: rotate(45deg);
}

/* Figma #5848:3433 — 特殊行动 / 开始表态为两个独立按钮，中间硬分缝 */
.bottom-actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  padding: 0 30rpx;
}

.special-btn-wrap {
  flex: none;
  width: 162rpx; /* Figma 81px；过窄时原生 button 会溢出盖住右侧按钮 */
  overflow: hidden;
}

/* 非房主当前玩家：仅有特殊行动时铺满底栏，文案横排一行 */
.special-btn-wrap-alone {
  flex: 1;
  width: auto;
  min-width: 0;
}

.special-btn-wrap-alone .special-btn {
  flex-direction: row;
  gap: 0;
  letter-spacing: 0.12em;
}

.special-btn-wrap-alone .special-btn-line {
  display: inline;
  line-height: 1.2;
}

.bottom-actions-gap {
  flex: none;
  width: 24rpx;
  height: 1rpx;
}

.statement-btn-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.special-btn {
  width: 100% !important;
  min-width: 0;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #e9f5e9;
  color: #5ec159;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.06em;
  letter-spacing: 0.1em;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.special-btn-line {
  display: block;
  line-height: 1.1;
}

.special-btn::after {
  border: none;
}

.special-btn-disabled,
.special-btn[disabled] {
  background: #e7e7e7 !important;
  color: #c1c1c1 !important;
  opacity: 1 !important;
}

/* Figma #5933:8010 — 已使用：底色不变，文案 50% 透明 + 绿色勾选叠加 */
.special-btn-used {
  position: relative;
  background: #e9f5e9;
  color: rgba(94, 193, 89, 0.5);
  box-sizing: border-box;
}

.special-btn-used-check {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 64rpx;
  height: 50rpx;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.statement-btn {
  width: 100% !important;
  min-width: 0;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #c0c0c0;
  color: #ffffff;
  font-size: 60rpx;
  font-weight: 400;
  letter-spacing: 0.0667em;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.statement-btn::after {
  border: none;
}

.statement-btn[disabled] {
  background: #c0c0c0 !important;
  color: #ffffff !important;
  opacity: 1 !important;
}

.statement-btn-enabled {
  background: #5ec159 !important;
  color: #fff !important;
  opacity: 1 !important;
}

.statement-btn-enabled:active {
  opacity: 0.9 !important;
}

.discussion-card-body {

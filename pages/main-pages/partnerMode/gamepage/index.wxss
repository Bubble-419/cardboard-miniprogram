.container {
  height: 100vh;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.custom-navbar {
  background: #fafafa;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
  padding-left: 20rpx;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.page-footer {
  flex-shrink: 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.top-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 28rpx 12rpx;
  flex-shrink: 0;
}

.room-entry {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #e9f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry-icon {
  width: 36rpx;
  height: 36rpx;
}

.problem-chip {
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  padding: 12rpx 20rpx 12rpx 52rpx;
  background: #e9f5e9;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  position: relative;
  box-sizing: border-box;
}

.problem-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  position: absolute;
  left: 16rpx;
  top: 50%;
  transform: translateY(-50%);
}

.problem-text {
  flex: 1;
  font-size: 24rpx;
  color: #747474;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.problem-text-empty {
  color: #a8c9a6;
}

.user-section {
  padding: 0 20rpx 8rpx;
  flex-shrink: 0;
}

.divider-line {
  height: 2rpx;
  margin: 0 28rpx 12rpx;
  background: #ececec;
  flex-shrink: 0;
}

.card-area {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-bottom: 4rpx;
  overflow: hidden;
}

.card-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
  height: 100%;
}

.card-swiper-item {
  box-sizing: border-box;
  padding: 0 6rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.card-swiper-item > .game-card,
.card-swiper-item > game-card-timer {
  flex: 1;
  min-height: 0;
  width: 100%;
}

.game-card {
  height: 100%;
  border-radius: 28rpx;
  background: #fff;
  border: 4rpx solid #5ec159;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.game-card-muted {
  border: 4rpx solid #d4e0d4;
  background: #f7faf7;
}

.game-card-no-border {
  border: none;
}

.card-bullet-empty {
  color: #b0b0b0;
}

.action-voice-list {
  padding: 0 28rpx 8rpx;
}

game-card-timer {
  display: block;
  height: 100%;
}

.card-header-row {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
  box-sizing: border-box;
}

.card-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.card-section-title-inline {
  margin-bottom: 0;
}

.card-player-round {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #7a9a78;
  margin-bottom: 8rpx;
}

.card-section-title-gap {
  margin-top: 28rpx;
}

.insert-image-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 4rpx 0;
}

.insert-image-icon {
  width: 32rpx;
  height: 28rpx;
  position: relative;
  box-sizing: border-box;
}

.insert-image-icon::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 28rpx;
  height: 20rpx;
  border: 2rpx solid #5ec159;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.insert-image-icon::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 0;
  width: 12rpx;
  height: 8rpx;
  border: 2rpx solid #5ec159;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

.insert-image-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.3;
}

.card-scroll {
  flex: 1;
  height: 0;
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
}

.card-bullet-list {
  margin-bottom: 20rpx;
}

.card-bullet {
  font-size: 28rpx;
  color: #5f5f5f;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.round-note-box {
  margin: 8rpx 0 24rpx;
  padding: 20rpx;
  border: 4rpx solid #5ec159;
  border-radius: 16rpx;
  background: #f7faf7;
  box-sizing: border-box;
}

.round-note-photo-area {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.round-note-photo-item {
  position: relative;
  width: 160rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.round-note-photo {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #e8e8e8;
}

.round-note-photo-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.round-note-photo-add {
  width: 160rpx;
  height: 120rpx;
  border: 2rpx dashed #5ec159;
  border-radius: 12rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.round-note-photo-icon {
  width: 48rpx;
  height: 40rpx;
  position: relative;
}

.round-note-photo-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  width: 40rpx;
  height: 28rpx;
  border: 2rpx solid #5ec159;
  border-radius: 6rpx;
}

.round-note-photo-icon::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 2rpx;
  width: 16rpx;
  height: 10rpx;
  border: 2rpx solid #5ec159;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

.round-note-photo-add-text {
  font-size: 22rpx;
  color: #5ec159;
  line-height: 1.2;
}

.round-note-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid #d4e0d4;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.card-photo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0 24rpx;
}

.card-photo {
  width: 200rpx;
  height: 300rpx;
  border-radius: 8rpx;
  border: 12rpx solid #fff;
  box-shadow: 0 0 12rpx rgba(0, 0, 0, 0.25);
  background: #e7e7e7;
}

.action-card-body {
  flex: 1;
  height: 0;
  padding: 28rpx 24rpx 0;
  box-sizing: border-box;
  overflow: hidden;
}

.action-title-row {
  display: flex;
  justify-content: center;
  margin-bottom: 12rpx;
}

.master-mode-badge {
  padding: 8rpx 24rpx;
  background: #5ec159;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.action-title {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.action-desc {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.4);
  line-height: 1.4;
  margin-bottom: 4rpx;
}

.action-divider {
  height: 2rpx;
  margin: 16rpx 0 20rpx;
  background: #ececec;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.action-cell {
  width: calc(50% - 8rpx);
  border-radius: 8rpx;
  min-height: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 16rpx;
  box-sizing: border-box;
}

.action-cell-filled {
  background: #e9f8fb;
}

.action-cell-empty {
  background: #e7e7e7;
}

.action-illus {
  flex: 1;
  width: 100%;
  min-height: 80rpx;
  margin-bottom: 8rpx;
}

.action-illus-play,
.action-illus-delete {
  background: linear-gradient(180deg, #f6fcfd 0%, #e9f8fb 100%);
}

.action-cell-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
}

.score-panel {
  flex-shrink: 0;
  margin: 8rpx 16rpx 12rpx;
  padding: 16rpx 12rpx 12rpx;
  background: #fff;
  border: 1rpx solid #f1f5f1;
  border-radius: 28rpx;
  box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.12);
}

.score-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 8rpx;
}

.score-label,
.score-progress {
  font-size: 22rpx;
  font-weight: 600;
  color: #5ec159;
}

.score-buttons {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 8rpx;
}

.score-btn {
  flex: 1;
  min-height: 88rpx;
  border-radius: 21rpx;
  background: #e3fae2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5ec159;
  box-sizing: border-box;
}

.score-btn-active {
  background: #5ec159;
  color: #fff;
}

.score-btn-disabled {
  opacity: 0.45;
}

.score-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

.score-unit {
  font-size: 20rpx;
  line-height: 1.2;
}

.card-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 8rpx 0 4rpx;
  position: relative;
  flex-shrink: 0;
}

.pagination-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9d9d9;
}

.dot-active {
  background: #5ec159;
}

.pagination-text {
  position: absolute;
  right: 40rpx;
  font-size: 32rpx;
  color: #5ec159;
}

.inspiration-bar {
  margin: 4rpx 28rpx 8rpx;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 51;
}

.inspiration-badge-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e3fae2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.inspiration-count-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #5ec159;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.inspiration-badge {
  font-size: 36rpx;
}

.inspiration-composer {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  padding: 10rpx 20rpx;
  background: #fff;
  border: 1rpx solid #d7d7d7;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.inspiration-composer-focused {
  border-color: #5ec159;
}

.inspiration-photo-strip {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.inspiration-photo-strip-inner {
  display: inline-flex;
  gap: 12rpx;
}

.inspiration-photo-thumb-wrap {
  position: relative;
  width: 96rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.inspiration-photo-thumb {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #eee;
}

.inspiration-photo-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.inspiration-textarea {
  width: 100%;
  min-height: 44rpx;
  max-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.45;
}

.inspiration-placeholder {
  font-size: 28rpx;
  color: #b0b0b0;
}

.inspiration-action-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #5ec159;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.inspiration-action-btn-disabled {
  opacity: 0.55;
}

.inspiration-camera-icon {
  width: 36rpx;
  height: 30rpx;
  position: relative;
  box-sizing: border-box;
}

.inspiration-camera-icon::before {
  content: '';
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 32rpx;
  height: 22rpx;
  border: 3rpx solid #fff;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.inspiration-camera-icon::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 0;
  width: 14rpx;
  height: 8rpx;
  border: 3rpx solid #fff;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  box-sizing: border-box;
}

.inspiration-send-icon {
  width: 32rpx;
  height: 32rpx;
}

.inspiration-focus-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: transparent;
}

.bottom-actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 0 28rpx;
}

.special-btn {
  width: 162rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #e9f5e9;
  color: #5ec159;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: 2rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.special-btn-line {
  display: block;
  line-height: 1.1;
}

.special-btn::after {
  border: none;
}

.special-btn-disabled {
  background: #e7e7e7;
  color: #c1c1c1;
}

.special-btn-used {
  background: #e3ebe3;
  border: 2rpx solid #d4e0d4;
  box-sizing: border-box;
}

.special-btn-check-mark {
  font-size: 56rpx;
  font-weight: 700;
  color: #2f8a2f;
  line-height: 1;
}

.statement-btn {
  flex: 1;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #c1c1c1;
  color: #fff;
  font-size: 44rpx;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.statement-btn::after {
  border: none;
}

.statement-btn-enabled {
  background: #5ec159;
}

.statement-btn-enabled:active {
  opacity: 0.9;
}

.discussion-card-body {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.discussion-title {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  line-height: 1.3;
  margin-bottom: 16rpx;
}

.discussion-divider {
  height: 2rpx;
  background: #ececec;
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.discussion-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.discussion-photo-placeholder {
  width: 200rpx;
  height: 150rpx;
  margin: 24rpx auto;
  border: 2rpx dashed #adadad;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.discussion-photo-icon {
  width: 48rpx;
  height: 40rpx;
  position: relative;
}

.discussion-photo-icon::before {
  content: '';
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  width: 40rpx;
  height: 28rpx;
  border: 2rpx solid #b0b0b0;
  border-radius: 6rpx;
}

.discussion-photo-icon::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 2rpx;
  width: 16rpx;
  height: 10rpx;
  border: 2rpx solid #b0b0b0;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

.discussion-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #b4b4b4;
  line-height: 1.4;
  margin: 16rpx 0 24rpx;
}

.discussion-report-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 16rpx;
}

.discussion-report-title {
  font-size: 26rpx;
  color: #909090;
}

.discussion-report-sub {
  font-size: 22rpx;
  color: #909090;
}

.end-discussion-btn {
  flex: 1;
  width: 100%;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #5ec159;
  color: #fff;
  font-size: 44rpx;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.end-discussion-btn::after {
  border: none;
}

.end-discussion-btn:active {
  opacity: 0.9;
}

.end-discussion-btn-disabled {
  background: #c1c1c1;
}

/* 收尾阶段 */
.closing-card {
  position: relative;
}

.closing-badge {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  z-index: 2;
  padding: 8rpx 24rpx;
  background: #5ec159;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.closing-card-body {
  flex: 1;
  height: 0;
  padding: 88rpx 24rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.closing-card-title {
  display: block;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  margin-bottom: 12rpx;
}

.closing-card-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: rgba(0, 0, 0, 0.4);
  margin-bottom: 16rpx;
}

.closing-divider {
  height: 2rpx;
  background: #ececec;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.closing-rune-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.closing-rune-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.closing-rune-slot {
  background: #e7e7e7;
  border-radius: 8rpx;
  min-height: 120rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.closing-rune-slot-top {
  min-height: 100rpx;
}

.closing-rune-label {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.4);
  text-align: center;
}

.closing-scroll {
  flex: 1;
  height: 0;
}

.closing-photo-hint {
  margin: 0 0 16rpx;
  padding: 16rpx 24rpx;
  background: #d9d9d9;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #000;
  flex-shrink: 0;
}

.closing-photo-placeholder {
  width: 200rpx;
  height: 150rpx;
  margin: 24rpx auto;
  border: 2rpx dashed #adadad;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.closing-next-btn,
.end-brainstorm-btn {
  flex: 1;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 28rpx;
  background: #5ec159;
  color: #fff;
  font-size: 44rpx;
  letter-spacing: 4rpx;

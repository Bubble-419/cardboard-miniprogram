<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        />
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="page-body">
    <!-- 顶部：房间入口 + 设计问题 -->
    <view class="top-bar">
      <view class="room-entry" bindtap="handleGoRoom">
        <image class="room-entry-icon" src="/assets/partnerMode/icon-room-entry-gp.svg" mode="aspectFit" />
      </view>
      <view class="problem-chip">
        <image class="problem-icon" src="/assets/partnerMode/icon-problem-chip.svg" mode="aspectFit" />
        <text class="problem-text {{selectedProblemText ? '' : 'problem-text-empty'}}">{{selectedProblemText || '暂无设计问题'}}</text>
      </view>
    </view>

    <!-- 玩家列表：使用 partner-avatar 展示六种头像状态 -->
    <view class="user-section">
      <user-list
        avatarList="{{avatarList}}"
        actingUser="{{currentPlayerIndex}}"
        selectedUser="{{selectedPlayerIndex}}"
        indicatorUser="{{indicatorPlayerIndex}}"
        enableAdd="{{false}}"
        isFold="{{true}}"
        showName="{{false}}"
        showActingFrame="{{gamepagePhase !== 'closing'}}"
        enableSelectedFrame="{{gamepagePhase !== 'closing'}}"
        enableAvatarTap="{{gamepagePhase !== 'closing'}}"
        roundStartedAt="{{partnerRoundStartedAt}}"
        roundTimerActive="{{roundTimerVisible}}"
        roundTimerKey="{{currentRound}}-{{currentPlayerIndex}}"
        bindavatartap="handleAvatarTap"
      />
    </view>

    <view class="divider-line"></view>

    <!-- 收尾阶段 -->
    <block wx:if="{{gamepagePhase === 'closing'}}">
      <view class="card-area">
        <swiper
          class="card-swiper"
          current="{{cardIndex}}"
          bindchange="onCardSwiperChange"
          previous-margin="56rpx"
          next-margin="56rpx"
          easing-function="easeOutCubic"
        >
          <swiper-item class="card-swiper-item">
            <view class="game-card game-card-active closing-card">
              <view class="closing-badge">收尾阶段</view>
              <view class="closing-card-body">
                <text class="closing-card-title">补全符文</text>
                <text class="closing-card-desc">请根据以下操作提示，补全符文</text>
                <view class="closing-divider"></view>
                <view class="closing-rune-grid">
                  <view class="closing-rune-col">
                    <view class="closing-rune-slot closing-rune-slot-top">
                      <text class="closing-rune-label">延时符文</text>
                    </view>
                    <view class="closing-rune-slot closing-rune-slot-bottom">
                      <text class="closing-rune-label">稳定态符文</text>
                    </view>
                  </view>
                  <view class="closing-rune-col">
                    <view class="closing-rune-slot closing-rune-slot-top">
                      <text class="closing-rune-label">延时符文</text>
                    </view>
                    <view class="closing-rune-slot closing-rune-slot-bottom">
                      <text class="closing-rune-label">属性类型符文</text>
                    </view>
                  </view>
                </view>
                <scroll-view class="closing-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                  <text class="card-section-title">第一轮-出牌解释</text>
                  <view class="card-bullet-list">
                    <view class="card-bullet" wx:for="{{playHistory}}" wx:key="*this">· {{item}}</view>
                  </view>
                  <text class="card-section-title card-section-title-gap">第一轮-疑问讨论</text>
                  <view class="card-bullet-list">
                    <view class="card-bullet" wx:for="{{discussionNotes}}" wx:key="*this">· {{item}}</view>
                  </view>
                </scroll-view>
              </view>
            </view>
          </swiper-item>

          <swiper-item class="card-swiper-item">
            <view class="game-card game-card-active closing-card">
              <view class="closing-badge">收尾阶段</view>
              <view class="closing-card-body">
                <text class="closing-card-title">创意点复盘</text>
                <view class="closing-photo-hint">（提示玩家拍摄卡组）</view>
                <scroll-view class="closing-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                  <text class="card-section-title">第一轮-出牌解释</text>
                  <view class="card-bullet-list">
                    <view class="card-bullet" wx:for="{{playHistory}}" wx:key="*this">· {{item}}</view>
                  </view>
                  <text class="card-section-title card-section-title-gap">第一轮-疑问讨论</text>
                  <view class="card-bullet-list">
                    <view class="card-bullet" wx:for="{{discussionNotes}}" wx:key="*this">· {{item}}</view>
                  </view>
                  <view class="closing-photo-placeholder" catchtap="handleClosingPhoto">
                    <view class="discussion-photo-icon"></view>
                  </view>
                  <view class="card-photo-wrap" wx:if="{{reviewPhotos.length}}">
                    <image
                      class="card-photo"
                      wx:for="{{reviewPhotos}}"
                      wx:key="*this"
                      src="{{item}}"
                      mode="aspectFill"
                    />
                  </view>
                  <text class="discussion-hint">讨论正在进行，AI报告仍在撰写请稍后查看</text>
                  <view class="discussion-report-hint">
                    <text class="discussion-report-title">玩家行动报告</text>
                    <text class="discussion-report-sub">下拉查看</text>
                  </view>
                </scroll-view>
              </view>
            </view>
          </swiper-item>
        </swiper>

        <view class="card-pagination">
          <view class="pagination-dots">
            <view class="dot {{cardIndex === 0 ? 'dot-active' : ''}}"></view>
            <view class="dot {{cardIndex === 1 ? 'dot-active' : ''}}"></view>
          </view>
          <text class="pagination-text">{{cardIndex + 1}}/2</text>
        </view>
      </view>

      <view class="inspiration-bar" bindtap="handleGoInspiration">
        <view class="insp-icon-wrap">
          <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
          <view class="insp-dot"></view>
        </view>
        <view class="inspiration-input-fake">
          <text class="inspiration-placeholder">记录您的灵感...</text>
          <image class="inspiration-arrow" src="/assets/partnerMode/icon-insp-arrow.svg" mode="aspectFit" />
        </view>
      </view>
    </block>

    <!-- 常规出牌 / 讨论 -->
    <block wx:else>
    <view class="card-area">
      <swiper
        class="card-swiper"
        current="{{cardIndex}}"
        bindchange="onCardSwiperChange"
        previous-margin="56rpx"
        next-margin="56rpx"
        easing-function="easeOutCubic"
      >
        <!-- 已完成轮次的文字纪要（时间线：越左越早） -->
        <swiper-item
          class="card-swiper-item"
          wx:for="{{displayRoundSummaries}}"
          wx:key="round"
        >
          <view class="game-card game-card-muted">
            <view class="card-header-row">
              <text class="card-section-title card-section-title-inline">{{item.playerName}} · 第{{item.round}}轮-文字纪要</text>
            </view>
            <scroll-view class="card-scroll" scroll-y enhanced show-scrollbar="{{false}}">
              <text class="card-section-title">第{{item.round}}轮-语音纪要</text>
              <view class="card-bullet-list">
                <view
                  class="card-bullet"
                  wx:for="{{item.voiceLines}}"
                  wx:for-item="voiceLine"
                  wx:key="at"
                >· {{voiceLine.text}}</view>
                <view class="card-bullet card-bullet-empty" wx:if="{{!item.voiceLines || !item.voiceLines.length}}">· 暂无记录</view>
              </view>
              <text class="card-section-title card-section-title-gap">第{{item.round}}轮-表态记录</text>
              <view class="card-bullet-list">
                <view
                  class="card-bullet"
                  wx:for="{{item.turnRecords}}"
                  wx:for-item="turn"
                  wx:for-index="turnIdx"
                  wx:key="turnIdx"
                >· <block wx:if="{{turn.avgScore != null}}">平均分 {{turn.avgScore}} · </block>{{turn.statementLabel || '未记录'}}</view>
                <view class="card-bullet card-bullet-empty" wx:if="{{!item.turnRecords || !item.turnRecords.length}}">· 暂无记录</view>
              </view>
            </scroll-view>
          </view>
        </swiper-item>

        <!-- 当前轮次：出牌并解释 / 提出疑问并讨论 -->
        <swiper-item class="card-swiper-item">
          <game-card-timer
            startedAt="{{partnerRoundStartedAt}}"
            timerActive="{{roundTimerVisible}}"
            loop="{{true}}"
            bind:timerexpire="handleRoundTimerExpire"
            wx:if="{{gamepagePhase === 'discussion'}}"
          >
            <view class="discussion-card-body">
              <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
              <text class="discussion-title">提出疑问并讨论</text>
              <view class="discussion-divider"></view>
              <scroll-view class="discussion-scroll" scroll-y enhanced show-scrollbar="{{false}}">
                <text class="card-section-title">第{{currentRound}}轮-出牌解释</text>
                <view class="card-bullet-list">
                  <view class="card-bullet" wx:for="{{playHistory}}" wx:key="*this">· {{item}}</view>
                  <view class="card-bullet card-bullet-empty" wx:if="{{!playHistory.length}}">· 暂无记录</view>
                </view>
                <text class="card-section-title card-section-title-gap">第{{currentRound}}轮-疑问讨论</text>
                <view class="card-bullet-list">
                  <view class="card-bullet" wx:for="{{discussionNotes}}" wx:key="*this">· {{item}}</view>
                  <view class="card-bullet card-bullet-empty" wx:if="{{!discussionNotes.length}}">· 暂无记录</view>
                </view>
                <text class="card-section-title card-section-title-gap">第{{currentRound}}轮-语音纪要</text>
                <view class="card-bullet-list">
                  <view class="card-bullet" wx:for="{{voiceLines}}" wx:key="at">· {{item.text}}</view>
                  <view class="card-bullet card-bullet-empty" wx:if="{{!voiceLines.length}}">· 正在聆听…</view>
                </view>
                <text class="card-section-title card-section-title-gap">第{{currentRound}}轮-表态记录</text>
                <view class="card-bullet-list">
                  <view
                    class="card-bullet"
                    wx:for="{{turnRecords}}"
                    wx:for-item="turn"
                    wx:for-index="turnIdx"
                    wx:key="turnIdx"
                  >· <block wx:if="{{turn.avgScore != null}}">平均分 {{turn.avgScore}} · </block>{{turn.statementLabel || '未记录'}}</view>
                  <view class="card-bullet card-bullet-empty" wx:if="{{!turnRecords.length}}">· 暂无记录</view>
                </view>
                <view class="discussion-photo-placeholder" catchtap="handleInsertImage">
                  <view class="discussion-photo-icon"></view>
                </view>
                <text class="discussion-hint">讨论正在进行，AI报告仍在撰写请稍后查看</text>
                <view class="discussion-report-hint">
                  <text class="discussion-report-title">玩家行动报告</text>
                  <text class="discussion-report-sub">下拉查看</text>
                </view>
              </scroll-view>
            </view>
          </game-card-timer>

          <game-card-timer
            startedAt="{{partnerRoundStartedAt}}"
            timerActive="{{roundTimerVisible}}"
            loop="{{true}}"
            bind:timerexpire="handleRoundTimerExpire"
            wx:else
          >
            <scroll-view class="action-card-scroll" scroll-y enhanced show-scrollbar="{{false}}">
              <view class="action-card-inner">
                <view class="action-title-row" wx:if="{{isMasterMode}}">
                  <view class="master-mode-badge">MASTER模式</view>
                </view>
                <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
                <text class="action-title">出牌并解释</text>
                <text class="action-desc">您可以进行1—3次行动，1 次行动可以是以下任意一种</text>
                <view class="action-divider"></view>
                <text class="card-section-title">第{{currentRound}}轮-语音纪要</text>
                <view class="card-bullet-list action-voice-list">
                  <view class="card-bullet" wx:for="{{voiceLines}}" wx:key="at">· {{item.text}}</view>
                  <view class="card-bullet card-bullet-empty" wx:if="{{!voiceLines.length}}">· 正在聆听…</view>
                </view>
                <view class="action-divider"></view>
                <view class="action-grid">
                  <view class="action-cell">
                    <view class="action-illus-box">
                      <view class="action-illus"></view>
                    </view>
                    <text class="action-cell-label">出 1 张卡牌</text>
                  </view>
                  <view class="action-cell">
                    <view class="action-illus-box">
                      <view class="action-illus"></view>
                    </view>
                    <text class="action-cell-label">删 1 张卡牌</text>
                  </view>
                  <view class="action-cell">
                    <view class="action-illus-box">
                      <view class="action-illus"></view>
                    </view>
                    <text class="action-cell-label">调整 1 张卡牌</text>
                  </view>
                  <view class="action-cell">
                    <view class="action-illus-box">
                      <view class="action-illus"></view>
                    </view>
                    <text class="action-cell-label">交换 2 张卡牌</text>
                  </view>
                </view>
              </view>
            </scroll-view>
            <view class="score-panel">
              <view class="score-panel-head">
                <text class="score-label">{{isCurrentPlayer ? '此次行动无需评分' : '此次行动评分'}}</text>
                <text class="score-progress">完成打分人数：{{scoredCount}}/{{totalRequired}}</text>
              </view>
              <view class="score-buttons" wx:if="{{!isCurrentPlayer}}">
                <view
                  class="score-btn {{selectedScore === item ? 'score-btn-active' : ''}}"
                  wx:for="{{scoreOptions}}"
                  wx:key="*this"
                  data-score="{{item}}"
                  bindtap="onScoreTap"
                >
                  <view class="score-btn-content">
                    <text class="score-num">{{item}}</text>
                    <text class="score-unit">分</text>
                  </view>
                </view>
              </view>
            </view>
          </game-card-timer>
        </swiper-item>
      </swiper>

      <view class="card-pagination">
        <view class="pagination-dots">
          <view
            class="dot {{cardIndex === item ? 'dot-active' : ''}}"
            wx:for="{{paginationIndexes}}"
            wx:key="*this"
          ></view>
        </view>
        <text class="pagination-text">{{cardIndex + 1}}/{{cardCount}}</text>
      </view>
    </view>

    <!-- 灵感记录 -->
    <view class="inspiration-bar" bindtap="handleGoInspiration">
      <view class="insp-icon-wrap">
        <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
        <view class="insp-dot"></view>
      </view>
      <view class="inspiration-input-fake">
        <text class="inspiration-placeholder">记录您的灵感...</text>
        <image class="inspiration-arrow" src="/assets/partnerMode/icon-insp-arrow.svg" mode="aspectFit" />
      </view>
    </view>
    </block>
  </view>

  <!-- 底部操作 -->
  <view class="page-footer">
    <view class="bottom-actions" wx:if="{{gamepagePhase === 'closing' && closingStep === 'rune'}}">
      <button
        class="closing-next-btn {{isHost ? '' : 'closing-btn-disabled'}}"
        disabled="{{!isHost}}"
        bindtap="handleClosingNextStep"
      >
        下一步
      </button>
    </view>
    <view class="bottom-actions" wx:elif="{{gamepagePhase === 'closing' && closingStep === 'review'}}">
      <button
        class="end-brainstorm-btn {{isHost ? '' : 'closing-btn-disabled'}}"
        disabled="{{!isHost}}"
        bindtap="handleEndBrainstorm"
      >
        结束脑暴
      </button>
    </view>
    <view class="bottom-actions" wx:elif="{{gamepagePhase === 'discussion'}}">
      <button
        class="end-discussion-btn {{isHost ? '' : 'end-discussion-btn-disabled'}}"
        disabled="{{!isHost}}"
        bindtap="handleEndDiscussion"
      >
        结束讨论
      </button>
    </view>
    <view class="bottom-actions" wx:else>
      <view class="special-btn-wrap">
        <button
          wx:if="{{!isCurrentPlayer}}"
          class="special-btn special-btn-disabled"
          disabled
          hover-class="none"
        >
          <text class="special-btn-line">特殊</text>
          <text class="special-btn-line">行动</text>
        </button>
        <view
          wx:elif="{{isCurrentPlayer && (specialMoveUsedThisTurn || isMasterMode)}}"
          class="special-btn special-btn-used"
        >
          <text class="special-btn-check-mark">✓</text>
        </view>
        <button
          wx:else
          class="special-btn"
          hover-class="none"
          bindtap="handleSpecialMove"
        >
          <text class="special-btn-line">特殊</text>
          <text class="special-btn-line">行动</text>
        </button>
      </view>
      <view class="statement-btn-wrap">
        <button
          class="statement-btn {{canStartStatement ? 'statement-btn-enabled' : ''}}"
          disabled="{{!canStartStatement}}"
          hover-class="none"
          bindtap="handleStartStatement"
        >
          开始表态
        </button>
      </view>
    </view>
  </view>
</view>

<room-wait-screen
  wx:if="{{roomShellScreen === 'waiting' && waitingModel}}"
  model="{{waitingModel}}"
  waitHeroSrc="{{waitHeroSrc}}"
/>

<view wx:elif="{{roomShellScreen === 'waiting'}}" class="room-shell-loading"></view>

<partner-closing-vote-screen
  wx:elif="{{roomShellScreen === 'closingVote' && closingVoteModel}}"
  model="{{closingVoteModel}}"
  submitting="{{closingVoteSubmitting}}"
  waitHeroSrc="{{waitHeroSrc}}"
  bind:vote="handleClosingVote"
/>

<view wx:elif="{{roomShellScreen === 'closingVote'}}" class="room-shell-loading"></view>

<block wx:elif="{{roomShellScreen === 'game'}}">
<view class="container {{isHistoryReview ? 'container-history-review' : ''}} {{!isHistoryReview && !isHost && gamepagePhase === 'discussion' ? 'container-discussion-guest' : ''}}">
  <view class="page-body">
    <partner-game-header
      id="partnerGameHeader"
      historyReview="{{isHistoryReview}}"
      topPadding="{{topBarPadTop}}"
      rightPadding="{{topBarPaddingRight}}"
      height="{{topBarHeight}}"
      iconSize="{{topBarIconSize}}"
      problemText="{{selectedProblemText}}"
      problemExpanded="{{problemExpanded}}"
      bind:intent="onGameHeaderIntent"
    />

    <partner-player-strip
      avatarList="{{avatarList}}"
      actingUser="{{isHistoryReview ? -1 : currentPlayerIndex}}"
      selectedUser="{{!isPlayerFilterActive ? -1 : selectedPlayerIndex}}"
      indicatorUser="{{indicatorPlayerIndex}}"
      actionPage="{{!isHistoryReview && showCurrentActionCard && cardIndex >= displayRoundSummaries.length}}"
      specialMoveActive="{{cardBorderVariant === 'master' || cardBorderVariant === 'sound'}}"
      interactive="{{gamepagePhase !== 'closing'}}"
      roundStartedAt="{{isHistoryReview ? null : avatarRoundStartedAt}}"
      roundTimerActive="{{!isHistoryReview && roundTimerVisible && roundTimerReady}}"
      roundTimerKey="{{currentRound}}-{{currentPlayerIndex}}"
      suppressTimerCanvas="{{showHostStatementTip || isHistoryReview}}"
      bind:timerexpire="handleRoundTimerExpire"
      bind:avatartap="handleAvatarTap"
    />

    <!-- 收尾阶段：全员通过后先补全符文，房主点下一步后再创意点复盘 -->
    <block wx:if="{{!isHistoryReview && gamepagePhase === 'closing'}}">
      <view class="card-area">
        <view class="closing-card-stage">
          <!-- 补全符文 -->
          <view class="game-card game-card-active closing-card" wx:if="{{closingStep === 'rune'}}">
            <view class="closing-badge">收尾阶段</view>
            <view class="closing-card-body">
              <text class="closing-card-title">补全符文</text>
              <text class="closing-card-desc">请根据以下操作提示，补全符文</text>
              <view class="closing-divider"></view>
              <view class="closing-rune-grid closing-rune-grid-fill">
                <view class="closing-rune-col">
                  <view class="closing-rune-slot closing-rune-slot-top">
                    <text class="closing-rune-label">延时符文</text>
                  </view>
                  <view class="closing-rune-slot closing-rune-slot-bottom">
                    <text class="closing-rune-label">稳定态符文</text>
                  </view>
                </view>
                <view class="closing-rune-col">
                  <view class="closing-rune-slot closing-rune-slot-top">
                    <text class="closing-rune-label">延时符文</text>
                  </view>
                  <view class="closing-rune-slot closing-rune-slot-bottom">
                    <text class="closing-rune-label">属性类型符文</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- 创意点复盘 -->
          <view class="game-card game-card-active closing-card" wx:else>
            <view class="closing-badge">收尾阶段</view>
            <view class="closing-card-body">
              <text class="closing-card-title">创意点复盘</text>
              <scroll-view class="closing-scroll" scroll-y enhanced show-scrollbar="{{true}}">
                <view class="closing-scroll-inner">
                <view class="card-section-flow">
                  <block wx:for="{{closingCreativeBlocks}}" wx:key="key">
                    <view
                      wx:if="{{item.type === 'text' && item.key !== closingCreativeEditingKey}}"
                      class="card-bullet {{isHost ? 'closing-text-editable' : ''}}"
                      data-key="{{item.key}}"
                      catchtap="onClosingCreativeTextTap"
                    >· {{item.text}}</view>
                    <view
                      wx:elif="{{item.type === 'image'}}"
                      class="closing-deck-photo-wrap {{closingImageDeleteKey === item.key ? 'closing-deck-photo-wrap-deleting' : ''}}"
                      data-key="{{item.key}}"
                      data-url="{{item.url}}"
                      bindlongpress="onClosingCreativeImageLongPress"
                    >
                      <image
                        class="closing-deck-photo"
                        src="{{item.url}}"
                        mode="widthFix"
                        data-key="{{item.key}}"
                        data-url="{{item.url}}"
                        catchtap="onClosingCreativeImageTap"
                      />
                      <view
                        wx:if="{{isHost && closingImageDeleteKey === item.key}}"
                        class="closing-deck-photo-remove"
                        catchtap="onClosingCreativeRemoveBlock"
                        data-key="{{item.key}}"
                      >×</view>
                    </view>
                  </block>
                  <view
                    class="card-bullet card-bullet-empty"
                    wx:if="{{!isHost && !closingCreativeBlocks.length}}"
                  >等待房主记录</view>
                </view>
                </view>
              </scroll-view>
              <!-- 输入区跟在已记录内容之后；插图入口始终在输入提示/最后一行文字下方 -->
              <view class="closing-compose-tail" wx:if="{{isHost}}">
                <form
                  class="closing-compose-form"
                  bindsubmit="onClosingCreativeFormSubmit"
                >
                  <view class="card-inline-textarea-wrap closing-compose-input-row">
                    <!-- 未激活时使用普通 view 接点击；避免 scroll-view 内原生 textarea 吞掉首次聚焦。 -->
                    <textarea
                      wx:if="{{closingCreativeWantFocus}}"
                      class="card-inline-textarea {{closingCreativeEditFocus || closingKeyboardHeight > 0 ? 'card-inline-textarea-active' : 'card-inline-textarea-hint'}}"
                      name="closingCreativeText"
                      value="{{closingCreativeEditText}}"
                      focus="{{true}}"
                      bindfocus="onClosingCreativeFocus"
                      bindinput="onClosingCreativeInput"
                      bindblur="onClosingCreativeBlur"
                      bindkeyboardheightchange="onClosingCreativeKeyboardHeightChange"
                      placeholder="{{closingCreativeBlocks.length ? '继续记录…' : '点击开始记录'}}"
                      placeholder-class="{{closingCreativeEditFocus || closingKeyboardHeight > 0 ? 'card-record-placeholder-active' : 'card-record-placeholder'}}"
                      maxlength="500"
                      auto-height
                      disable-default-padding="{{true}}"
                      show-confirm-bar="{{false}}"
                      adjust-position="{{true}}"
                      hold-keyboard="{{true}}"
                      cursor-spacing="120"
                    />
                    <view
                      wx:else
                      class="card-inline-textarea card-inline-textarea-hint closing-compose-trigger"
                      bindtap="onClosingCreativeTitleTap"
                    >
                      <text class="{{closingCreativeEditText ? 'closing-compose-draft' : 'card-record-placeholder'}}">{{closingCreativeEditText || (closingCreativeBlocks.length ? '继续记录…' : '点击开始记录')}}</text>
                    </view>
                    <button
                      class="closing-compose-save-btn {{closingCreativeSaving ? 'closing-compose-save-disabled' : ''}}"
                      bindtap="onClosingCreativeSendTap"
                      hover-class="none"
                      disabled="{{closingCreativeSaving}}"
                    >
                      <image
                        class="closing-compose-save-icon"
                        src="/assets/partnerMode/icon-insp-send.svg"
                        mode="aspectFit"
                      />
                    </button>
                  </view>
                </form>
                <view class="closing-deck-capture" wx:if="{{!closingHasDeckImage}}">
                  <view
                    class="closing-deck-capture-inner"
                    catchtap="onClosingCreativeAddImage"
                  >
                    <view class="closing-deck-capture-frame">
                      <image
                        class="closing-deck-camera-icon"
                        src="/assets/partnerMode/icon-closing-deck-camera.svg"
                        mode="aspectFit"
                      />
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 输入模块拥有键盘与原生输入节点；房间 View 刷新不重建其局部状态。 -->
      <partner-inspiration-composer
        count="{{inspirationCount}}"
        draftText="{{inspirationDraftText}}"
        draftPhotos="{{inspirationDraftPhotos}}"
        hasText="{{inspirationHasText}}"
        holdKeyboard="{{inspirationHoldKeyboard}}"
        saving="{{inspirationSaving}}"
        keyboardHeight="{{inspirationKeyboardHeight}}"
        closing="{{true}}"
        safeBottom="{{!isHost && closingStep !== 'review'}}"
        hiddenByKeyboard="{{closingKeyboardHeight > 0}}"
        bind:opencenter="handleGoInspirationCenter"
        bind:focus="onInspirationFocus"
        bind:blur="onInspirationBlur"
        bind:input="onInspirationInput"
        bind:keyboardheightchange="onInspirationKeyboardHeightChange"
        bind:action="onInspirationActionTap"
        bind:previewphoto="onInspirationPreviewPhoto"
        bind:removephoto="onInspirationRemovePhoto"
      />
    </block>

    <!-- 常规出牌 / 讨论 -->
    <block wx:else>
    <view class="card-area {{!isHost && gamepagePhase === 'discussion' ? 'card-area-discussion-guest' : ''}}">
      <swiper
        class="card-swiper"
        current="{{cardIndex}}"
        disable-touch="{{isHistoryReview ? reviewInnerScrolling : (scoreSwipeLocked || innerScrollLocked || starRatingGesturing || starRatingChipSwiping || chipTouchActive || (!starRatingCollapsed && !isCurrentPlayer))}}"
        bindchange="onCardSwiperChange"
        bindtransition="onCardSwiperTransition"
        bindanimationfinish="onCardSwiperAnimationFinish"
        previous-margin="24rpx"
        next-margin="24rpx"
        easing-function="easeOutCubic"
      >
        <!-- 已完成轮次的文字纪要（时间线：越左越早） -->
        <swiper-item
          class="card-swiper-item"
          wx:if="{{isHistoryReview && !displayRoundSummaries.length}}"
        >
          <view class="game-card game-card-muted">
            <view class="card-header-row">
              <text class="card-section-title card-section-title-inline">历史回顾</text>
            </view>
            <view class="card-scroll-inner" style="padding: 48rpx 24rpx;">
              <view class="card-bullet card-bullet-empty">· 暂无轮次纪要</view>
            </view>
          </view>
        </swiper-item>
        <swiper-item
          class="card-swiper-item"
          wx:for="{{displayRoundSummaries}}"
          wx:key="reviewCardKey"
        >
          <!-- 收尾创意复盘是全局卡片，不属于任何玩家或行动轮。 -->
          <view
            wx:if="{{item.cardType === 'closingReview'}}"
            class="game-card game-card-active closing-card {{isHistoryReview && index === cardIndex ? reviewCardAnim : ''}} {{isHistoryReview && index === cardIndex && reviewFocusAnim ? 'review-card-focus' : ''}}"
          >
            <view class="closing-badge">收尾阶段</view>
            <view class="closing-card-body">
              <text class="closing-card-title">创意点复盘</text>
              <scroll-view
                class="closing-scroll"
                scroll-y="{{reviewCardScrollY}}"
                show-scrollbar="{{true}}"
                bindtouchstart="onReviewCardTouchStart"
                bindtouchmove="onReviewCardTouchMove"
                bindtouchend="onReviewCardTouchEnd"
                bindtouchcancel="onReviewCardTouchEnd"
              >
                <view class="closing-scroll-inner">
                  <view class="card-section-flow">
                    <block wx:for="{{item.closingReviewBlocks}}" wx:for-item="block" wx:key="key">
                      <view wx:if="{{block.type === 'text'}}" class="card-bullet">· {{block.text}}</view>
                      <view
                        wx:elif="{{block.type === 'image'}}"
                        class="closing-deck-photo-wrap"
                        data-url="{{block.url}}"
                        bindtap="onReviewClosingImagePreview"
                      >
                        <image class="closing-deck-photo" src="{{block.url}}" mode="widthFix" />
                      </view>
                    </block>
                  </view>
                </view>
              </scroll-view>
            </view>
          </view>

          <view wx:else class="game-card game-card-muted {{isHistoryReview && index === cardIndex ? reviewCardAnim : ''}} {{isHistoryReview && index === cardIndex && reviewFocusAnim ? 'review-card-focus' : ''}}">
            <view class="card-header-row">
              <text class="card-section-title card-section-title-inline">{{item.playerName}} · 第{{item.round}}轮-文字纪要</text>
            </view>
            <view
              wx:if="{{isHistoryReview && index === cardIndex && item.totalStars > 0}}"
              class="card-earned-stars-wrap"
            >
              <earned-stars
                totalStars="{{item.totalStars}}"
                motion="{{reviewStarMotion}}"
              />
            </view>
            <scroll-view
              class="card-scroll"
              scroll-y="{{!isHistoryReview || reviewCardScrollY}}"
              enhanced="{{!isHistoryReview}}"
              show-scrollbar="{{true}}"
              bindtouchstart="onReviewCardTouchStart"
              bindtouchmove="onReviewCardTouchMove"
              bindtouchend="onReviewCardTouchEnd"
              bindtouchcancel="onReviewCardTouchEnd"
            >
              <view class="card-scroll-inner">
              <text class="card-section-title">出牌解释</text>
              <view class="card-section-flow">
                <block wx:if="{{item.privateNote.playBlocks && item.privateNote.playBlocks.length}}">
                  <block wx:for="{{item.privateNote.playBlocks}}" wx:for-item="block" wx:key="key">
                    <view wx:if="{{block.type === 'text'}}" class="card-bullet">· {{block.text}}</view>
                    <image
                      wx:elif="{{block.type === 'image'}}"
                      class="card-media-thumb card-media-thumb-flow"
                      src="{{block.url}}"
                      mode="aspectFill"
                      data-url="{{block.url}}"
                      data-round="{{item.round}}"
                      data-scope="play"
                      bindtap="onRoundPrivateInsertPreview"
                    />
                  </block>
                </block>
                <block wx:else>
                  <view class="card-bullet-list">
                    <view
                      class="card-bullet"
                      wx:for="{{item.privateNote.playHistory}}"
                      wx:for-item="line"
                      wx:key="*this"
                    >· {{line}}</view>
                    <view
                      class="card-bullet card-bullet-empty"
                      wx:if="{{!(item.privateNote.playHistory && item.privateNote.playHistory.length)}}"
                    >· 暂无记录</view>
                  </view>
                  <view class="card-media-grid" wx:if="{{item.privateNote.playImages && item.privateNote.playImages.length}}">
                    <image
                      class="card-media-thumb"
                      wx:for="{{item.privateNote.playImages}}"
                      wx:for-item="img"
                      wx:key="*this"
                      src="{{img}}"
                      mode="aspectFill"
                      data-url="{{img}}"
                      data-round="{{item.round}}"
                      data-scope="play"
                      bindtap="onRoundPrivateInsertPreview"
                    />
                  </view>
                </block>
              </view>
              <view class="summary-express-list" wx:if="{{item.playExpressChatList && item.playExpressChatList.length}}">
                <view
                  class="spectator-chat-row"
                  wx:for="{{item.playExpressChatList}}"
                  wx:for-item="express"
                  wx:key="id"
                >
                  <view class="spectator-chat-avatar-wrap">
                    <image class="spectator-chat-avatar" src="{{express.avatar}}" mode="aspectFill" />
                    <view class="spectator-chat-avatar-dot" style="{{express.avatarDotStyle}}"></view>
                  </view>
                  <view class="spectator-chat-bubble">
                    <text class="spectator-chat-text">{{express.text}}</text>
                  </view>
                </view>
              </view>
              <text class="card-section-title card-section-title-gap">疑问讨论</text>
              <view class="card-section-flow">
                <block wx:if="{{item.privateNote.discussionBlocks && item.privateNote.discussionBlocks.length}}">
                  <block wx:for="{{item.privateNote.discussionBlocks}}" wx:for-item="block" wx:key="key">
                    <view wx:if="{{block.type === 'text'}}" class="card-bullet">· {{block.text}}</view>
                    <view
                      wx:elif="{{block.type === 'image'}}"
                      class="card-media-flow-fit"
                      data-url="{{block.url}}"
                      data-round="{{item.round}}"
                      data-scope="discussion"
                      bindtap="onRoundPrivateInsertPreview"
                    >
                      <image
                        class="card-media-flow-fit-img"
                        src="{{block.url}}"
                        mode="widthFix"
                      />
                    </view>
                  </block>
                </block>
                <block wx:else>
                  <view class="card-bullet-list">
                    <view
                      class="card-bullet"
                      wx:for="{{item.privateNote.discussionNotes}}"
                      wx:for-item="line"
                      wx:key="*this"
                    >· {{line}}</view>
                    <view
                      class="card-bullet card-bullet-empty"
                      wx:if="{{!(item.privateNote.discussionNotes && item.privateNote.discussionNotes.length)}}"
                    >· 暂无记录</view>
                  </view>
                  <view class="card-media-grid" wx:if="{{item.privateNote.discussionImages && item.privateNote.discussionImages.length}}">
                    <image
                      class="card-media-thumb"
                      wx:for="{{item.privateNote.discussionImages}}"
                      wx:for-item="img"
                      wx:key="*this"
                      src="{{img}}"
                      mode="aspectFill"
                      data-url="{{img}}"
                      data-round="{{item.round}}"
                      data-scope="discussion"
                      bindtap="onRoundPrivateInsertPreview"
                    />
                  </view>
                </block>
              </view>
              <view class="summary-express-list" wx:if="{{item.discussionExpressChatList && item.discussionExpressChatList.length}}">
                <view
                  class="spectator-chat-row"
                  wx:for="{{item.discussionExpressChatList}}"
                  wx:for-item="express"
                  wx:key="id"
                >
                  <view class="spectator-chat-avatar-wrap">
                    <image class="spectator-chat-avatar" src="{{express.avatar}}" mode="aspectFill" />
                    <view class="spectator-chat-avatar-dot" style="{{express.avatarDotStyle}}"></view>
                  </view>
                  <view class="spectator-chat-bubble">
                    <text class="spectator-chat-text">{{express.text}}</text>
                  </view>
                </view>
              </view>
              <text class="card-section-title card-section-title-gap">语音纪要</text>
              <view class="card-bullet-list">
                <view
                  class="card-bullet"
                  wx:for="{{item.voiceLines}}"
                  wx:for-item="voiceLine"
                  wx:key="at"
                >· {{voiceLine.text}}</view>
                <view class="card-bullet card-bullet-empty" wx:if="{{!item.voiceLines || !item.voiceLines.length}}">· 暂无记录</view>
              </view>
              <text class="card-section-title card-section-title-gap">表态记录</text>
              <view class="card-bullet-list">
                <view
                  class="card-bullet card-turn-row"
                  wx:for="{{item.turnRecords}}"
                  wx:for-item="turn"
                  wx:for-index="turnIdx"
                  wx:key="turnIdx"
                >
                  <text>· {{turn.statementLabel || '未记录'}}</text>
                </view>
                <view class="card-bullet card-bullet-empty" wx:if="{{!item.turnRecords || !item.turnRecords.length}}">· 暂无记录</view>
              </view>
              </view>
            </scroll-view>
          </view>
        </swiper-item>

        <!-- 当前轮次出牌卡：仅看他人时隐藏，只保留属于该玩家的纪要 -->
        <swiper-item class="card-swiper-item" wx:if="{{!isHistoryReview && showCurrentActionCard}}">
          <game-card-timer
            startedAt="{{partnerRoundStartedAt}}"
            timerActive="{{roundTimerVisible && !cardBorderVariant}}"
            durationSec="{{roundTimerMaxSec}}"
            loop="{{true}}"
            suppressCanvas="{{showHostStatementTip}}"
            borderVariant="{{cardBorderVariant}}"
            soundLevel="{{silentSoundLevel}}"
            bind:timerexpire="handleRoundTimerExpire"
            wx:if="{{gamepagePhase === 'discussion'}}"
          >
            <view class="discussion-card-body">
              <view class="discussion-header-row">
                <view class="discussion-header-main">
                  <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
                  <text class="discussion-title">提出疑问并讨论</text>
                </view>
              </view>
              <view class="discussion-divider"></view>
              <scroll-view
                class="discussion-scroll"
                scroll-y
                enhanced
                show-scrollbar="{{true}}"
                scroll-into-view="{{discussionExpressChatAnchor}}"
                bindtouchstart="onInnerScrollTouchStart"
                bindtouchend="onInnerScrollTouchEnd"
                bindtouchcancel="onInnerScrollTouchEnd"
              >
                <view class="discussion-scroll-inner">
                  <!-- 匿名表达：仅出牌阶段匿名聊天 -->
                  <view class="card-section-block">
                    <view class="card-section-head">
                      <text class="card-section-title">匿名表达</text>
                    </view>
                    <view class="discussion-express-list" wx:if="{{playExpressChatList.length}}">
                      <view
                        class="spectator-chat-row"
                        wx:for="{{playExpressChatList}}"
                        wx:key="id"
                      >
                        <view class="spectator-chat-avatar-wrap">
                          <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                          <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                        </view>
                        <view class="spectator-chat-bubble">
                          <text class="spectator-chat-text">{{item.text}}</text>
                        </view>
                      </view>
                    </view>
                    <view class="spectator-chat-empty spectator-chat-empty-compact" wx:else>
                      <text class="spectator-chat-empty-text">暂无匿名表达</text>
                    </view>
                  </view>

                  <!-- 疑问讨论：讨论阶段匿名聊天 + 可插图 -->
                  <view class="card-section-block card-section-block-gap">
                    <view class="card-section-head">
                      <text class="card-section-title">疑问讨论</text>
                      <view
                        class="card-section-add"
                        data-target="discussion"
                        catchtap="onCardSectionAddImage"
                        wx:if="{{isHost}}"
                      >
                        <image
                          class="card-section-add-icon"
                          src="/assets/partnerMode/icon-insp-plus.svg"
                          mode="aspectFit"
                        />
                      </view>
                    </view>
                    <view class="card-section-flow" wx:if="{{discussionBlocks.length}}">
                      <block wx:for="{{discussionBlocks}}" wx:key="key">
                        <view wx:if="{{item.type === 'text'}}" class="card-bullet">· {{item.text}}</view>
                        <view
                          wx:elif="{{item.type === 'image'}}"
                          class="card-media-flow-fit"
                          data-url="{{item.url}}"
                          data-scope="discussion"
                          catchtap="onCardImagePreview"
                        >
                          <image
                            class="card-media-flow-fit-img"
                            src="{{item.url}}"
                            mode="widthFix"
                          />
                        </view>
                      </block>
                    </view>
                    <view class="discussion-express-list" wx:if="{{discussionExpressChatList.length}}">
                      <view
                        class="spectator-chat-row"
                        wx:for="{{discussionExpressChatList}}"
                        wx:key="id"
                        id="discussion-express-{{item.id}}"
                      >
                        <view class="spectator-chat-avatar-wrap">
                          <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                          <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                        </view>
                        <view class="spectator-chat-bubble">
                          <text class="spectator-chat-text">{{item.text}}</text>
                        </view>
                      </view>
                      <view id="discussion-express-chat-bottom" style="height: 1rpx;"></view>
                    </view>
                    <view class="spectator-chat-empty spectator-chat-empty-compact" wx:elif="{{!discussionBlocks.length}}">
                      <text class="spectator-chat-empty-text">暂无疑问讨论</text>
                    </view>
                  </view>
                </view>
              </scroll-view>

              <!-- 讨论阶段：表达入口统一在卡片右下角 -->
              <view
                wx:if="{{expressComposerOpen}}"
                class="express-dismiss-mask"
                catchtap="closeExpressComposer"
              ></view>
              <view class="card-express-corner {{expressComposerOpen ? 'card-express-corner-open' : ''}}">
                <form
                  wx:if="{{expressComposerOpen}}"
                  class="spectator-express-form"
                  bindsubmit="onExpressFormSubmit"
                >
                  <view class="spectator-express-composer">
                    <input
                      class="spectator-express-input"
                      name="expressText"
                      value="{{expressDraftText}}"
                      maxlength="40"
                      confirm-type="send"
                      hold-keyboard="{{false}}"
                      adjust-position="{{true}}"
                      cursor-spacing="24"
                      focus="{{expressComposerNeedFocus}}"
                      placeholder="说点什么…"
                      placeholder-class="spectator-express-placeholder"
                      bindfocus="onExpressComposerFocus"
                      bindconfirm="onExpressConfirm"
                      bindinput="onExpressInput"
                      bindblur="onExpressComposerBlur"
                      bindkeyboardheightchange="onExpressKeyboardHeightChange"
                    />
                    <button
                      class="spectator-express-send-btn {{expressHasText ? '' : 'spectator-express-send-disabled'}}"
                      hover-class="spectator-express-send-hover"
                      catchtap="onExpressSendTap"
                    >发送</button>
                  </view>
                </form>
                <view
                  wx:else
                  class="express-fab-btn"
                  catchtap="openExpressComposer"
                >
                  <image
                    class="express-fab-bubble"
                    src="/assets/partnerMode/icon-express-bubble.svg"
                    mode="aspectFit"
                  />
                </view>
              </view>
            </view>
          </game-card-timer>

          <game-card-timer
            startedAt="{{partnerRoundStartedAt}}"
            timerActive="{{roundTimerVisible && !cardBorderVariant}}"
            durationSec="{{roundTimerMaxSec}}"
            loop="{{true}}"
            suppressCanvas="{{showHostStatementTip}}"
            borderVariant="{{cardBorderVariant}}"
            soundLevel="{{silentSoundLevel}}"
            bind:timerexpire="handleRoundTimerExpire"
            wx:else
          >
            <view class="action-card-wrap">
              <!-- 当前出牌玩家：出牌并解释（规则一屏内展示，禁止上下滚动） -->
              <view
                class="action-card-scroll"
                wx:if="{{isCurrentPlayer}}"
              >
                <view class="action-card-inner {{expressChatPanelVisible ? 'action-card-inner-express' : ''}}">
                  <view class="action-header {{specialActionBadge ? 'action-header-special' : ''}}">
                    <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
                    <view class="action-title-block">
                      <view class="action-title-row" wx:if="{{specialActionBadge}}">
                        <view class="special-mode-badge">{{specialActionBadge}}</view>
                        <text class="action-title action-title-special">{{isMasterMode ? '请进行卡牌行动并解释' : '出牌并解释'}}</text>
                      </view>
                      <text class="action-title" wx:else>出牌并解释</text>
                      <text class="action-desc">{{isMasterMode ? '您可以进行任意次行动，每次行动可以是以下任意一种' : '每轮行动 1–3 次，可新开方案，也可延续他人想法。每次行动后，简要说明你的想法。'}}</text>
                    </view>
                  </view>
                  <view class="action-divider"></view>

                  <!-- 点击表达：仅切换卡内内容为匿名聊天（Figma 5966:29140） -->
                  <view class="action-express-chat-body" wx:if="{{expressChatPanelVisible}}">
                    <scroll-view
                      class="action-express-chat"
                      scroll-y
                      enhanced
                      show-scrollbar="{{true}}"
                      scroll-into-view="{{expressChatAnchor}}"
                      bindtouchstart="onInnerScrollTouchStart"
                      bindtouchend="onInnerScrollTouchEnd"
                      bindtouchcancel="onInnerScrollTouchEnd"
                    >
                      <view
                        class="spectator-chat-row"
                        wx:for="{{expressChatList}}"
                        wx:key="id"
                        id="express-chat-{{item.id}}"
                      >
                        <view class="spectator-chat-avatar-wrap">
                          <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                          <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                        </view>
                        <view class="spectator-chat-bubble">
                          <text class="spectator-chat-text">{{item.text}}</text>
                        </view>
                      </view>
                      <view class="spectator-chat-empty" wx:if="{{!expressChatList.length}}">
                        <text class="spectator-chat-empty-text">暂无匿名表达</text>
                      </view>
                      <view id="express-chat-bottom" style="height: 1rpx;"></view>
                    </scroll-view>
                    <view class="action-express-chat-locked" wx:if="{{!expressCanSend}}">
                      <text class="action-express-chat-locked-text">本轮表态结束后可发送</text>
                    </view>
                  </view>

                  <!-- 行动规则固定展示 -->
                  <view class="action-rules-block" wx:else>
                    <view class="action-grid">
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">出 1 张卡牌</text>
                        <text class="action-cell-detail">新开或延续方案</text>
                      </view>
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">翻 1 张卡牌</text>
                        <text class="action-cell-detail">改变卡牌朝向</text>
                      </view>
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">调整 1 张卡牌</text>
                        <text class="action-cell-detail">移动卡牌位置</text>
                      </view>
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">交换 2 张卡牌</text>
                        <text class="action-cell-detail">互换卡牌位置</text>
                      </view>
                    </view>
                  </view>

                </view>
              </view>

              <!-- 非出牌玩家：玩家正在出牌 -->
              <view class="spectator-card" wx:else bindtap="onStarRatingBackdropTap">
                <view
                  wx:if="{{expressComposerOpen}}"
                  class="express-dismiss-mask"
                  catchtap="closeExpressComposer"
                ></view>
                <view class="spectator-card-head {{specialActionBadge ? 'spectator-card-head-special' : ''}}">
                  <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
                  <view class="action-title-row" wx:if="{{specialActionBadge}}">
                    <view class="special-mode-badge">{{specialActionBadge}}</view>
                    <text class="spectator-card-title spectator-card-title-special">玩家正在出牌</text>
                  </view>
                  <text class="spectator-card-title" wx:else>玩家正在出牌</text>
                  <text class="spectator-card-desc">您可以对该玩家的出牌进行表达或打分</text>
                </view>
                <view class="action-divider"></view>

                <!-- 匿名聊天区：外包一层定高，iOS 原生 scroll-view 才能滚 -->
                <view class="spectator-chat-wrap">
                <scroll-view
                  class="spectator-chat"
                  scroll-y
                  enhanced
                  show-scrollbar="{{true}}"
                  scroll-into-view="{{expressChatAnchor}}"
                  bindtouchstart="onInnerScrollTouchStart"
                  bindtouchend="onInnerScrollTouchEnd"
                  bindtouchcancel="onInnerScrollTouchEnd"
                >
                  <view
                    class="spectator-chat-row"
                    wx:for="{{expressChatList}}"
                    wx:key="id"
                    id="express-chat-{{item.id}}"
                  >
                    <view class="spectator-chat-avatar-wrap">
                      <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                      <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                    </view>
                    <view class="spectator-chat-bubble">
                      <text class="spectator-chat-text">{{item.text}}</text>
                    </view>
                  </view>
                  <view class="spectator-chat-empty" wx:if="{{!expressChatList.length}}">
                    <text class="spectator-chat-empty-text">匿名表达会出现在这里</text>
                  </view>
                  <view id="express-chat-bottom" style="height: 1rpx;"></view>
                </scroll-view>
                </view>

                <view
                  class="spectator-bottom-stack {{starRatingCollapsed ? 'spectator-bottom-stack-collapsed' : ''}} {{expressComposerOpen ? 'spectator-bottom-stack-composing' : ''}} {{chipTouchActive || starRatingChipSwiping ? 'spectator-bottom-stack-scoring' : ''}}"
                  catchtap="noop"
                >
                  <view class="star-rating-shell {{starRatingCollapsed ? 'star-rating-shell-collapsed' : ''}} {{starRatingChipSwiping ? 'star-rating-shell-swiping' : ''}}">
                    <!-- 收起/右滑中：全宽透明热区，避免手指右移离开 chip 后断触、被卡片 swiper 抢走 -->
                    <view
                      wx:if="{{starRatingCollapsed || starRatingChipSwiping || chipTouchActive}}"
                      class="star-rating-chip-hit"
                      catchtouchstart="onStarChipTouchStart"
                      catchtouchmove="onStarChipTouchMove"
                      catchtouchend="onStarChipTouchEnd"
                      catchtouchcancel="onStarChipTouchEnd"
                    ></view>
                    <view class="star-rating-chip">
                      <text class="star-rating-chip-text">已打分：{{scoredCount}}/{{totalRequired}}人</text>
                    </view>
                    <view class="star-rating-body">
                      <view class="star-rating-row">
                        <star-rating
                          id="starRating"
                          value="{{selectedScore}}"
                          disabled="{{scoreSubmitting}}"
                          bind:preview="onStarRatingPreview"
                          bind:scoreconfirm="onStarRatingConfirm"
                          bind:gesturestart="onStarGestureStart"
                          bind:gestureend="onStarGestureEnd"
                        />
                      </view>
                    </view>
                  </view>

                  <view class="spectator-express-slot spectator-express-slot-flow">
                    <form
                      wx:if="{{expressComposerOpen}}"
                      class="spectator-express-form"
                      bindsubmit="onExpressFormSubmit"
                    >
                      <view class="spectator-express-composer">
                        <input
                          class="spectator-express-input"
                          name="expressText"
                          value="{{expressDraftText}}"
                          maxlength="40"
                          confirm-type="send"
                          hold-keyboard="{{false}}"
                          adjust-position="{{true}}"
                          cursor-spacing="24"
                          focus="{{expressComposerNeedFocus}}"
                          placeholder="说点什么…"
                          placeholder-class="spectator-express-placeholder"
                          bindfocus="onExpressComposerFocus"
                          bindconfirm="onExpressConfirm"
                          bindinput="onExpressInput"
                          bindblur="onExpressComposerBlur"
                          bindkeyboardheightchange="onExpressKeyboardHeightChange"
                        />
                        <button
                          class="spectator-express-send-btn {{expressHasText ? '' : 'spectator-express-send-disabled'}}"
                          hover-class="spectator-express-send-hover"
                          catchtap="onExpressSendTap"
                        >发送</button>
                      </view>
                    </form>
                    <view
                      wx:else
                      class="spectator-express-fab-row"
                    >
                      <view
                        class="spectator-express-fab"
                        hover-class="spectator-express-fab-hover"
                        catchtap="openExpressComposer"
                      >
                        <image
                          class="spectator-express-fab-bubble"
                          src="/assets/partnerMode/icon-express-bubble.svg"
                          mode="aspectFit"
                        />
                      </view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 出牌玩家：同步显示打分进度（不可自评）；匿名表达入口在右下角 -->
              <view
                class="card-express-corner {{!expressChatPanelVisible ? 'card-express-corner-with-progress' : ''}}"
                wx:if="{{isCurrentPlayer}}"
              >
                <view
                  class="actor-score-chip"
                  wx:if="{{!expressChatPanelVisible}}"
                  catchtap="onStarRatingChipTap"
                >
                  <text class="star-rating-chip-text">已打分：{{scoredCount}}/{{totalRequired}}人</text>
                </view>
                <view
                  class="express-fab-btn"
                  catchtap="toggleExpressChatInCard"
                >
                  <image
                    class="express-fab-bubble"
                    src="{{expressChatPanelVisible ? '/assets/partnerMode/icon-express-view.png' : '/assets/partnerMode/icon-express-bubble.svg'}}"
                    mode="aspectFit"
                  />
                </view>
              </view>
            </view>
          </game-card-timer>
        </swiper-item>
      </swiper>

      <view class="card-pagination">
        <view class="pagination-dots">
          <view
            wx:for="{{paginationDots}}"
            wx:for-item="dot"
            wx:key="key"
            class="dot {{dot.sizeClass}} {{dot.active ? 'dot-active' : ''}}"
          ></view>
        </view>
        <text class="pagination-text">{{cardIndex + 1}}/{{cardCount}}</text>
      </view>
    </view>

    <partner-inspiration-composer
      count="{{inspirationCount}}"
      draftText="{{inspirationDraftText}}"
      draftPhotos="{{inspirationDraftPhotos}}"
      hasText="{{inspirationHasText}}"
      holdKeyboard="{{inspirationHoldKeyboard}}"
      saving="{{inspirationSaving}}"
      keyboardHeight="{{inspirationKeyboardHeight}}"
      history="{{isHistoryReview}}"
      historyWithFooter="{{isHistoryReview && reviewCanGoBack}}"
      safeBottom="{{!isHistoryReview && !isHost && gamepagePhase === 'discussion'}}"
      bind:opencenter="handleGoInspirationCenter"
      bind:focus="onInspirationFocus"
      bind:blur="onInspirationBlur"
      bind:input="onInspirationInput"
      bind:keyboardheightchange="onInspirationKeyboardHeightChange"
      bind:action="onInspirationActionTap"
      bind:previewphoto="onInspirationPreviewPhoto"
      bind:removephoto="onInspirationRemovePhoto"
    />
  </block>
  </view>

  <partner-game-footer
    wx:if="{{inspirationKeyboardHeight <= 0 && closingKeyboardHeight <= 0}}"
    id="partnerGameFooter"
    visible="{{(isHistoryReview && reviewCanGoBack) || (!isHistoryReview && (isHost || gamepagePhase === 'play' || (gamepagePhase === 'closing' && closingStep === 'review')))}}"
    keyboardOpen="{{inspirationKeyboardHeight > 0 || closingKeyboardHeight > 0}}"
    historyReview="{{isHistoryReview}}"
    reviewCanGoBack="{{reviewCanGoBack}}"
    phase="{{gamepagePhase}}"
    closingStep="{{closingStep}}"
    isHost="{{isHost}}"
    isCurrentPlayer="{{isCurrentPlayer}}"
    showSpecialMove="{{showSpecialMoveBtn}}"
    specialMoveUsed="{{specialMoveUsedThisTurn}}"
    masterMode="{{isMasterMode}}"
    canStartStatement="{{canStartStatement}}"
    statementSwitching="{{statementSwitching}}"
    discussionSwitching="{{discussionSwitching}}"
    discussionSwitchAction="{{discussionSwitchAction}}"
    bind:intent="onGameFooterIntent"
  />

  <!-- 房主首次进入：聚光提示“全员打分后才可开始表态”，点击任意处关闭 -->
  <view
    class="host-statement-tip-layer"
    wx:if="{{showHostStatementTip && hostStatementTipReady}}"
    catchtouchmove="preventMove"
    catchtap="dismissHostStatementTip"
  >
    <view
      class="host-statement-tip-spot"
      style="{{hostStatementTipSpotStyle}}"
    ></view>
    <view
      class="host-statement-tip-bubble"
      style="{{hostStatementTipTextStyle}}"
    >
      <view class="host-statement-tip-kicker">
        <view class="host-statement-tip-icon">!</view>
        <text class="host-statement-tip-kicker-text">操作提示</text>
      </view>
      <text class="host-statement-tip-title">先完成全员打分</text>
      <text class="host-statement-tip-text">全部完成后，「开始表态」按钮会亮起</text>
      <view class="host-statement-tip-meta">
        <text class="host-statement-tip-progress">已打分 {{scoredCount}}/{{totalRequired}} 人</text>
        <text class="host-statement-tip-dismiss">点击任意处继续</text>
      </view>
      <view class="host-statement-tip-arrow" style="{{hostStatementTipArrowStyle}}"></view>
    </view>
  </view>

</view>
</block>

<view wx:else class="room-shell-loading"></view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

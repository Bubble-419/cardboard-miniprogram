<view class="container {{isHistoryReview ? 'container-history-review' : ''}}">
  <view class="page-body">
    <!-- 顶部：房间入口 + 设计问题（与微信胶囊垂直齐平） -->
    <view
      class="top-bar"
      style="padding-top: {{topBarPadTop}}px; padding-right: {{topBarPaddingRight}}px;"
    >
      <view
        class="top-bar-inner"
        style="height: {{topBarHeight}}px;"
      >
        <view
          class="room-entry"
          style="width: {{topBarIconSize}}px; height: {{topBarIconSize}}px;"
          bindtap="handleGoRoom"
        >
          <image class="room-entry-icon" src="/assets/partnerMode/icon-room-entry-gp.svg" mode="aspectFit" />
        </view>
        <view
          class="problem-chip {{problemExpanded ? 'problem-chip-expanded' : ''}} problem-chip-tappable"
          style="min-height: {{topBarIconSize}}px;"
          bindtap="handleViewSituation"
        >
          <image class="problem-icon" src="/assets/partnerMode/icon-problem-chip.svg" mode="aspectFit" />
          <view class="problem-text-wrap">
            <text
              id="problemText"
              class="problem-text {{selectedProblemText ? '' : 'problem-text-empty'}} {{problemExpanded ? 'problem-text-expanded' : ''}}"
            >{{selectedProblemText || '暂无设计问题'}}</text>
            <text wx:if="{{selectedProblemText && !problemExpanded}}" id="problemTextMeasure" class="problem-text-measure">{{selectedProblemText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 玩家列表：使用 partner-avatar 展示六种头像状态 -->
    <view class="user-section">
      <user-list
        avatarList="{{avatarList}}"
        actingUser="{{isHistoryReview ? -1 : currentPlayerIndex}}"
        selectedUser="{{isHistoryReview || !isPlayerFilterActive ? -1 : selectedPlayerIndex}}"
        indicatorUser="{{indicatorPlayerIndex}}"
        enableAdd="{{false}}"
        isFold="{{true}}"
        showName="{{false}}"
        visualMode="partner-game"
        onActionPage="{{!isHistoryReview && showCurrentActionCard && cardIndex >= displayRoundSummaries.length}}"
        showActingFrame="{{!isHistoryReview && gamepagePhase !== 'closing'}}"
        enableSelectedFrame="{{!isHistoryReview && gamepagePhase !== 'closing'}}"
        enableAvatarTap="{{!isHistoryReview && gamepagePhase !== 'closing'}}"
        roundStartedAt="{{isHistoryReview ? null : partnerRoundStartedAt}}"
        roundTimerActive="{{!isHistoryReview && roundTimerVisible && roundTimerReady}}"
        roundTimerKey="{{currentRound}}-{{currentPlayerIndex}}"
        suppressTimerCanvas="{{showHostStatementTip || isHistoryReview}}"
        bindavatartap="handleAvatarTap"
      />
    </view>

    <view class="divider-line"></view>

    <!-- 收尾阶段：全员通过后先补全符文，房主点下一步后再创意点复盘 -->
    <block wx:if="{{!isHistoryReview && gamepagePhase === 'closing'}}">
      <view class="card-area">
        <view class="closing-card-stage">
          <!-- 补全符文 -->
          <view class="game-card game-card-active closing-card" wx:if="{{closingStep === 'rune'}}">
            <view class="closing-badge">收尾阶段</view>
            <view class="closing-card-body">
              <text class="closing-card-title">补全符文</text>
              <text class="closing-card-desc">请根据以下操作提示，补全符文</text>
              <view class="closing-divider"></view>
              <view class="closing-rune-grid closing-rune-grid-fill">
                <view class="closing-rune-col">
                  <view class="closing-rune-slot closing-rune-slot-top">
                    <text class="closing-rune-label">延时符文</text>
                  </view>
                  <view class="closing-rune-slot closing-rune-slot-bottom">
                    <text class="closing-rune-label">稳定态符文</text>
                  </view>
                </view>
                <view class="closing-rune-col">
                  <view class="closing-rune-slot closing-rune-slot-top">
                    <text class="closing-rune-label">延时符文</text>
                  </view>
                  <view class="closing-rune-slot closing-rune-slot-bottom">
                    <text class="closing-rune-label">属性类型符文</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- 创意点复盘 -->
          <view class="game-card game-card-active closing-card" wx:else>
            <view class="closing-badge">收尾阶段</view>
            <view class="closing-card-body">
              <text class="closing-card-title">创意点复盘</text>
              <scroll-view class="closing-scroll" scroll-y enhanced show-scrollbar="{{true}}">
                <view class="closing-scroll-inner">
                <view class="card-section-flow">
                  <block wx:for="{{closingCreativeBlocks}}" wx:key="key">
                    <view
                      wx:if="{{item.type === 'text' && item.key !== closingCreativeEditingKey}}"
                      class="card-bullet {{isHost ? 'closing-text-editable' : ''}}"
                      data-key="{{item.key}}"
                      catchtap="onClosingCreativeTextTap"
                    >· {{item.text}}</view>
                    <view
                      wx:elif="{{item.type === 'image'}}"
                      class="closing-deck-photo-wrap {{closingImageDeleteKey === item.key ? 'closing-deck-photo-wrap-deleting' : ''}}"
                      data-key="{{item.key}}"
                      data-url="{{item.url}}"
                      bindlongpress="onClosingCreativeImageLongPress"
                    >
                      <image
                        class="closing-deck-photo"
                        src="{{item.url}}"
                        mode="widthFix"
                        data-key="{{item.key}}"
                        data-url="{{item.url}}"
                        catchtap="onClosingCreativeImageTap"
                      />
                      <view
                        wx:if="{{isHost && closingImageDeleteKey === item.key}}"
                        class="closing-deck-photo-remove"
                        catchtap="onClosingCreativeRemoveBlock"
                        data-key="{{item.key}}"
                      >×</view>
                    </view>
                  </block>
                  <view
                    class="card-bullet card-bullet-empty"
                    wx:if="{{!isHost && !closingCreativeBlocks.length}}"
                  >等待房主记录</view>
                </view>
                </view>
              </scroll-view>
              <!-- 输入区跟在已记录内容之后；插图入口始终在输入提示/最后一行文字下方 -->
              <view class="closing-compose-tail" wx:if="{{isHost}}">
                <form
                  class="closing-compose-form"
                  bindsubmit="onClosingCreativeFormSubmit"
                >
                  <view class="card-inline-textarea-wrap closing-compose-input-row">
                    <!-- 勿绑 focus=false：真机会锁死原生键盘。仅编辑已有文字时用 focus=true 的实例。 -->
                    <textarea
                      wx:if="{{closingCreativeWantFocus}}"
                      class="card-inline-textarea {{closingCreativeEditFocus ? 'card-inline-textarea-active' : 'card-inline-textarea-hint'}}"
                      name="closingCreativeText"
                      value="{{closingCreativeEditText}}"
                      focus="{{true}}"
                      bindfocus="onClosingCreativeFocus"
                      bindinput="onClosingCreativeInput"
                      bindblur="onClosingCreativeBlur"
                      bindkeyboardheightchange="onClosingCreativeKeyboardHeightChange"
                      placeholder="{{closingCreativeBlocks.length || closingCreativeEditText ? '' : '点击开始记录'}}"
                      placeholder-class="{{closingCreativeEditFocus ? 'card-record-placeholder-active' : 'card-record-placeholder'}}"
                      maxlength="500"
                      auto-height
                      disable-default-padding="{{true}}"
                      show-confirm-bar="{{false}}"
                      adjust-position="{{true}}"
                      hold-keyboard="{{true}}"
                      cursor-spacing="40"
                    />
                    <textarea
                      wx:else
                      class="card-inline-textarea {{closingCreativeEditFocus ? 'card-inline-textarea-active' : 'card-inline-textarea-hint'}}"
                      name="closingCreativeText"
                      value="{{closingCreativeEditText}}"
                      bindfocus="onClosingCreativeFocus"
                      bindinput="onClosingCreativeInput"
                      bindblur="onClosingCreativeBlur"
                      bindkeyboardheightchange="onClosingCreativeKeyboardHeightChange"
                      placeholder="{{closingCreativeBlocks.length || closingCreativeEditText ? '' : '点击开始记录'}}"
                      placeholder-class="{{closingCreativeEditFocus ? 'card-record-placeholder-active' : 'card-record-placeholder'}}"
                      maxlength="500"
                      auto-height
                      disable-default-padding="{{true}}"
                      show-confirm-bar="{{false}}"
                      adjust-position="{{true}}"
                      hold-keyboard="{{true}}"
                      cursor-spacing="40"
                    />
                    <button
                      class="closing-compose-save-btn {{closingCreativeSaving ? 'closing-compose-save-disabled' : ''}}"
                      form-type="submit"
                      hover-class="none"
                      disabled="{{closingCreativeSaving}}"
                    >
                      <image
                        class="closing-compose-save-icon"
                        src="/assets/partnerMode/icon-insp-send.svg"
                        mode="aspectFit"
                      />
                    </button>
                  </view>
                </form>
                <view class="closing-deck-capture" wx:if="{{!closingHasDeckImage}}">
                  <view
                    class="closing-deck-capture-inner"
                    catchtap="onClosingCreativeAddImage"
                  >
                    <view class="closing-deck-capture-frame">
                      <image
                        class="closing-deck-camera-icon"
                        src="/assets/partnerMode/icon-closing-deck-camera.svg"
                        mode="aspectFit"
                      />
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 勿绑 focus=false：真机会锁死原生聚焦；点击交给 input 原生拉起输入法 -->
      <view
        class="inspiration-bar inspiration-bar-closing {{isHost ? '' : 'inspiration-bar-safe-bottom'}} {{closingCreativeEditFocus ? 'inspiration-bar-kb-hidden' : ''}}"
        style="{{inspirationLiftStyle}}"
      >
        <view class="insp-icon-wrap" catchtap="handleGoInspirationCenter">
          <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
          <view class="insp-badge" wx:if="{{inspirationCount > 0}}">
            <text class="insp-badge-num">{{inspirationCount > 99 ? '99' : inspirationCount}}</text>
          </view>
        </view>
        <view class="inspiration-composer {{inspirationDraftPhotos.length ? 'inspiration-composer-with-photos' : ''}}">
          <scroll-view
            wx:if="{{inspirationDraftPhotos.length}}"
            class="inspiration-photo-strip"
            scroll-x
            enhanced
            show-scrollbar="{{false}}"
          >
            <view class="inspiration-photo-strip-inner">
              <view
                class="inspiration-photo-thumb-wrap"
                wx:for="{{inspirationDraftPhotos}}"
                wx:key="*this"
              >
                <image
                  class="inspiration-photo-thumb"
                  src="{{item}}"
                  mode="aspectFill"
                  catchtap="onInspirationPreviewPhoto"
                  data-url="{{item}}"
                />
                <view
                  class="inspiration-photo-remove"
                  catchtap="onInspirationRemovePhoto"
                  data-index="{{index}}"
                >×</view>
              </view>
            </view>
          </scroll-view>
          <view class="inspiration-row">
            <input
              class="inspiration-textarea"
              type="text"
              value="{{inspirationDraftText}}"
              hold-keyboard="{{inspirationHoldKeyboard}}"
              bindfocus="onInspirationFocus"
              bindblur="onInspirationBlur"
              bindinput="onInspirationInput"
              bindkeyboardheightchange="onInspirationKeyboardHeightChange"
              placeholder="记录您的灵感..."
              placeholder-class="inspiration-placeholder"
              maxlength="2000"
              confirm-type="done"
              adjust-position="{{false}}"
              cursor-spacing="12"
            />
            <view
              class="inspiration-action {{inspirationSaving ? 'inspiration-action-disabled' : ''}}"
              catchtap="onInspirationActionTap"
            >
              <image
                wx:if="{{inspirationHasText || inspirationDraftPhotos.length}}"
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-send.svg"
                mode="aspectFit"
              />
              <image
                wx:else
                class="inspiration-action-icon"
                src="/assets/partnerMode/icon-insp-plus.svg"
                mode="aspectFit"
              />
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 常规出牌 / 讨论 -->
    <block wx:else>
    <view class="card-area">
      <swiper
        class="card-swiper"
        current="{{cardIndex}}"
        disable-touch="{{scoreSwipeLocked || innerScrollLocked || starRatingGesturing}}"
        bindchange="onCardSwiperChange"
        bindtransition="onCardSwiperTransition"
        bindanimationfinish="onCardSwiperAnimationFinish"
        previous-margin="56rpx"
        next-margin="56rpx"
        easing-function="easeOutCubic"
      >
        <!-- 已完成轮次的文字纪要（时间线：越左越早） -->
        <swiper-item
          class="card-swiper-item"
          wx:if="{{isHistoryReview && !displayRoundSummaries.length}}"
        >
          <view class="game-card game-card-muted">
            <view class="card-header-row">
              <text class="card-section-title card-section-title-inline">历史回顾</text>
            </view>
            <view class="card-scroll-inner" style="padding: 48rpx 24rpx;">
              <view class="card-bullet card-bullet-empty">· 暂无轮次纪要</view>
            </view>
          </view>
        </swiper-item>
        <swiper-item
          class="card-swiper-item"
          wx:for="{{displayRoundSummaries}}"
          wx:key="round"
        >
          <view class="game-card game-card-muted">
            <view class="card-header-row">
              <text class="card-section-title card-section-title-inline">{{item.playerName}} · 第{{item.round}}轮-文字纪要</text>
              <text wx:if="{{isHistoryReview && item.avgScoreText}}" class="card-avg-score">均分 {{item.avgScoreText}}</text>
            </view>
            <scroll-view class="card-scroll" scroll-y enhanced show-scrollbar="{{true}}">
              <view class="card-scroll-inner">
              <text class="card-section-title">出牌解释</text>
              <view class="card-section-flow">
                <block wx:if="{{item.privateNote.playBlocks && item.privateNote.playBlocks.length}}">
                  <block wx:for="{{item.privateNote.playBlocks}}" wx:for-item="block" wx:key="key">
                    <view wx:if="{{block.type === 'text'}}" class="card-bullet">· {{block.text}}</view>
                    <image
                      wx:elif="{{block.type === 'image'}}"
                      class="card-media-thumb card-media-thumb-flow"
                      src="{{block.url}}"
                      mode="aspectFill"
                      data-url="{{block.url}}"
                      data-round="{{item.round}}"
                      data-scope="play"
                      bindtap="onRoundPrivateInsertPreview"
                    />
                  </block>
                </block>
                <block wx:else>
                  <view class="card-bullet-list">
                    <view
                      class="card-bullet"
                      wx:for="{{item.privateNote.playHistory}}"
                      wx:for-item="line"
                      wx:key="*this"
                    >· {{line}}</view>
                    <view
                      class="card-bullet card-bullet-empty"
                      wx:if="{{!(item.privateNote.playHistory && item.privateNote.playHistory.length)}}"
                    >· 暂无记录</view>
                  </view>
                  <view class="card-media-grid" wx:if="{{item.privateNote.playImages && item.privateNote.playImages.length}}">
                    <image
                      class="card-media-thumb"
                      wx:for="{{item.privateNote.playImages}}"
                      wx:for-item="img"
                      wx:key="*this"
                      src="{{img}}"
                      mode="aspectFill"
                      data-url="{{img}}"
                      data-round="{{item.round}}"
                      data-scope="play"
                      bindtap="onRoundPrivateInsertPreview"
                    />
                  </view>
                </block>
              </view>
              <view class="summary-express-list" wx:if="{{item.playExpressChatList && item.playExpressChatList.length}}">
                <view
                  class="spectator-chat-row"
                  wx:for="{{item.playExpressChatList}}"
                  wx:for-item="express"
                  wx:key="id"
                >
                  <view class="spectator-chat-avatar-wrap">
                    <image class="spectator-chat-avatar" src="{{express.avatar}}" mode="aspectFill" />
                    <view class="spectator-chat-avatar-dot" style="{{express.avatarDotStyle}}"></view>
                  </view>
                  <view class="spectator-chat-bubble">
                    <text class="spectator-chat-text">{{express.text}}</text>
                  </view>
                </view>
              </view>
              <text class="card-section-title card-section-title-gap">疑问讨论</text>
              <view class="card-section-flow">
                <block wx:if="{{item.privateNote.discussionBlocks && item.privateNote.discussionBlocks.length}}">
                  <block wx:for="{{item.privateNote.discussionBlocks}}" wx:for-item="block" wx:key="key">
                    <view wx:if="{{block.type === 'text'}}" class="card-bullet">· {{block.text}}</view>
                    <image
                      wx:elif="{{block.type === 'image'}}"
                      class="card-media-thumb card-media-thumb-flow"
                      src="{{block.url}}"
                      mode="aspectFill"
                      data-url="{{block.url}}"
                      data-round="{{item.round}}"
                      data-scope="discussion"
                      bindtap="onRoundPrivateInsertPreview"
                    />
                  </block>
                </block>
                <block wx:else>
                  <view class="card-bullet-list">
                    <view
                      class="card-bullet"
                      wx:for="{{item.privateNote.discussionNotes}}"
                      wx:for-item="line"
                      wx:key="*this"
                    >· {{line}}</view>
                    <view
                      class="card-bullet card-bullet-empty"
                      wx:if="{{!(item.privateNote.discussionNotes && item.privateNote.discussionNotes.length)}}"
                    >· 暂无记录</view>
                  </view>
                  <view class="card-media-grid" wx:if="{{item.privateNote.discussionImages && item.privateNote.discussionImages.length}}">
                    <image
                      class="card-media-thumb"
                      wx:for="{{item.privateNote.discussionImages}}"
                      wx:for-item="img"
                      wx:key="*this"
                      src="{{img}}"
                      mode="aspectFill"
                      data-url="{{img}}"
                      data-round="{{item.round}}"
                      data-scope="discussion"
                      bindtap="onRoundPrivateInsertPreview"
                    />
                  </view>
                </block>
              </view>
              <view class="summary-express-list" wx:if="{{item.discussionExpressChatList && item.discussionExpressChatList.length}}">
                <view
                  class="spectator-chat-row"
                  wx:for="{{item.discussionExpressChatList}}"
                  wx:for-item="express"
                  wx:key="id"
                >
                  <view class="spectator-chat-avatar-wrap">
                    <image class="spectator-chat-avatar" src="{{express.avatar}}" mode="aspectFill" />
                    <view class="spectator-chat-avatar-dot" style="{{express.avatarDotStyle}}"></view>
                  </view>
                  <view class="spectator-chat-bubble">
                    <text class="spectator-chat-text">{{express.text}}</text>
                  </view>
                </view>
              </view>
              <text class="card-section-title card-section-title-gap">语音纪要</text>
              <view class="card-bullet-list">
                <view
                  class="card-bullet"
                  wx:for="{{item.voiceLines}}"
                  wx:for-item="voiceLine"
                  wx:key="at"
                >· {{voiceLine.text}}</view>
                <view class="card-bullet card-bullet-empty" wx:if="{{!item.voiceLines || !item.voiceLines.length}}">· 暂无记录</view>
              </view>
              <text class="card-section-title card-section-title-gap">表态记录</text>
              <view class="card-bullet-list">
                <view
                  class="card-bullet"
                  wx:for="{{item.turnRecords}}"
                  wx:for-item="turn"
                  wx:for-index="turnIdx"
                  wx:key="turnIdx"
                >· <block wx:if="{{isHistoryReview && turn.avgScoreText}}">获评均分 {{turn.avgScoreText}} · </block>{{turn.statementLabel || '未记录'}}</view>
                <view class="card-bullet card-bullet-empty" wx:if="{{!item.turnRecords || !item.turnRecords.length}}">· 暂无记录</view>
              </view>
              </view>
            </scroll-view>
          </view>
        </swiper-item>

        <!-- 当前轮次出牌卡：仅看他人时隐藏，只保留属于该玩家的纪要 -->
        <swiper-item class="card-swiper-item" wx:if="{{!isHistoryReview && showCurrentActionCard}}">
          <game-card-timer
            startedAt="{{partnerRoundStartedAt}}"
            timerActive="{{roundTimerVisible}}"
            durationSec="{{roundTimerMaxSec}}"
            loop="{{true}}"
            suppressCanvas="{{showHostStatementTip}}"
            borderVariant="{{isMasterMode ? 'rainbow' : ''}}"
            bind:timerexpire="handleRoundTimerExpire"
            wx:if="{{gamepagePhase === 'discussion'}}"
          >
            <view class="discussion-card-body">
              <view class="discussion-header-row">
                <view class="discussion-header-main">
                  <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
                  <text class="discussion-title">提出疑问并讨论</text>
                </view>
              </view>
              <view class="discussion-divider"></view>
              <scroll-view
                class="discussion-scroll"
                scroll-y
                enhanced
                show-scrollbar="{{true}}"
                scroll-into-view="{{discussionExpressChatAnchor}}"
                bindtouchstart="onInnerScrollTouchStart"
                bindtouchend="onInnerScrollTouchEnd"
                bindtouchcancel="onInnerScrollTouchEnd"
              >
                <view class="discussion-scroll-inner">
                  <!-- 出牌解释：仅出牌阶段匿名聊天 -->
                  <view class="card-section-block">
                    <view class="card-section-head">
                      <text class="card-section-title">出牌解释</text>
                    </view>
                    <view class="discussion-express-list" wx:if="{{playExpressChatList.length}}">
                      <view
                        class="spectator-chat-row"
                        wx:for="{{playExpressChatList}}"
                        wx:key="id"
                      >
                        <view class="spectator-chat-avatar-wrap">
                          <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                          <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                        </view>
                        <view class="spectator-chat-bubble">
                          <text class="spectator-chat-text">{{item.text}}</text>
                        </view>
                      </view>
                    </view>
                    <view class="spectator-chat-empty" wx:else>
                      <text class="spectator-chat-empty-text">暂无匿名表达</text>
                    </view>
                  </view>

                  <!-- 疑问讨论：讨论阶段匿名聊天 + 可插图 -->
                  <view class="card-section-block card-section-block-gap">
                    <view class="card-section-head">
                      <text class="card-section-title">疑问讨论</text>
                      <view
                        class="card-section-add"
                        data-target="discussion"
                        catchtap="onCardSectionAddImage"
                        wx:if="{{isHost}}"
                      >
                        <image
                          class="card-section-add-icon"
                          src="/assets/partnerMode/icon-insp-plus.svg"
                          mode="aspectFit"
                        />
                      </view>
                    </view>
                    <view class="card-section-flow" wx:if="{{discussionBlocks.length}}">
                      <block wx:for="{{discussionBlocks}}" wx:key="key">
                        <view wx:if="{{item.type === 'text'}}" class="card-bullet">· {{item.text}}</view>
                        <image
                          wx:elif="{{item.type === 'image'}}"
                          class="card-media-thumb card-media-thumb-flow"
                          src="{{item.url}}"
                          mode="aspectFill"
                          data-url="{{item.url}}"
                          data-scope="discussion"
                          catchtap="onCardImagePreview"
                        />
                      </block>
                    </view>
                    <view class="discussion-express-list" wx:if="{{discussionExpressChatList.length}}">
                      <view
                        class="spectator-chat-row"
                        wx:for="{{discussionExpressChatList}}"
                        wx:key="id"
                        id="discussion-express-{{item.id}}"
                      >
                        <view class="spectator-chat-avatar-wrap">
                          <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                          <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                        </view>
                        <view class="spectator-chat-bubble">
                          <text class="spectator-chat-text">{{item.text}}</text>
                        </view>
                      </view>
                      <view id="discussion-express-chat-bottom" style="height: 1rpx;"></view>
                    </view>
                    <view class="spectator-chat-empty" wx:elif="{{!discussionBlocks.length}}">
                      <text class="spectator-chat-empty-text">暂无匿名表达</text>
                    </view>
                  </view>
                </view>
              </scroll-view>

              <!-- 讨论阶段：表达入口统一在卡片右下角 -->
              <view
                wx:if="{{expressComposerOpen}}"
                class="express-dismiss-mask"
                catchtap="closeExpressComposer"
              ></view>
              <view class="card-express-corner {{expressComposerOpen ? 'card-express-corner-open' : ''}}">
                <form
                  wx:if="{{expressComposerOpen}}"
                  class="spectator-express-form"
                  bindsubmit="onExpressFormSubmit"
                >
                  <view class="spectator-express-composer">
                    <input
                      class="spectator-express-input"
                      name="expressText"
                      maxlength="40"
                      confirm-type="send"
                      hold-keyboard="{{true}}"
                      adjust-position="{{true}}"
                      cursor-spacing="24"
                      focus="{{expressComposerNeedFocus}}"
                      placeholder="说点什么…"
                      placeholder-class="spectator-express-placeholder"
                      bindfocus="onExpressComposerFocus"
                      bindconfirm="onExpressConfirm"
                      bindinput="onExpressInput"
                      bindblur="onExpressComposerBlur"
                    />
                    <button
                      class="express-form-submit-hidden"
                      form-type="submit"
                      hover-class="none"
                    ></button>
                  </view>
                </form>
                <view
                  wx:else
                  class="express-fab-btn"
                  catchtap="openExpressComposer"
                >
                  <image
                    class="express-fab-bubble"
                    src="/assets/partnerMode/icon-express-bubble.svg"
                    mode="aspectFit"
                  />
                </view>
              </view>
            </view>
          </game-card-timer>

          <game-card-timer
            startedAt="{{partnerRoundStartedAt}}"
            timerActive="{{roundTimerVisible}}"
            durationSec="{{roundTimerMaxSec}}"
            loop="{{true}}"
            suppressCanvas="{{showHostStatementTip}}"
            borderVariant="{{isMasterMode ? 'rainbow' : ''}}"
            bind:timerexpire="handleRoundTimerExpire"
            wx:else
          >
            <view class="action-card-wrap">
              <!-- 当前出牌玩家：出牌并解释（规则一屏内展示，禁止上下滚动） -->
              <view
                class="action-card-scroll"
                wx:if="{{isCurrentPlayer}}"
              >
                <view class="action-card-inner {{expressChatPanelVisible ? 'action-card-inner-express' : ''}}">
                  <view class="action-header {{isMasterMode ? 'action-header-master' : ''}}">
                    <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
                    <view class="action-title-block">
                      <view class="action-title-row" wx:if="{{isMasterMode}}">
                        <view class="master-mode-badge">MASTER模式</view>
                        <text class="action-title action-title-master">请进行卡牌行动并解释</text>
                      </view>
                      <text class="action-title" wx:else>出牌并解释</text>
                      <text class="action-desc">{{isMasterMode ? '您可以进行任意次行动，每次行动可以是以下任意一种' : (expressChatPanelVisible ? '您可以进行1—3次行动' : '您可以进行1—3次行动，1次行动可以是以下任意一种')}}</text>
                    </view>
                  </view>
                  <view class="action-divider"></view>

                  <!-- 点击表达：仅切换卡内内容为匿名聊天（Figma 5966:29140） -->
                  <view class="action-express-chat-body" wx:if="{{expressChatPanelVisible}}">
                    <scroll-view
                      class="action-express-chat"
                      scroll-y
                      enhanced
                      show-scrollbar="{{true}}"
                      scroll-into-view="{{expressChatAnchor}}"
                      bindtouchstart="onInnerScrollTouchStart"
                      bindtouchend="onInnerScrollTouchEnd"
                      bindtouchcancel="onInnerScrollTouchEnd"
                    >
                      <view
                        class="spectator-chat-row"
                        wx:for="{{expressChatList}}"
                        wx:key="id"
                        id="express-chat-{{item.id}}"
                      >
                        <view class="spectator-chat-avatar-wrap">
                          <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                          <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                        </view>
                        <view class="spectator-chat-bubble">
                          <text class="spectator-chat-text">{{item.text}}</text>
                        </view>
                      </view>
                      <view class="spectator-chat-empty" wx:if="{{!expressChatList.length}}">
                        <text class="spectator-chat-empty-text">暂无匿名表达</text>
                      </view>
                      <view id="express-chat-bottom" style="height: 1rpx;"></view>
                    </scroll-view>
                    <view class="action-express-chat-locked" wx:if="{{!expressCanSend}}">
                      <text class="action-express-chat-locked-text">本轮表态结束后可发送</text>
                    </view>
                  </view>

                  <!-- 行动规则固定展示 -->
                  <view class="action-rules-block" wx:else>
                    <view class="action-grid">
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">出 1 张卡牌</text>
                      </view>
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">删 1 张卡牌</text>
                      </view>
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">调整 1 张卡牌</text>
                      </view>
                      <view class="action-cell">
                        <view class="action-illus"></view>
                        <text class="action-cell-label">交换 2 张卡牌</text>
                      </view>
                    </view>
                  </view>

                </view>
              </view>

              <!-- 非出牌玩家：玩家正在出牌 -->
              <view class="spectator-card" wx:else>
                <view
                  wx:if="{{expressComposerOpen}}"
                  class="express-dismiss-mask"
                  catchtap="closeExpressComposer"
                ></view>
                <view class="spectator-card-head">
                  <text class="card-player-round">{{currentPlayerName}} · 第{{currentRound}}轮</text>
                  <text class="spectator-card-title">玩家正在出牌</text>
                  <text class="spectator-card-desc">您可以对该玩家的出牌进行表达或打分</text>
                </view>
                <view class="action-divider"></view>

                <!-- 匿名聊天区：外包一层定高，iOS 原生 scroll-view 才能滚 -->
                <view class="spectator-chat-wrap">
                <scroll-view
                  class="spectator-chat"
                  scroll-y
                  enhanced
                  show-scrollbar="{{true}}"
                  scroll-into-view="{{expressChatAnchor}}"
                  bindtouchstart="onInnerScrollTouchStart"
                  bindtouchend="onInnerScrollTouchEnd"
                  bindtouchcancel="onInnerScrollTouchEnd"
                >
                  <view
                    class="spectator-chat-row"
                    wx:for="{{expressChatList}}"
                    wx:key="id"
                    id="express-chat-{{item.id}}"
                  >
                    <view class="spectator-chat-avatar-wrap">
                      <image class="spectator-chat-avatar" src="{{item.avatar}}" mode="aspectFill" />
                      <view class="spectator-chat-avatar-dot" style="{{item.avatarDotStyle}}"></view>
                    </view>
                    <view class="spectator-chat-bubble">
                      <text class="spectator-chat-text">{{item.text}}</text>
                    </view>
                  </view>
                  <view class="spectator-chat-empty" wx:if="{{!expressChatList.length}}">
                    <text class="spectator-chat-empty-text">匿名表达会出现在这里</text>
                  </view>
                  <view id="express-chat-bottom" style="height: 1rpx;"></view>
                </scroll-view>
                </view>

                <view class="spectator-bottom-stack {{starRatingCollapsed ? 'spectator-bottom-stack-collapsed' : ''}} {{expressComposerOpen ? 'spectator-bottom-stack-composing' : ''}}">
                  <view class="spectator-express-slot spectator-express-slot-flow">
                    <form
                      wx:if="{{expressComposerOpen}}"
                      class="spectator-express-form"
                      bindsubmit="onExpressFormSubmit"
                    >
                      <view class="spectator-express-composer">
                        <input
                          class="spectator-express-input"
                          name="expressText"
                          maxlength="40"
                          confirm-type="done"
                          hold-keyboard="{{true}}"
                          adjust-position="{{true}}"
                          cursor-spacing="24"
                          focus="{{expressComposerNeedFocus}}"
                          placeholder="说点什么…"
                          placeholder-class="spectator-express-placeholder"
                          bindfocus="onExpressComposerFocus"
                          bindconfirm="onExpressConfirm"
                          bindinput="onExpressInput"
                          bindblur="onExpressComposerBlur"
                        />
                        <button
                          class="express-form-submit-hidden"
                          form-type="submit"
                          hover-class="none"
                        ></button>
                      </view>
                    </form>
                    <view
                      wx:else
                      class="spectator-express-fab-row"
                    >
                      <view
                        class="spectator-express-fab"
                        hover-class="spectator-express-fab-hover"
                        catchtap="openExpressComposer"
                      >
                        <image
                          class="spectator-express-fab-bubble"
                          src="/assets/partnerMode/icon-express-bubble.svg"
                          mode="aspectFit"
                        />
                      </view>
                    </view>
                  </view>

                  <view class="star-rating-shell {{starRatingCollapsed ? 'star-rating-shell-collapsed' : ''}}">
                    <view
                      class="star-rating-chip"
                      catchtap="onStarRatingChipTap"
                    >
                      <text class="star-rating-chip-text">已打分：{{scoredCount}}/{{totalRequired}}人</text>
                    </view>
                    <view class="star-rating-body">
                      <view class="star-rating-row">
                        <star-rating
                          value="{{selectedScore}}"
                          disabled="{{scoreSubmitting}}"
                          bind:preview="onStarRatingPreview"
                          bind:scoreconfirm="onStarRatingConfirm"
                          bind:gesturestart="onStarGestureStart"
                          bind:gestureend="onStarGestureEnd"
                        />
                      </view>
                    </view>
                  </view>
                </view>
              </view>

              <!-- 出牌玩家：同步显示打分进度（不可自评）；匿名表达入口在右下角 -->
              <view
                class="card-express-corner {{!expressChatPanelVisible ? 'card-express-corner-with-progress' : ''}}"
                wx:if="{{isCurrentPlayer}}"
              >
                <view
                  class="actor-score-chip"
                  wx:if="{{!expressChatPanelVisible}}"
                  catchtap="onStarRatingChipTap"
                >
                  <text class="star-rating-chip-text">已打分：{{scoredCount}}/{{totalRequired}}人</text>
                </view>
                <view
                  class="express-fab-btn"
                  catchtap="toggleExpressChatInCard"
                >
                  <image
                    class="express-fab-bubble"
                    src="{{expressChatPanelVisible ? '/assets/partnerMode/icon-express-view.png' : '/assets/partnerMode/icon-express-bubble.svg'}}"
                    mode="aspectFit"
                  />
                </view>
              </view>
            </view>
          </game-card-timer>
        </swiper-item>
      </swiper>

      <view class="card-pagination">
        <view class="pagination-dots">
          <view
            wx:for="{{paginationDots}}"
            wx:for-item="dot"
            wx:key="key"
            class="dot {{dot.sizeClass}} {{dot.active ? 'dot-active' : ''}}"
          ></view>
        </view>
        <text class="pagination-text">{{cardIndex + 1}}/{{cardCount}}</text>
      </view>
    </view>

    <!-- 灵感记录：图标进灵感空间 + 底栏快捷输入 -->
    <view
      class="inspiration-bar {{isHistoryReview ? 'inspiration-bar-history' : ''}} {{inspirationKeyboardHeight > 0 && isHistoryReview ? 'inspiration-bar-history-lifted' : ''}}"
      style="{{inspirationLiftStyle}}"
    >
      <view class="insp-icon-wrap" catchtap="handleGoInspirationCenter">
        <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
        <view class="insp-badge" wx:if="{{inspirationCount > 0}}">
          <text class="insp-badge-num">{{inspirationCount > 99 ? '99' : inspirationCount}}</text>
        </view>
      </view>
      <view class="inspiration-composer {{inspirationDraftPhotos.length ? 'inspiration-composer-with-photos' : ''}}">
        <scroll-view
          wx:if="{{inspirationDraftPhotos.length}}"
          class="inspiration-photo-strip"
          scroll-x
          enhanced
          show-scrollbar="{{false}}"
        >
          <view class="inspiration-photo-strip-inner">
            <view
              class="inspiration-photo-thumb-wrap"
              wx:for="{{inspirationDraftPhotos}}"
              wx:key="*this"
            >
              <image
                class="inspiration-photo-thumb"
                src="{{item}}"
                mode="aspectFill"
                catchtap="onInspirationPreviewPhoto"
                data-url="{{item}}"
              />
              <view
                class="inspiration-photo-remove"
                catchtap="onInspirationRemovePhoto"
                data-index="{{index}}"
              >×</view>
            </view>
          </view>
        </scroll-view>
        <view class="inspiration-row">
          <input
            class="inspiration-textarea"
            type="text"
            value="{{inspirationDraftText}}"
            hold-keyboard="{{inspirationHoldKeyboard}}"
            bindfocus="onInspirationFocus"
            bindblur="onInspirationBlur"
            bindinput="onInspirationInput"
            bindkeyboardheightchange="onInspirationKeyboardHeightChange"
            placeholder="记录您的灵感..."
            placeholder-class="inspiration-placeholder"
            maxlength="2000"
            confirm-type="done"
            adjust-position="{{false}}"
            cursor-spacing="12"
          />
          <view
            class="inspiration-action {{inspirationSaving ? 'inspiration-action-disabled' : ''}}"
            catchtap="onInspirationActionTap"
          >
            <image
              wx:if="{{inspirationHasText || inspirationDraftPhotos.length}}"
              class="inspiration-action-icon"
              src="/assets/partnerMode/icon-insp-send.svg"
              mode="aspectFit"
            />
            <image
              wx:else
              class="inspiration-action-icon"
              src="/assets/partnerMode/icon-insp-plus.svg"
              mode="aspectFit"
            />
          </view>
        </view>
      </view>
    </view>
  </block>
  </view>

  <!-- 底部操作：键盘升起时留在原位被盖住，并用透明度隐藏避免「浮在键盘上」 -->
  <view
    class="page-footer {{inspirationKeyboardHeight > 0 || closingKeyboardHeight > 0 ? 'page-footer-insp-hidden' : ''}}"
    wx:if="{{!isHistoryReview && !((gamepagePhase === 'closing' || gamepagePhase === 'discussion') && !isHost)}}"
  >
    <view class="bottom-actions" wx:if="{{gamepagePhase === 'closing' && closingStep === 'rune' && isHost}}">
      <button
        class="closing-next-btn"
        bindtap="handleClosingNextStep"
      >
        下一步
      </button>
    </view>
    <view class="bottom-actions" wx:elif="{{gamepagePhase === 'closing' && closingStep === 'review' && isHost}}">
      <button
        class="end-brainstorm-btn"
        bindtap="handleEndBrainstorm"
      >
        结束脑暴
      </button>
    </view>
    <view class="bottom-actions bottom-actions-discussion" wx:elif="{{gamepagePhase === 'discussion' && isHost}}">
      <button
        class="end-discussion-btn {{discussionSwitching && discussionSwitchAction === 'end' ? 'end-discussion-btn-loading' : ''}}"
        disabled="{{discussionSwitching}}"
        loading="{{discussionSwitching && discussionSwitchAction === 'end'}}"
        hover-class="none"
        bindtap="handleEndDiscussion"
      >
        {{discussionSwitching && discussionSwitchAction === 'end' ? '处理中' : '结束讨论'}}
      </button>
      <button
        class="end-discussion-btn end-discussion-btn-secondary {{discussionSwitching && discussionSwitchAction === 'allPass' ? 'end-discussion-btn-loading' : ''}}"
        disabled="{{discussionSwitching}}"
        loading="{{discussionSwitching && discussionSwitchAction === 'allPass'}}"
        hover-class="none"
        bindtap="handleAllPassFromDiscussion"
      >
        {{discussionSwitching && discussionSwitchAction === 'allPass' ? '处理中' : '全部通过'}}
      </button>
    </view>
    <view class="bottom-actions" wx:elif="{{showSpecialMoveBtn || isHost || (isCurrentPlayer && gamepagePhase !== 'discussion' && gamepagePhase !== 'closing')}}">
      <!-- 特殊行动：出牌阶段轮到谁，谁显示；房主非本人出牌时不显示 -->
      <view
        wx:if="{{showSpecialMoveBtn || (isCurrentPlayer && gamepagePhase !== 'discussion' && gamepagePhase !== 'closing')}}"
        class="special-btn-wrap {{isHost ? '' : 'special-btn-wrap-alone'}}"
      >
        <view
          wx:if="{{specialMoveUsedThisTurn || isMasterMode}}"
          class="special-btn special-btn-used"
        >
          <text class="special-btn-line">特殊</text>
          <text class="special-btn-line">行动</text>
          <image
            class="special-btn-used-check"
            src="/assets/partnerMode/icon-special-used-check.svg"
            mode="aspectFit"
          />
        </view>
        <button
          wx:else
          class="special-btn"
          hover-class="none"
          catchtap="onTapSpecialMove"
        >
          <text class="special-btn-line">特殊</text>
          <text class="special-btn-line">行动</text>
        </button>
      </view>
      <view class="bottom-actions-gap" wx:if="{{(showSpecialMoveBtn || isCurrentPlayer) && isHost && gamepagePhase !== 'discussion' && gamepagePhase !== 'closing'}}"></view>
      <view class="statement-btn-wrap" wx:if="{{isHost}}" id="hostStatementBtn">
        <button
          class="statement-btn {{canStartStatement && !statementSwitching ? 'statement-btn-enabled' : ''}} {{statementSwitching ? 'statement-btn-loading' : ''}}"
          disabled="{{!canStartStatement || statementSwitching}}"
          loading="{{statementSwitching}}"
          hover-class="none"
          bindtap="handleStartStatement"
        >
          {{statementSwitching ? '进入中' : '表态并讨论'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 房主首次进入：轻量单行提示（透明热区，任意处可关） -->
  <view
    class="host-statement-tip-layer"
    wx:if="{{showHostStatementTip}}"
    catchtouchmove="preventMove"
    catchtap="dismissHostStatementTip"
  >
    <view
      class="host-statement-tip-bubble"
      wx:if="{{hostStatementTipReady}}"
      style="{{hostStatementTipTextStyle}}"
      catchtap="dismissHostStatementTip"
    >
      <text class="host-statement-tip-text">全员打分后，「表态并讨论」才会亮起</text>
      <view class="host-statement-tip-arrow"></view>
    </view>
  </view>

</view>

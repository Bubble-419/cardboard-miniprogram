.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0faf0 0%, #fafafa 60%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 48rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.end-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 80rpx 48rpx 64rpx;
  box-shadow: 0 16rpx 48rpx rgba(94, 193, 89, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.end-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #e9f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.end-icon {
  font-size: 80rpx;
  line-height: 1;
}

.end-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.end-subtitle {
  font-size: 30rpx;
  color: #747474;
  margin-bottom: 40rpx;
}

.end-divider {
  width: 120rpx;
  height: 4rpx;
  background: #e9f5e9;
  border-radius: 2rpx;
  margin-bottom: 0;
}

.footer {
  z-index: 100;
  padding: 24rpx 54rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top,
    rgba(240, 250, 240, 0.98) 55%,
    rgba(240, 250, 240, 0) 100%);
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  background-color: #c8e6c8;
  color: #8cbf8c;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 500;
  border: none;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: normal;
  box-sizing: border-box;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.enabled {
  background: linear-gradient(135deg, #5ec159, #4db84a);
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(94, 193, 89, 0.38);
}

.confirm-btn.enabled:active {
  opacity: 0.9;
}

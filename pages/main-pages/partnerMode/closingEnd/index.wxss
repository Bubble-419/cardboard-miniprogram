.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0faf0 0%, #fafafa 60%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.end-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 80rpx 48rpx 64rpx;
  box-shadow: 0 16rpx 48rpx rgba(94, 193, 89, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.end-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #e9f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.end-icon {
  font-size: 80rpx;
  line-height: 1;
}

.end-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.end-subtitle {
  font-size: 30rpx;
  color: #747474;
  margin-bottom: 40rpx;
}

.end-divider {
  width: 120rpx;
  height: 4rpx;
  background: #e9f5e9;
  border-radius: 2rpx;
  margin-bottom: 40rpx;
}

.end-hint {
  font-size: 28rpx;
  color: #9a9a9a;
}

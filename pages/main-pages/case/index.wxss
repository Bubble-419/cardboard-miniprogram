/* ===== 全局容器 ===== */
.container {
  background-color: #FFFFFF;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===== 滚动区域 ===== */
.main-scroll {
  width: 100%;
  overflow: hidden;
}

/* MainContent: 对齐 selectProblem 的视觉（用 main-content 自带 padding） */
.main-content {
  padding: 30rpx 40rpx 192rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* ===== Header Section（TopBar + 情境格合为一组） ===== */
.header-section {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
}

.title-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #509D59;
  line-height: 72rpx;
}

.page-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #6B7280;
  line-height: 40rpx;
}

/* ===== 问题列表（卡片框） ===== */
.problem-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.problem-item {
  background-color: #F3F3F3;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  padding: 30rpx 24rpx 30rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
  box-sizing: border-box;
}

.problem-item:active {
  opacity: 0.95;
}

.problem-indicator {
  width: 8rpx;
  min-height: 60rpx;
  align-self: stretch;
  border-radius: 4rpx;
  background-color: rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.problem-body {
  flex: 1;
  min-width: 0;
  align-self: center;
  overflow: hidden;
}

.problem-text {
  width: 100%;
  font-size: 28rpx;
  font-weight: 400;
  color: #999999;
  line-height: 1.4;
  display: block;
  white-space: normal;
  word-break: break-all;
  overflow-wrap: anywhere;
}

/* 适配固定底栏：给左右留出与页面一致的内边距 */
.footer {
  padding: 0 40rpx;
}


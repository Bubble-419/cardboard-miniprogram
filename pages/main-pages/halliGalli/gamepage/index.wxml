<view class="container">
  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">

    <!-- 顶部：房间入口+头像堆叠 + 情境格子 -->
    <view class="header-section">
      <player-top-bar
        avatarList="{{avatarList}}"
        maxVisible="{{5}}"
        enableAdd="{{true}}"
        bind:goroom="handleGoRoom"
        bind:addtap="handleGoBack"
      />

      <!-- 情境展示 -->
      <context-display bg="{{selectedBG}}" />
    </view>

    <!-- 规则说明区 -->
    <view class="rules-section">

      <!-- 标题 -->
      <view class="rules-header">
        <text class="rules-title">规则说明</text>
        <text class="rules-subtitle">开始前，先快速了解本轮玩法</text>
      </view>

      <!-- 步骤卡片组 -->
      <view class="steps-card">

        <!-- 第 1 行：步骤 1 & 2 -->
        <view class="steps-row">
          <view class="step-wrap">
            <view class="step-card">
              <image class="step-img" src="{{stepImgDeal}}" data-key="deal" binderror="onStepImgError" mode="aspectFill" />
              <view class="step-text-col">
                <text class="step-title">发牌</text>
                <text class="step-desc">每位玩家获得3张交互方式卡</text>
              </view>
            </view>
            <view class="step-badge"><text class="step-num">1</text></view>
          </view>
          <image class="arrow-h" src="/assets/halliGalli/icon-arrow-h.svg" mode="aspectFit" />
          <view class="step-wrap">
            <view class="step-card">
              <image class="step-img" src="{{stepImgFlip}}" data-key="flip" binderror="onStepImgError" mode="aspectFill" />
              <view class="step-text-col">
                <text class="step-title">翻牌</text>
                <text class="step-desc">展示本轮控件形态卡</text>
              </view>
            </view>
            <view class="step-badge"><text class="step-num">2</text></view>
          </view>
        </view>

        <!-- 向下箭头 -->
        <view class="arrow-down-row">
          <image class="arrow-down" src="/assets/halliGalli/icon-arrow-down.svg" mode="widthFix" />
        </view>

        <!-- 第 2 行：步骤 3 & 4 -->
        <view class="steps-row">
          <view class="step-wrap">
            <view class="step-card">
              <image class="step-img" src="{{stepImgRing}}" data-key="ring" binderror="onStepImgError" mode="aspectFill" />
              <view class="step-text-col">
                <text class="step-title">抢铃</text>
                <text class="step-desc">准备完成后抢铃争取出牌权</text>
              </view>
            </view>
            <view class="step-badge"><text class="step-num">3</text></view>
          </view>
          <image class="arrow-h" src="/assets/halliGalli/icon-arrow-h.svg" mode="aspectFit" />
          <view class="step-wrap">
            <view class="step-card">
              <image class="step-img" src="{{stepImgPlay}}" data-key="play" binderror="onStepImgError" mode="aspectFill" />
              <view class="step-text-col">
                <text class="step-title">出牌</text>
                <text class="step-desc">说明如何与情境信息结合</text>
              </view>
            </view>
            <view class="step-badge"><text class="step-num">4</text></view>
          </view>
        </view>

        <!-- 向下箭头 -->
        <view class="arrow-down-row">
          <image class="arrow-down" src="/assets/halliGalli/icon-arrow-down.svg" mode="widthFix" />
        </view>

        <!-- 第 3 行：步骤 5 & 6 -->
        <view class="steps-row">
          <view class="step-wrap">
            <view class="step-card">
              <image class="step-img" src="{{stepImgVote}}" data-key="vote" binderror="onStepImgError" mode="aspectFill" />
              <view class="step-text-col">
                <text class="step-title">表决</text>
                <text class="step-desc">其他玩家投票或提问评分</text>
              </view>
            </view>
            <view class="step-badge"><text class="step-num">5</text></view>
          </view>
          <image class="arrow-h" src="/assets/halliGalli/icon-arrow-h.svg" mode="aspectFit" />
          <view class="step-wrap">
            <view class="step-card">
              <image class="step-img" src="{{stepImgJudge}}" data-key="judge" binderror="onStepImgError" mode="aspectFill" />
              <view class="step-text-col">
                <text class="step-title">判定</text>
                <text class="step-desc">半数通过即成功，否则失败并摸1张牌</text>
              </view>
            </view>
            <view class="step-badge"><text class="step-num">6</text></view>
          </view>
        </view>
      </view>

      <!-- 规则重点高亮块 -->
      <view class="key-highlight">
        <view class="key-icon-wrap">
          <image class="key-icon" src="/assets/halliGalli/icon-rules-key.svg" mode="aspectFit" />
        </view>
        <view class="key-para">
          <text class="key-line-green">规则重点：超过半数通过=成功；</text>
          <text class="key-line-dark">未通过=失败并从公区摸 1 张牌</text>
        </view>
      </view>
    </view>

    <!-- 底部占位，防止内容被固定按钮遮挡 -->
    <view class="footer-placeholder" wx:if="{{isHost}}"></view>

  </scroll-view>

  <!-- 底部：结束游戏（仅房主），固定悬浮在底部 -->
  <view class="footer-section" wx:if="{{isHost}}">
    <button class="end-game-btn" bindtap="handleEndGame">结束游戏</button>
  </view>
</view>

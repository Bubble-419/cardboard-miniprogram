<view class="container">
  <!-- 悬浮导航：padding 由 JS 动态计算，避免真机顶部留白过多 -->
  <view class="custom-navbar" style="padding-top: {{navbarPaddingTop}}px">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        />
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right" />
    </view>
  </view>

  <!-- 顶部玩家列表 -->
  <view class="section top-section" style="padding-top: {{contentOffsetTop}}px">
    <user-list
      avatarList="{{avatarList}}"
      currentUser=""
      enableAdd="{{false}}"
      isFold="{{true}}"
    />
    <view
      class="scenario-wrap"
      wx:if="{{selectedBG && (selectedBG.scene || selectedBG.user || selectedBG.function)}}"
    >
      <view class="scenario-track">
        <view class="scenario-chip" wx:if="{{selectedBG.scene}}">
          <text class="scenario-chip-label">场景</text>
          <text class="scenario-chip-text">{{selectedBG.scene}}</text>
        </view>
        <view class="scenario-chip" wx:if="{{selectedBG.user}}">
          <text class="scenario-chip-label">用户</text>
          <text class="scenario-chip-text">{{selectedBG.user}}</text>
        </view>
        <view class="scenario-chip" wx:if="{{selectedBG.function}}">
          <text class="scenario-chip-label">功能</text>
          <text class="scenario-chip-text">{{selectedBG.function}}</text>
        </view>
        <view class="scenario-spacer"></view>
      </view>
    </view>
  </view>

  <!-- 中部出牌展示区 -->
  <view class="section card-section">
    <view class="card-container">
      <image
        class="card-bg-img"
        src="{{bgImageSrc}}"
        mode="widthFix"
        binderror="onBgImageError"
      />
    </view>
  </view>

  <!-- 底部操作区：房主结束游戏 -->
  <view class="section bottom-section" wx:if="{{isHost}}">
    <button class="end-game-btn" bindtap="handleEndGame">结束游戏</button>
  </view>
</view>

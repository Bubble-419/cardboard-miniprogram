/* ===== 容器：整页一屏，底栏进文档流 ===== */
.container {
  height: 100vh;
  min-height: 100vh;
  background-color: #FAFAFA;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.page-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.page-body.is-fit {
  overflow: hidden;
}

.page-body.is-scrollable {
  overflow-x: hidden;
  overflow-y: auto;
}

/* 固定顶栏：贴页顶；状态栏由 player-top-bar.padTop 负责 */
.topbar-fixed {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
}

/* ===== 顶部区（情境） ===== */
.header-section {
  flex-shrink: 0;
  padding: 0 32rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* Topbar */
.topbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

/* 房间页入口图标（左侧） */
.room-entry {
  width: 74rpx;
  height: 74rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

/* 添加成员按钮（右侧） */
.add-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background-color: #F3F4F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.add-btn:active {
  opacity: 0.75;
}

.add-btn-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 头像列表容器 */
.avatar-bar {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: visible;
}

/* ===== 规则说明区 ===== */
.rules-section {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
}

.rules-header {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rules-title {
  font-size: 48rpx;
  font-weight: 500;
  color: #1F2937;
  line-height: 56rpx;
}

.rules-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #9CA3AF;
  line-height: 34rpx;
}

/* ===== 步骤卡片组：吃满剩余高度 ===== */
.steps-card {
  flex: 1;
  min-height: 0;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 16rpx;
  box-shadow: 0px 8rpx 40rpx 0px rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.steps-grid {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr 1fr;
  gap: 12rpx;
  width: 100%;
  height: 100%;
}

/* ===== 干瞪眼四步规则 ===== */
.gan-steps-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 24rpx;
}

.gan-step-card {
  min-width: 0;
  overflow: hidden;
  background: #FFFFFF;
  border: 2rpx solid #DCEFD8;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(40, 119, 35, 0.08);
  display: flex;
  align-items: stretch;
}

.gan-step-image-wrap {
  position: relative;
  width: 220rpx;
  flex-shrink: 0;
  background: #F4FFF4;
}

.gan-step-img {
  display: block;
  width: 100%;
  height: 220rpx;
}

.gan-step-copy {
  min-width: 0;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.gan-step-copy .step-title {
  font-size: 30rpx;
  line-height: 40rpx;
}

.gan-step-copy .step-desc {
  font-size: 22rpx;
  line-height: 32rpx;
  word-break: normal;
  text-align: justify;
}

/* 单个步骤外层（card + badge 叠加） */
.step-wrap {
  position: relative;
  min-width: 0;
  min-height: 0;
  height: 100%;
}

/* 步骤卡片：底色贴近插图浅绿底，避免露白 */
.step-card {
  position: relative;
  background: #EAF6E8;
  border: 2rpx solid #5EC159;
  border-radius: 20rpx;
  padding: 0;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.step-img-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 8rpx 52rpx;
  box-sizing: border-box;
  background: transparent;
}

.step-img {
  display: block;
  width: 94%;
  height: 94%;
  border-radius: 14rpx;
  background: transparent;
}

.step-text-col {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  padding: 28rpx 12rpx 10rpx;
  box-sizing: border-box;
  background: linear-gradient(
    180deg,
    rgba(234, 246, 232, 0) 0%,
    rgba(234, 246, 232, 0.55) 50%,
    rgba(234, 246, 232, 0.92) 100%
  );
}

.step-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #287723;
  line-height: 34rpx;
}

.step-desc {
  font-size: 20rpx;
  font-weight: 400;
  color: #6B7280;
  line-height: 28rpx;
  word-break: break-word;
  overflow-wrap: anywhere;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 步骤序号徽章 */
.step-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 9999rpx;
  background: #5EC159;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.step-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}

/* ===== 规则重点高亮块 ===== */
.key-highlight {
  flex-shrink: 0;
  background: #F2FAF5;
  border: 2rpx solid #E1F2E8;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.key-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: #5EC159;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.key-icon {
  width: 36rpx;
  height: 36rpx;
}

.key-para {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.key-line-green {
  font-size: 24rpx;
  font-weight: 500;
  color: #45AD59;
  line-height: 34rpx;
}

.key-line-dark {
  font-size: 24rpx;
  font-weight: 500;
  color: #374151;
  line-height: 34rpx;
}

/* ===== 底部按钮：文档流占位，不遮挡说明内容 ===== */
.footer-section {
  flex-shrink: 0;
  padding: 12rpx 40rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.end-game-btn {
  width: 100%;
  max-width: 680rpx;
  height: 96rpx;
  font-size: 40rpx;
  font-weight: 400;
  color: #FFFFFF;
  background-color: #5EC159;
  border-radius: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.0909em;
  white-space: nowrap;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.end-game-btn::after {
  border: none;
}

.end-game-btn:active {
  opacity: 0.9;
}

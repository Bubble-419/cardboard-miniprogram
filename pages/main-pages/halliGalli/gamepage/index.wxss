.container {
  height: 100vh;
  min-height: 100vh;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #ffffff;
}

.navbar-content {
  height: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  flex: 1;
  text-align: center;
}

.navbar-right {
  width: 80rpx;
}

.section {
  padding: 0 24rpx;
}

.top-section {
  background-color: #fff;
  padding-bottom: 8rpx;
  flex-shrink: 0;
}

.scenario-wrap {
  margin-top: 12rpx;
  width: 100%;
}

.scenario-track {
  width: 100%;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8px;
}

.scenario-chip {
  flex: 0 0 auto;
  min-height: 56rpx;
  padding: 0 2.4vw;
  border: 2rpx solid #5EC159;
  border-radius: 999rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 0;
}

.scenario-chip-label {
  font-size: 24rpx;
  color: #5EC159;
  font-weight: 600;
}

.scenario-chip-text {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #2d7e2b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.scenario-spacer {
  flex: 1 1 auto;
  min-width: 0;
}

.card-section {
  flex: 1;
  min-height: 0;
  padding: 0rpx 24rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-container {
  width: 100%;
  max-height: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.card-bg-img {
  width: 100%;
  max-height: 100%;
  height: auto;
  display: block;
}

.bottom-section {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: transparent;
}

.end-game-btn {
  width: 100%;
  height: 96rpx;
  font-size: 36rpx;
  font-weight: 500;
  color: #ffffff;
  background-color: #5EC159;
  border-radius: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
}

.end-game-btn::after {
  border: none;
}

.end-game-btn:active {
  opacity: 0.9;
}

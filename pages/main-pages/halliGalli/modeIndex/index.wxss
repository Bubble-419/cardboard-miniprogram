.container {
  min-height: 100vh;
  background: #f8fbfa;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.content {
  padding: 120rpx 54rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.placeholder-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5ec159;
  margin-bottom: 24rpx;
}

.placeholder-desc {
  font-size: 28rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
}

.placeholder-note {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  line-height: 1.6;
}

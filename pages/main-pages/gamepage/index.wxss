.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #fff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  flex: 1;
  text-align: center;
}

.navbar-right {
  width: 80rpx;
}

/* 顶部玩家列表 */
.section {
  padding: 0 24rpx;
}

.top-section {
  background-color: #fff;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

/* 中部出牌展示区：灰底容器 */
.card-section {
  flex: 1;
  padding: 24rpx;
  min-height: 320rpx;
}

.card-container {
  width: 100%;
  height: 100%;
  min-height: 320rpx;
  background-color: #e8e8e8;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.card-img {
  width: 100%;
  height: 100%;
  min-height: 320rpx;
}

.card-placeholder {
  padding: 48rpx;
  text-align: center;
}

.card-placeholder-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部评分与操作区：与 card-section 同宽（padding 24rpx） */
.bottom-section {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: transparent;
}

/* 打分区域：白色圆角卡片，与 aaatest 灰底容器同宽，浅灰描边/阴影 */
.score-card {
  width: 100%;
  background-color: #fff;
  border-radius: 32rpx;
  border: 2rpx solid #e8e8e8;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  padding: 36rpx 28rpx 40rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

/* 顶部信息栏：左右分布，绿色文案 */
.score-info-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.score-info-title,
.score-info-progress {
  font-size: 30rpx;
  font-weight: 500;
  color: #00a84a;
}

.score-info-title {
  flex: 0 1 auto;
}

.score-info-progress {
  flex: 0 0 auto;
}

/* 评分按钮区：6 个等宽横向排列，固定间距 */
.score-row {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
}

.score-btn {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  background-color: #e8f5e9;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
}

.score-btn-inner {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: flex-end;
}

/* 数字大号加粗绿色，分字小号位于数字右下 */
.score-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2e7d32;
  line-height: 1.1;
}

.score-unit {
  font-size: 22rpx;
  color: #2e7d32;
  line-height: 1;
  margin-top: 2rpx;
}

/* 自己的打分轮次：置灰不可选 */
.score-btn-disabled {
  background-color: #e0e0e0 !important;
  opacity: 0.6;
}

.score-btn-disabled .score-num,
.score-btn-disabled .score-unit {
  color: #999 !important;
}

/* 选中态：高饱和绿底、白色文字 */
.score-btn-active {
  background-color: #00a84a;
}

.score-btn-active .score-num,
.score-btn-active .score-unit {
  color: #fff;
}

/* 底部操作区：结束游戏（左）+ 开始表态（右） */
.action-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}

.end-game-btn {
  flex: 0 0 auto;
  width: 120rpx;
  height: 88rpx;
  background-color: #e8f5e9;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
}

.end-game-line {
  font-size: 26rpx;
  font-weight: 500;
  color: #00a84a;
  line-height: 1.35;
}

.action-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  background-color: #00d468;
  border-radius: 16rpx;
  border: none;
}

.action-btn-disabled {
  background-color: #c8e6c9;
  color: #fff;
}

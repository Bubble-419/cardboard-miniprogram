/* ===== 全局容器 ===== */
/* Figma: bg #FFFFFF */
.container {
  background-color: #FFFFFF;
  min-height: 100vh;
}

/* ===== 滚动区域 ===== */
.main-scroll {
  width: 100%;
  overflow: hidden;
}

/* MainContent: Figma padding 30px 20px 96px → 60rpx 40rpx 192rpx, gap 15px → 30rpx */
.main-content {
  padding: 0 40rpx 192rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* ===== Header Section（TopBar + 情境格合为一组，gap 12px → 24rpx） ===== */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 24rpx;
}

/* TopBar: Figma row, fill, alignItems center */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

/* 房间入口图标: Figma 37.14×37.14px → 74rpx */
.room-entry {
  flex-shrink: 0;
}

.room-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

/* 堆叠头像列表 */
.avatar-bar {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
  overflow: visible;
}

/* ===== 标题区 ===== */
/* Figma TitleSection gap: 12px → 24rpx（与主 gap 相同，通过外层控制） */
.title-section {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Figma: fontSize 24px → 48rpx, lineHeight 36px → 72rpx, #509D59, Bold 700 */
.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #509D59;
  line-height: 72rpx;
}

/* Figma: fontSize 12px → 24rpx, lineHeight 20px → 40rpx, #6B7280, Medium 500 */
.page-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #6B7280;
  line-height: 40rpx;
}

/* ===== 问题列表 ===== */
/* Figma ProblemList gap: 8px → 16rpx */
.problem-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 问题卡片（普通态）: Figma padding 15px 12px 15px 16px → 30rpx 24rpx 30rpx 32rpx
   gap 16px → 32rpx, border-radius 12px → 24rpx, bg #F3F3F3 */
.problem-item {
  background-color: #F3F3F3;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  padding: 30rpx 24rpx 30rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
  box-sizing: border-box;
}

/* 选中态: bg #F2F4F1, border #5EC159 1px → 2rpx */
.problem-item.selected {
  background-color: #F2F4F1;
  border-color: #5EC159;
}

.problem-item:active:not(.readonly) {
  opacity: 0.88;
}

.problem-item.readonly:active {
  opacity: 1;
}

/* 左侧竖线: Figma 0×30px + stroke 4px → 8rpx×60rpx */
.problem-indicator {
  width: 8rpx;
  height: 60rpx;
  border-radius: 4rpx;
  background-color: rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.indicator-selected {
  background-color: #5EC159;
}

/* 问题主体 */
.problem-body {
  flex: 1;
  min-width: 0;
  align-self: center;
}

/* Figma: 14px Regular 400, lineHeight 1.2em, #999999 */
.problem-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #999999;
  line-height: 1.2;
  display: block;
}

.problem-text-mine {
  color: #575757;
}

.problem-item.selected .problem-text {
  color: #575757;
}

/* Textarea 编辑态：高度由 JS 测量锁定，与展示态文字一致 */
.problem-textarea {
  width: 100%;
  font-size: 28rpx;
  font-weight: 400;
  color: #575757;
  line-height: 1.2;
  background: transparent;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  overflow: hidden;
}

/* 右侧图标区 */
.problem-right {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: center;
}

.right-icon-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Figma: 24×24px → 48rpx */
.right-icon {
  width: 48rpx;
  height: 48rpx;
}

.right-icon-placeholder {
  width: 48rpx;
  height: 48rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 80rpx 20rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ===== 底部确认按钮 =====
   Figma: padding 20px → 40rpx
   Button: 315.66×44.56px → ~632rpx×90rpx, border-radius 11.14px → 22rpx, bg #5EC159 */
.footer {
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4px);
}

/* 按钮宽度由 page-footer 并排布局控制 */
.confirm-btn {
  width: 100%;
  max-width: none;
  height: 90rpx;
  background-color: #5EC159;
  color: #FFFFFF;
  border-radius: 22rpx;
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.confirm-btn:active {
  opacity: 0.85;
}

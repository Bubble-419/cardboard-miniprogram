/* ===== 全局容器 ===== */
.container {
  background-color: #FAFAFA;
}

/* ===== 滚动区域 ===== */
.main-scroll {
  width: 100%;
  overflow: hidden;
}

/* MainContent: Figma padding = 30px 20px 96px → 60rpx 40rpx 192rpx */
.main-content {
  padding: 0 40rpx 192rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* Figma gap 12px → 24rpx */
}

/* ===== 顶部头像栏 ===== */
.header-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.room-entry {
  width: 74rpx;
  height: 74rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

.header-user-list {
  flex: 1;
  min-width: 0;
  overflow: visible;
}

/* 添加成员按钮: padding-left 8px→16rpx, 内圆 40×40px→80×80rpx */
.add-member-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background-color: #F3F4F6;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-member-icon {
  width: 48rpx;
  height: 48rpx;
}

/* ===== 情境标签区 ===== */
/* Figma: grid 2×2, gap 4px → 8rpx */
.context-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
}

/* Figma EL-d18e22f2: row, padding 2px 16px → 4rpx 32rpx, border-radius 16px → 32rpx */
.context-item {
  background-color: #E9F5E9;
  border: 2rpx solid #68D062;
  border-radius: 32rpx;
  padding: 4rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* Figma: fontSize 10px→20rpx, lineHeight 15px→30rpx, #5EC159 */
.context-label {
  font-size: 20rpx;
  font-weight: 500;
  color: #5EC159;
  line-height: 30rpx;
}

/* Figma: fontSize 12px→24rpx, lineHeight 16px→32rpx, #1E293B */
.context-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #1E293B;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 标题区 ===== */
.title-section {
  display: flex;
  flex-direction: column;
}

/* Figma: fontSize 24px→48rpx, lineHeight 36px→72rpx, #111827, weight 500 */
.page-title {
  font-size: 48rpx;
  font-weight: 500;
  color: #111827;
  line-height: 72rpx;
}

/* Figma: fontSize 12px→24rpx, lineHeight 20px→40rpx, #6B7280, weight 500 */
.page-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #6B7280;
  line-height: 40rpx;
}

/* ===== 问题列表 ===== */
/* Figma ProblemList gap: 8px → 16rpx */
.problem-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* Figma 问题卡片: padding 15px 12px 15px 16px → 30rpx 24rpx 30rpx 32rpx
   gap 16px → 32rpx, border-radius 12px → 24rpx */
.problem-item {
  background-color: #F3F3F3;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  padding: 30rpx 24rpx 30rpx 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
  box-sizing: border-box;
}

.problem-item.selected {
  background-color: #F2F4F1;
  border-color: #5EC159;
}

/* 编辑态顶对齐，保证 textarea 高度变化时不乱排 */
.problem-item.editing {
  align-items: flex-start;
}

.problem-item:active:not(.readonly) {
  opacity: 0.88;
}

.problem-item.readonly {
  opacity: 0.92;
}

/* 左侧竖线: Figma 0×30px + stroke 4px → 8rpx×60rpx */
.problem-indicator {
  width: 8rpx;
  height: 60rpx;
  border-radius: 4rpx;
  background-color: rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.problem-indicator.selected {
  background-color: #5EC159;
}

/* 问题主体 */
.problem-body {
  flex: 1;
  min-width: 0;
  align-self: center;
}

/* 编辑态时主体顶对齐 */
.problem-item.editing .problem-body {
  align-self: flex-start;
}

/* Figma 问题文字: 14px→28rpx, lineHeight 1.2em, #999999 */
.problem-text {
  font-size: 28rpx;
  font-weight: 400;
  color: #999999;
  line-height: 1.2;
  display: block;
}

.problem-text-mine {
  color: #575757;
}

.problem-item.selected .problem-text {
  color: #575757;
}

/* ===== Textarea 编辑态 =====
   高度完全由 JS（bindlinechange + onEditProblem 预计算）控制，
   通过 style="height: Xpx" 内联传入，不使用 auto-height 属性，
   避免微信原生 textarea 初始渲染时的高度跳变。 */
.problem-textarea {
  width: 100%;
  font-size: 28rpx;
  font-weight: 400;
  color: #575757;
  line-height: 1.2;
  background: transparent;
  padding: 0;
  margin: 0;
}

/* 右侧图标区 */
.problem-right {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  align-self: center;
}

.problem-item.editing .problem-right {
  align-self: flex-start;
  padding-top: 4rpx;
}

.right-icon-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.right-icon {
  width: 48rpx;
  height: 48rpx;
}

.right-icon-placeholder {
  width: 48rpx;
  height: 48rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 80rpx 20rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ===== 底部确认按钮 =====
   Figma: padding 20px → 40rpx, fill rgba(255,255,255,0.9), blur 2px
   Button: 315.66×44.56px, border-radius 11.14px */
.footer {
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4px);
}

/* 按钮宽度由 page-footer 并排布局控制 */
.confirm-btn {
  width: 100%;
  max-width: none;
  height: 90rpx; /* 44.56px × 2 ≈ 89rpx */
  background-color: #5EC159;
  color: #FFFFFF;
  border-radius: 22rpx; /* 11.14px × 2 ≈ 22rpx */
  font-size: 40rpx; /* 20.42px × 2 ≈ 41rpx */
  font-weight: 400;
  letter-spacing: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.confirm-btn:active {
  opacity: 0.85;
}

<view class="container">

  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{scrollHeight}}px">
    <view class="main-content" style="padding-top: {{contentPaddingTop}}px">

      <!-- 顶部：TopBar + 情境格 -->
      <view class="header-section">

        <!-- TopBar：房间入口 + 堆叠头像 + 添加按钮 -->
        <view class="topbar">
          <view class="room-entry" bindtap="handleGoRoom">
            <image class="room-entry-icon" src="/assets/icons/icon-room-entry.svg" mode="aspectFit" />
          </view>
          <view class="avatar-stack">
            <view
              class="avatar-frame {{item.isMe ? 'avatar-me' : ''}}"
              wx:for="{{avatarList}}"
              wx:key="id"
              style="margin-left: {{index > 0 ? '-16rpx' : '0'}}"
            >
              <image class="avatar-img" src="{{item.avatarImage}}" mode="aspectFill" />
            </view>
          </view>
          <view class="add-btn">
            <image class="add-btn-icon" src="/assets/modeIndex/icon-plus.svg" mode="aspectFit" />
          </view>
        </view>

        <!-- 情境展示 -->
        <context-display items="{{categories}}" />
      </view>

      <!-- 标题区 -->
      <view class="title-section">
        <text class="page-title" wx:if="{{isHost}}">选择设计问题</text>
        <text class="page-title" wx:else>等待房主选择设计问题</text>
        <text class="page-subtitle" wx:if="{{isHost}}">房主可以对设计问题进行选择、编辑</text>
        <text class="page-subtitle" wx:else>可修改自己提交的问题，等待房主选择</text>
      </view>

      <!-- 设计问题列表 -->
      <view class="problem-list">
        <view
          class="problem-item {{item.selected ? 'selected' : ''}} {{editingProblemId === item.id ? 'editing' : ''}} {{!isHost && !item.isMine ? 'readonly' : ''}}"
          wx:for="{{problems}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectProblem"
        >
          <!-- 左侧竖线指示器 -->
          <view class="problem-indicator {{isHost && item.selected ? 'indicator-selected' : ''}}"></view>

          <!-- 问题文字（含编辑态） -->
          <view class="problem-body">
            <block wx:if="{{editingProblemId === item.id && (isHost || item.isMine)}}">
              <textarea
                class="problem-textarea"
                value="{{item.text}}"
                maxlength="120"
                auto-height="{{false}}"
                style="height: {{textareaHeights[item.id]}}px;"
                data-id="{{item.id}}"
                catchtap="stopPropagation"
                bindinput="onProblemInput"
                bindblur="onProblemBlur"
              />
            </block>
            <text wx:else class="problem-text {{item.isMine && !isHost ? 'problem-text-mine' : ''}}" id="problem-text-{{item.id}}">{{item.text}}</text>
          </view>

          <!-- 右侧图标 -->
          <view class="problem-right">
            <view
              wx:if="{{editingProblemId === item.id && (isHost || item.isMine)}}"
              class="right-icon-btn"
              catchtap="onSaveEdit"
            >
              <image class="right-icon" src="/assets/icons/icon-problem-confirm.svg" mode="aspectFit" />
            </view>
            <view
              wx:elif="{{isHost && item.selected}}"
              class="right-icon-btn"
              data-id="{{item.id}}"
              catchtap="onEditProblem"
            >
              <image class="right-icon" src="/assets/icons/icon-problem-arrow.svg" mode="aspectFit" />
            </view>
            <view
              wx:elif="{{!isHost && item.isMine && item.selected}}"
              class="right-icon-btn"
              data-id="{{item.id}}"
              catchtap="onEditProblem"
            >
              <image class="right-icon" src="/assets/icons/icon-problem-arrow.svg" mode="aspectFit" />
            </view>
            <view wx:else class="right-icon-placeholder"></view>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{problems.length === 0}}">
          <text class="empty-text">等待成员提交设计问题…</text>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- 底部确认按钮（仅房主可见） -->
  <page-footer
    wx:if="{{isHost}}"
    extClass="footer"
    showPrev="{{false}}"
  >
    <view class="confirm-btn" bindtap="confirmSelection">确认问题</view>
  </page-footer>

</view>

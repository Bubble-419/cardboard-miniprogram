<view class="container">

  <!-- 顶部：TopBar + 情境格（固定在滚动区之外，避免随内容滚走） -->
  <view class="header-section" id="selectProblemHeader">
    <player-top-bar
      avatarList="{{avatarList}}"
      maxVisible="{{5}}"
      bind:goroom="handleGoRoom"
    />

    <!-- 情境展示：点击可回看完整情境（只读） -->
    <view bindtap="handleViewContext">
      <context-display items="{{categories}}" />
    </view>
  </view>

  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{scrollHeight}}px">
    <view class="main-content">

      <!-- 标题区 -->
      <view class="title-section">
        <text class="page-title" wx:if="{{isHost}}">选择设计问题</text>
        <text class="page-title" wx:else>等待房主选择设计问题</text>
        <text class="page-subtitle" wx:if="{{isHost}}">房主可以对设计问题进行选择、编辑</text>
        <text class="page-subtitle" wx:else>仅可查看，等待房主选择</text>
      </view>

      <!-- 设计问题列表 -->
      <view class="problem-list">
        <view
          class="problem-item {{item.selected ? 'selected' : ''}} {{editingProblemId === item.id || remoteEditingProblemId === item.id ? 'editing' : ''}} {{!isHost ? 'readonly' : ''}}"
          wx:for="{{problems}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="selectProblem"
        >
          <!-- 左侧竖线指示器 -->
          <view class="problem-indicator {{isHost && item.selected ? 'indicator-selected' : ''}}"></view>

          <!-- 问题文字（含编辑态） -->
          <view class="problem-body">
            <block wx:if="{{editingProblemId === item.id && isHost}}">
              <textarea
                class="problem-textarea"
                value="{{item.text}}"
                maxlength="50"
                auto-height="{{false}}"
                style="height: {{textareaHeights[item.id]}}px;"
                data-id="{{item.id}}"
                focus="{{editingProblemId === item.id}}"
                cursor="{{editingCursor}}"
                selection-start="{{editingCursor}}"
                selection-end="{{editingCursor}}"
                catchtap="stopPropagation"
                bindinput="onProblemInput"
                bindblur="onProblemBlur"
              />
            </block>
            <block wx:else>
              <text class="problem-text" id="problem-text-{{item.id}}">{{item.text}}</text>
              <text class="problem-editing-hint" wx:if="{{!isHost && remoteEditingProblemId === item.id}}">房主编辑中…</text>
            </block>
          </view>

          <!-- 右侧图标：仅房主可编辑 -->
          <view class="problem-right">
            <view
              wx:if="{{editingProblemId === item.id && isHost}}"
              class="right-icon-btn"
              catchtap="onSaveEdit"
            >
              <image class="right-icon" src="/assets/icons/icon-problem-confirm.svg" mode="aspectFit" />
            </view>
            <view
              wx:elif="{{isHost && item.selected}}"
              class="right-icon-btn"
              data-id="{{item.id}}"
              catchtap="onEditProblem"
            >
              <image class="right-icon" src="/assets/icons/icon-problem-arrow.svg" mode="aspectFit" />
            </view>
            <view wx:else class="right-icon-placeholder"></view>
          </view>
        </view>

        <!-- 空状态 Figma #5912:50988 -->
        <view class="empty-state" wx:if="{{problems.length === 0}}">
          <image
            class="empty-illus"
            src="/assets/selectProblem/empty-wait-problems.svg"
            mode="aspectFit"
          />
          <text class="empty-text">等待所有玩家提交设计问题...</text>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- 底部确认按钮（仅房主可见） -->
  <page-footer
    wx:if="{{isHost}}"
    extClass="footer"
    showPrev="{{false}}"
  >
    <view class="confirm-btn" bindtap="confirmSelection">确认问题</view>
  </page-footer>

</view>

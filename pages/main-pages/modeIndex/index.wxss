.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.wait-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.sub-title {
  font-size: 30rpx;
  color: #666666;
}

.wait-hint {
  color: #999999 !important;
}

.empty-state {
  padding: 60rpx 40rpx;
  text-align: center;
}

.empty-state-text {
  font-size: 30rpx;
  color: #999999;
  line-height: 1.6;
}

.header-section {
  padding: 28rpx 42rpx 20rpx;
  background-color: #ffffff;
  flex-shrink: 0;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #5ec159;
  margin-bottom: 8rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #6b7280;
}

.scenario-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx 32rpx 0;
  box-sizing: border-box;
}

.scenario-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding-bottom: 24rpx;
}

.scenario-card {
  width: calc((100% - 20rpx) / 2);
  min-height: 220rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 20rpx 20rpx;
  box-sizing: border-box;
  border: 2rpx solid #f0f0f0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  position: relative;
}

.scenario-card.selected {
  border-color: #5ec159;
  background-color: #f8fdf8;
  box-shadow: 0 4rpx 16rpx rgba(94, 193, 89, 0.18);
}

.scenario-card:active {
  opacity: 0.92;
}

.scenario-card-badge {
  align-self: flex-start;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  margin-bottom: 12rpx;
}

.badge-case {
  background-color: #e9f5e9;
  color: #5ec159;
}

.badge-history {
  background-color: #f3f4f6;
  color: #6b7280;
}

.badge-offline {
  background-color: #e8f4fd;
  color: #3b82f6;
}

.scenario-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
  line-height: 1.3;
}

.scenario-card-summary {
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.scenario-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: auto;
}

.scenario-tag {
  font-size: 20rpx;
  color: #59ae54;
  background-color: #e9f5e9;
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footer {
  flex-shrink: 0;
  padding: 24rpx 42rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.footer-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  font-size: 36rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.footer-btn::after {
  border: none;
}

.footer-btn-add {
  background-color: #ffffff;
  color: #5ec159;
  border: 2rpx solid #5ec159;
}

.footer-btn-select {
  background: linear-gradient(135deg, #5ec159 0%, #4db84a 100%);
  color: #ffffff;
}

.footer-btn:active {
  opacity: 0.9;
}

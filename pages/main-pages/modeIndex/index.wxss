/* ===== 全局容器 ===== */
.container {
  height: 100vh;
  background-color: #fafafa;
  box-sizing: border-box;
  overflow: hidden;
}

/* 房主页：头/线下卡固定，仅脑暴列表滚动 */
.host-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  padding-bottom: 160rpx;
}

/* ===== 等待视图 ===== */
.wait-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.wait-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
}

.wait-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 16rpx;
}

.wait-hint {
  font-size: 28rpx;
  color: #6b7280;
}

/* ===== 页头 ===== */
/* Figma MainHeader: padding 48px 24px 24px → 96rpx 48rpx 48rpx, gap 10px → 20rpx */
.header-section {
  padding: 0 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  flex-shrink: 0;
}

/* player-top-bar 已自带 padding-left:40rpx，抵消父级左边距避免加倍 */
.header-section > player-top-bar {
  margin-left: -48rpx;
  width: calc(100% + 48rpx);
}

/* 工作坊名称: Figma 18px Medium #45AD59 → 36rpx */
.workshop-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #45ad59;
  line-height: 56rpx;
}

/* TopBar: Figma row, alignItems center */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.room-entry {
  width: 74rpx;
  height: 74rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

/* 堆叠头像列表 */
.avatar-bar {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
  overflow: visible;
}

/* ===== 标题区 ===== */
.title-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 12rpx;
}

.page-main-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  line-height: 80rpx;
}

.page-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 46rpx;
}

/* ===== 主内容区 ===== */
/* Figma Main: padding 0 20px, gap 32px → 0 40rpx, gap 64rpx */
.main-content {
  flex: 1;
  min-height: 0;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 64rpx;
  box-sizing: border-box;
}

/* ===== 线下情境卡片 ===== */
.offline-card {
  flex-shrink: 0;
  background-color: #f9fafd;
  border: 2rpx solid #0598de;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  box-shadow: 0 16rpx 20rpx -12rpx rgba(0, 0, 0, 0.05),
              0 20rpx 50rpx -10rpx rgba(0, 0, 0, 0.05);
}

.offline-card:active {
  opacity: 0.9;
}

.offline-card-inner {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.offline-icon-wrap {
  width: 162rpx;
  height: 162rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.offline-icon {
  width: 162rpx;
  height: 120rpx;
}

.offline-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 0 0;
}

.offline-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #1f2937;
  line-height: 56rpx;
  margin-top: 8rpx;
}

.offline-desc {
  font-size: 24rpx;
  font-weight: 500;
  color: #6b7280;
  line-height: 39rpx;
}

/* ===== 徽章 ===== */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 24rpx;
  border-radius: 9999rpx;
  align-self: flex-start;
}

.badge-blue {
  background-color: #0598de;
}

.badge-green {
  background-color: #dcfce7;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 30rpx;
}

.badge-blue .badge-text {
  color: #ffffff;
}

.badge-green .badge-text {
  color: #5eba6d;
}

/* ===== 箭头按钮 ===== */
.arrow-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.arrow-wrap-blue {
  background-color: #dbeafe;
}

.arrow-wrap-green {
  background-color: #d8efdc;
}

.arrow-wrap-gray {
  background-color: #f2f2f2;
}

.arrow-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ===== 自定义情境区 ===== */
.custom-section {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.section-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-shrink: 0;
}

.section-header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.section-indicator {
  width: 8rpx;
  height: 32rpx;
  background-color: #5eba6d;
  border-radius: 9999rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1f2937;
}

.section-add-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 5;
}

.section-add-btn:active {
  opacity: 0.6;
}

.section-add-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ===== 情境列表（唯一可滚动区域） ===== */
.scenario-list {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

.scenario-list .scenario-item {
  margin-bottom: 32rpx;
}

.scenario-list .scenario-item:last-child {
  margin-bottom: 24rpx;
}

.scenario-item {
  background-color: #ffffff;
  border: 2rpx solid #f9fafb;
  border-radius: 48rpx;
  padding: 24rpx 40rpx;
  position: relative;
  box-shadow: 0 16rpx 20rpx -12rpx rgba(13, 128, 23, 0.1);
}

.scenario-item:active {
  opacity: 0.9;
}

.scenario-item-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.scenario-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 0;
}

.scenario-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1f2937;
  line-height: 56rpx;
}

/* ===== 情境标签 ===== */
.scenario-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding-top: 8rpx;
}

.scenario-tag {
  font-size: 18rpx;
  font-weight: 500;
  color: #509d59;
  background-color: #eef6ee;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  line-height: 27rpx;
}

/* ===== 底部上一页 ===== */
.footer {
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    0deg,
    rgba(255, 255, 255, 1) 0%,
    rgba(255, 255, 255, 0.95) 60%,
    rgba(255, 255, 255, 0) 100%
  );
}

.wait-page {
  padding-bottom: 160rpx;
}

<view class="container">
  <!-- 等待视图（非房主 / 等待中） -->
  <block wx:if="{{!isHost || isWaiting}}">
    <view class="wait-page">
      <view class="wait-header" style="padding-top: {{navbarPaddingTop}}px">
        <image class="back-icon" src="/assets/icons/miniprogram-btn.png" mode="aspectFit" bindtap="handleGoBack" />
      </view>
      <view class="wait-body">
        <view class="mode-badge-row">
          <view class="mode-icon-wrap">
            <image class="mode-icon" src="/assets/modeIndex/icon-mode-badge.svg" mode="aspectFit" />
          </view>
          <text class="mode-badge-text">{{modeTitle}}</text>
        </view>
        <text class="wait-title">选择情境</text>
        <text class="wait-hint">等待房主选择情境…</text>
      </view>
    </view>
  </block>

  <!-- 房主视图 -->
  <block wx:else>
    <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <!-- 页面头部 -->
      <view class="header-section" style="padding-top: {{navbarPaddingTop}}px">
        <view class="nav-row">
          <image class="back-icon" src="/assets/icons/miniprogram-btn.png" mode="aspectFit" bindtap="handleGoBack" />
        </view>
        <view class="mode-badge-row">
          <view class="mode-icon-wrap">
            <image class="mode-icon" src="/assets/modeIndex/icon-mode-badge.svg" mode="aspectFit" />
          </view>
          <text class="mode-badge-text">{{modeTitle}}</text>
        </view>
        <view class="title-block">
          <text class="page-main-title">选择情境</text>
          <text class="page-subtitle">选择一个情境开始游戏，或新建自定义情境</text>
        </view>
      </view>

      <!-- 主内容区 -->
      <view class="main-content">
        <!-- 线下情境卡片（halliGalli 模式才有） -->
        <view
          wx:if="{{offlineScenario}}"
          class="offline-card"
          data-id="{{offlineScenario.id}}"
          bindtap="onCardArrow"
        >
          <view class="offline-card-inner">
            <view class="offline-icon-wrap">
              <image class="offline-icon" src="/assets/modeIndex/icon-offline-bg.svg" mode="aspectFit" />
            </view>
            <view class="offline-details">
              <view class="badge badge-blue">
                <text class="badge-text">线下</text>
              </view>
              <text class="offline-title">线下情境</text>
              <text class="offline-desc">选择线下大屏上已展示的情境，直接进入游戏</text>
            </view>
            <view class="arrow-wrap arrow-wrap-blue">
              <image class="arrow-icon" src="/assets/modeIndex/icon-arrow-blue.svg" mode="aspectFit" />
            </view>
          </view>
        </view>

        <!-- 我的自定义情境 -->
        <view class="custom-section">
          <view class="section-header-row">
            <view class="section-indicator"></view>
            <text class="section-title">我的自定义情境</text>
          </view>

          <view class="scenario-list">
            <!-- 每个情境卡片 -->
            <view
              class="scenario-item"
              wx:for="{{customScenarios}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="onCardArrow"
            >
              <view class="scenario-item-inner">
                <view class="scenario-left">
                  <view class="badge badge-green">
                    <text class="badge-text">{{item.type === 'history' ? '历史' : '案例'}}</text>
                  </view>
                  <text class="scenario-title">{{item.title}}</text>
                  <view class="scenario-tags" wx:if="{{item.bg}}">
                    <text class="scenario-tag" wx:if="{{item.bg.scene}}">{{item.bg.scene}}</text>
                    <text class="scenario-tag" wx:if="{{item.bg.user}}">{{item.bg.user}}</text>
                    <text class="scenario-tag" wx:if="{{item.bg.platform}}">{{item.bg.platform}}</text>
                  </view>
                </view>
                <view class="arrow-wrap arrow-wrap-green">
                  <image class="arrow-icon" src="/assets/modeIndex/icon-arrow-green.svg" mode="aspectFit" />
                </view>
              </view>
            </view>

            <!-- 新增情境 -->
            <view class="scenario-item add-item" bindtap="handleAddScenario">
              <view class="scenario-item-inner">
                <view class="scenario-left">
                  <text class="add-title">新增情境</text>
                </view>
                <view class="arrow-wrap arrow-wrap-gray">
                  <image class="arrow-icon" src="/assets/modeIndex/icon-plus.svg" mode="aspectFit" />
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </block>
</view>

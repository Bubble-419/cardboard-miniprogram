<room-wait-screen
  wx:if="{{roomShellScreen === 'waiting' && waitingModel}}"
  model="{{waitingModel}}"
  waitHeroSrc="{{waitHeroSrc}}"
/>

<view wx:elif="{{roomShellScreen === 'waiting'}}" class="room-shell-loading"></view>

<view wx:elif="{{roomShellScreen === 'selector'}}" class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left" wx:if="{{isHost}}" hover-class="back-icon-hover" hover-stay-time="80" bindtap="goBack">
        <image class="back-icon" src="/assets/icons/icon-nav-back.svg" mode="aspectFit" />
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right">
        <view class="navbar-icon">⋯</view>
        <view class="navbar-icon">○</view>
      </view>
    </view>
  </view>

  <!-- 房主：触摸交互区域 -->
  <block>
  <view class="instruction-text" wx:if="{{!selectedPlayerIndex}}">
    <text class="instruction-line">请所有人把手指持续放到屏幕上</text>
    <text class="instruction-line" wx:if="{{iosTouchLimitActive}}">第6位玩家触碰后，从前5个触点中立即抽取</text>
    <text class="instruction-line" wx:else>由系统随机选出首位翻牌玩家</text>
  </view>

  <!-- 触摸交互区域（限制在文字和按钮之间） -->
  <view 
    class="touch-area"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchCancel"
  >
    <!-- 波纹效果：仅未选中时显示 -->
    <view 
      class="ripple visible"
      wx:for="{{activeTouches}}"
      wx:key="id"
      wx:if="{{!selectedPlayerIndex}}"
      style="left: {{item.x}}px; top: {{item.y}}px;"
    >
      <view class="ripple-circle ripple-1"></view>
      <view class="ripple-circle ripple-2"></view>
      <view class="ripple-circle ripple-3"></view>
    </view>

    <!-- 选中后的水波纹荡开效果（绿色），动画结束后保持显示 -->
    <view 
      wx:if="{{selectedPlayerIndex && selectedPosition}}"
      class="ripple ripple-water-spread visible"
      style="left: {{selectedPosition.x}}px; top: {{selectedPosition.y}}px;"
    >
      <view class="water-ring ring-1"></view>
      <view class="water-ring ring-2"></view>
      <view class="water-ring ring-3"></view>
      <view class="water-ring ring-4"></view>
      <view class="water-ring ring-5"></view>
    </view>

    <!-- 倒计时显示 -->
    <view class="countdown-display" wx:if="{{countdown > 0 && isSelecting}}">
      <text class="countdown-text">{{countdown}}s</text>
    </view>

    <!-- 选出动画结束后显示几号玩家被选中 -->
    <!-- <view class="selected-player-display" wx:if="{{selectionAnimationDone && selectedPlayerIndex}}">
      <text class="selected-player-text">{{selectedPlayerIndex}} 号玩家</text>
      <text class="selected-player-hint">被选为首位翻牌</text>
    </view> -->
  </view>

  <!-- 玩家数量显示（选中后隐藏） -->
  <view class="player-count" wx:if="{{!selectedPlayerIndex}}">
    <text class="count-number">{{playerCount}}</text>
    <text class="count-divider" wx:if="{{minPlayers > 0}}">/</text>
    <text class="count-total" wx:if="{{minPlayers > 0}}">{{minPlayers}}</text>
  </view>

    <!-- 底部：未选中时显示跳过按钮，选中后显示重新选择+确认 -->
  <page-footer
    wx:if="{{!selectedPlayerIndex}}"
    extClass="footer footer-skip"
    bind:prev="goBack"
  >
    <button class="skip-btn-green" bindtap="handleSkip">跳过</button>
  </page-footer>
  <page-footer
    wx:elif="{{selectionAnimationDone && selectedPlayerIndex}}"
    extClass="footer"
    showPrev="{{false}}"
  >
    <button class="reselect-btn" bindtap="reselectSelection">重新选择</button>
    <button class="confirm-btn" bindtap="confirmSelection">确认</button>
  </page-footer>

  <!-- 添加玩家：仅抽取前显示，确认/重选阶段隐藏 -->
  <view class="add-player-btn" wx:if="{{!selectedPlayerIndex}}" bindtap="addPlayer">
    <image class="add-player-icon" src="/assets/icons/passenger.png" mode="aspectFit"></image>
  </view>
  </block>
</view>

<view wx:else class="room-shell-loading"></view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

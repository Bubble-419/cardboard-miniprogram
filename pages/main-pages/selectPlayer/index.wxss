.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  position: relative;
  overflow: hidden;
}

/* 自定义导航栏 */
.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
  position: relative;
  z-index: 10;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 普通玩家等待空状态 */
.empty-wait-state {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 80rpx 60rpx;
  text-align: center;
}

.empty-wait-text {
  font-size: 36rpx;
  color: #666;
  line-height: 1.6;
}

/* 提示文字（不可触摸区域） */
.instruction-text {
  position: absolute;
  top: 142rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 2;
  pointer-events: none;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 触摸交互区域（限制在文字和按钮之间） */
.touch-area {
  position: absolute;
  top: 300rpx;
  left: 0;
  right: 0;
  bottom: 250rpx;
  background-color: #f8fbfa;
  z-index: 1;
  overflow: hidden;
  pointer-events: auto;
}

.instruction-line {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.5;
  text-align: center;
}

/* 波纹效果 */
.ripple {
  position: fixed;
  width: 0;
  height: 0;
  transform: translate(-50%, -50%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease-in;
  z-index: 5;
}

.ripple.visible {
  opacity: 1;
}

.ripple-circle {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid #5ec159;
  border-radius: 50%;
  background-color: rgba(94, 193, 89, 0.1);
  pointer-events: none;
}

.ripple-1 {
  width: 172rpx;
  height: 172rpx;
  animation: ripple-animation 1.5s ease-out infinite;
}

.ripple-2 {
  width: 172rpx;
  height: 172rpx;
  animation: ripple-animation 1.5s ease-out 0.5s infinite;
}

.ripple-3 {
  width: 172rpx;
  height: 172rpx;
  animation: ripple-animation 1.5s ease-out 1s infinite;
}

/* 选中波纹样式 */
.ripple.selected .ripple-circle {
  border-color: #4fc3f7;
  border-width: 4rpx;
  background-color: rgba(79, 195, 247, 0.25);
}

/* 水珠荡开效果：同心圆向外扩散，更明显 */
.water-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  pointer-events: none;
  z-index: -1;
  border: 8rpx solid rgba(33, 150, 243, 0.95);
  background: transparent;
  box-shadow:
    0 0 30rpx rgba(33, 150, 243, 0.6),
    inset 0 0 20rpx rgba(79, 195, 247, 0.2);
}

.water-ring.ring-1 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread 0.9s ease-out forwards;
}

.water-ring.ring-2 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread 0.9s ease-out 0.15s forwards;
}

.water-ring.ring-3 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread 0.9s ease-out 0.3s forwards;
}

.water-ring.ring-4 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread 0.9s ease-out 0.45s forwards;
}

.water-ring.ring-5 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread 0.9s ease-out 0.6s forwards;
}

@keyframes water-spread {
  0% {
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 1;
    border-width: 8rpx;
  }
  40% {
    opacity: 0.85;
  }
  100% {
    transform: translate(-50%, -50%) scale(2.2);
    opacity: 0;
    border-width: 2rpx;
  }
}

@keyframes ripple-animation {
  0% {
    transform: translate(-50%, -50%) scale(0.8);
    opacity: 0.8;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0.4;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.6);
    opacity: 0;
  }
}

/* 倒计时显示 */
.countdown-display {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 3;
}

.countdown-text {
  font-size: 80rpx;
  font-weight: 400;
  color: #ffffff;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 玩家数量显示 */
.player-count {
  position: absolute;
  bottom: 350rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: baseline;
  justify-content: center;
  z-index: 2;
}

.count-number {
  font-size: 100rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.1;
}

.count-divider {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  margin: 0 4rpx;
  line-height: 1.1;
}

.count-total {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.1;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: transparent;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  z-index: 10;
  pointer-events: auto;
}

.skip-btn {
  width: 100%;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 44rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.skip-btn::after {
  border: none;
}

.skip-btn:active {
  opacity: 0.8;
}

/* 添加玩家按钮 */
.add-player-btn {
  position: absolute;
  top: 218rpx;
  right: 48rpx;
  width: 100rpx;
  height: 100rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-player-icon {
  width: 100%;
  height: 100%;
}


.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  position: relative;
  overflow: hidden;
}

/* 自定义导航栏：悬浮叠加，与页面背景一致 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background-color: #f8fbfa;
  padding-top: max(0px, calc(env(safe-area-inset-top, 0) - 18px));
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 普通玩家等待空状态 */
.empty-wait-state {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 80rpx 60rpx;
  text-align: center;
}

.empty-wait-text {
  font-size: 36rpx;
  color: #666;
  line-height: 1.6;
}

/* 提示文字（不可触摸区域）：top 需大于 navbar 高度，避免被遮挡 */
.instruction-text {
  position: absolute;
  top: 280rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 2;
  pointer-events: none;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* 触摸交互区域（限制在文字和按钮之间） */
.touch-area {
  position: absolute;
  top: 440rpx;
  left: 0;
  right: 0;
  bottom: 250rpx;
  background-color: #f8fbfa;
  z-index: 1;
  overflow: hidden;
  pointer-events: auto;
}

.instruction-line {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.5;
  text-align: center;
}

/* 底部跳过按钮（与确认按钮统一样式：绿色实心） */
.footer-skip {
  justify-content: center;
}

.skip-btn-green {
  width: 100%;
  max-width: 600rpx;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 40rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.skip-btn-green::after {
  border: none;
}

.skip-btn-green:active {
  opacity: 0.8;
}

/* 波纹效果 */
.ripple {
  position: fixed;
  width: 0;
  height: 0;
  transform: translate(-50%, -50%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease-in;
  z-index: 5;
}

.ripple.visible {
  opacity: 1;
}

.ripple-circle {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid #5ec159;
  border-radius: 50%;
  background-color: rgba(94, 193, 89, 0.1);
  pointer-events: none;
}

.ripple-1 {
  width: 172rpx;
  height: 172rpx;
  animation: ripple-animation 1.5s ease-out infinite;
}

.ripple-2 {
  width: 172rpx;
  height: 172rpx;
  animation: ripple-animation 1.5s ease-out 0.5s infinite;
}

.ripple-3 {
  width: 172rpx;
  height: 172rpx;
  animation: ripple-animation 1.5s ease-out 1s infinite;
}

/* 选中后的水波纹荡开效果（与页面绿色 #5ec159 一致，持续 1.5s） */
.water-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  pointer-events: none;
  z-index: -1;
  border: 8rpx solid rgba(94, 193, 89, 0.95);
  background: transparent;
  box-shadow:
    0 0 30rpx rgba(94, 193, 89, 0.5),
    inset 0 0 20rpx rgba(94, 193, 89, 0.15);
}

/* 水波纹循环播放，5 个环错开 0.35s 依次荡开 */
.water-ring.ring-1 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread-loop 3s ease-out infinite;
}

.water-ring.ring-2 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread-loop 3s ease-out 0.35s infinite;
}

.water-ring.ring-3 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread-loop 3s ease-out 0.7s infinite;
}

.water-ring.ring-4 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread-loop 3s ease-out 1.05s infinite;
}

.water-ring.ring-5 {
  width: 120rpx;
  height: 120rpx;
  animation: water-spread-loop 3s ease-out 1.4s infinite;
}

@keyframes water-spread-loop {
  0% {
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 1;
    border-width: 8rpx;
  }
  40% {
    opacity: 0.85;
  }
  90% {
    transform: translate(-50%, -50%) scale(3.5);
    opacity: 0.5;
    border-width: 4rpx;
  }
  100% {
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 1;
    border-width: 8rpx;
  }
}

@keyframes ripple-animation {
  0% {
    transform: translate(-50%, -50%) scale(0.8);
    opacity: 0.8;
  }
  50% {
    transform: translate(-50%, -50%) scale(1.2);
    opacity: 0.4;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.6);
    opacity: 0;
  }
}

/* 倒计时显示 */
.countdown-display {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 3;
}

.countdown-text {
  font-size: 80rpx;
  font-weight: 400;
  color: #ffffff;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 选中后显示的玩家号 */
.selected-player-display {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 4;
  pointer-events: none;
}

.selected-player-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #5ec159;
}

.selected-player-hint {
  font-size: 28rpx;
  color: #5ec159;
}

/* 玩家数量显示 */
.player-count {
  position: absolute;
  bottom: 350rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: baseline;
  justify-content: center;
  z-index: 2;
}

.count-number {
  font-size: 100rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.1;
}

.count-divider {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  margin: 0 4rpx;
  line-height: 1.1;
}

.count-total {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.1;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: transparent;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  z-index: 10;
  pointer-events: auto;
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.reselect-btn {
  flex: 1;
  height: 96rpx;
  background-color: #fff;
  color: #5ec159;
  border: 2rpx solid #5ec159;
  border-radius: 28rpx;
  font-size: 40rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
}

.reselect-btn::after {
  border: none;
}

.reselect-btn:active {
  opacity: 0.8;
}

.confirm-btn {
  flex: 1;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 40rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:active {
  opacity: 0.8;
}

/* 添加玩家按钮 */
.add-player-btn {
  position: absolute;
  top: 218rpx;
  right: 48rpx;
  width: 100rpx;
  height: 100rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-player-icon {
  width: 100%;
  height: 100%;
}


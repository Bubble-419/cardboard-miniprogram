.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  padding-bottom: 200rpx;
}

/* 自定义导航栏 */
.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-section {
  padding: 48rpx 54rpx 0;
}

.field {
  margin-bottom: 40rpx;
}

.field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.field-label {
  font-size: 32rpx;
  color: #111827;
}

.field-optional {
  font-size: 24rpx;
  color: #9ca3af;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #111827;
}

.field-placeholder {
  color: #9ca3af;
  font-size: 28rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
}

.avatar-picker {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx dashed #5ec159;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #5ec159;
}

.field-desc {
  flex: 1;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* 标题区 */
.header-section {
  padding: 48rpx 54rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* 头像区 */
.avatar-section {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.avatar-wrapper {
  width: 200rpx;
  height: 200rpx;
  border-radius: 100rpx;
  background-color: #e5e7eb;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

/* 昵称区 */
.nickname-section {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.nickname-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nickname-text {
  font-size: 32rpx;
  color: #111827;
}

.nickname-edit-icon {
  width: 40rpx;
  height: 40rpx;
}

.nickname-input {
  min-width: 200rpx;
  max-width: 320rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background-color: #f3f4f6;
  font-size: 28rpx;
}

.nickname-confirm-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 工作坊名称输入区 */
.workshop-section {
  margin-top: 48rpx;
  padding: 0 54rpx;
}

.workshop-input-wrapper {
  position: relative;
  height: 88rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  padding: 0 80rpx 0 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.workshop-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.workshop-placeholder {
  font-size: 28rpx;
  color: #9ca3af;
}

.workshop-clear-icon {
  position: absolute;
  right: 24rpx;
  width: 32rpx;
  height: 32rpx;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.primary-btn::after {
  border: none;
}

.primary-btn:active {
  opacity: 0.85;
}


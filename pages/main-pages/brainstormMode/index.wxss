.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  padding-bottom: 60rpx;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

.team-section {
  background-color: #ffffff;
  padding: 24rpx 42rpx 20rpx;
}

.section-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #5ec159;
  margin-bottom: 16rpx;
}

.team-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.wait-tip {
  margin: 24rpx 42rpx 0;
  padding: 20rpx 28rpx;
  background-color: #e9f5e9;
  border-radius: 20rpx;
  text-align: center;
}

.wait-tip text {
  font-size: 28rpx;
  color: #59ae54;
}

.mode-section {
  padding: 32rpx 0 0;
}

.mode-hint {
  padding: 0 42rpx 20rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.cards-wrap {
  padding-top: 8rpx;
}

.mode-swiper {
  height: 560rpx;
}

.mode-swiper-item {
  display: flex;
  align-items: stretch;
  justify-content: center;
}

.card-padding {
  width: 100%;
  padding: 0 22rpx;
  box-sizing: border-box;
}

.mode-card {
  height: 100%;
  background-color: #ffffff;
  border: 2rpx solid #fcfcfc;
  border-radius: 34rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 2rpx 12rpx 0 rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.mode-card-selectable {
  border-color: #e9f5e9;
}

.mode-card-selectable:active {
  border-color: #5ec159;
  opacity: 0.92;
}

.mode-card-readonly {
  opacity: 0.85;
}

.mode-card-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background-color: #e9f5e9;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.mode-card-icon {
  width: 64rpx;
  height: 64rpx;
}

.mode-card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5ec159;
  text-align: center;
  margin-bottom: 24rpx;
}

.mode-card-desc {
  font-size: 28rpx;
  color: #565656;
  line-height: 1.6;
  text-align: center;
  flex: 1;
}

.mode-card-action {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #5ec159 0%, #4db84a 100%);
  border-radius: 48rpx;
}

.mode-card-action text {
  font-size: 28rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.swiper-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 28rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #d1d5db;
}

.dot.active {
  width: 28rpx;
  border-radius: 6rpx;
  background-color: #5ec159;
}

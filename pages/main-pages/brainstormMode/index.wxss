.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
}

/* 工作坊区域 — 与 selectMode 一致 */
.workshop-section {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 42rpx;
  height: 72rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.workshop-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.workshop-name {
  font-size: 32rpx;
  color: #374151;
  flex-shrink: 0;
}

.wait-tip {
  flex-shrink: 0;
  margin: 20rpx 42rpx 0;
  padding: 18rpx 28rpx;
  background-color: #e9f5e9;
  border-radius: 20rpx;
  text-align: center;
}

.wait-tip-text {
  font-size: 28rpx;
  color: #59ae54;
  line-height: 1.4;
}

.mode-scroll {
  flex: 1;
  height: 0;
}

.mode-section {
  padding: 40rpx 39rpx 48rpx;
  box-sizing: border-box;
}

.section-header {
  margin-bottom: 28rpx;
  text-align: center;
}

.section-title {
  display: block;
  font-size: 44rpx;
  font-weight: 400;
  color: #5ec159;
  line-height: 1.3;
  margin-bottom: 8rpx;
  text-align: center;
}

.section-subtitle {
  display: block;
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.4;
  text-align: center;
}

.mode-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.mode-item {
  position: relative;
  background-color: #ffffff;
  border: 2rpx solid #f0f0f0;
  border-radius: 34rpx;
  padding: 36rpx 32rpx 32rpx;
  min-height: 200rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.mode-item.selected {
  border-color: #5ec159;
  box-shadow: 0 6rpx 24rpx rgba(94, 193, 89, 0.18);
  background-color: #fcfffc;
}

.mode-item:active:not(.readonly) {
  transform: scale(0.985);
  border-color: #5ec159;
}

.mode-item.readonly {
  opacity: 0.72;
}

.mode-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(145deg, #eef9ee 0%, #e9f5e9 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 8rpx rgba(94, 193, 89, 0.08);
}

.mode-item.selected .mode-icon-wrap {
  background: linear-gradient(145deg, #e9f5e9 0%, #dff5df 100%);
}

.mode-icon {
  width: 56rpx;
  height: 56rpx;
}

.mode-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.mode-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #5ec159;
  line-height: 1.4;
  text-align: center;
  margin-bottom: 16rpx;
}

.mode-desc {
  font-size: 28rpx;
  color: #565656;
  line-height: 1.6;
  text-align: center;
  max-width: 560rpx;
}

/* ===== 全局容器 ===== */
.container {
  min-height: 100vh;
  background-color: #F3FAF9;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部标题区 ===== */
.header-section {
  padding: 0 48rpx 48rpx;
  flex-shrink: 0;
}

.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
}

.title-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.page-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: #6F6F6F;
  line-height: 1.6;
}

/* ===== 模式列表滚动区 ===== */
.mode-scroll {
  flex: 1;
}

.mode-list {
  padding: 0 40rpx 280rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ===== 模式卡片 ===== */
.mode-item {
  background-color: #FFFFFF;
  border-radius: 40rpx;
  border: 4rpx solid transparent;
  padding: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 16rpx 48rpx 0 rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.mode-item.selected {
  border-color: #5EC159;
}

.mode-item:active {
  opacity: 0.88;
}

/* ===== 封面图 ===== */
.mode-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  overflow: hidden;
  background-color: #f0f0f0;
}

/* ===== 文字信息 ===== */
.mode-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.mode-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #545454;
  line-height: 1.4;
}

.mode-name.active {
  color: #3AAE34;
}

.mode-desc {
  font-size: 24rpx;
  font-weight: 400;
  color: #94A3B8;
  line-height: 1.6;
  white-space: pre-line;
}

/* ===== 选中状态圆形指示器 ===== */
.status-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 9999rpx;
  border: 4rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-right: 8rpx;
}

.status-wrap.checked {
  background-color: #5EC159;
  border-color: #5EC159;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ===== 底部确认按钮区 ===== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    0deg,
    rgba(255, 255, 255, 1) 0%,
    rgba(255, 255, 255, 0.95) 50%,
    rgba(255, 255, 255, 0) 100%
  );
}

.confirm-btn {
  background-color: #5EC159;
  color: #FFFFFF;
  border-radius: 24rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
}

.confirm-btn.dimmed {
  opacity: 0.5;
}

.confirm-btn:active {
  opacity: 0.85;
}

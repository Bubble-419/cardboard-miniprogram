/* ===== 全局容器 ===== */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F3FAF9;
  box-sizing: border-box;
  overflow: hidden;
}

/* ===== 顶部标题区 ===== */
.header-section {
  padding: 4rpx 48rpx 20rpx;
  flex-shrink: 0;
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 88rpx;
}

.room-entry {
  width: 74rpx;
  height: 74rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

.avatar-bar {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
  overflow: visible;
}

.title-block {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.page-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: #6F6F6F;
  line-height: 1.4;
}

/* ===== 模式列表可视区 ===== */
.mode-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.mode-groups {
  height: 100%;
  padding: 0 40rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.mode-group {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mode-group-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 8rpx;
}

.mode-group-mark {
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #5EC159;
}

.mode-group-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.mode-list {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* ===== 模式卡片 ===== */
.mode-item {
  flex: 0 0 auto;
  height: 176rpx;
  background-color: #FFFFFF;
  min-height: 0;
  border-radius: 32rpx;
  border: 4rpx solid transparent;
  padding: 10rpx 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 16rpx 48rpx 0 rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.mode-item.selected {
  border-color: #5EC159;
}

.mode-item:active {
  opacity: 0.88;
}

.mode-cover {
  width: 144rpx;
  height: 144rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
  background-color: #ffffff;
}

.mode-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.mode-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #545454;
  line-height: 1.25;
}

.mode-name.active {
  color: #3AAE34;
}

.mode-desc {
  font-size: 26rpx;
  font-weight: 400;
  color: #94A3B8;
  line-height: 1.35;
  white-space: pre-line;
}

.status-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 9999rpx;
  border: 4rpx solid #E2E8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  margin-right: 4rpx;
}

.status-wrap.checked {
  background-color: #5EC159;
  border-color: #5EC159;
}

.check-icon {
  width: 34rpx;
  height: 34rpx;
}

.footer {
  flex-shrink: 0;
  padding: 16rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: transparent;
}

.footer .page-footer__prev-btn {
  height: 80rpx;
  font-size: 38rpx;
}

.confirm-btn {
  flex: 1;
  width: 100%;
  background-color: #5EC159;
  color: #FFFFFF;
  border-radius: 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
}

.confirm-btn.dimmed {
  opacity: 0.5;
}

.confirm-btn:active {
  opacity: 0.85;
}

/* 小屏机型继续压缩纵向密度，保证四张卡与底部按钮同屏可见 */
@media screen and (max-height: 700px) {
  .header-section {
    padding-bottom: 12rpx;
  }

  .page-title {
    font-size: 40rpx;
  }

  .mode-groups {
    padding: 0 32rpx 8rpx;
    gap: 8rpx;
  }

  .mode-group {
    gap: 4rpx;
  }

  .mode-list {
    gap: 6rpx;
  }

  .mode-item {
    height: 152rpx;
    min-height: 0;
    padding: 8rpx 20rpx;
    gap: 20rpx;
  }

  .mode-cover {
    width: 128rpx;
    height: 128rpx;
  }

  .mode-name {
    font-size: 34rpx;
  }

  .mode-desc {
    font-size: 22rpx;
  }

  .footer {
    padding: 8rpx 32rpx calc(12rpx + env(safe-area-inset-bottom));
  }

  .footer .page-footer__prev-btn,
  .confirm-btn {
    height: 72rpx;
    font-size: 34rpx;
  }
}

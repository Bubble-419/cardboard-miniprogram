<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="handleGoBack"
        ></image>
      </view>
      <view class="navbar-title">选择脑暴模式</view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 队伍信息：成员列表 -->
  <view class="team-section">
    <view class="team-info">
      <user-list
        avatarList="{{avatarList}}"
        currentUser="{{currentUser}}"
        enableAdd="{{false}}"
        isFold="{{true}}"
        showName="{{true}}"
      />
    </view>
  </view>

  <view class="wait-tip" wx:if="{{!isHost}}">
    <text class="wait-tip-text">等待房主选择脑暴模式</text>
  </view>

  <scroll-view class="mode-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="mode-section">
      <view class="section-header">
        <text class="section-title">脑暴模式</text>
        <text class="section-subtitle" wx:if="{{isHost}}">点击选择一种模式</text>
        <text class="section-subtitle" wx:else>房主确认后将进入游戏</text>
      </view>

      <view class="mode-list">
        <view
          class="mode-item {{selectedModeId === item.id ? 'selected' : ''}} {{isHost ? '' : 'readonly'}}"
          wx:for="{{brainstormModes}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onSelectMode"
        >
          <view class="mode-radio" wx:if="{{isHost}}">
            <view class="radio-outer {{selectedModeId === item.id ? 'selected' : ''}}">
              <view class="radio-inner" wx:if="{{selectedModeId === item.id}}"></view>
            </view>
          </view>

          <view class="mode-icon-wrap">
            <image class="mode-icon" src="{{item.icon}}" mode="aspectFit"></image>
          </view>

          <view class="mode-info">
            <text class="mode-title">{{item.title}}</text>
            <text class="mode-desc">{{item.description}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

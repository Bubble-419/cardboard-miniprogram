<view class="container">
  <player-top-bar
    avatarList="{{avatarList}}"
    currentUser="{{currentUser}}"
    maxVisible="{{5}}"
    padLeftRpx="{{48}}"
    bind:goroom="handleGoRoom"
  />

  <!-- 顶部标题区 -->
  <view class="header-section">
    <view class="title-block">
      <text class="page-title">脑暴模式</text>
      <text class="page-subtitle">
        {{isHost ? '请选择一种模式，房主可进行切换' : '等待房主选择模式…'}}
      </text>
    </view>
  </view>

  <!-- 四张模式卡固定在剩余可视区内，不使用页内滚动 -->
  <view class="mode-scroll">
    <view class="mode-groups">
      <view class="mode-group" wx:for="{{modeGroups}}" wx:key="id" wx:for-item="group">
        <view class="mode-group-heading">
          <view class="mode-group-mark"></view>
          <text class="mode-group-title">{{group.title}}</text>
        </view>
        <view class="mode-list">
          <view
            class="mode-item {{selectedModeId === item.id ? 'selected' : ''}}"
            wx:for="{{group.modes}}"
            wx:key="id"
            wx:for-item="item"
            data-id="{{item.id}}"
            bindtap="onTapMode"
          >
            <image class="mode-cover" src="{{item.coverImage}}" mode="aspectFill" />
            <view class="mode-info">
              <text class="mode-name {{selectedModeId === item.id ? 'active' : ''}}">{{item.title}}</text>
              <text class="mode-desc">{{item.description}}</text>
            </view>
            <view class="status-wrap {{selectedModeId === item.id ? 'checked' : ''}}">
              <image
                wx:if="{{selectedModeId === item.id}}"
                class="check-icon"
                src="/assets/brainstormMode/icon-mode-check.svg"
                mode="aspectFit"
              />
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <page-footer
    wx:if="{{isHost}}"
    fixed="{{false}}"
    extClass="footer"
    bind:prev="handleGoBack"
  >
    <view
      class="confirm-btn {{selectedModeId ? '' : 'dimmed'}}"
      bindtap="onConfirmMode"
    >确认模式</view>
  </page-footer>

  <page-footer
    wx:else
    fixed="{{false}}"
    extClass="footer"
    showPrimary="{{false}}"
    bind:prev="handleGoBack"
  ></page-footer>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

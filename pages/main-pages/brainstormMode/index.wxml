<view class="container">
  <!-- 顶部标题区 -->
  <view class="header-section">
    <player-top-bar
      avatarList="{{avatarList}}"
      currentUser="{{currentUser}}"
      maxVisible="{{5}}"
      bind:goroom="handleGoRoom"
    />
    <view class="title-block">
      <text class="page-title">脑暴模式</text>
      <text class="page-subtitle">
        {{isHost ? '请选择一种模式，房主可进行切换' : '等待房主选择模式…'}}
      </text>
    </view>
  </view>

  <!-- 模式列表：scroll-view 必须用 px 高度，flex+height:0 在部分基础库会整页空白 -->
  <scroll-view
    class="mode-scroll"
    scroll-y
    show-scrollbar="{{false}}"
    style="height: {{scrollHeight}}px"
  >
    <view class="mode-list">
      <view
        class="mode-item {{selectedModeId === item.id ? 'selected' : ''}}"
        wx:for="{{brainstormModes}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTapMode"
      >
        <image class="mode-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="mode-info">
          <text class="mode-name {{selectedModeId === item.id ? 'active' : ''}}">{{item.title}}</text>
          <text class="mode-desc">{{item.description}}</text>
        </view>
        <view class="status-wrap {{selectedModeId === item.id ? 'checked' : ''}}">
          <image
            wx:if="{{selectedModeId === item.id}}"
            class="check-icon"
            src="/assets/brainstormMode/icon-mode-check.svg"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>
  </scroll-view>

  <page-footer
    wx:if="{{isHost}}"
    extClass="footer"
    bind:prev="handleGoBack"
  >
    <view
      class="confirm-btn {{selectedModeId ? '' : 'dimmed'}}"
      bindtap="onConfirmMode"
    >确认模式</view>
  </page-footer>

  <page-footer
    wx:else
    extClass="footer"
    showPrimary="{{false}}"
    bind:prev="handleGoBack"
  ></page-footer>
</view>

<view class="page">
  <!-- 顶部用户信息 -->
  <view class="main-header" style="padding-top: {{headerPaddingTop}}px">
    <view class="user-info">
      <view class="avatar-wrap">
        <image class="user-avatar" src="{{userAvatarUrl}}" mode="aspectFill" />
        <view class="online-dot" />
      </view>
      <text class="user-name">{{userNickName}}</text>
    </view>
  </view>

  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- Hero 标题区 -->
    <view class="hero-section">
      <view class="hero-text">
        <view class="hero-title">
          <text class="hero-title-bold">脑暴</text>
          <text class="hero-title-bold">工作坊</text>
        </view>
        <text class="hero-subtitle">创建或加入房间，快速开启共创</text>
      </view>
      <image class="hero-illustration" src="/assets/home/hero-illustration.svg" mode="aspectFit" />
    </view>

    <!-- 主控制卡片 -->
    <view class="action-section">
      <view class="control-card">
        <view class="card-top-row">
          <view class="workshop-info">
            <text class="workshop-name">{{isJoinedRoom ? roomName : '工作坊名称'}}</text>
            <text class="workshop-desc">{{isJoinedRoom ? roomDesc : '集思广益，激发无限灵感'}}</text>
          </view>
          <view class="status-bar">
            <text class="status-label">当前状态</text>
            <view class="status-pill">
              <view class="status-dot" />
              <text class="status-text">{{roleLabel}}</text>
            </view>
          </view>
        </view>

        <!-- 未加入：创建 / 扫码 -->
        <view class="btn-grid" wx:if="{{!isJoinedRoom}}">
          <view
            class="action-btn action-btn-primary {{loading ? 'action-btn-disabled' : ''}}"
            bindtap="handleCreateRoom"
          >
            <view class="btn-icon-wrap btn-icon-wrap-light">
              <image class="btn-icon" src="/assets/home/icon-create-room.svg" mode="aspectFit" />
            </view>
            <view class="btn-text-group">
              <text class="btn-title btn-title-light">{{loading ? '处理中…' : '创建房间'}}</text>
              <text class="btn-desc btn-desc-light">发起新的共创脑暴</text>
            </view>
          </view>
          <view class="action-btn action-btn-outline" bindtap="handleScanJoin">
            <view class="btn-icon-wrap">
              <image class="btn-icon" src="/assets/home/icon-scan-join.svg" mode="aspectFit" />
            </view>
            <view class="btn-text-group">
              <text class="btn-title btn-title-green">扫码加入</text>
              <text class="btn-desc">扫描邀请码加入</text>
            </view>
          </view>
        </view>

        <!-- DEV_TEST_START: 输入房间号加入（测试用，删除 utils/devJoinRoomById.js 及 DEV_TEST 段落） -->
        <view class="dev-join-room" wx:if="{{devJoinEnabled && !isJoinedRoom}}">
          <text class="dev-join-label">测试：输入房间号加入</text>
          <view class="dev-join-row">
            <input
              class="dev-join-input"
              type="number"
              maxlength="8"
              value="{{devJoinRoomIdInput}}"
              placeholder="8位房间号"
              placeholder-class="dev-join-placeholder"
              bindinput="onDevJoinRoomIdInput"
              confirm-type="go"
              bindconfirm="handleDevJoinByRoomId"
            />
            <button class="dev-join-btn" bindtap="handleDevJoinByRoomId">加入</button>
          </view>
        </view>
        <!-- DEV_TEST_END -->

        <!-- 已加入：查看房间 -->
        <view class="btn-grid btn-grid-single" wx:else>
          <view class="action-btn action-btn-primary action-btn-full" bindtap="handleViewRoom">
            <view class="btn-text-group btn-text-group-center">
              <text class="btn-title btn-title-light">查看房间</text>
              <text class="btn-desc btn-desc-light" wx:if="{{roomTimeText}}">{{timeLabel}} {{roomTimeText}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 历史工作坊 -->
    <view class="history-section">
      <view class="history-header">
        <text class="history-title">历史工作坊</text>
        <view class="history-sort" wx:if="{{historyWorkshops.length > 0}}">
          <text class="history-sort-text">时间</text>
          <image class="history-sort-icon" src="/assets/home/icon-sort-time.svg" mode="aspectFit" />
        </view>
      </view>

      <!-- 空状态 -->
      <view class="history-empty" wx:if="{{historyWorkshops.length === 0}}">
        <image class="empty-illustration" src="/assets/home/empty-history-6f27f1.png" mode="aspectFit" />
        <text class="empty-title">暂无历史工作坊</text>
        <text class="empty-desc">加入或创建房间，开始你的脑暴之旅吧！</text>
      </view>

      <!-- 有历史数据（视觉占位，暂无业务逻辑） -->
      <view class="history-grid" wx:else>
        <view class="history-column">
          <block wx:for="{{historyWorkshops}}" wx:key="id" wx:for-index="idx" wx:if="{{idx % 2 === 0}}">
            <view class="history-card">
              <view class="history-card-header">
                <view class="history-card-title-wrap">
                  <text class="history-card-name">{{item.name}}</text>
                </view>
                <view class="history-card-meta">
                  <text class="history-card-creator">{{item.creator}}</text>
                  <text class="history-card-time">{{item.time}}</text>
                </view>
              </view>
              <view class="history-card-body">
                <view class="ai-summary-label">
                  <text class="ai-summary-text">AI总结</text>
                  <image class="ai-sparkle-icon" src="/assets/home/icon-ai-sparkle.svg" mode="aspectFit" />
                </view>
                <text class="ai-summary-content">{{item.summary}}</text>
              </view>
              <image
                wx:if="{{item.hasCover}}"
                class="history-card-cover"
                src="{{item.cover}}"
                mode="aspectFill"
              />
            </view>
          </block>
        </view>
        <view class="history-column">
          <block wx:for="{{historyWorkshops}}" wx:key="id" wx:for-index="idx" wx:if="{{idx % 2 === 1}}">
            <view class="history-card">
              <view class="history-card-header">
                <view class="history-card-title-wrap">
                  <text class="history-card-name">{{item.name}}</text>
                </view>
                <view class="history-card-meta">
                  <text class="history-card-creator">{{item.creator}}</text>
                  <text class="history-card-time">{{item.time}}</text>
                </view>
              </view>
              <view class="history-card-body">
                <view class="ai-summary-label">
                  <text class="ai-summary-text">AI总结</text>
                  <image class="ai-sparkle-icon" src="/assets/home/icon-ai-sparkle.svg" mode="aspectFit" />
                </view>
                <text class="ai-summary-content">{{item.summary}}</text>
              </view>
              <image
                wx:if="{{item.hasCover}}"
                class="history-card-cover"
                src="{{item.cover}}"
                mode="aspectFill"
              />
            </view>
          </block>
        </view>
      </view>

      <view class="history-footer" wx:if="{{historyWorkshops.length > 0}}">
        <view class="footer-divider" />
        <text class="footer-text">没有更多了</text>
        <view class="footer-divider" />
      </view>
    </view>
  </scroll-view>

  <!-- 调试用：输入房间号加入（固定底部，不占文档流，后续会移除） -->
  <view class="debug-join-bar" wx:if="{{!isJoinedRoom}}">
    <input
      class="debug-join-input"
      type="number"
      maxlength="8"
      placeholder="输入房间号"
      value="{{debugRoomIdInput}}"
      bindinput="onDebugRoomIdInput"
      confirm-type="go"
      bindconfirm="handleJoinByRoomId"
    />
    <view class="debug-join-btn" bindtap="handleJoinByRoomId">加入</view>
  </view>
</view>

<view class="container">
  <view class="content">
    <view class="title-section">
      <text class="main-title">脑暴工作坊</text>
      <text class="sub-title">创建或加入房间，开始头脑风暴</text>
    </view>

    <view class="action-cards">
      <view
        class="action-card action-card-primary"
        bindtap="handleCreateRoom"
      >
        <view class="card-icon create-icon">✨</view>
        <text class="card-title">创建房间</text>
        <text class="card-desc">新建脑暴房间，邀请成员扫码加入</text>
        <view class="card-btn {{loading ? 'card-btn-disabled' : ''}}">
          {{loading ? '创建中…' : '立即创建'}}
        </view>
      </view>

      <view class="action-card action-card-join">
        <view class="card-icon join-icon">📲</view>
        <text class="card-title">加入房间</text>
        <text class="card-desc">扫描二维码或输入房间号加入已有房间</text>
        <!-- 验证码风格 8 位房间号输入：点击整块区域即可聚焦输入 -->
        <view class="room-code-wrapper" bindtap="onRoomCodeTap">
          <view class="room-code-box">
            <block wx:for="{{8}}" wx:key="index">
              <view class="room-code-slot {{(index === 3) ? 'room-code-slot-gap' : ''}}">
                <text class="room-code-char">
                  {{ inputRoomId[index] || '' }}
                </text>
              </view>
            </block>
          </view>
          <input
            class="room-code-input"
            type="number"
            maxlength="8"
            focus="{{inputFocused}}"
            value="{{inputRoomId}}"
            bindinput="onInputRoomId"
            bindblur="onRoomCodeBlur"
            placeholder="请输入 8 位房间号"
            placeholder-class="room-code-placeholder"
          />
        </view>
        <view class="join-btn-row">
          <view class="card-btn card-btn-outline" data-action="scan" bindtap="handleJoinAction">扫码加入</view>
        </view>
      </view>
    </view>
  </view>
</view>

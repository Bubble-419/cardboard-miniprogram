.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fbfa 0%, #e9f5e9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.content {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 标题区域 */
.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.main-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #5ec159;
  margin-bottom: 24rpx;
  text-align: center;
}

.sub-title {
  font-size: 30rpx;
  color: #666666;
  text-align: center;
  line-height: 1.5;
}

/* 操作卡片 */
.action-cards {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.action-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(94, 193, 89, 0.15);
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.action-card:active {
  transform: scale(0.98);
}

.action-card-primary {
  border: 2rpx solid rgba(94, 193, 89, 0.3);
}

.action-card-secondary {
  border: 2rpx solid rgba(150, 150, 150, 0.2);
}

.card-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  line-height: 1;
}

.create-icon {
  color: #5ec159;
}

.scan-icon {
  color: #5ec159;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  text-align: center;
}

.card-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.card-btn {
  padding: 24rpx 64rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  background-color: #5ec159;
  color: #ffffff;
}

.card-btn-outline {
  background-color: transparent;
  color: #5ec159;
  border: 2rpx solid #5ec159;
}

.card-btn-disabled {
  opacity: 0.7;
}

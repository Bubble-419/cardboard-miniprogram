.container {
  min-height: 100vh;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 24rpx;
}

.hint {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 64rpx;
  line-height: 1.5;
}

.create-btn {
  width: 100%;
  max-width: 480rpx;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #5ec159;
  color: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  border: none;
}

.create-btn[disabled] {
  opacity: 0.7;
}

.create-btn::after {
  border: none;
}

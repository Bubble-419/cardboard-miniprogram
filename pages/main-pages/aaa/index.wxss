.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f9f1 0%, #f8fafc 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.main-header {
  flex-shrink: 0;
  padding: 0 48rpx 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.online-dot {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 24rpx;
  height: 24rpx;
  background-color: #4ade80;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 45rpx;
}

.main-scroll {
  flex: 1;
  height: 0;
}

.hero-section {
  display: flex;
  align-items: center;
  padding: 0 48rpx;
  height: 254rpx;
  box-sizing: border-box;
}

.hero-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.hero-title {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.hero-title-bold {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.2;
  letter-spacing: -0.9rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #333333;
  line-height: 1.4;
}

.hero-illustration {
  width: 310rpx;
  height: 254rpx;
  flex-shrink: 0;
  opacity: 0.26;
  margin-left: -12rpx;
}

.action-section {
  padding: 0 40rpx;
  margin-bottom: 48rpx;
}

.control-card {
  background-color: #ffffff;
  border-radius: 64rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.card-top-row {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  margin-bottom: 26rpx;
}

.workshop-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.workshop-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 56rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.workshop-desc {
  font-size: 24rpx;
  font-weight: 500;
  color: #9ca3af;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-bar {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  padding: 16rpx 0 16rpx 12rpx;
  background-color: #f9fafb;
  border-radius: 9999rpx;
  margin-left: 16rpx;
}

.status-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #9ca3af;
  line-height: 32rpx;
  padding-right: 20rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 20rpx;
  background-color: #e0f3e0;
  border-radius: 40rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #5ec159;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #5ec159;
  line-height: 32rpx;
  white-space: nowrap;
}

.btn-grid {
  display: flex;
  gap: 14rpx;
}

.btn-grid-single {
  display: block;
}

.action-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  padding: 26rpx 24rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.action-btn-full {
  width: 100%;
}

.action-btn-primary {
  background-color: #5ec159;
}

.action-btn-outline {
  background-color: #ffffff;
  border: 2rpx solid #2fb037;
}

.action-btn-disabled {
  opacity: 0.7;
}

.action-btn:active {
  opacity: 0.9;
}

.btn-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-icon-wrap-light {
  /* 圆圈造型已内含在 SVG 图标中，无需额外边框 */
}

.btn-icon {
  width: 60rpx;
  height: 60rpx;
}

.btn-text-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.btn-text-group-center {
  align-items: center;
}

.btn-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.3;
}

.btn-title-light {
  color: #ffffff;
}

.btn-title-green {
  color: #5ec159;
}

.btn-desc {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
  color: #9ca3af;
}

.btn-desc-light {
  color: rgba(255, 255, 255, 0.85);
}

.history-section {
  padding: 0 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.history-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  line-height: 56rpx;
}

.history-sort {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.history-sort-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #9ca3af;
  line-height: 40rpx;
}

.history-sort-icon {
  width: 32rpx;
  height: 32rpx;
}

.history-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 32rpx;
}

.empty-illustration {
  width: 318rpx;
  height: 318rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  line-height: 48rpx;
  margin-bottom: 4rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 32rpx;
  text-align: center;
}

.history-grid {
  display: flex;
  gap: 12rpx;
}

.history-column {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.history-card-header {
  margin-bottom: 28rpx;
}

.history-card-title-wrap {
  margin-bottom: 8rpx;
}

.history-card-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #000000;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.history-card-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.history-card-creator,
.history-card-time {
  font-size: 20rpx;
  font-weight: 500;
  color: #666666;
  line-height: 1.22;
}

.history-card-body {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.ai-summary-label {
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.ai-summary-text {
  font-size: 20rpx;
  color: #666666;
  line-height: 1.22;
}

.ai-sparkle-icon {
  width: 19rpx;
  height: 18rpx;
}

.ai-summary-content {
  font-size: 24rpx;
  color: #393939;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.history-card-cover {
  width: 100%;
  height: 195rpx;
  border-radius: 8rpx;
  display: block;
}

.history-footer {
  display: flex;
  align-items: center;
  padding-top: 32rpx;
  gap: 0;
}

.footer-divider {
  flex: 1;
  height: 2rpx;
  background-color: #e5e7eb;
}

.footer-text {
  flex-shrink: 0;
  padding: 0 32rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #d1d5db;
  line-height: 32rpx;
}

/* 调试用：输入房间号加入（fixed 不占布局，后续会移除） */
.debug-join-bar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #e5e7eb;
  box-sizing: border-box;
}

.debug-join-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #111827;
  background-color: #f3f4f6;
  border-radius: 12rpx;
}

.debug-join-btn {
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background-color: #5ec159;
  border-radius: 12rpx;
}

.debug-join-btn:active {
  opacity: 0.85;
}

/* DEV_TEST_START: 输入房间号加入（测试用） */
.dev-join-room {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed #f59e0b;
  border-radius: 24rpx;
  background: #fffbeb;
  box-sizing: border-box;
}

.dev-join-label {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  margin-bottom: 12rpx;
}

.dev-join-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dev-join-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 1rpx solid #fcd34d;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.dev-join-placeholder {
  color: #d1d5db;
}

.dev-join-btn {
  flex-shrink: 0;
  width: 140rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 16rpx;
  background: #f59e0b;
  color: #fff;
  font-size: 28rpx;
  line-height: 72rpx;
  text-align: center;
}

.dev-join-btn::after {
  border: none;
}
/* DEV_TEST_END */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fbfa 0%, #e9f5e9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.content {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.main-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #5ec159;
  margin-bottom: 24rpx;
  text-align: center;
}

.sub-title {
  font-size: 30rpx;
  color: #666666;
  text-align: center;
  line-height: 1.5;
}

.role-status {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(94, 193, 89, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.role-status-label {
  font-size: 28rpx;
  color: #999999;
}

.role-status-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.scan-entry {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(94, 193, 89, 0.15);
  border: 2rpx solid rgba(94, 193, 89, 0.2);
  box-sizing: border-box;
}

.scan-entry:active {
  transform: scale(0.98);
}

.scan-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: rgba(94, 193, 89, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.scan-icon {
  font-size: 64rpx;
  line-height: 1;
}

.scan-label {
  font-size: 30rpx;
  color: #5ec159;
  font-weight: 500;
}

.room-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(94, 193, 89, 0.15);
  border: 2rpx solid rgba(94, 193, 89, 0.2);
  box-sizing: border-box;
}

.room-card-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 32rpx;
}

.room-info-row {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.room-info-row:last-child {
  margin-bottom: 0;
}

.room-info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.room-info-value {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
}

.room-info-desc {
  color: #666666;
}

.link-section {
  width: 100%;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
}

.primary-btn:active {
  opacity: 0.85;
}

.primary-btn-disabled {
  opacity: 0.7;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-panel {
  width: 100%;
  max-height: 85vh;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  line-height: 1;
  padding: 0 8rpx;
}

.modal-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.modal-action-card {
  width: 100%;
  background-color: #f8fbfa;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid rgba(150, 150, 150, 0.15);
  box-sizing: border-box;
}

.modal-action-primary {
  border-color: rgba(94, 193, 89, 0.3);
  background-color: #ffffff;
}

.modal-action-primary:active {
  transform: scale(0.98);
}

.modal-card-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}

.modal-card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.modal-card-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.room-code-wrapper {
  position: relative;
  width: 100%;
  margin-top: 24rpx;
  overflow: hidden;
}

.room-code-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
}

.room-code-slot {
  position: relative;
  width: 56rpx;
  margin: 0 8rpx;
  border-bottom: 5rpx solid #707E93;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 64rpx;
  padding-bottom: 6rpx;
}

.room-code-slot-active {
  border-bottom-color: #5ec159;
}

.room-code-slot-gap {
  margin-right: 40rpx;
}

.room-code-char {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1;
}

.room-code-input {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 1px;
  height: 1px;
  min-height: 0;
  padding: 0;
  margin: 0;
  font-size: 1px;
  line-height: 1px;
  opacity: 0;
  color: transparent;
  caret-color: transparent;
  background: transparent;
  border: none;
  outline: none;
  overflow: hidden;
}

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fbfa 0%, #e9f5e9 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.content {
  width: 100%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 标题区域 */
.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.main-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #5ec159;
  margin-bottom: 24rpx;
  text-align: center;
}

.sub-title {
  font-size: 30rpx;
  color: #666666;
  text-align: center;
  line-height: 1.5;
}

/* 操作卡片 */
.action-cards {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.action-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(94, 193, 89, 0.15);
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.action-card-primary:active {
  transform: scale(0.98);
}

.action-card-primary {
  border: 2rpx solid rgba(94, 193, 89, 0.3);
}

.action-card-secondary {
  border: 2rpx solid rgba(150, 150, 150, 0.2);
}

.card-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  line-height: 1;
}

.create-icon {
  color: #5ec159;
}

.scan-icon,
.join-icon {
  color: #5ec159;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  text-align: center;
}

.card-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.card-btn {
  padding: 24rpx;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  background-color: #5ec159;
  color: #ffffff;
}

.card-btn-outline {
  background-color: transparent;
  color: #5ec159;
  border: 2rpx solid #5ec159;
}

.card-btn-disabled {
  opacity: 0.7;
}

/* 加入房间卡片 */
.action-card-join {
  align-items: center;
  border: 2rpx solid rgba(150, 150, 150, 0.2);
}

.action-card-join .room-id-input,
.action-card-join .join-btn-row {
  align-self: stretch;
  width: 100%;
}

.join-btn-row {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
  width: 100%;
  justify-content: center;
}

.join-btn-row .card-btn {
  flex: 1;
  text-align: center;
}

/* 验证码风格房间号输入 */
.room-code-wrapper {
  position: relative;
  width: 100%;
  margin: 24rpx 0 32rpx;
  overflow: hidden;
}

.room-code-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 32rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
}

.room-code-slot {
  position: relative;
  width: 56rpx;
  margin: 0 8rpx;
  border-bottom: 5rpx solid #707E93;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 64rpx;
  padding-bottom: 6rpx;
}

.room-code-slot-active {
  border-bottom-color: #5ec159;
}

/* 第 4 个之后增加额外间距，视觉上形成 4-4 分组 */
.room-code-slot-gap {
  margin-right: 40rpx;
}

.room-code-char {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1;
}

.room-code-input {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 1px;
  height: 1px;
  min-height: 0;
  padding: 0;
  margin: 0;
  font-size: 1px;
  line-height: 1px;
  opacity: 0;
  color: transparent;
  caret-color: transparent;
  background: transparent;
  border: none;
  outline: none;
  overflow: hidden;
}

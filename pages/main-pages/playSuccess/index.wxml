<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="handleGoBack">
        <text class="back-chevron">‹</text>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="content">
    <view class="success-badge-wrap">
      <view class="success-ring ring-1"></view>
      <view class="success-ring ring-2"></view>
      <view class="success-core">✓</view>
    </view>
    <text class="main-text">恭喜出牌成功</text>
    <text class="sub-text">通过人数 {{passCount}} / {{memberCount}}</text>
  </view>

  <view class="footer" wx:if="{{isHost && !isWaiting}}">
    <button class="continue-btn" bindtap="handleContinue">继续</button>
  </view>
</view>

.container {
  min-height: 100vh;
  background: #f4fbf4;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.custom-navbar {
  background: #f4fbf4;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-chevron {
  font-size: 48rpx;
  color: #000;
  line-height: 1;
}

.navbar-title {
  flex: 1;
}

.navbar-right {
  width: 80rpx;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
}

.success-badge-wrap {
  width: 240rpx;
  height: 240rpx;
  position: relative;
  margin-bottom: 48rpx;
}

.success-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 3rpx solid #7fd67b;
  opacity: 0.5;
}

.ring-1 {
  animation: pulseRing 1.8s ease-out infinite;
}

.ring-2 {
  animation: pulseRing 1.8s ease-out infinite 0.9s;
}

.success-core {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #5ec159;
  color: #fff;
  font-size: 84rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(94, 193, 89, 0.35);
}

.main-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #35a940;
}

.sub-text {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #6a7a6a;
}

.next-player-wrap {
  margin-top: 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.next-player-title {
  font-size: 30rpx;
  color: #4f9f54;
  font-weight: 600;
}

.next-player-card {
  min-width: 320rpx;
  padding: 20rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(94, 193, 89, 0.14);
}

.next-player-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #eaf7ea;
}

.next-player-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.next-player-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c6831;
}

.next-player-me {
  font-size: 30rpx;
  color: #5ec159;
  font-weight: 600;
}

.footer {
  padding: 24rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
}

.continue-btn {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 16rpx;
  background: #5ec159;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0;
}

.continue-btn::after {
  border: none;
}

@keyframes pulseRing {
  0% {
    transform: scale(0.88);
    opacity: 0.55;
  }
  70% {
    transform: scale(1.25);
    opacity: 0;
  }
  100% {
    transform: scale(1.25);
    opacity: 0;
  }
}

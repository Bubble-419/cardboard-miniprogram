.container {
  min-height: 100vh;
  background-color: #F8FBFA;
  display: flex;
  flex-direction: column;
}

/* Page body */
.page-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 98rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.top-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Wait panel */
.wait-panel {
  padding: 40rpx 32rpx;
  background-color: #ffffff;
  border-radius: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.wait-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
}

.wait-desc {
  font-size: 28rpx;
  color: #6b7280;
}

.wait-problem {
  font-size: 28rpx;
  color: #374151;
  text-align: center;
  line-height: 1.5;
  margin-top: 12rpx;
}

/* Categories */
.categories-section {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.category-item {
  width: calc(50% - 4rpx);
  padding: 4rpx 32rpx;
  background-color: #E9F5E9;
  border: 2rpx solid #68D062;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.category-item.selected {
  background-color: rgba(94, 193, 89, 0.3);
  border-color: #5EC159;
}

.category-label {
  font-size: 20rpx;
  font-weight: 500;
  color: #5EC159;
  line-height: 30rpx;
}

.category-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #1E293B;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Input card */
.input-card {
  border-radius: 80rpx;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  box-sizing: border-box;
}

.card-title-section {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.card-title {
  font-size: 48rpx;
  font-weight: 500;
  color: #0F172A;
  line-height: 60rpx;
  text-align: left;
}

.card-subtitle {
  font-size: 24rpx;
  font-weight: 500;
  color: #94A3B8;
  line-height: 39rpx;
  padding-bottom: 10rpx;
  text-align: left;
}

/* Example box */
.example-box {
  background-color: rgba(243, 255, 240, 0.5);
  border: 2rpx solid #F3FFF0;
  border-radius: 32rpx;
  padding: 12rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}

.example-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.example-icon-wrap {
  width: 40rpx;
  height: 40rpx;
  background-color: #5EC159;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.example-icon {
  width: 24rpx;
  height: 24rpx;
}

.example-label-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #5EC159;
  line-height: 32rpx;
  text-align: left;
}

.example-content {
  font-size: 28rpx;
  font-weight: 500;
  color: #395338;
  line-height: 42rpx;
  text-align: left;
}

/* Form input */
.form-input-wrap {
  position: relative;
  width: 100%;
}

.textarea-box {
  background-color: #ffffff;
  border: 2rpx solid rgba(76, 175, 80, 0.3);
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.problem-input {
  width: 100%;
  height: 320rpx;
  font-size: 28rpx;
  color: #3F3F3F;
  line-height: 1.5;
  box-sizing: border-box;
}

.input-placeholder {
  color: #CBD5E1;
  font-size: 28rpx;
}

.counter-row {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.char-count {
  font-size: 24rpx;
  color: #CBD5E1;
}

.submit-circle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.submit-circle:active {
  opacity: 0.8;
}

.submit-arrow-img {
  width: 52rpx;
  height: 52rpx;
}

/* Footer */
.footer-action {
  padding: 32rpx 0 48rpx;
}

.next-btn {
  width: 100%;
  height: 112rpx;
  background-color: #5EC159;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.next-btn:active {
  opacity: 0.85;
}

.next-btn-text {
  font-size: 60rpx;
  color: #ffffff;
  font-weight: 400;
  letter-spacing: 4rpx;
}

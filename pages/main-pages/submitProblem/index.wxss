.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  padding-bottom: 40rpx;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left,
.navbar-right {
  width: 174rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #2d2d2d;
  text-align: center;
  flex: 1;
}

.team-section {
  display: flex;
  align-items: center;
  padding: 0 42rpx;
  min-height: 72rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.team-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.workshop-name {
  font-size: 32rpx;
  color: #374151;
  flex-shrink: 0;
}

.progress-bar {
  padding: 16rpx 42rpx 0;
}

.progress-text {
  font-size: 26rpx;
  color: #6b7280;
}

.wait-panel {
  margin: 40rpx 42rpx 0;
  padding: 40rpx 32rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.wait-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
}

.wait-desc {
  font-size: 28rpx;
  color: #6b7280;
}

.wait-problem {
  font-size: 28rpx;
  color: #374151;
  text-align: center;
  line-height: 1.5;
  margin-top: 12rpx;
}

.categories-section {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 20rpx 41rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  width: 100%;
}

.category-item {
  height: 68rpx;
  padding: 0 20rpx;
  background-color: #e9f5e9;
  border: 2rpx solid #5ec159;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 0 0 calc((100% - 10rpx) / 2);
  min-width: 0;
  box-sizing: border-box;
  max-width: calc((100% - 10rpx) / 2);
}

.category-item.selected {
  background-color: rgba(94, 193, 89, 0.25);
}

.category-icon {
  width: 28rpx;
  height: 28rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #5ec159;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submit-section {
  padding: 40rpx 42rpx 0;
}

.submit-header {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  margin-bottom: 20rpx;
  padding-left: 40rpx;
}

.character-icon {
  width: 158rpx;
  height: 202rpx;
  background-color: #4fc8e7;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.character-face {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye {
  width: 32rpx;
  height: 32rpx;
  background-color: #ffffff;
  border-radius: 50%;
  position: absolute;
  top: 40%;
}

.eye-left {
  left: 25%;
  transform: translate(-50%, -50%);
}

.eye-right {
  right: 25%;
  transform: translate(50%, -50%);
}

.mouth {
  width: 22rpx;
  height: 11rpx;
  border: 2rpx solid #ffffff;
  border-top: none;
  border-radius: 0 0 22rpx 22rpx;
  position: absolute;
  bottom: 30%;
  left: 50%;
  transform: translateX(-50%);
}

.header-text {
  font-size: 44rpx;
  font-weight: 600;
  color: #5ec159;
  flex: 1;
  line-height: 1.5;
  padding-top: 20rpx;
}

.example-text {
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.example-label,
.example-content {
  font-size: 24rpx;
  color: #747474;
}

.input-container {
  position: relative;
  background-color: #ffffff;
  border: 2rpx solid #5ec159;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  min-height: 200rpx;
  box-sizing: border-box;
}

.problem-input {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #3f3f3f;
  line-height: 1.5;
  box-sizing: border-box;
}

.input-placeholder {
  color: #9a9a9a;
  font-size: 28rpx;
}

.input-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 20rpx;
}

.char-count {
  font-size: 32rpx;
  color: #a7a7a7;
}

.submit-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #5ec159;
  border-radius: 50%;
}

.submit-icon:active {
  opacity: 0.8;
}

.icon-img {
  width: 26rpx;
  height: 26rpx;
}

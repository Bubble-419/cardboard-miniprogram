<view class="container">
  <!-- 顶部区：TopBar + 情境格（固定在滚动区之外，避免随内容滚走） -->
  <view class="header-section">
    <player-top-bar
      avatarList="{{avatarList}}"
      maxVisible="{{5}}"
      bind:goroom="handleGoRoom"
    />

    <!-- 情境展示：点击跳转确认情境页（只读回看） -->
    <view class="context-entry" hover-class="context-entry-hover">
      <context-display items="{{categories}}" bind:opentap="handleViewContext" />
    </view>
  </view>

  <view class="main-body" catchtouchmove="preventTouchMove">

    <!-- 主内容区（未提交状态） -->
    <view class="content-section" wx:if="{{!hasSubmitted}}">

      <!-- 标题区 -->
      <view class="title-section">
        <text class="page-title">匿名提交您的设计问题</text>
      </view>

      <!-- 输入区域 -->
      <view class="input-area">

        <!-- 示例框 -->
        <view class="example-box">
          <view class="example-header-row">
            <view class="example-icon-wrap">
              <image class="example-icon" src="/assets/icons/icon-example-hint.svg" mode="aspectFit" />
            </view>
            <text class="example-label-text">设计问题示例</text>
          </view>
          <text class="example-content">如何帮助用户在驾驶过程中快速进行导航切换？</text>
        </view>

        <!-- 输入框 + 字数计数 + 提交图标 -->
        <view class="form-input-wrap">
          <view class="textarea-box">
            <textarea
              class="problem-input"
              placeholder="请输入设计问题..."
              value="{{problemText}}"
              maxlength="{{maxLength}}"
              adjust-position="{{true}}"
              show-confirm-bar="{{false}}"
              bindfocus="onInputFocus"
              bindblur="onInputBlur"
              bindinput="onInput"
              placeholder-class="input-placeholder"
            />
          </view>
          <view class="counter-row">
            <text class="char-count">{{problemText.length}}/{{maxLength}}</text>
            <image
              class="submit-icon"
              src="/assets/icons/icon-submit-arrow.svg"
              mode="aspectFit"
              bindtap="submitProblem"
            />
          </view>
        </view>
      </view>
    </view>

    <!-- 已提交等待状态（Figma #5912:50988） -->
    <view class="wait-panel" wx:if="{{hasSubmitted}}">
      <image
        class="wait-empty-illus"
        src="/assets/submitProblem/empty-wait-problems.svg"
        mode="aspectFit"
      />
      <text class="wait-empty-text">等待所有玩家提交设计问题...</text>
    </view>

  </view>

  <!-- 固定底部按钮 -->
  <page-footer
    wx:if="{{!hasSubmitted}}"
    extClass="footer-action"
    showPrev="{{false}}"
  >
    <button class="confirm-btn" bindtap="submitProblem">确认问题</button>
  </page-footer>
</view>

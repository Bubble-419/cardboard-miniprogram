<view class="container">
  <scroll-view
    class="main-scroll"
    scroll-y="{{!inputFocused}}"
    show-scrollbar="{{false}}"
  >

    <!-- 顶部区：TopBar + 情境格 -->
    <view class="header-section" style="padding-top: {{navbarPaddingTop}}px">

      <!-- TopBar：房间入口 + 成员头像 -->
      <view class="topbar">
        <view class="room-entry" bindtap="handleGoRoom">
          <image class="room-entry-icon" src="/assets/icons/icon-room-entry.svg" mode="aspectFit" />
        </view>
        <view class="avatar-bar">
          <user-list
            avatarList="{{avatarList}}"
            enableAdd="{{false}}"
            isFold="{{true}}"
            showName="{{false}}"
            layout="stack"
          />
        </view>
      </view>

      <!-- 情境展示 -->
      <context-display items="{{categories}}" />
    </view>

    <!-- 主内容区（未提交状态） -->
    <view class="content-section" wx:if="{{!hasSubmitted}}">

      <!-- 标题区 -->
      <view class="title-section">
        <text class="page-title">匿名提交您的设计问题</text>
      </view>

      <!-- 输入区域 -->
      <view class="input-area">

        <!-- 示例框 -->
        <view class="example-box">
          <view class="example-header-row">
            <view class="example-icon-wrap">
              <image class="example-icon" src="/assets/icons/icon-example-hint.svg" mode="aspectFit" />
            </view>
            <text class="example-label-text">设计问题示例</text>
          </view>
          <text class="example-content">如何帮助用户在驾驶过程中快速进行导航切换？</text>
        </view>

        <!-- 输入框 + 字数计数 + 提交图标 -->
        <view class="form-input-wrap" catchtouchmove="preventTouchMove">
          <view class="textarea-box">
            <textarea
              class="problem-input"
              placeholder="请输入设计问题..."
              value="{{problemText}}"
              maxlength="{{maxLength}}"
              adjust-position="{{true}}"
              show-confirm-bar="{{false}}"
              bindfocus="onInputFocus"
              bindblur="onInputBlur"
              bindinput="onInput"
              placeholder-class="input-placeholder"
            />
          </view>
          <view class="counter-row">
            <text class="char-count">{{problemText.length}}/{{maxLength}}</text>
            <image
              class="submit-icon"
              src="/assets/icons/icon-submit-arrow.svg"
              mode="aspectFit"
              bindtap="submitProblem"
            />
          </view>
        </view>
      </view>
    </view>

    <!-- 已提交等待状态 -->
    <view class="wait-panel" wx:if="{{hasSubmitted}}">
      <text class="wait-title">已提交设计问题</text>
      <text class="wait-desc">等待其他成员提交后进入选择问题</text>
      <text class="wait-problem">{{problemText}}</text>
    </view>

  </scroll-view>

  <!-- 固定底部按钮 -->
  <page-footer
    wx:if="{{!hasSubmitted}}"
    extClass="footer-action"
    showPrev="{{false}}"
  >
    <button class="confirm-btn" bindtap="submitProblem">确认问题</button>
  </page-footer>
</view>

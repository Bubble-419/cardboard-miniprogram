.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  padding-bottom: 200rpx;
}

/* 自定义导航栏 */
.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.content {
  padding: 80rpx 54rpx 0;
}

.headline {
  font-size: 44rpx;
  font-weight: 500;
  color: #5ec159;
  margin-bottom: 24rpx;
}

.subtext {
  font-size: 28rpx;
  color: #565656;
  line-height: 1.6;
  margin-bottom: 80rpx;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.primary-btn::after {
  border: none;
}

.primary-btn:active {
  opacity: 0.85;
}

.tips {
  margin-top: 32rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.5;
}

.debug-info {
  margin-top: 40rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background-color: #fff7f7;
}

.debug-title {
  font-size: 24rpx;
  color: #b91c1c;
}

.debug-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ef4444;
  word-break: break-all;
}


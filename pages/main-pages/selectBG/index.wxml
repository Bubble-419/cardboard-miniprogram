<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image class="back-icon" src="/assets/icons/miniprogram-btn.png" mode="aspectFit" bindtap="goBack"></image>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right">
        <view class="navbar-icon">⋯</view>
        <view class="navbar-icon">○</view>
      </view>
    </view>
  </view>

  <!-- 步骤条 -->
  <view class="stepper">
    <view class="stepper-line"></view>
    <view class="step-item {{currentStep === 0 ? 'active' : ''}}" data-step="0" bindtap="onTapStep">
      <view class="step-circle {{currentStep === 0 ? 'active' : ''}}">1</view>
      <text class="step-text">场景</text>
    </view>
    <view class="step-item {{currentStep === 1 ? 'active' : ''}}" data-step="1" bindtap="onTapStep">
      <view class="step-circle {{currentStep === 1 ? 'active' : ''}}">2</view>
      <text class="step-text">用户</text>
    </view>
    <!-- 当前版本不需要，之后会恢复
    <view class="step-item {{currentStep === 2 ? 'active' : ''}}" data-step="2" bindtap="onTapStep">
      <view class="step-circle {{currentStep === 2 ? 'active' : ''}}">3</view>
      <text class="step-text">平台</text>
    </view>
    -->
    <view class="step-item {{currentStep === 2 ? 'active' : ''}}" data-step="2" bindtap="onTapStep">
      <view class="step-circle {{currentStep === 2 ? 'active' : ''}}">3</view>
      <text class="step-text">功能</text>
    </view>
  </view>

  <!-- 卡片 swiper -->
  <view class="cards-wrap">
    <swiper
      class="cards-swiper"
      current="{{currentStep}}"
      bindchange="onSwiperChange"
      previous-margin="54rpx"
      next-margin="54rpx"
      easing-function="easeOutCubic"
    >
      <swiper-item class="card-item">
        <view class="card-padding">
          <bg-card type="scene" value="{{bg.scene}}" active="{{currentStep === 0}}" bind:input="onCardInput" bind:next="onNextCard"></bg-card>
        </view>
      </swiper-item>
      <swiper-item class="card-item">
        <view class="card-padding">
          <bg-card type="user" value="{{bg.user}}" active="{{currentStep === 1}}" bind:input="onCardInput" bind:next="onNextCard"></bg-card>
        </view>
      </swiper-item>
      <!-- 当前版本不需要，之后会恢复
      <swiper-item class="card-item">
        <view class="card-padding">
          <bg-card type="platform" value="{{bg.platform}}" active="{{currentStep === 2}}" bind:input="onCardInput" bind:next="onNextCard"></bg-card>
        </view>
      </swiper-item>
      -->
      <swiper-item class="card-item">
        <view class="card-padding">
          <bg-card type="function" value="{{bg.function}}" active="{{currentStep === 2}}" bind:input="onCardInput" bind:next="onNextCard"></bg-card>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 底部确认按钮 -->
  <view class="footer">
    <button class="confirm-btn {{canConfirm ? 'enabled' : ''}}" disabled="{{!canConfirm}}" bindtap="confirmBG">确认情境</button>
  </view>
</view>
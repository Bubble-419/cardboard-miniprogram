<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar" style="padding-top: {{navbarPaddingTop}}px">
    <view class="navbar-content">
      <view class="navbar-left">
        <view class="room-entry" bindtap="handleGoRoom">
          <image class="room-entry-icon" src="/assets/icons/icon-room-entry.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 步骤条 -->
  <view class="stepper">
    <view class="stepper-line"></view>
    <view
      class="step-item {{currentStep === index ? 'active' : ''}}"
      wx:for="{{steps}}"
      wx:key="type"
      data-step="{{index}}"
      bindtap="onTapStep"
    >
      <view class="step-circle {{currentStep === index ? 'active' : ''}}">{{index + 1}}</view>
      <text class="step-text">{{item.label}}</text>
    </view>
  </view>

  <!-- 卡片 swiper -->
  <view class="cards-wrap">
    <swiper
      class="cards-swiper"
      current="{{currentStep}}"
      bindchange="onSwiperChange"
      previous-margin="54rpx"
      next-margin="54rpx"
      easing-function="easeOutCubic"
    >
      <swiper-item class="card-item" wx:for="{{steps}}" wx:key="type">
        <view class="card-padding">
          <bg-card
            type="{{item.type}}"
            value="{{bg[item.type]}}"
            active="{{currentStep === index}}"
            isLast="{{index === steps.length - 1}}"
            bind:input="onCardInput"
            bind:next="onNextCard"
          ></bg-card>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 底部确认按钮 -->
  <page-footer extClass="footer" bind:prev="goBack">
    <button class="confirm-btn {{canConfirm ? 'enabled' : ''}}" disabled="{{!canConfirm}}" bindtap="confirmBG">确认情境</button>
  </page-footer>
</view>

.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  padding-bottom: 220rpx;
}

/* 自定义导航栏 */
.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 步骤条 */
.stepper {
  position: relative;
  height: 110rpx;
  background-color: #ffffff;
  padding: 18rpx 54rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.stepper-line {
  position: absolute;
  left: 90rpx;
  right: 90rpx;
  top: 38rpx;
  height: 2rpx;
  background-color: #e5e5e5;
}

.step-item {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  z-index: 1;
}

.step-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  border: 2rpx solid #e5e5e5;
  color: #c2c2c2;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.step-circle.active {
  border-color: #5ec159;
  color: #5ec159;
}

.step-text {
  font-size: 24rpx;
  color: #7b7b7b;
}

/* 卡片区域 */
.cards-wrap {
  padding-top: 20rpx;
}

.cards-swiper {
  height: 520rpx;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-padding {
  width: 100%;
  padding: 0 22rpx;
  box-sizing: border-box;
}

/* 底部确认 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background-color: transparent;
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  background-color: #c0c0c0;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 44rpx;
  font-weight: 400;
  border: none;
  letter-spacing: 4rpx;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.enabled {
  background-color: #5ec159;
}

/* 输入弹层 */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 99;
}

.input-modal {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  z-index: 100;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.18);
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.input-title {
  font-size: 30rpx;
  color: #111827;
  font-weight: 600;
}

.input-close {
  font-size: 40rpx;
  color: #9ca3af;
  padding: 0 10rpx;
}

.input-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f3f3f3;
  border-radius: 18rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #374151;
}

.input-save {
  margin-top: 18rpx;
  width: 100%;
  height: 84rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 32rpx;
  border: none;
}

.input-save::after {
  border: none;
}


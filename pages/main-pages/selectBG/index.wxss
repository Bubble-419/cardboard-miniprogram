/* ===== 页面容器 ===== */
.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  display: flex;
  flex-direction: column;
  padding-bottom: 220rpx;
}

/* ===== 自定义导航栏 ===== */
.custom-navbar {
  background: transparent;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.room-entry {
  width: 74rpx;
  height: 74rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1f2937;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 80rpx;
}

/* ===== 步骤条 ===== */
.stepper {
  position: relative;
  padding: 0 60rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  margin: 0 40rpx 8rpx;
}

/* 与数字圆圈（48rpx）水平中线对齐：top = 圆圈半径 */
.stepper-line {
  position: absolute;
  left: 90rpx;
  right: 90rpx;
  top: 24rpx;
  transform: translateY(-50%);
  height: 2rpx;
  background-color: rgba(94, 193, 89, 0.25);
}

.step-item {
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 1;
}

.step-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background-color: #f8fbfa;
  border: 2rpx solid rgba(94, 193, 89, 0.3);
  color: #b0c9b0;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: background 0.3s, border-color 0.3s, color 0.3s;
}

.step-circle.active {
  background-color: #5ec159;
  border-color: #5ec159;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(94, 193, 89, 0.4);
}

.step-text {
  font-size: 22rpx;
  color: #aab8aa;
}

.step-item.active .step-text {
  color: #5ec159;
  font-weight: 500;
}

/* ===== 卡片 swiper 区 ===== */
.cards-wrap {
  padding-top: 8rpx;
  flex: 1;
}

.cards-swiper {
  height: 680rpx;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-padding {
  width: 100%;
  padding: 0 22rpx;
  box-sizing: border-box;
}

/* ===== 底部确认按钮 ===== */
.footer {
  padding: 24rpx 54rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(248, 251, 250, 0.98) 70%, transparent);
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  background-color: #d0e8d0;
  color: #9ec89e;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  letter-spacing: 4rpx;
  transition: background 0.3s, color 0.3s, box-shadow 0.3s;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.enabled {
  background: linear-gradient(135deg, #5ec159, #4db84a);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(94, 193, 89, 0.35);
}

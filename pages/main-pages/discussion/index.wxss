.container {
  min-height: 100vh;
  background-color: #fafafa;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #fff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  flex: 1;
  text-align: center;
}

.navbar-right {
  width: 80rpx;
}

.section {
  padding: 0 24rpx;
}

.top-section {
  background-color: #fff;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.content-section {
  flex: 1;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.discussion-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5EC159;
  margin-bottom: 40rpx;
  text-align: center;
}

.discussion-empty-img {
  width: 100%;
  flex: 1;
  min-height: 320rpx;
  display: block;
}

.footer-section {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.continue-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
  background-color: #5EC159;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.continue-btn::after {
  border: none;
}

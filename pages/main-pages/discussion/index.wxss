.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.navbar-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
}

.navbar-right {
  width: 80rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.section {
  padding: 0 24rpx;
  box-sizing: border-box;
}

.top-section {
  background-color: #ffffff;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  flex-shrink: 0;
}

.content-section {
  flex: 1;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.discussion-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #5EC159;
  margin-bottom: 40rpx;
  text-align: center;
  line-height: 1.4;
  display: block;
}

.discussion-empty-img {
  width: 80%;
  max-width: 600rpx;
  height: auto;
  display: block;
}

.footer-section {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  flex-shrink: 0;
}

.continue-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
  background-color: #5EC159;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.continue-btn::after {
  border: none;
}

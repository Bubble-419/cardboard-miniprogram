<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="handleGoBack">
        <text class="back-chevron">‹</text>
      </view>
      <view class="navbar-title">表态</view>
      <view class="navbar-right">
        <text class="navbar-icon">⋯</text>
        <text class="navbar-icon">◎</text>
      </view>
    </view>
  </view>

  <!-- 普通玩家：请用实体表态卡进行表态（与 awaitBG 等副屏等待页风格一致） -->
  <view class="waiting-content" wx:if="{{isWaiting}}">
    <view class="character-container">
      <view class="character-bg">
        <view class="character-icon">
          <view class="character-face">
            <view class="eye eye-left"></view>
            <view class="eye eye-right"></view>
            <view class="mouth"></view>
            <view class="foot foot-left"></view>
            <view class="foot foot-right"></view>
          </view>
        </view>
      </view>
    </view>
    <view class="main-text">请用实体表态卡进行表态</view>
    <view class="sub-text">等待主屏操作...</view>
  </view>

  <!-- 房主：表态操作区 -->
  <block wx:else>
  <view class="instruction">
    <text class="instruction-line">请用表态卡对{{currentPlayerName}}的行动表态</text>
    <text class="instruction-line">选择表态统计结果</text>
  </view>

  <view class="statement-buttons">
    <view class="statement-btn statement-btn-pass" bindtap="onStatementTap" data-type="all_pass">全部通过</view>
    <view class="statement-btn statement-btn-partial" bindtap="onStatementTap" data-type="partial_pass">部分通过</view>
    <view class="statement-btn statement-btn-question" bindtap="onStatementTap" data-type="all_question">全部疑问</view>
  </view>
  </block>
</view>

<view class="container">
  <view class="custom-navbar" style="padding-top: {{navbarPaddingTop}}px;">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="handleGoBack">
        <text class="back-chevron">‹</text>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 普通玩家：请用实体表态卡进行表态（与 awaitBG 等副屏等待页风格一致） -->
  <view class="waiting-content" wx:if="{{isWaiting}}">
    <view class="character-container">
      <view class="character-bg">
        <view class="character-icon">
          <view class="character-face">
            <view class="eye eye-left"></view>
            <view class="eye eye-right"></view>
            <view class="mouth"></view>
            <view class="foot foot-left"></view>
            <view class="foot foot-right"></view>
          </view>
        </view>
      </view>
    </view>
    <view class="main-text">请用实体表态卡进行表态</view>
    <view class="sub-text">等待主屏操作...</view>
  </view>

  <!-- 房主：表态操作区 -->
  <block wx:else>
  <view class="host-content">
    <view class="instruction">
      <text class="instruction-line">请用表态卡对出牌玩家的行动表态</text>
      <text class="instruction-line">选择共几人给出通过牌</text>
    </view>

    <view class="statement-buttons" wx:if="{{isPassOptionsReady}}">
      <block wx:for="{{passCountOptions}}" wx:key="*this">
        <view
          class="statement-btn {{selectedPassCount === item ? 'statement-btn-active' : ''}}"
          bindtap="onStatementTap"
          data-passcount="{{item}}"
        >
          {{item}}
        </view>
      </block>
    </view>
    <view class="statement-loading" wx:else>人数加载中...</view>

    <view class="confirm-wrap">
      <button
        class="confirm-btn {{selectedPassCount == null || !isPassOptionsReady ? 'confirm-btn-disabled' : ''}}"
        disabled="{{selectedPassCount == null || !isPassOptionsReady}}"
        bindtap="handleConfirm"
      >确认</button>
    </view>
  </view>
  </block>
</view>

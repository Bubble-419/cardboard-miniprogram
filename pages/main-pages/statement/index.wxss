.container {
  min-height: 100vh;
  background-color: #fff;
  padding-bottom: env(safe-area-inset-bottom);
}

.custom-navbar {
  background-color: #fff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-chevron {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  flex: 1;
  text-align: center;
}

.navbar-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
}

.navbar-icon {
  font-size: 36rpx;
  color: #000;
}

.instruction {
  padding: 48rpx 40rpx 56rpx;
  text-align: center;
}

.instruction-line {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #00a84a;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.instruction-line:last-child {
  margin-bottom: 0;
}

.statement-buttons {
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.statement-btn {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  color: #fff;
  box-sizing: border-box;
}

.statement-btn-pass {
  background-color: #00d468;
}

.statement-btn-partial {
  background-color: #9e9e9e;
}

.statement-btn-question {
  background-color: #212121;
}

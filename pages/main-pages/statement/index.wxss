.container {
  min-height: 100vh;
  background-color: #fafafa;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #fafafa;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-chevron {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  flex: 1;
  text-align: center;
}

.navbar-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
}

.navbar-icon {
  font-size: 36rpx;
  color: #000;
}

.instruction {
  padding: 48rpx 40rpx 56rpx;
  text-align: center;
}

.instruction-line {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #00a84a;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.instruction-line:last-child {
  margin-bottom: 0;
}

.statement-buttons {
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.statement-btn {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  color: #fff;
  box-sizing: border-box;
}

.statement-btn-pass {
  background-color: #00d468;
}

.statement-btn-partial {
  background-color: #9e9e9e;
}

.statement-btn-question {
  background-color: #212121;
}

/* 普通玩家等待状态（与 awaitBG 等副屏页面风格一致） */
.waiting-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.character-container {
  margin-bottom: 40rpx;
}

.character-bg {
  width: 438rpx;
  height: 294rpx;
  background-color: rgba(31, 177, 213, 0.15);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.character-icon {
  width: 128rpx;
  height: 120rpx;
  background-color: #4fc8e7;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.character-face {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye {
  width: 26rpx;
  height: 26rpx;
  background-color: #000000;
  border-radius: 50%;
  position: absolute;
  top: 40%;
}

.eye-left { left: 25%; transform: translate(-50%, -50%); }
.eye-right { right: 25%; transform: translate(50%, -50%); }

.mouth {
  width: 18rpx;
  height: 9rpx;
  border: 2rpx solid #000000;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  position: absolute;
  bottom: 30%;
  left: 50%;
  transform: translateX(-50%);
}

.foot {
  width: 34rpx;
  height: 32rpx;
  background-color: #000000;
  border-radius: 4rpx;
  position: absolute;
  bottom: 10%;
}

.foot-left { left: 20%; }
.foot-right { right: 20%; }

.main-text {
  font-size: 56rpx;
  color: #16a6ca;
  text-align: center;
  margin-bottom: 20rpx;
  font-weight: 500;
  line-height: 1.5;
}

.sub-text {
  font-size: 36rpx;
  color: #9a9a9a;
  text-align: center;
  line-height: 1.33;
}

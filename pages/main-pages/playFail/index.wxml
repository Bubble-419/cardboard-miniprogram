<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="handleGoBack">
        <text class="back-chevron">‹</text>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="content">
    <view class="fail-badge-wrap">
      <view class="fail-core">!</view>
    </view>
    <text class="main-text">出牌失败，请从牌区罚摸一张</text>
    <text class="sub-text">通过人数 {{passCount}} / {{memberCount}}</text>
    <view class="next-player-wrap" wx:if="{{nextPlayer}}">
      <text class="next-player-title">下一位翻牌玩家</text>
      <view class="next-player-card">
        <image class="next-player-avatar" src="{{nextPlayer.avatar}}" mode="aspectFill" />
        <view class="next-player-meta">
          <text class="next-player-name">{{nextPlayer.playerIndex}}号玩家</text>
          <text class="next-player-me" wx:if="{{nextPlayer.isMe}}">（我）</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer" wx:if="{{isHost && !isWaiting}}">
    <button class="continue-btn" bindtap="handleContinue">继续</button>
  </view>
</view>

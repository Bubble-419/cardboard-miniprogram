.orbit-wrap {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  animation: orbit-spin 9s linear infinite;
  z-index: 1;
  pointer-events: none;
}

.orbit-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background: #5ec159;

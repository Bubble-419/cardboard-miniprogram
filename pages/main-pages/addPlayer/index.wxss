.container {
  min-height: 100vh;
  background-color: #fff;
  padding-bottom: 200rpx;
}

.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.instruction-section {
  padding: 48rpx 54rpx 24rpx;
}

.instruction-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.instruction-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* 主视觉区：中央码 + 圆周成员 */
.main-visual {
  padding: 0 54rpx;
  display: flex;
  justify-content: center;
}

.circle-wrap {
  position: relative;
  width: 600rpx;
  height: 600rpx;
}

.qrcode-card {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 260rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.qrcode-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
}

.qrcode-placeholder {
  width: 220rpx;
  min-height: 220rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #5ec159;
  background-color: #f0fdf4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}

.qrcode-placeholder-text {
  font-size: 26rpx;
  color: #16a34a;
  text-align: center;
}

.qrcode-placeholder-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
  text-align: center;
  line-height: 1.4;
}

.qrcode-retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  line-height: 1.2;
  background: #5ec159;
  color: #fff;
  border: none;
  border-radius: 12rpx;
}

.qrcode-roomid {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 16rpx;
}

/* 圆周成员槽位 */
.avatar-slot {
  position: absolute;
  width: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx dashed #d1d5db;
  background: #f3f4f6;
}

.avatar-name {
  font-size: 24rpx;
  color: #374151;
  margin-top: 8rpx;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.placeholder-name {
  color: #9ca3af;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.primary-btn::after {
  border: none;
}

.primary-btn:active {
  opacity: 0.85;
}

/* PRD：整个页面白底 #fff */
.container {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* PRD：拖拽时页面让位，不滑动、不刷新，界面锁住 */
.container-dragging {
  height: 100vh;
  overflow: hidden;
  overflow-x: hidden;
  overflow-y: hidden;
  touch-action: none;
}

.drag-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: transparent;
  pointer-events: none;
}

/* PRD：拖拽时遮罩不拦截，保证同一根手指长按后可直接拖拽，不抢手势 */
.drag-mask-active {
  pointer-events: none;
}

.custom-navbar {
  flex-shrink: 0;
  width: 100%;
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.instruction-section {
  flex-shrink: 0;
  padding: 36rpx 54rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.instruction-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.instruction-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  text-align: center;
}

.instruction-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
  text-align: center;
}

.room-id-wrap {
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background-color: #f3f4f6;
  border-radius: 12rpx;
  flex-direction: row;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.room-id-label {
  font-size: 26rpx;
  color: #6b7280;
}

.room-id-value {
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
  word-break: break-all;
}

.content-area {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
}

.content-area-dragging {
  overflow: hidden;
  touch-action: none;
}

.main-stage {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  padding: 0 54rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

.circle-wrap {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  overflow: visible;
}

.deco-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 1rpx solid rgba(94, 193, 89, 0.15);
  transform: translate(-50%, -50%);
  animation: deco-ring-pulse 4s ease-in-out infinite;
  z-index: 0;
}

.deco-glow {
  z-index: 0;
}

.deco-particle {
  z-index: 0;
}

.deco-ring-1 {
  width: 520rpx;
  height: 520rpx;
  animation-delay: 0s;
}

.deco-ring-2 {
  width: 440rpx;
  height: 440rpx;
  animation-delay: 0.5s;
  border-color: rgba(94, 193, 89, 0.12);
}

.deco-ring-3 {
  width: 360rpx;
  height: 360rpx;
  animation-delay: 1s;
  border-color: rgba(94, 193, 89, 0.1);
}

.deco-ring-inner {
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(94, 193, 89, 0.08);
  animation: deco-ring-rotate 8s linear infinite;
}

.deco-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 240rpx;
  height: 240rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(94, 193, 89, 0.06) 0%, rgba(94, 193, 89, 0.02) 50%, transparent 70%);
  border-radius: 50%;
  animation: deco-glow-breathe 3s ease-in-out infinite;
}

.deco-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: rgba(94, 193, 89, 0.4);
  border-radius: 50%;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  animation: deco-particle-float 5s ease-in-out infinite;
  box-shadow: 0 0 12rpx rgba(94, 193, 89, 0.3);
}

.deco-particle-1 { animation-delay: 0s; margin-left: 180rpx; margin-top: -120rpx; }
.deco-particle-2 { animation-delay: 0.8s; margin-left: -200rpx; margin-top: -80rpx; }
.deco-particle-3 { animation-delay: 1.6s; margin-left: 220rpx; margin-top: 60rpx; }
.deco-particle-4 { animation-delay: 2.4s; margin-left: -160rpx; margin-top: 140rpx; }
.deco-particle-5 { animation-delay: 3.2s; margin-left: 0; margin-top: -220rpx; }
.deco-particle-6 { animation-delay: 4s; margin-left: 100rpx; margin-top: 200rpx; }

@keyframes deco-ring-pulse {
  0%, 100% {
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(0.98);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.02);
  }
}

@keyframes deco-ring-rotate {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@keyframes deco-glow-breathe {
  0%, 100% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }
}

@keyframes deco-particle-float {
  0%, 100% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(1.3);
  }
}

.qrcode-area {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 3;
}

.qrcode-card {
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.qrcode-circle-bg {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06), inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.qrcode-img {
  width: 200rpx;
  height: 200rpx;
}

.qrcode-placeholder {
  width: 200rpx;
  min-height: 200rpx;
  border: 2rpx dashed #5ec159;
  background-color: #f0fdf4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}

.qrcode-placeholder-text {
  font-size: 26rpx;
  color: #16a34a;
  text-align: center;
}

.qrcode-placeholder-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
  text-align: center;
  line-height: 1.4;
}

.qrcode-retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  line-height: 1.2;
  background: #5ec159;
  color: #fff;
  border: none;
  border-radius: 12rpx;
}

.avatar-slot {
  position: absolute;
  width: 80rpx; /* PRD：头像 72–88rpx */
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  transition: left 0.22s ease, top 0.22s ease, transform 0.18s ease;
  will-change: left, top, transform;
}

.avatar-slot-dragging {
  z-index: 2;
  transition: none;
}

.avatar-drag-float {
  position: fixed;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  z-index: 25;
}

.avatar-drag-float-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 20rpx rgba(94, 193, 89, 0.35), 0 0 40rpx rgba(94, 193, 89, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.avatar-drag-float-name {
  font-size: 24rpx;
  color: #374151;
  margin-top: 8rpx;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-drag-float-placeholder {
  width: 80rpx;
  height: 80rpx;
}

.avatar-circle,
.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-img {
  display: block;
  object-fit: cover;
}

.avatar-circle-glow {
  animation: avatar-breathe 2.5s ease-in-out infinite;
  box-shadow: 0 0 20rpx rgba(94, 193, 89, 0.25), 0 0 40rpx rgba(94, 193, 89, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

/* 「我」的头像：描边 + 涟漪动效，仅作用于 image，不作用于文字 */
.avatar-img.avatar-me {
  border: 4rpx solid #5ec159;
  box-shadow: 0 0 24rpx rgba(94, 193, 89, 0.5), 0 0 48rpx rgba(94, 193, 89, 0.2);
}

.avatar-slot-me {
  position: relative;
}

.avatar-slot-me::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(94, 193, 89, 0.6);
  animation: avatar-me-ripple 2.2s ease-out infinite;
  pointer-events: none;
}

@keyframes avatar-me-ripple {
  0% {
    transform: scale(0.85);
    opacity: 0.9;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

@keyframes avatar-breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx dashed #d1d5db;
  background: #f3f4f6;
}

.avatar-placeholder-animate {
  animation: placeholder-breathe 2.5s ease-in-out infinite;
}

.avatar-drop-target {
  border: 2rpx dashed #5ec159;
  background: rgba(94, 193, 89, 0.12);
  animation: drop-target-pulse 0.8s ease-in-out infinite;
}

@keyframes drop-target-pulse {
  0%, 100% { opacity: 0.7; transform: scale(0.95); }
  50% { opacity: 1; transform: scale(1.05); }
}

@keyframes placeholder-breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.04);
    opacity: 1;
  }
}

/* PRD：头像下方名字 24–26rpx 灰黑色 */
.avatar-name-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 8rpx;
}

.avatar-name {
  font-size: 24rpx;
  color: #374151;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  user-select: none;
}

.avatar-name-wrap .avatar-name:first-child {
  margin-top: 0;
}

.avatar-me {
  margin-top: 2rpx;
  white-space: nowrap;
}

.placeholder-name {
  color: #9ca3af;
}

/* 单行「空位」与头像的间距 */
.avatar-slot > text.avatar-name.placeholder-name {
  margin-top: 8rpx;
}

.footer {
  flex-shrink: 0;
  width: 100%;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #5ec159 0%, #4db84a 100%);
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 40rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(94, 193, 89, 0.3);
}

.primary-btn::after {
  border: none;
}

.primary-btn:active {
  opacity: 0.85;
}

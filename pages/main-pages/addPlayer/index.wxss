.mode-banner {
  flex-shrink: 0;
  margin: 0 54rpx 16rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(94, 193, 89, 0.25);
  box-sizing: border-box;
}

.mode-banner-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.mode-banner-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.content-area {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
  animation: anim-fade-scale 0.55s ease-out both;
  animation-delay: 0.05s;
}

.content-area-dragging {
  overflow: hidden;
  touch-action: none;
}

.mode-banner {
  display: none;
}

.main-stage {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

.circle-wrap {
  position: relative;
  width: 660rpx;
  height: 660rpx;
  overflow: visible;
}

.deco-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 1rpx solid rgba(94, 193, 89, 0.15);
  transform: translate(-50%, -50%);
  animation: deco-ring-pulse 4s ease-in-out infinite;
  z-index: 0;
}

.deco-glow {
  z-index: 0;
}

.deco-particle {
  z-index: 0;
}

.deco-ring-1 {
  width: 580rpx;
  height: 580rpx;
  animation-delay: 0s;
}

.deco-ring-2 {
  width: 500rpx;
  height: 500rpx;
  animation-delay: 0.5s;
  border-color: rgba(94, 193, 89, 0.12);
}

.deco-ring-3 {
  width: 420rpx;
  height: 420rpx;
  animation-delay: 1s;
  border-color: rgba(94, 193, 89, 0.1);
}

.deco-ring-inner {
  width: 320rpx;
  height: 320rpx;
  border: 1rpx solid rgba(94, 193, 89, 0.08);
  animation: deco-ring-rotate 8s linear infinite;
}

.deco-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 240rpx;
  height: 240rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(94, 193, 89, 0.06) 0%, rgba(94, 193, 89, 0.02) 50%, transparent 70%);
  border-radius: 50%;
  animation: deco-glow-breathe 3s ease-in-out infinite;
}

.deco-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: rgba(94, 193, 89, 0.4);
  border-radius: 50%;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  animation: deco-particle-float 5s ease-in-out infinite;
  box-shadow: 0 0 12rpx rgba(94, 193, 89, 0.3);
}

.deco-particle-1 { animation-delay: 0s; margin-left: 180rpx; margin-top: -120rpx; }
.deco-particle-2 { animation-delay: 0.8s; margin-left: -200rpx; margin-top: -80rpx; }
.deco-particle-3 { animation-delay: 1.6s; margin-left: 220rpx; margin-top: 60rpx; }
.deco-particle-4 { animation-delay: 2.4s; margin-left: -160rpx; margin-top: 140rpx; }
.deco-particle-5 { animation-delay: 3.2s; margin-left: 0; margin-top: -220rpx; }
.deco-particle-6 { animation-delay: 4s; margin-left: 100rpx; margin-top: 200rpx; }

@keyframes deco-ring-pulse {
  0%, 100% {
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(0.98);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.02);
  }
}

@keyframes deco-ring-rotate {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@keyframes deco-glow-breathe {
  0%, 100% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }
}

@keyframes deco-particle-float {
  0%, 100% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(1.3);
  }
}

.qrcode-area {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 3;
}

.qrcode-card {
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.qrcode-circle-bg {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06), inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.qrcode-img {
  width: 200rpx;
  height: 200rpx;
}

.qrcode-placeholder {
  width: 200rpx;
  min-height: 200rpx;
  border: 2rpx dashed #5ec159;
  background-color: #f0fdf4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}

.qrcode-placeholder-text {
  font-size: 26rpx;
  color: #16a34a;
  text-align: center;
}

.qrcode-placeholder-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
  text-align: center;
  line-height: 1.4;
}

.qrcode-retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  line-height: 1.2;
  background: #5ec159;
  color: #fff;
  border: none;
  border-radius: 12rpx;
}

.avatar-slot {
  position: absolute;
  width: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  transition: left 0.22s ease, top 0.22s ease, transform 0.18s ease;
  will-change: left, top, transform;
}

.avatar-slot-dragging {
  z-index: 2;
  transition: none;
}

.avatar-drag-float {
  position: fixed;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  z-index: 25;
}

.avatar-drag-float-enter {
  animation: drag-float-enter 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes drag-float-enter {
  0% {
    transform: translate(-50%, -50%) scale(0.72);
    opacity: 0.35;
  }
  70% {
    transform: translate(-50%, -50%) scale(1.08);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.avatar-drag-float-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 20rpx rgba(94, 193, 89, 0.35), 0 0 40rpx rgba(94, 193, 89, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.avatar-drag-float-name {
  font-size: 24rpx;
  color: #374151;
  margin-top: 8rpx;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-drag-float-placeholder {
  width: 80rpx;
  height: 80rpx;
}

.avatar-circle,
.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-img {
  display: block;
  object-fit: cover;
}

.avatar-circle-glow {
  animation: avatar-breathe 2.5s ease-in-out infinite;
  box-shadow: 0 0 20rpx rgba(94, 193, 89, 0.25), 0 0 40rpx rgba(94, 193, 89, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

/* ??????????+ ??????????image????????*/
.avatar-img.avatar-me {
  border: 4rpx solid #5ec159;
  box-shadow: 0 0 24rpx rgba(94, 193, 89, 0.5), 0 0 48rpx rgba(94, 193, 89, 0.2);
}

.avatar-slot-me {
  position: relative;
}

.avatar-slot-me::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(94, 193, 89, 0.6);
  animation: avatar-me-ripple 2.2s ease-out infinite;
  pointer-events: none;
}

@keyframes avatar-me-ripple {
  0% {
    transform: scale(0.85);
    opacity: 0.9;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

@keyframes avatar-breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}

.avatar-placeholder {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 2rpx dashed #d1d5db;
  background: #f3f4f6;
}

.avatar-placeholder-animate {
  animation: placeholder-breathe 2.5s ease-in-out infinite;
}

.avatar-drop-target {
  border: 2rpx dashed #5ec159;
  background: rgba(94, 193, 89, 0.12);
  box-shadow: 0 0 10rpx rgba(94, 193, 89, 0.25);
  animation: drop-target-pulse 0.95s ease-in-out infinite;
  position: absolute;
  left: 50%;
  top: 0;
  margin-left: -40rpx;
  z-index: 1;
}

/* ?????????? DOM ???????????????? */
.avatar-origin-hidden {
  opacity: 0;
}

@keyframes drop-target-pulse {
  0%, 100% {
    opacity: 0.68;
    box-shadow: 0 0 8rpx rgba(94, 193, 89, 0.18);
  }
  50% {
    opacity: 0.98;
    box-shadow: 0 0 16rpx rgba(94, 193, 89, 0.32);
  }

/* PRD：整个页面白底 #fff */
.container {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

/* PRD：拖拽时页面让位，不滑动、不刷新，界面锁住 */
.container-dragging {
  height: 100vh;
  overflow: hidden;
  overflow-x: hidden;
  overflow-y: hidden;
  touch-action: none;
}

.drag-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: transparent;
  pointer-events: none;
}

/* 拖拽期由遮罩统一承接 move/end/cancel，减少手指离开原节点后的事件丢失 */
.drag-mask-active {
  pointer-events: auto;
  touch-action: none;
}

.custom-navbar {
  flex-shrink: 0;
  width: 100%;
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.instruction-section {
  flex-shrink: 0;
  padding: 36rpx 54rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: anim-slide-down 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.instruction-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.instruction-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
  text-align: center;
}

.instruction-subtitle {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
  text-align: center;
}

.member-count-wrap {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-count-label {
  font-size: 26rpx;
  color: #6b7280;
}

.member-count-value {
  font-size: 32rpx;
  color: #5ec159;
  font-weight: 700;
}

/* DEV_TEST_START: 显示房间号（测试用） */
.dev-room-id-banner {
  flex-shrink: 0;
  margin: 0 40rpx 16rpx;
  padding: 16rpx 24rpx;
  border: 2rpx dashed #f59e0b;
  border-radius: 20rpx;
  background: #fffbeb;
  box-sizing: border-box;
}

.dev-room-id-label {
  display: block;
  font-size: 22rpx;
  color: #b45309;
  margin-bottom: 8rpx;
}

.dev-room-id-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #92400e;
  letter-spacing: 4rpx;
  text-align: center;
}
/* DEV_TEST_END */

.mode-banner {
  flex-shrink: 0;
  margin: 0 54rpx 16rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(94, 193, 89, 0.25);
  box-sizing: border-box;
}

.mode-banner-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.mode-banner-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 4rpx;
}

.mode-banner-desc {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

.content-area {
  flex: 1;
  min-height: 0;
  position: relative;
  overflow: hidden;
  animation: anim-fade-scale 0.55s ease-out both;
  animation-delay: 0.05s;
}

.content-area-dragging {
  overflow: hidden;
  touch-action: none;
}

.main-stage {
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  padding: 0 54rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

.circle-wrap {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  overflow: visible;
}

.deco-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  border: 1rpx solid rgba(94, 193, 89, 0.15);
  transform: translate(-50%, -50%);
  animation: deco-ring-pulse 4s ease-in-out infinite;
  z-index: 0;
}

.deco-glow {
  z-index: 0;
}

.deco-particle {
  z-index: 0;
}

.deco-ring-1 {
  width: 520rpx;
  height: 520rpx;
  animation-delay: 0s;
}

.deco-ring-2 {
  width: 440rpx;
  height: 440rpx;
  animation-delay: 0.5s;
  border-color: rgba(94, 193, 89, 0.12);
}

.deco-ring-3 {
  width: 360rpx;
  height: 360rpx;
  animation-delay: 1s;
  border-color: rgba(94, 193, 89, 0.1);
}

.deco-ring-inner {
  width: 280rpx;
  height: 280rpx;
  border: 1rpx solid rgba(94, 193, 89, 0.08);
  animation: deco-ring-rotate 8s linear infinite;
}

.deco-glow {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 240rpx;
  height: 240rpx;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(94, 193, 89, 0.06) 0%, rgba(94, 193, 89, 0.02) 50%, transparent 70%);
  border-radius: 50%;
  animation: deco-glow-breathe 3s ease-in-out infinite;
}

.deco-particle {
  position: absolute;
  width: 6rpx;
  height: 6rpx;
  background: rgba(94, 193, 89, 0.4);
  border-radius: 50%;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  animation: deco-particle-float 5s ease-in-out infinite;
  box-shadow: 0 0 12rpx rgba(94, 193, 89, 0.3);
}

.deco-particle-1 { animation-delay: 0s; margin-left: 180rpx; margin-top: -120rpx; }
.deco-particle-2 { animation-delay: 0.8s; margin-left: -200rpx; margin-top: -80rpx; }
.deco-particle-3 { animation-delay: 1.6s; margin-left: 220rpx; margin-top: 60rpx; }
.deco-particle-4 { animation-delay: 2.4s; margin-left: -160rpx; margin-top: 140rpx; }
.deco-particle-5 { animation-delay: 3.2s; margin-left: 0; margin-top: -220rpx; }
.deco-particle-6 { animation-delay: 4s; margin-left: 100rpx; margin-top: 200rpx; }

@keyframes deco-ring-pulse {
  0%, 100% {
    opacity: 0.6;
    transform: translate(-50%, -50%) scale(0.98);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.02);
  }
}

@keyframes deco-ring-rotate {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@keyframes deco-glow-breathe {
  0%, 100% {
    opacity: 0.8;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.1);
  }
}

@keyframes deco-particle-float {
  0%, 100% {
    opacity: 0.5;
    transform: translate(-50%, -50%) scale(1);
  }
  50% {
    opacity: 0.9;
    transform: translate(-50%, -50%) scale(1.3);
  }
}

.qrcode-area {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 3;
}

.qrcode-card {
  width: 260rpx;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.qrcode-circle-bg {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06), inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.qrcode-img {
  width: 200rpx;
  height: 200rpx;
}

.qrcode-placeholder {
  width: 200rpx;
  min-height: 200rpx;
  border: 2rpx dashed #5ec159;
  background-color: #f0fdf4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}

.qrcode-placeholder-text {
  font-size: 26rpx;
  color: #16a34a;
  text-align: center;
}

.qrcode-placeholder-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 8rpx;
  text-align: center;
  line-height: 1.4;
}

.qrcode-retry-btn {
  margin-top: 16rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  line-height: 1.2;
  background: #5ec159;
  color: #fff;
  border: none;
  border-radius: 12rpx;
}

.avatar-slot {
  position: absolute;
  width: 80rpx; /* PRD：头像 72–88rpx */
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  transition: left 0.22s ease, top 0.22s ease, transform 0.18s ease;
  will-change: left, top, transform;
}

.avatar-slot-dragging {
  z-index: 2;
  transition: none;
}

.avatar-drag-float {
  position: fixed;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  z-index: 25;
}

.avatar-drag-float-enter {
  animation: drag-float-enter 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes drag-float-enter {
  0% {
    transform: translate(-50%, -50%) scale(0.72);
    opacity: 0.35;
  }
  70% {
    transform: translate(-50%, -50%) scale(1.08);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

.avatar-drag-float-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 20rpx rgba(94, 193, 89, 0.35), 0 0 40rpx rgba(94, 193, 89, 0.15);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.avatar-drag-float-name {
  font-size: 24rpx;
  color: #374151;
  margin-top: 8rpx;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-drag-float-placeholder {
  width: 80rpx;
  height: 80rpx;
}

.avatar-circle,
.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-img {
  display: block;
  object-fit: cover;
}

.avatar-circle-glow {
  animation: avatar-breathe 2.5s ease-in-out infinite;
  box-shadow: 0 0 20rpx rgba(94, 193, 89, 0.25), 0 0 40rpx rgba(94, 193, 89, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
}

/* 「我」的头像：描边 + 涟漪动效，仅作用于 image，不作用于文字 */
.avatar-img.avatar-me {
  border: 4rpx solid #5ec159;
  box-shadow: 0 0 24rpx rgba(94, 193, 89, 0.5), 0 0 48rpx rgba(94, 193, 89, 0.2);
}

.avatar-slot-me {
  position: relative;
}

.avatar-slot-me::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 80rpx;
  height: 80rpx;
  margin-left: -40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(94, 193, 89, 0.6);
  animation: avatar-me-ripple 2.2s ease-out infinite;
  pointer-events: none;
}

@keyframes avatar-me-ripple {
  0% {
    transform: scale(0.85);
    opacity: 0.9;
  }
  100% {
    transform: scale(1.5);
    opacity: 0;
  }
}

@keyframes avatar-breathe {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.06);
  }
}

.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx dashed #d1d5db;
  background: #f3f4f6;
}

.avatar-placeholder-animate {
  animation: placeholder-breathe 2.5s ease-in-out infinite;
}

.avatar-drop-target {
  border: 2rpx dashed #5ec159;
  background: rgba(94, 193, 89, 0.12);
  box-shadow: 0 0 10rpx rgba(94, 193, 89, 0.25);
  animation: drop-target-pulse 0.95s ease-in-out infinite;
  position: absolute;
  left: 50%;
  top: 0;
  margin-left: -40rpx;
  z-index: 1;
}

/* 拖拽时原槽位成员保留 DOM 但隐藏，避免替换节点打断触摸链路 */
.avatar-origin-hidden {
  opacity: 0;
}

@keyframes drop-target-pulse {
  0%, 100% {
    opacity: 0.68;
    box-shadow: 0 0 8rpx rgba(94, 193, 89, 0.18);
  }
  50% {
    opacity: 0.98;
    box-shadow: 0 0 16rpx rgba(94, 193, 89, 0.32);
  }
}

@keyframes placeholder-breathe {
  0%, 100% {
    transform: scale(1);
    opacity: 0.8;
  }
  50% {
    transform: scale(1.04);
    opacity: 1;
  }
}

/* PRD：头像下方名字 24–26rpx 灰黑色 */
.avatar-name-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 8rpx;
}

.avatar-name {
  font-size: 24rpx;
  color: #374151;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  user-select: none;
}

.avatar-name-wrap .avatar-name:first-child {
  margin-top: 0;
}

.avatar-me {
  margin-top: 2rpx;
  white-space: nowrap;
}

.placeholder-name {
  color: #9ca3af;
}

/* 单行「空位」与头像的间距 */
.avatar-slot > text.avatar-name.placeholder-name {
  margin-top: 8rpx;
}

.footer-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: anim-slide-up 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  animation-delay: 0.1s;
}

.footer {
  width: 100%;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.footer-btn-row {
  display: flex;
  gap: 20rpx;
}

.footer-btn-row .secondary-btn {
  flex: 1;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #5ec159 0%, #4db84a 100%);
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(94, 193, 89, 0.3);
  animation: btn-glow-pulse 2.8s ease-in-out infinite;
}

.secondary-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #374151;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e5e7eb;
}

.danger-btn {
  color: #dc2626;
  border-color: rgba(220, 38, 38, 0.25);
  background: #fff7f7;
}

.primary-btn::after,
.secondary-btn::after {
  border: none;
}

.primary-btn:active {
  opacity: 0.85;
}

.secondary-btn:active {
  opacity: 0.85;
}

/* =============================================
   入场动效
   ============================================= */
@keyframes anim-slide-down {
  from {
    opacity: 0;
    transform: translateY(-28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes anim-slide-up {
  from {
    opacity: 0;
    transform: translateY(28rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes anim-fade-scale {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* =============================================
   轨道光点：沿内环公转
   ============================================= */
.orbit-wrap {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  animation: orbit-spin 9s linear infinite;
  z-index: 1;
  pointer-events: none;
}

.orbit-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  background: #5ec159;
  border-radius: 50%;
  /* 内环半径 140rpx，光点半尺寸 7rpx */
  left: 133rpx;
  top: -7rpx;
  box-shadow:
    0 0 12rpx 4rpx rgba(94, 193, 89, 0.7),
    0 0 24rpx 8rpx rgba(94, 193, 89, 0.3);
  animation: orbit-dot-glow 9s linear infinite;
}

/* 光点拖尾：用第二个光点模拟，延迟半圈 */
.orbit-wrap::after {
  content: '';
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  background: rgba(94, 193, 89, 0.45);
  border-radius: 50%;
  left: 136rpx;
  top: -4rpx;
  box-shadow: 0 0 8rpx rgba(94, 193, 89, 0.4);
}

@keyframes orbit-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

@keyframes orbit-dot-glow {
  0%, 100% { opacity: 0.75; }
  50%       { opacity: 1; }
}

/* =============================================
   二维码扫描线
   ============================================= */
.scan-line {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  height: 4rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(94, 193, 89, 0.4) 20%,
    rgba(94, 193, 89, 1) 50%,
    rgba(94, 193, 89, 0.4) 80%,
    transparent 100%
  );
  border-radius: 2rpx;
  pointer-events: none;
  z-index: 5;
  animation: scan-sweep 2.8s ease-in-out infinite;
}

@keyframes scan-sweep {
  0%   { top: 14rpx;  opacity: 0; }
  6%   { opacity: 1; }
  94%  { opacity: 1; }
  100% { top: 196rpx; opacity: 0; }
}

/* =============================================
   主按钮呼吸光晕
   ============================================= */
@keyframes btn-glow-pulse {
  0%, 100% {
    box-shadow: 0 8rpx 24rpx rgba(94, 193, 89, 0.3);
  }
  50% {
    box-shadow:
      0 8rpx 36rpx rgba(94, 193, 89, 0.55),
      0 0 0 6rpx rgba(94, 193, 89, 0.1);
  }
}

/* =============================================
   人数数字跳动（新成员加入时触发）
   ============================================= */
@keyframes count-bounce {
  0%   { transform: scale(1); }
  30%  { transform: scale(1.65); }
  60%  { transform: scale(0.88); }
  80%  { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.count-bounce {
  animation: count-bounce 0.55s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  display: inline-block;
}

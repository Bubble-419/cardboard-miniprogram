<view
  class="container {{isDragging ? 'container-dragging' : ''}} {{navFreeze ? 'container-nav-freeze' : ''}}"
  catchtouchmove="onContentTouchMove"
  catchtouchend="onContentTouchEnd"
  catchtouchcancel="onContentTouchEnd"
>
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          catchtap="handleGoBack"
        ></image>
      </view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- 紧凑信息区：工作坊名 + 人数 · 模式 -->
  <view class="info-section">
    <block wx:if="{{!isEditingRoomName}}">
      <view class="info-title-row" catchtap="startEditRoomName">
        <text class="info-title">{{workshopName || '脑暴工作坊'}}</text>
        <image
          wx:if="{{isHost}}"
          class="room-name-edit-icon"
          src="/assets/icons/editname.png"
          mode="aspectFit"
        />
      </view>
    </block>
    <block wx:else>
      <view class="room-name-input-row" catchtap="noop">
        <input
          class="room-name-input"
          value="{{editingRoomName}}"
          focus="{{isEditingRoomName}}"
          maxlength="20"
          placeholder="设置房间名称"
          placeholder-class="room-name-placeholder"
          bindinput="onRoomNameInput"
          bindconfirm="confirmEditRoomName"
        />
        <image
          class="room-name-confirm-icon"
          src="/assets/icons/comfirm.svg"
          mode="aspectFit"
          catchtap="confirmEditRoomName"
        />
      </view>
    </block>
    <view class="info-meta-row">
      <text class="info-meta-text {{memberCountBounce ? 'count-bounce' : ''}}">{{memberCount}}/{{maxMembers}}人</text>
      <text class="info-meta-dot" wx:if="{{hasSelectedMode && selectedModeTitle}}"> · </text>
      <view class="mode-pill" wx:if="{{hasSelectedMode && selectedModeTitle}}">
        <text class="mode-pill-text">{{selectedModeTitle}}</text>
      </view>
      <text class="info-meta-text muted" wx:elif="{{!hasSelectedMode}}"> · 待选模式</text>
    </view>
    <text class="info-hint" wx:if="{{isHost}}">长按拖动可调序；长按头像可踢出</text>
    <text class="info-hint" wx:else>等待房主选择脑暴模式</text>
  </view>

  <!-- DEV_TEST_START: 显示房间号（测试用，不参与布局占位依赖） -->
  <view class="dev-room-id-banner" wx:if="{{devShowRoomId}}" catchtap="handleDevCopyRoomId">
    <text class="dev-room-id-label">测试：房间号（点击复制）</text>
    <text class="dev-room-id-value">{{devRoomIdDisplay}}</text>
  </view>
  <!-- DEV_TEST_END -->

  <view
    class="content-area {{isDragging ? 'content-area-dragging' : ''}}"
    catchtouchmove="onContentTouchMove"
    catchtouchend="onContentTouchEnd"
    catchtouchcancel="onContentTouchEnd"
  >
    <view class="main-stage">
      <view
        class="circle-wrap"
        id="circleWrap"
        catchtouchmove="onWrapTouchMove"
        catchtouchend="onWrapTouchEnd"
        catchtouchcancel="onWrapTouchEnd"
      >
        <view class="deco-ring deco-ring-1"></view>
        <view class="deco-ring deco-ring-2"></view>
        <view class="deco-ring deco-ring-3"></view>
        <view class="deco-ring deco-ring-inner"></view>
        <view class="deco-glow"></view>
        <view class="deco-particle deco-particle-1"></view>
        <view class="deco-particle deco-particle-2"></view>
        <view class="deco-particle deco-particle-3"></view>
        <view class="deco-particle deco-particle-4"></view>
        <view class="deco-particle deco-particle-5"></view>
        <view class="deco-particle deco-particle-6"></view>

        <view class="orbit-wrap">
          <view class="orbit-dot"></view>
        </view>

        <view class="qrcode-area">
          <view class="qrcode-card">
            <view class="qrcode-circle-bg">
              <image
                wx:if="{{qrcodeStatus === 'success' && qrcodeUrl}}"
                class="qrcode-img"
                src="{{qrcodeUrl}}"
                mode="aspectFit"
              />
              <view wx:elif="{{qrcodeStatus === 'loading'}}" class="qrcode-placeholder">
                <text class="qrcode-placeholder-text">加载中…</text>
              </view>
              <view wx:elif="{{qrcodeStatus === 'no_qr'}}" class="qrcode-placeholder">
                <text class="qrcode-placeholder-text">二维码未生成</text>
                <text class="qrcode-placeholder-hint">
                  若为体验版或开发版，请确保 addPlayer 页面已发布；或点击重试
                </text>
                <button class="qrcode-retry-btn" catchtap="handleRetryQrcode">重试</button>
              </view>
              <view wx:elif="{{qrcodeStatus === 'load_error'}}" class="qrcode-placeholder">
                <text class="qrcode-placeholder-text">房间数据加载失败</text>
                <text class="qrcode-placeholder-hint">{{qrcodeErrorHint || '请检查云函数 getAddPlayerData 是否已重新部署'}}</text>
                <button class="qrcode-retry-btn" catchtap="handleRetryQrcode">重试</button>
              </view>
              <view wx:else class="qrcode-placeholder">
                <text class="qrcode-placeholder-text">获取二维码失败</text>
                <text class="qrcode-placeholder-hint">{{qrcodeErrorHint || '可点击重试重新生成'}}</text>
                <button class="qrcode-retry-btn" catchtap="handleRetryQrcode">重试</button>
              </view>
              <view class="scan-line" wx:if="{{qrcodeStatus === 'success' && qrcodeUrl}}"></view>
            </view>
          </view>
        </view>

        <block wx:for="{{memberSlots}}" wx:key="index">
          <view
            class="avatar-slot {{item.member ? 'avatar-slot-filled' : 'avatar-slot-empty'}} {{isDragging && dropTargetIndex === item.index ? 'avatar-slot-dragging' : ''}} {{item.member && item.member.isMe ? 'avatar-slot-me' : ''}}"
            style="left: {{item.left}}rpx; top: {{item.top}}rpx;"
            data-index="{{item.index}}"
            catchtap="onSlotTap"
            catchtouchstart="onSlotTouchStart"
            catchtouchmove="onSlotTouchMove"
            catchtouchend="onSlotTouchEnd"
            catchtouchcancel="onSlotTouchEnd"
          >
            <image
              wx:if="{{item.member && item.member.avatarImage}}"
              class="avatar-img avatar-circle-glow {{item.member.isMe ? 'avatar-me' : ''}} {{isDragging && (item.index === draggingSlotIndex || item.index === dropTargetIndex) ? 'avatar-origin-hidden' : ''}}"
              src="{{item.member.avatarImage}}"
              mode="aspectFill"
              data-index="{{item.index}}"
            />
            <view
              wx:if="{{isDragging && item.index === dropTargetIndex}}"
              class="avatar-placeholder avatar-drop-target"
            ></view>
            <view
              wx:if="{{!item.member && !(isDragging && item.index === dropTargetIndex)}}"
              class="avatar-placeholder avatar-placeholder-animate"
            ></view>

            <view
              wx:if="{{item.member}}"
              class="avatar-name-wrap {{isDragging && (item.index === draggingSlotIndex || item.index === dropTargetIndex) ? 'avatar-origin-hidden' : ''}}"
            >
              <text class="avatar-name {{item.member.isMe ? 'avatar-name-me' : ''}}">
                {{item.member.isMe ? '我' : (item.member.nickName || '玩家')}}
              </text>
            </view>
            <text
              wx:elif="{{!item.member && !(isDragging && item.index === dropTargetIndex)}}"
              class="avatar-name placeholder-name"
            >
              等待加入
            </text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view
    class="drag-mask {{isDragging ? 'drag-mask-active' : ''}}"
    catchtouchmove="onDragMaskTouchMove"
    catchtouchend="onDragMaskTouchEnd"
    catchtouchcancel="onDragMaskTouchEnd"
  ></view>

  <view
    wx:if="{{isDragging && dragPosX != null}}"
    class="avatar-drag-float {{dragEnterAnimating ? 'avatar-drag-float-enter' : ''}}"
    style="left: {{dragPosX}}px; top: {{dragPosY}}px;"
  >
    <image
      wx:if="{{draggingMember && draggingMember.avatarImage}}"
      class="avatar-img avatar-circle-glow avatar-drag-float-circle {{draggingMember.isMe ? 'avatar-me' : ''}}"
      src="{{draggingMember.avatarImage}}"
      mode="aspectFill"
    />
    <view
      wx:else
      class="avatar-placeholder avatar-placeholder-animate avatar-drag-float-placeholder"
    ></view>
  </view>

  <!-- 底部：绿色主按钮 + 小号文字（房主解散 / 成员退出） -->
  <view class="footer-wrap">
    <view class="footer">
      <button
        class="primary-btn {{primaryBtnDisabled ? 'primary-btn-disabled' : ''}}"
        disabled="{{primaryBtnDisabled}}"
        catchtap="onTapPrimaryAction"
      >{{primaryBtnText}}</button>
      <text
        wx:if="{{showExitText}}"
        class="exit-text-btn {{exitTextDanger ? 'exit-text-btn-danger' : ''}}"
        catchtap="onTapExitText"
      >{{exitTextLabel}}</text>
    </view>
  </view>
</view>

<view class="avatar-auth-mask" wx:if="{{showAvatarAuth}}">
  <view class="avatar-auth-dialog">
    <text class="avatar-auth-title">授权微信头像</text>
    <text class="avatar-auth-desc">加入房间可使用你的微信头像，也可稍后用随机头像加入</text>
    <button class="avatar-auth-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatarAuth">
      选择微信头像
    </button>
    <text class="avatar-auth-skip" bindtap="onSkipAvatarAuth">使用随机头像加入</text>
  </view>
</view>

.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  position: relative;
  overflow: hidden;
}

/* 自定义导航栏，与主流程其他页面保持一致风格 */
.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
  position: relative;
  z-index: 10;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 提示文案 */
.instruction-text {
  position: absolute;
  top: 150rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 2;
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.instruction-line {
  font-size: 36rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.5;
  text-align: center;
}

/* 环形玩家布局 */
.circle-wrapper {
  position: absolute;
  left: 0;
  right: 0;
  top: 260rpx;
  bottom: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-ring {
  position: absolute;
  border: 4rpx solid #5ec159;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.player-avatar {
  position: absolute;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  /* 让 left/top 表示头像中心点，便于与手指位置对齐 */
  transform: translate(-50%, -50%);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.player-avatar-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid #5ec159;
  background-color: #e4f7e4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.player-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #4a4a4a;
}

.player-avatar.selected .player-avatar-inner {
  border-width: 6rpx;
  box-shadow: 0 8rpx 18rpx rgba(94, 193, 89, 0.5);
  transform: scale(1.1);
}

.player-avatar.dragging {
  z-index: 20;
}

.player-avatar.dragging .player-avatar-inner {
  opacity: 0.8;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.25);
  transform: scale(1.12);
}

/* 底部主按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: transparent;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 44rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.primary-btn::after {
  border: none;
}

.primary-btn:active {
  opacity: 0.85;
}

.primary-btn--disabled {
  background-color: #d8d8d8;
  color: #ffffff;
}


<view class="container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left">
        <image
          class="back-icon"
          src="/assets/icons/miniprogram-btn.png"
          mode="aspectFit"
          bindtap="goBack"
        ></image>
      </view>
      <view class="navbar-title">确认首位出牌玩家</view>
      <view class="navbar-right">
        <view class="navbar-icon">⋯</view>
        <view class="navbar-icon">○</view>
      </view>
    </view>
  </view>

  <!-- 提示文案 -->
  <view class="instruction-text">
    <text class="instruction-line">选择首位出牌玩家</text>
  </view>

  <!-- 环形玩家布局 -->
  <view
    id="circleWrapper"
    class="circle-wrapper"
    catchtouchmove="onCircleTouchMove"
    catchtouchend="onCircleTouchEnd"
    catchtouchcancel="onCircleTouchEnd"
  >
    <view
      class="circle-ring"
      style="width: {{ringDiameter}}rpx; height: {{ringDiameter}}rpx; left: {{circleCenterX}}rpx; top: {{circleCenterY}}rpx;"
    ></view>

    <view
      wx:for="{{players}}"
      wx:key="id"
      class="player-avatar {{selectedFirstPlayerId === item.id ? 'selected' : ''}} {{draggingPlayerId === item.id ? 'dragging' : ''}}"
      style="left: {{item.x}}rpx; top: {{item.y}}rpx;"
      bindtap="onPlayerTap"
      bindlongpress="onPlayerLongPress"
      catchtouchmove="onPlayerTouchMove"
      catchtouchend="onPlayerTouchEnd"
      data-id="{{item.id}}"
      data-index="{{index}}"
    >
      <view class="player-avatar-inner">
        <image
          class="avatar-img"
          src="{{item.avatarUrl || defaultAvatar}}"
          mode="aspectFill"
          data-id="{{item.id}}"
          binderror="onAvatarError"
        ></image>
        <text class="player-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 底部主按钮 -->
  <view class="footer">
    <button
      class="primary-btn {{!selectedFirstPlayerId ? 'primary-btn--disabled' : ''}}"
      bindtap="onConfirmFirstPlayer"
      disabled="{{!selectedFirstPlayerId}}"
    >
      下一步
    </button>
  </view>
</view>

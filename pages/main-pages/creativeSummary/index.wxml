<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left"></view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="content">
    <text class="title">令你印象深刻的创意汇总</text>
    <text class="sub-title">一起看看每位玩家最有印象的创意</text>

    <scroll-view class="list-wrap" scroll-y="true">
      <view class="idea-card" wx:for="{{summaryList}}" wx:key="playerIndex">
        <view class="player-row">
          <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
          <text class="player-name">{{item.playerIndex}}号玩家</text>
          <text class="player-me" wx:if="{{item.isMe}}">（我）</text>
        </view>
        <text class="idea-text">{{item.ideaText || '（待填写）'}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="footer" wx:if="{{isHost || canEditIdea}}">
    <button class="edit-btn" wx:if="{{canEditIdea}}" bindtap="handleEditIdea">修改我的创意</button>
    <view class="footer-actions" wx:if="{{isHost && canRestartRound}}">
      <button class="room-btn" bindtap="handleGoRoom">返回房间</button>
      <button class="finish-btn" bindtap="handleFinish">再来一轮</button>
    </view>
    <button
      wx:elif="{{isHost}}"
      class="finish-btn finish-btn-disabled"
      disabled
    >再来一轮</button>
  </view>
</view>

<interaction-lock-layer locked="{{interactionLocked}}" loading="{{interactionLoading}}" text="{{interactionLoadingText}}" />

<view class="container">
  <view class="custom-navbar">
    <view class="navbar-content">
      <view class="navbar-left"></view>
      <view class="navbar-title"></view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <view class="content">
    <text class="title">令你印象深刻的创意汇总</text>
    <text class="sub-title">一起看看每位玩家最有印象的创意</text>

    <scroll-view class="list-wrap" scroll-y="true">
      <view
        class="idea-card {{item.isMe && editing ? 'editing' : ''}}"
        wx:for="{{summaryList}}"
        wx:key="playerIndex"
      >
        <view class="idea-card-body">
          <view class="player-row">
            <image class="avatar" src="{{item.avatar}}" mode="aspectFill" />
            <text class="player-name">{{item.playerIndex}}号玩家</text>
            <text class="player-me" wx:if="{{item.isMe}}">（我）</text>
          </view>
          <block wx:if="{{item.isMe && editing}}">
            <textarea
              class="idea-textarea"
              value="{{editDraft}}"
              maxlength="120"
              auto-height="{{true}}"
              focus="{{editing}}"
              cursor="{{editingCursor}}"
              selection-start="{{editingCursor}}"
              selection-end="{{editingCursor}}"
              adjust-position="{{true}}"
              cursor-spacing="32"
              catchtap="stopPropagation"
              bindinput="onIdeaInput"
              bindblur="onIdeaBlur"
            />
          </block>
          <text wx:else class="idea-text" id="idea-text-{{item.playerIndex}}">{{item.ideaText || '（待填写）'}}</text>
        </view>
        <view class="idea-right">
          <view
            wx:if="{{item.isMe && editing}}"
            class="idea-action-btn"
            catchtap="handleSaveIdea"
            hover-class="idea-action-btn-hover"
            hover-stay-time="80"
          >
            <image
              class="idea-action-icon"
              src="/assets/icons/icon-problem-confirm.svg"
              mode="aspectFit"
            />
          </view>
          <view
            wx:elif="{{item.isMe && canEditIdea}}"
            class="idea-action-btn"
            catchtap="handleEditIdea"
            hover-class="idea-action-btn-hover"
            hover-stay-time="80"
          >
            <image
              class="idea-action-icon"
              src="/assets/icons/icon-problem-arrow.svg"
              mode="aspectFit"
            />
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="footer" wx:if="{{isHost}}">
    <view class="footer-actions" wx:if="{{canRestartRound}}">
      <button class="room-btn" bindtap="handleGoRoom">返回房间</button>
      <button class="finish-btn" bindtap="handleFinish">再来一轮</button>
    </view>
    <button
      wx:else
      class="finish-btn finish-btn-disabled"
      disabled
    >再来一轮</button>
  </view>
</view>

<interaction-lock-layer locked="{{interactionLocked}}" loading="{{interactionLoading}}" text="{{interactionLoadingText}}" />

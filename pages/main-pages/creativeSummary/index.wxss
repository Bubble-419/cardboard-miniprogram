.container {
  min-height: 100vh;
  background: #f7fbf7;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.custom-navbar {
  background: #f7fbf7;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-chevron {
  font-size: 48rpx;
  color: #000;
  line-height: 1;
}

.navbar-title {
  flex: 1;
}

.navbar-right {
  width: 80rpx;
}

.content {
  flex: 1;
  padding: 56rpx 30rpx 0;
  display: flex;
  flex-direction: column;
}

.title {
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #2f9f3f;
}

.sub-title {
  margin-top: 10rpx;
  text-align: center;
  font-size: 28rpx;
  color: #809180;
}

.list-wrap {
  margin-top: 24rpx;
  flex: 1;
  min-height: 0;
}

.idea-card {
  background: #fff;
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(94, 193, 89, 0.1);
}

.player-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #eaf7ea;
}

.player-name {
  font-size: 30rpx;
  color: #2e6f33;
  font-weight: 600;
}

.player-me {
  font-size: 28rpx;
  color: #5ec159;
  font-weight: 600;
}

.idea-text {
  margin-top: 14rpx;
  display: block;
  font-size: 30rpx;
  line-height: 1.55;
  color: #2f2f2f;
}

.footer {
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
}

.finish-btn {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 16rpx;
  background: #5ec159;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.finish-btn::after {
  border: none;
}

<view class="container" style="padding-top: {{navbarPaddingTop}}px">
  <view class="header-section">
    <view class="topbar">
      <view class="room-entry" bindtap="handleGoRoom">
        <image class="room-entry-icon" src="/assets/icons/icon-room-entry.svg" mode="aspectFit" />
      </view>
    </view>
    <view class="title-block">
      <text class="page-title">下一轮准备</text>
      <text class="page-subtitle">任意玩家可继续</text>
    </view>
  </view>

  <view class="section">
    <view class="section-body">点击下方按钮进入下一轮发言</view>
  </view>

  <page-footer extClass="footer" showPrev="{{false}}">
    <view class="primary-btn {{acting ? 'dimmed' : ''}}" bindtap="onStartNext">开始下一轮发言</view>
  </page-footer>
</view>

<view class="container" style="padding-top: {{navbarPaddingTop}}px">
  <view class="header-section">
    <view class="topbar">
      <view class="room-entry" bindtap="handleGoRoom">
        <image class="room-entry-icon" src="/assets/icons/icon-room-entry.svg" mode="aspectFit" />
      </view>
      <view class="avatar-bar">
        <user-list
          avatarList="{{avatarList}}"
          enableAdd="{{false}}"
          isFold="{{true}}"
          showName="{{false}}"
          layout="stack"
        />
      </view>
    </view>
    <view class="title-block">
      <text class="page-title">发言阶段</text>
      <text class="page-subtitle">
        {{tieBreak ? '平票加时：并列玩家重新陈述' : (isMyTurn ? '现在轮到你发言' : '请按顺序发言，勿直接念出词名')}}
      </text>
    </view>
  </view>

  <!-- 仅本人可见：翻牌查看分配词 / 词语1，不展示他人词语 -->
  <view class="my-word-card-wrap">
    <view class="my-word-label">我的词语卡</view>
    <flip-word-card
      wx:if="{{cardReady}}"
      word="{{myWord}}"
      backSrc="{{cardBackSrc}}"
      assignedWordSrc="{{assignedWordSrc}}"
      assignedWordFallbackSrc="{{assignedWordFallbackSrc}}"
      word1Src="{{word1Src}}"
      word1FallbackSrc="{{word1FallbackSrc}}"
    />
    <view class="my-word-card-loading" wx:else>词语加载中…</view>
    <view class="my-word-hint">背面 → 词语 → 词语1 → 再点回背面，可循环翻看。请勿直接念出词名。</view>
    <view class="library-entry" bindtap="onOpenLibrary">
      <view class="deck-icon">
        <view class="deck-layer deck-l3"></view>
        <view class="deck-layer deck-l2"></view>
        <view class="deck-layer deck-l1"></view>
      </view>
      <view class="library-entry-text">
        <text class="library-entry-title">牌库 · {{libraryGroupCount}}组</text>
        <text class="library-entry-sub">浏览全部词语卡</text>
      </view>
      <text class="library-entry-arrow">›</text>
    </view>
  </view>

  <!-- 发言进度 -->
  <view class="section status-card">
    <view class="section-title-row">
      <text class="section-title">发言进度</text>
      <text class="section-count" wx:if="{{isMyTurn}}">{{turnCountdownText}}</text>
    </view>

    <view class="status-empty" wx:if="{{!progressList.length}}">加载中…</view>

    <block wx:for="{{progressList}}" wx:key="playerIndex">
      <view class="status-row status-row-current" wx:if="{{item.isCurrent}}">
        <view class="status-row-main">
          <view class="rank-badge rank-badge-active">{{item.rank}}</view>
          <view class="avatar-wrap avatar-wrap-lg">
            <view class="avatar-ring"></view>
            <image class="player-avatar player-avatar-lg" src="{{item.avatarImage}}" mode="aspectFill" />
          </view>
          <view class="player-info">
            <view class="name-line">
              <text class="player-name">{{item.name}}</text>
              <text class="me-tag" wx:if="{{item.isMe}}">我</text>
            </view>
            <view class="speaking-inline">
              <text class="speaking-tag">发言中</text>
              <text class="speaking-timer">{{turnCountdownText}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="status-row status-row-{{item.statusKey}}" wx:else>
        <view class="rank-badge">{{item.rank}}</view>
        <image class="player-avatar" src="{{item.avatarImage}}" mode="aspectFill" />
        <view class="player-info">
          <view class="name-line">
            <text class="player-name">{{item.name}}</text>
            <text class="me-tag" wx:if="{{item.isMe}}">我</text>
          </view>
        </view>
        <view class="status-chip status-chip-{{item.statusKey}}">
          <text class="status-check" wx:if="{{item.statusKey === 'done'}}">✓</text>
          <text>{{item.statusText}}</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 当前发言玩家：底部固定「发言完毕」 -->
  <page-footer wx:if="{{isMyTurn}}" extClass="footer" showPrev="{{false}}">
    <view class="primary-btn {{acting ? 'dimmed' : ''}}" bindtap="onFinishSpeak">发言完毕</view>
  </page-footer>
</view>

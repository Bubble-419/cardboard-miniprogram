<view class="container" style="padding-top: {{navbarPaddingTop}}px">
  <view class="header-section">
    <view class="topbar">
      <view class="room-entry" bindtap="handleGoRoom">
        <image class="room-entry-icon" src="/assets/icons/icon-room-entry.svg" mode="aspectFit" />
      </view>
      <view class="avatar-bar">
        <user-list
          avatarList="{{avatarList}}"
          enableAdd="{{false}}"
          isFold="{{true}}"
          showName="{{false}}"
          layout="stack"
        />
      </view>
    </view>
    <view class="title-block">
      <text class="page-title">公布淘汰结果</text>
      <text class="page-subtitle">第 {{round}} 轮</text>
    </view>
  </view>

  <view class="section">
    <view class="result-hero" wx:if="{{hasElimination}}">
      <view class="result-name">{{eliminatedName}}</view>
      <view class="result-role {{eliminatedRole === 'spy' ? 'spy' : ''}}">身份：{{eliminatedRoleLabel}}</view>
      <view class="section-body" style="margin-top: 20rpx">得票 {{maxVotes}}</view>
    </view>
    <view class="result-hero" wx:else>
      <view class="result-name">本轮无人出局</view>
      <view class="section-body">{{tied ? '最高票并列' : '有效票不足或全员弃票'}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">存活玩家</view>
    <view class="player-row" wx:for="{{alivePlayers}}" wx:key="playerIndex">
      <view class="player-name">{{item.name}}</view>
      <view class="player-meta">仍在场</view>
    </view>
  </view>

  <page-footer wx:if="{{isHost}}" extClass="footer" showPrev="{{false}}">
    <view class="primary-btn" bindtap="onNext">进入下一轮准备</view>
  </page-footer>

  <page-footer
    wx:else
    extClass="footer"
    showPrimary="{{false}}"
    bind:prev="handleGoRoom"
    prevText="房间"
  ></page-footer>
</view>

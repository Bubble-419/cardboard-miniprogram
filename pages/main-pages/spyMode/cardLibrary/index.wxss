@import "../styles/common.wxss";

.card-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
}

.card-tile {
  width: 50%;
  padding: 12rpx;
  box-sizing: border-box;
}

.card-tile:active {
  opacity: 0.88;
}

.tile-stack {
  position: relative;
  width: 100%;
  padding-top: 62%;
  background: transparent;
}

.tile-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: transparent;
}

.tile-meta {
  margin-top: 12rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 0 4rpx;
}

.tile-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.viewer-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 20, 30, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.viewer-sheet {
  width: 100%;
  max-height: 88vh;
  background: #f7f9fb;
  border-radius: 32rpx 32rpx 0 0;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.viewer-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.viewer-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.viewer-close {
  font-size: 26rpx;
  color: #3aae34;
  padding: 8rpx 12rpx;
}

.viewer-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 20rpx;
}

.viewer-blurb {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6f6f6f;
  line-height: 1.55;
}

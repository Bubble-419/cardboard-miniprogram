<view class="container" style="padding-top: {{navbarPaddingTop}}px">
  <view class="header-section">
    <view class="topbar">
      <view class="room-entry" bindtap="handleGoRoom">
        <image class="room-entry-icon" src="/assets/icons/icon-room-entry.svg" mode="aspectFit" />
      </view>
      <view class="avatar-bar">
        <user-list
          avatarList="{{avatarList}}"
          enableAdd="{{false}}"
          isFold="{{true}}"
          showName="{{false}}"
          layout="stack"
        />
      </view>
    </view>
    <view class="title-block">
      <text class="page-title">{{isHost ? '身份与发言顺序' : '查看你的词语'}}</text>
      <text class="page-subtitle">
        {{isHost ? '请确认分配结果后开始游戏' : (memorized ? '已记住，等待主持人开始' : '点击卡片查看，并记住你的词')}}
      </text>
    </view>
  </view>

  <block wx:if="{{isHost}}">
    <view class="section">
      <view class="section-title">本局词对</view>
      <view class="word-card">
        <view class="word-card-tag">平民词</view>
        <view class="word-card-word">{{civilianWord}}</view>
      </view>
      <view class="word-card">
        <view class="word-card-tag spy">卧底词</view>
        <view class="word-card-word">{{spyWord}}</view>
      </view>
    </view>
    <view class="section">
      <view class="section-title">全员分配</view>
      <view
        class="player-row"
        wx:for="{{overviewPlayers}}"
        wx:key="playerIndex"
      >
        <view>
          <view class="player-name">{{item.name}}</view>
          <view class="player-meta">发言顺序第 {{item.speakOrderRank}} 位</view>
        </view>
        <view class="player-meta">{{item.roleLabel}} · {{item.word}}</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="section" bindtap="onRevealCard">
      <view class="section-title">你的交互方式卡</view>
      <block wx:if="{{revealed}}">
        <view class="word-card">
          <view class="word-card-tag">你的词语</view>
          <view class="word-card-word">{{myCard.word}}</view>
          <view class="word-card-blurb">{{myCard.blurb}}</view>
        </view>
        <view class="hint-text">你是第 {{myCard.speakOrderRank}} / {{myCard.speakOrderTotal}} 位发言</view>
      </block>
      <block wx:else>
        <view class="section-body">点击此处翻开卡片</view>
        <view class="flip-hint">请注意遮挡屏幕，避免被他人看到</view>
      </block>
    </view>
  </block>

  <page-footer wx:if="{{isHost}}" extClass="footer" bind:prev="handleGoBack">
    <view class="primary-btn" bindtap="onStartSpeak">开始游戏</view>
  </page-footer>

  <page-footer
    wx:elif="{{!memorized}}"
    extClass="footer"
    showPrev="{{false}}"
  >
    <view class="primary-btn {{revealed ? '' : 'dimmed'}}" bindtap="onMemorized">已记住</view>
  </page-footer>

  <page-footer
    wx:else
    extClass="footer"
    showPrimary="{{false}}"
    bind:prev="handleGoBack"
  ></page-footer>
</view>

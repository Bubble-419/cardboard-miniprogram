/* spyMode 共用视觉：对齐 brainstormMode */
.container {
  min-height: 100vh;
  background-color: #F3FAF9;
  box-sizing: border-box;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.header-section {
  padding: 0 48rpx 24rpx;
}

/* 顶栏已迁移至 player-top-bar；保留样式以免未迁移页引用断裂 */
.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  height: 88rpx;
}

.room-entry {
  width: 74rpx;
  height: 74rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.room-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 74rpx;
  height: 74rpx;
}

.avatar-bar {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
}

.title-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  line-height: 1.2;
}

.page-subtitle {
  font-size: 24rpx;
  font-weight: 400;
  color: #6F6F6F;
  line-height: 1.6;
}

.section {
  margin: 0 40rpx 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx 0 rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-body {
  font-size: 26rpx;
  color: #6F6F6F;
  line-height: 1.7;
}

.hint-text {
  font-size: 26rpx;
  color: #3AAE34;
  line-height: 1.6;
}

.warn-text {
  font-size: 24rpx;
  color: #E07A5F;
  margin-top: 12rpx;
}

.status-text {
  font-size: 28rpx;
  color: #545454;
  font-weight: 600;
}

.countdown {
  font-size: 64rpx;
  font-weight: 700;
  color: #3AAE34;
  letter-spacing: 2rpx;
  text-align: center;
}

.countdown-label {
  text-align: center;
  font-size: 24rpx;
  color: #94A3B8;
  margin-top: 8rpx;
}

.word-card {
  background: linear-gradient(160deg, #F7FCF8 0%, #FFFFFF 100%);
  border: 2rpx solid #D8EFD6;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.word-card:last-child {
  margin-bottom: 0;
}

.word-card-tag {
  font-size: 22rpx;
  color: #3AAE34;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.word-card-tag.spy {
  color: #E07A5F;
}

.word-card-word {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.word-card-blurb {
  font-size: 24rpx;
  color: #6F6F6F;
  line-height: 1.6;
}

.player-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEF2F0;
}

.player-row:last-child {
  border-bottom: none;
}

.player-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.player-meta {
  font-size: 24rpx;
  color: #94A3B8;
}

.footer {
  padding: 40rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  background: linear-gradient(
    0deg,
    rgba(255, 255, 255, 1) 0%,
    rgba(255, 255, 255, 0.95) 50%,
    rgba(255, 255, 255, 0) 100%
  );
}

.primary-btn {
  flex: 1;
  width: 100%;
  background-color: #5EC159;
  color: #FFFFFF;
  border-radius: 24rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 4rpx;
}

.primary-btn.dimmed {
  opacity: 0.45;
}

.primary-btn:active {
  opacity: 0.85;
}

.secondary-btn {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 2rpx solid #5EC159;
  color: #3AAE34;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: #FFFFFF;
}

.secondary-btn:active {
  opacity: 0.85;
}

.rules-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.rules-item {
  font-size: 26rpx;
  color: #6F6F6F;
  line-height: 1.6;
}

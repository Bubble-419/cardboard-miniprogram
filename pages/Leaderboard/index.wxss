.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8fbfa 0%, #e9f5e9 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

.custom-navbar {
  background-color: rgba(255, 255, 255, 0.95);
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-chevron {
  font-size: 48rpx;
  font-weight: 300;
  color: #000;
  line-height: 1;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000;
  flex: 1;
  text-align: center;
}

.navbar-right {
  width: 80rpx;
}

.content {
  padding: 32rpx;
  padding-bottom: 180rpx;
}

.loading-wrap,
.error-wrap {
  padding: 80rpx;
  text-align: center;
}

.loading-text {
  font-size: 30rpx;
  color: #999;
}

.error-text {
  font-size: 30rpx;
  color: #e24a4a;
}

.leaderboard-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.leaderboard-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(94, 193, 89, 0.12);
}

.rank {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  border-radius: 50%;
  background-color: #f0f0f0;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.rank-top {
  background-color: #5ec159;
  color: #fff;
  font-weight: 700;
}

.avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.meta {
  font-size: 24rpx;
  color: #999;
}

.score-wrap {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.score-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #5ec159;
}

.score-unit {
  font-size: 24rpx;
  color: #5ec159;
  margin-left: 4rpx;
}

/* 底部再来一局按钮 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx 54rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #e9f5e9 0%, transparent 100%);
  z-index: 10;
}

.new-game-btn {
  width: 100%;
  height: 96rpx;
  background-color: #5ec159;
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 44rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  letter-spacing: 4rpx;
}

.new-game-btn::after {
  border: none;
}

.new-game-btn:active {
  opacity: 0.8;
}

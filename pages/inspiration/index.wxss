.container {
  min-height: 100vh;
  background-color: #f8fbfa;
  display: flex;
  flex-direction: column;
}

.custom-navbar {
  background-color: #f8fbfa;
  flex-shrink: 0;
  box-sizing: border-box;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.navbar-left {
  width: 80rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
}

.back-chevron {
  font-size: 48rpx;
  color: #000000;
  line-height: 1;
  font-weight: 400;
}

.navbar-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1a1a1a;
  line-height: 1.2;
}

.navbar-right {
  width: 80rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.ai-section {
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  flex-shrink: 0;
}

.ai-input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ai-input-wrapper {
  flex: 1;
  height: 140rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border: 2rpx solid #c7ffc4;
  border-radius: 40rpx;
  padding: 20rpx;
  position: relative;
}

.ai-placeholder {
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #828282;
  pointer-events: none;
}

.ai-input {
  width: 100%;
  height: 100%;
  font-size: 24rpx;
  color: #424242;
}

.ai-button {
  width: 138rpx;
  height: 48rpx;
  background: linear-gradient(223.34deg, rgba(0, 240, 81, 1) 11.75%, rgba(0, 177, 255, 1) 88.25%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.4rpx solid #ffffff;
}

.ai-button-disabled {
  opacity: 0.5;
}

.ai-button-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.referenced-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #cdffe5;
  border-radius: 25.2rpx;
  padding: 8rpx 16rpx;
  margin-left: 24rpx;
}

.referenced-icon {
  width: 20rpx;
  height: 20rpx;
}

.referenced-text {
  font-size: 20rpx;
  color: #00b46a;
}

.inspirations-container {
  flex: 1;
  height: 0;
  width: 100%;
  padding: 24rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.waterfall-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.waterfall-empty-text {
  font-size: 28rpx;
  color: #879487;
  line-height: 1.5;
}

.waterfall-wrapper {
  display: flex;
  gap: 16rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.inspiration-card {
  position: relative;
  background-color: #ffffff;
  border: 0.8rpx solid #d6e8eb;
  border-radius: 40rpx;
  padding: 28rpx;
  box-shadow: 0 0 8rpx rgba(94, 223, 255, 0);
  transition: all 0.3s;
}

.inspiration-card.referenced {
  box-shadow: 0 0 8rpx rgba(94, 223, 255, 1);
}

.reference-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  width: 38rpx;
  height: 38rpx;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-text {
  font-size: 24rpx;
  color: #424242;
  line-height: 1.5;
  word-break: break-word;
}

.card-image {
  width: 100%;
  border-radius: 28rpx;
}

.card-ai-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 20rpx;
  color: #00b46a;
  background: #cdffe5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.audio-player {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.audio-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.play-icon {
  width: 40rpx;
  height: 40rpx;
}

.audio-time {
  font-size: 20rpx;
  color: #5ec159;
}

.audio-waveform {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 30rpx;
}

.wave-bar {
  flex: 1;
  background-color: #5ec159;
  border-radius: 2rpx;
  height: 20rpx;
}

/* 灵感输入栏：复用 gamepage，无左侧灯泡 */
.inspiration-bar {
  margin: 0 30rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 51;
  min-height: 100rpx;
  box-sizing: border-box;
  background-color: #f8fbfa;
}

.inspiration-composer {
  flex: 1;
  min-width: 0;
  min-height: 92rpx;
  padding: 18rpx 30rpx;
  background: #fff;
  border: 1rpx solid #d7d7d7;
  border-radius: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.inspiration-composer-focused {
  border-color: #d7d7d7;
}

.inspiration-photo-strip {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.inspiration-photo-strip-inner {
  display: inline-flex;
  gap: 12rpx;
}

.inspiration-photo-thumb-wrap {
  position: relative;
  width: 96rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.inspiration-photo-thumb {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #eee;
}

.inspiration-photo-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.inspiration-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.inspiration-textarea {
  flex: 1;
  min-width: 0;
  min-height: 44rpx;
  max-height: 200rpx;
  font-size: 32rpx;
  color: #333;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.inspiration-placeholder {
  font-size: 32rpx;
  color: #aeaeae;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.inspiration-action {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inspiration-action-disabled {
  opacity: 0.55;
}

.inspiration-action-icon {
  width: 44rpx;
  height: 44rpx;
}

.inspiration-focus-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: transparent;
}

.container {
  position: relative;
  height: 100vh;
  min-height: 100vh;
  /* 青绿雾感：比主界面更沉、更湿润，带纵向层次 */
  background:
    radial-gradient(ellipse 90% 55% at 12% -8%, rgba(126, 224, 186, 0.55) 0%, transparent 58%),
    radial-gradient(ellipse 70% 45% at 92% 18%, rgba(94, 193, 89, 0.28) 0%, transparent 52%),
    radial-gradient(ellipse 80% 50% at 50% 108%, rgba(0, 140, 120, 0.18) 0%, transparent 55%),
    linear-gradient(168deg, #d8f0e4 0%, #eaf6ef 38%, #f3faf6 72%, #e4f2ea 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.container::before {
  content: '';
  position: absolute;
  left: -20%;
  right: -20%;
  top: 18%;
  height: 42%;
  background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.55) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.container::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
  z-index: 0;
}

.custom-navbar {
  position: relative;
  z-index: 2;
  background: transparent;
  flex-shrink: 0;
  box-sizing: border-box;
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.navbar-left {
  width: 96rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-shrink: 0;
}

.back-chevron {
  font-size: 64rpx;
  color: #1a3d2e;
  line-height: 1;
  font-weight: 500;
}

.navbar-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.navbar-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #16352a;
  line-height: 1.2;
  letter-spacing: 0.08em;
}

.navbar-right {
  width: 80rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.ai-section {
  position: relative;
  z-index: 2;
  padding: 20rpx 24rpx;
  background-color: transparent;
  flex-shrink: 0;
}

.ai-input-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.ai-input-wrapper {
  flex: 1;
  height: 140rpx;
  background-color: rgba(255, 255, 255, 0.45);
  border: 2rpx solid rgba(94, 193, 89, 0.35);
  border-radius: 40rpx;
  padding: 20rpx;
  position: relative;
  backdrop-filter: blur(8px);
}

.ai-placeholder {
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #6b8f7c;
  pointer-events: none;
}

.ai-input {
  width: 100%;
  height: 100%;
  font-size: 24rpx;
  color: #2a4a3a;
}

.ai-button {
  width: 138rpx;
  height: 48rpx;
  background: linear-gradient(223.34deg, rgba(0, 240, 81, 1) 11.75%, rgba(0, 177, 255, 1) 88.25%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0.4rpx solid #ffffff;
}

.ai-button-disabled {
  opacity: 0.5;
}

.ai-button-text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 500;
}

.referenced-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(205, 255, 229, 0.85);
  border-radius: 25.2rpx;
  padding: 8rpx 16rpx;
  margin-left: 24rpx;
}

.referenced-icon {
  width: 20rpx;
  height: 20rpx;
}

.referenced-text {
  font-size: 20rpx;
  color: #00b46a;
}

.inspirations-container {
  position: relative;
  z-index: 2;
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  padding: 24rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.waterfall-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.waterfall-empty-text {
  font-size: 28rpx;
  color: #5f8a74;
  line-height: 1.5;
}

.waterfall-wrapper {
  display: flex;
  gap: 16rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.inspiration-card {
  position: relative;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(126, 200, 160, 0.45);
  border-radius: 36rpx;
  padding: 28rpx;
  box-shadow:
    0 8rpx 28rpx rgba(46, 120, 90, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.75);
}

.inspiration-card.referenced {
  background: rgba(255, 255, 255, 0.88);
  border-color: rgba(94, 193, 89, 0.75);
  box-shadow:
    0 0 0 2rpx rgba(94, 223, 180, 0.35),
    0 10rpx 32rpx rgba(46, 140, 100, 0.14);
}

.reference-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  width: 38rpx;
  height: 38rpx;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-text {
  font-size: 24rpx;
  color: #2c4538;
  line-height: 1.55;
  word-break: break-word;
}

.card-image {
  width: 100%;
  border-radius: 28rpx;
}

.card-ai-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  font-size: 20rpx;
  color: #00b46a;
  background: #cdffe5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.audio-player {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.audio-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.play-icon {
  width: 40rpx;
  height: 40rpx;
}

.audio-time {
  font-size: 20rpx;
  color: #5ec159;
}

.audio-waveform {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 30rpx;
}

.wave-bar {
  flex: 1;
  background-color: #5ec159;
  border-radius: 2rpx;
  height: 20rpx;
}

/* 灵感输入栏：雾感底，与页面氛围衔接 */
.inspiration-bar {
  position: relative;
  z-index: 60;
  margin: 0 30rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  min-height: 100rpx;
  box-sizing: border-box;
  background: transparent;
  transition: padding-bottom 0.15s ease-out;
}

/* 键盘升起后 Home Indicator 已被覆盖，去掉 safe-area 避免叠空隙 */
.inspiration-bar-focused {
  padding-bottom: 18rpx;
  background: rgba(243, 250, 246, 0.96);
}

.inspiration-composer {
  flex: 1;
  min-width: 0;
  min-height: 92rpx;
  padding: 18rpx 30rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(126, 200, 160, 0.5);
  border-radius: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-shadow: 0 10rpx 36rpx rgba(40, 100, 70, 0.1);
}

.inspiration-composer-focused {
  border-color: rgba(94, 193, 89, 0.7);
  background: rgba(255, 255, 255, 0.92);
}

.inspiration-photo-strip {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.inspiration-photo-strip-inner {
  display: inline-flex;
  gap: 12rpx;
}

.inspiration-photo-thumb-wrap {
  position: relative;
  width: 96rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.inspiration-photo-thumb {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  background: #eee;
}

.inspiration-photo-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.inspiration-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.inspiration-textarea {
  flex: 1;
  min-width: 0;
  min-height: 44rpx;
  max-height: 200rpx;
  font-size: 32rpx;
  color: #2c4538;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.inspiration-placeholder {
  font-size: 32rpx;
  color: #8aab98;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.inspiration-action {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inspiration-action-disabled {
  opacity: 0.55;
}

.inspiration-action-icon {
  width: 44rpx;
  height: 44rpx;
}

.inspiration-focus-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  /* bottom 由内联样式按键盘高度留出输入栏 */
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  z-index: 50;
  background: transparent;
}

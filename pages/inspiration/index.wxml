<view class="container">
  <view class="custom-navbar" style="padding-top: {{navbarPaddingTop}}px;">
    <view class="navbar-content">
      <view class="navbar-left" bindtap="goBack">
        <text class="back-chevron">‹</text>
      </view>
      <view class="navbar-center">
        <text class="navbar-title">灵感空间</text>
      </view>
      <view class="navbar-right"></view>
    </view>
  </view>

  <!-- AI_TEMP_DISABLED: 恢复 AI 时去掉外层 wx:if="{{aiFeatureEnabled}}" 即可 -->
  <view class="ai-section" wx:if="{{aiFeatureEnabled}}">
    <view class="ai-input-container">
      <view class="ai-input-wrapper">
        <text class="ai-placeholder" wx:if="{{!aiPrompt}}">输入提示词，AI帮你生成灵感</text>
        <input class="ai-input" type="text" value="{{aiPrompt}}" bindinput="onAIInput" confirm-type="done"></input>
      </view>
      <view class="ai-button {{isGenerating ? 'ai-button-disabled' : ''}}" bindtap="generateAIInspiration">
        <text class="ai-button-text">AI灵感</text>
      </view>
    </view>
    <view class="referenced-tag" wx:if="{{referencedInspirations.length > 0}}">
      <image class="referenced-icon" src="/assets/icons/link-icon.png" mode="aspectFit"></image>
      <text class="referenced-text">已引用{{referencedInspirations.length}}个灵感</text>
    </view>
  </view>

  <scroll-view class="inspirations-container" scroll-y show-scrollbar="{{false}}">
    <view class="waterfall-empty" wx:if="{{!displayInspirations.length}}">
      <text class="waterfall-empty-text">还没有灵感，写下第一条吧</text>
    </view>

    <view class="waterfall-wrapper" wx:if="{{displayInspirations.length}}">
      <view class="waterfall-column" wx:for="{{waterfallColumns}}" wx:key="key" wx:for-index="colIndex">
        <view
          class="inspiration-card {{inspiration.referenced ? 'referenced' : ''}}"
          wx:for="{{item.items}}"
          wx:for-item="inspiration"
          wx:for-index="inspIndex"
          wx:key="id"
          data-id="{{inspiration.id}}"
          bindtap="toggleReference"
        >
          <view class="reference-check" wx:if="{{inspiration.referenced}}">
            <image class="check-icon" src="/assets/icons/check-icon.png" mode="aspectFit"></image>
          </view>

          <view class="card-content" wx:if="{{inspiration.type === 'text'}}">
            <text class="card-text">{{inspiration.content}}</text>
          </view>

          <view class="card-content" wx:if="{{inspiration.type === 'image'}}">
            <image class="card-image" src="{{inspiration.imageUrl}}" mode="widthFix" wx:if="{{inspiration.imageUrl}}"></image>
            <text class="card-text" wx:if="{{inspiration.content}}">{{inspiration.content}}</text>
          </view>

          <view class="card-content" wx:if="{{inspiration.type === 'audio'}}">
            <view class="audio-player">
              <view class="audio-controls">
                <image class="play-icon" src="/assets/icons/play-icon.png" mode="aspectFit"></image>
                <text class="audio-time">{{inspiration.duration || '00:00'}}</text>
              </view>
              <view class="audio-waveform">
                <view class="wave-bar" wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this"></view>
              </view>
            </view>
            <text class="card-text" wx:if="{{inspiration.content}}">{{inspiration.content}}</text>
          </view>

          <!-- AI_TEMP_DISABLED: 恢复 AI 时改回 wx:if="{{inspiration.isAIGenerated}}" -->
          <view class="card-ai-tag" wx:if="{{aiFeatureEnabled && inspiration.isAIGenerated}}">AI</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 灵感输入：页面定高不可滚，按键盘高度把输入栏抬到键盘上方 -->
  <view
    class="inspiration-focus-mask"
    wx:if="{{inspirationInputFocused}}"
    style="{{inspirationMaskStyle}}"
    catchtouchstart="onInspirationDismissFocus"
  ></view>
  <view
    class="inspiration-bar {{inspirationInputFocused ? 'inspiration-bar-focused' : ''}}"
    style="{{inspirationLiftStyle}}"
  >
    <view class="inspiration-composer {{inspirationInputFocused ? 'inspiration-composer-focused' : ''}}" catchtap="onInspirationComposerTap">
      <scroll-view
        wx:if="{{inspirationDraftPhotos.length}}"
        class="inspiration-photo-strip"
        scroll-x
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="inspiration-photo-strip-inner">
          <view
            class="inspiration-photo-thumb-wrap"
            wx:for="{{inspirationDraftPhotos}}"
            wx:key="*this"
          >
            <image
              class="inspiration-photo-thumb"
              src="{{item}}"
              mode="aspectFill"
              catchtap="onInspirationPreviewPhoto"
              data-url="{{item}}"
            />
            <view
              class="inspiration-photo-remove"
              catchtap="onInspirationRemovePhoto"
              data-index="{{index}}"
            >×</view>
          </view>
        </view>
      </scroll-view>
      <view class="inspiration-row">
        <textarea
          class="inspiration-textarea"
          value="{{inspirationDraftText}}"
          hold-keyboard="{{inspirationHoldKeyboard}}"
          bindfocus="onInspirationFocus"
          bindblur="onInspirationBlur"
          bindinput="onInspirationInput"
          bindkeyboardheightchange="onInspirationKeyboardHeightChange"
          placeholder="记录您的灵感..."
          placeholder-class="inspiration-placeholder"
          maxlength="2000"
          auto-height
          show-confirm-bar="{{false}}"
          adjust-position="{{false}}"
          cursor-spacing="24"
        />
        <view
          class="inspiration-action {{inspirationSaving ? 'inspiration-action-disabled' : ''}}"
          catchtap="onInspirationActionTap"
        >
          <image
            wx:if="{{inspirationHasText || inspirationDraftPhotos.length}}"
            class="inspiration-action-icon"
            src="/assets/partnerMode/icon-insp-send.svg"
            mode="aspectFit"
          />
          <image
            wx:else
            class="inspiration-action-icon"
            src="/assets/partnerMode/icon-insp-plus.svg"
            mode="aspectFit"
          />
        </view>
      </view>
    </view>
  </view>
</view>

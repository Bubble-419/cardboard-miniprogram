<view class="container">
  <!-- 右上角灵感空间入口（仅房主显示） -->
  <!-- <view class="inspiration-entry" wx:if="{{isHost}}" bindtap="goToInspiration">
    <text class="inspiration-text">灵感空间</text>
  </view> -->

  <!-- 普通玩家：等待房主选择情境 -->
  <view class="content" wx:if="{{!isHost || isWaiting}}">
    <view class="title-section">
      <text class="main-title">脑暴工作坊</text>
      <text class="sub-title wait-hint">等待房主选择情境</text>
    </view>
    <view class="empty-state">
      <text class="empty-state-text">等待房主选择情境</text>
    </view>
  </view>

  <!-- 房主：情境选择卡片 -->
  <view class="content" wx:else>
    <view class="title-section">
      <text class="main-title">脑暴工作坊</text>
      <text class="sub-title">请选择情境类型</text>
    </view>
    <view class="role-cards">
      <view class="role-card" bindtap="selectPresetScenario">
        <view class="card-icon preset-icon">📺</view>
        <text class="role-title">已设定情境</text>
        <text class="role-description">选择线下大屏上已展示的情境，直接进入游戏页面</text>
      </view>
      <view class="role-card" bindtap="selectCustomScenario">
        <view class="card-icon custom-icon">✏️</view>
        <text class="role-title">自定义情境</text>
        <text class="role-description">自行选择情境卡（场景、用户、平台、功能），创建专属脑暴情境</text>
      </view>
    </view>
  </view>
</view>

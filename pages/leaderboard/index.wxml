<view class="container">
  <view
    class="custom-navbar"
    style="padding-top: {{topBarPadTop}}px; padding-right: {{topBarPaddingRight}}px;"
  >
    <view class="navbar-content" style="height: {{topBarHeight}}px;">
      <view
        class="navbar-room-entry"
        style="width: {{topBarIconSize}}px; height: {{topBarIconSize}}px;"
        bindtap="handleGoRoom"
        role="button"
        aria-label="打开房间"
      >
        <image
          class="navbar-room-entry-icon"
          src="/assets/partnerMode/icon-room-entry-gp.svg"
          mode="aspectFit"
        />
      </view>
      <view class="navbar-title"></view>
      <view
        class="navbar-right"
        style="width: {{topBarIconSize}}px; height: {{topBarIconSize}}px;"
      />
    </view>
  </view>

  <view class="content">
    <view wx:if="{{loading}}" class="loading-wrap">
      <text class="loading-text">加载中…</text>
    </view>

    <view wx:elif="{{error}}" class="error-wrap">
      <text class="error-text">{{error}}</text>
    </view>

    <view wx:else class="leaderboard-list">
      <view
        class="leaderboard-item"
        wx:for="{{leaderboard}}"
        wx:key="playerIndex"
      >
        <view class="rank {{item.rank <= 3 ? 'rank-top' : ''}}">{{item.rank}}</view>
        <view class="avatar-wrap" style="background-color: {{item.avatarColor || '#5EC159'}}">
          <image
            wx:if="{{item.avatarUrl}}"
            class="avatar-img"
            src="{{item.avatarUrl}}"
            mode="aspectFill"
          />
          <text wx:else class="avatar-placeholder">{{item.nickName && item.nickName[0] ? item.nickName[0] : item.playerIndex}}</text>
        </view>
        <view class="info">
          <text class="name">{{item.nickName}}</text>
          <text class="meta">共 {{item.scoreCount}} 次评分</text>
        </view>
        <view class="score-wrap">
          <image
            class="total-star-icon"
            src="/assets/partnerMode/icon-star-full.png"
            mode="aspectFit"
          />
          <text class="total-star-num">{{item.totalStars}}</text>
        </view>
      </view>
      <view class="review-entry" bindtap="handleGlobalReview">
        <text class="review-entry-text">全局回顾</text>
      </view>
    </view>
  </view>

  <!-- 房主可保留当前模式再来一轮，或清除模式返回房间 -->
  <view class="footer" wx:if="{{!loading && !error && !isSubScreen}}">
    <block wx:if="{{from === 'closingEnd'}}">
      <view class="footer-actions">
        <button
          class="return-room-btn"
          disabled="{{actioning}}"
          bindtap="handleReturnRoom"
        >返回房间</button>
        <button
          class="new-game-btn"
          disabled="{{actioning}}"
          bindtap="handleAnotherRound"
        >再来一轮</button>
      </view>
    </block>
    <button
      wx:else
      class="new-game-btn"
      disabled="{{actioning}}"
      bindtap="handleNewGame"
    >再来一局</button>
  </view>
</view>

<interaction-lock-layer
  locked="{{interactionLocked}}"
  loading="{{interactionLoading}}"
  text="{{interactionLoadingText}}"
/>

.container {
  min-height: 100vh;
  background-color: #fafafa;
  display: flex;
  flex-direction: column;
}

/* ===== 情境等待页 Figma #5878:13766 ===== */
.container-bg-scene {
  min-height: 100vh;
  background-color: #F7F9F5;
}

.bg-wait-page {
  position: relative;
  flex: 1;
  min-height: 100vh;
  overflow: hidden;
}

.bg-pattern {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  opacity: 0.4;
  pointer-events: none;
}

.bg-wait-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: calc(env(safe-area-inset-top) + 46rpx);
  box-sizing: border-box;
}

/* Illustration: height 443px → 886rpx, bottom padding 40px → 80rpx */
.hero-section {
  width: 100%;
  height: 886rpx;
  padding-bottom: 80rpx;
  box-sizing: content-box;
  overflow: hidden;
}

.hero-image {
  display: block;
  width: 100%;
  height: 886rpx;
}

/* Text section: padding 0 16px → 32rpx, gap 15px → 30rpx */
.text-section {
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

/* Heading: 28px Medium, #2B2B2B, line-height 36px → 56rpx / 72rpx */
.heading {
  width: 100%;
  font-size: 56rpx;
  font-weight: 500;
  color: #2B2B2B;
  line-height: 72rpx;
  letter-spacing: -0.0268em;
  text-align: center;
}

/* Desc: 16px Regular, #909090, line-height 24px → 32rpx / 48rpx */
.desc-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.desc-line {
  font-size: 32rpx;
  font-weight: 400;
  color: #909090;
  line-height: 48rpx;
  text-align: center;
}

/* Status pill margin-top 36px → 72rpx */
.status-pill {
  margin-top: 72rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 56rpx;
  background-color: #EDF6EC;
  border-radius: 9999rpx;
}

.status-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

/* Status text: 14px Medium, #6EBA62, line-height 28px → 28rpx / 56rpx */
.status-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #6EBA62;
  line-height: 56rpx;
  white-space: nowrap;
}

/* ===== 其他等待场景（原样式） ===== */
.custom-navbar {
  background-color: #ffffff;
  padding-top: env(safe-area-inset-top);
}

.navbar-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 42rpx;
}

.navbar-left {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
  text-align: center;
  flex: 1;
}

.navbar-right {
  width: 174rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
}

.navbar-icon {
  width: 32rpx;
  height: 32rpx;
  font-size: 24rpx;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.waiting-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
}

.countdown {
  font-size: 80rpx;
  color: #ffffff;
  text-align: center;
  line-height: 1.5;
  font-weight: 400;
  margin-bottom: 40rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.character-container {
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.character-bg {
  width: 438rpx;
  height: 294rpx;
  background-color: rgba(31, 177, 213, 0.15);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.character-icon {
  width: 128rpx;
  height: 120rpx;
  background-color: #4fc8e7;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.character-face {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.eye {
  width: 26rpx;
  height: 26rpx;
  background-color: #000000;
  border-radius: 50%;
  position: absolute;
  top: 40%;
}

.eye-left {
  left: 25%;
  transform: translate(-50%, -50%);
}

.eye-right {
  right: 25%;
  transform: translate(50%, -50%);
}

.mouth {
  width: 18rpx;
  height: 9rpx;
  border: 2rpx solid #000000;
  border-top: none;
  border-radius: 0 0 18rpx 18rpx;
  position: absolute;
  bottom: 30%;
  left: 50%;
  transform: translateX(-50%);
}

.foot {
  width: 34rpx;
  height: 32rpx;
  background-color: #000000;
  border-radius: 4rpx;
  position: absolute;
  bottom: 10%;
}

.foot-left {
  left: 20%;
}

.foot-right {
  right: 20%;
}

.main-text {
  font-size: 56rpx;
  color: #16a6ca;
  text-align: center;
  margin-bottom: 20rpx;
  font-weight: 500;
  line-height: 1.5;
  padding: 0 40rpx;
}

.main-text-multiline {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-text-line {
  display: block;
  line-height: 1.5;
}

.sub-text {
  font-size: 36rpx;
  color: #9a9a9a;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.33;
}

<view class="container {{useHeroLayout ? 'container-hero-scene' : ''}}">
  <!-- 非 hero 等待场景保留原导航栏 -->
  <view class="custom-navbar" wx:if="{{!useHeroLayout}}">
    <view class="navbar-content">
      <view class="navbar-left">
        <image class="back-icon" src="/assets/icons/back-arrow.png" mode="aspectFit"></image>
      </view>
      <view class="navbar-title">{{navbarTitle}}</view>
      <view class="navbar-right">
        <view class="navbar-icon">⋯</view>
        <view class="navbar-icon">○</view>
      </view>
    </view>
  </view>

  <!-- Hero 等待页：情境 / 首位玩家等（Figma #5904:13756） -->
  <view class="hero-wait-page" wx:if="{{useHeroLayout}}">
    <image class="bg-pattern" src="/assets/subAwait/bg-dotted-lines.svg" mode="widthFix" />
    <view class="hero-wait-content">
      <view class="hero-section">
        <image
          class="hero-image"
          src="/assets/subAwait/wait-hero-5a8ea5.webp"
          mode="widthFix"
        />
      </view>

      <view class="text-section">
        <text class="heading">{{mainText}}</text>
        <view class="desc-group">
          <text class="desc-line">{{subTextLine1}}</text>
          <text class="desc-line">{{subTextLine2}}</text>
        </view>
      </view>

      <view class="status-pill">
        <image class="status-icon" src="/assets/subAwait/icon-waiting.png" mode="aspectFit" />
        <text class="status-text">{{statusText}}</text>
      </view>
    </view>
  </view>

  <!-- 其他等待场景：沿用原布局 -->
  <view class="waiting-content" wx:else>
    <view class="countdown" wx:if="{{countdown > 0}}">{{countdown}}s</view>

    <view class="character-container">
      <view class="character-bg">
        <view class="character-icon">
          <view class="character-face">
            <view class="eye eye-left"></view>
            <view class="eye eye-right"></view>
            <view class="mouth"></view>
            <view class="foot foot-left"></view>
            <view class="foot foot-right"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="main-text" wx:if="{{!multiLine}}">{{mainText}}</view>
    <view class="main-text main-text-multiline" wx:else>
      <text class="main-text-line" wx:for="{{mainTextLines}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="sub-text">{{subText}}</view>
  </view>
</view>

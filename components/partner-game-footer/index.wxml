<view
  class="page-footer {{keyboardOpen ? 'page-footer-insp-hidden' : ''}}"
  wx:if="{{visible}}"
>
  <view class="bottom-actions" wx:if="{{historyReview && reviewCanGoBack}}">
    <button class="end-brainstorm-btn" data-intent="REVIEW_BACK" bindtap="emitIntent">返回</button>
  </view>
  <view class="bottom-actions" wx:elif="{{phase === 'closing' && closingStep === 'rune' && isHost}}">
    <button class="closing-next-btn" data-intent="CLOSING_NEXT" bindtap="emitIntent">下一步</button>
  </view>
  <view class="bottom-actions" wx:elif="{{phase === 'closing' && closingStep === 'review' && isHost}}">
    <button class="end-brainstorm-btn" data-intent="END_BRAINSTORM" bindtap="emitIntent">结束脑暴</button>
  </view>
  <view class="bottom-actions" wx:elif="{{phase === 'closing' && closingStep === 'review'}}">
    <button class="end-brainstorm-btn" data-intent="GLOBAL_REVIEW" bindtap="emitIntent">全局回顾</button>
  </view>
  <view class="bottom-actions bottom-actions-discussion" wx:elif="{{phase === 'discussion' && isHost}}">
    <button
      class="end-discussion-btn end-discussion-btn-secondary {{discussionSwitching && discussionSwitchAction === 'allPass' ? 'end-discussion-btn-loading' : ''}}"
      disabled="{{discussionSwitching}}"
      loading="{{discussionSwitching && discussionSwitchAction === 'allPass'}}"
      hover-class="none"
      data-intent="DISCUSSION_ALL_PASS"
      bindtap="emitIntent"
    >{{discussionSwitching && discussionSwitchAction === 'allPass' ? '处理中' : '没有疑问'}}</button>
    <button
      class="end-discussion-btn {{discussionSwitching && discussionSwitchAction === 'end' ? 'end-discussion-btn-loading' : ''}}"
      disabled="{{discussionSwitching}}"
      loading="{{discussionSwitching && discussionSwitchAction === 'end'}}"
      hover-class="none"
      data-intent="END_DISCUSSION"
      bindtap="emitIntent"
    >{{discussionSwitching && discussionSwitchAction === 'end' ? '处理中' : '结束讨论'}}</button>
  </view>
  <view class="bottom-actions" wx:elif="{{showSpecialMove || isHost || (isCurrentPlayer && phase !== 'discussion' && phase !== 'closing')}}">
    <view
      wx:if="{{showSpecialMove || (isCurrentPlayer && phase !== 'discussion' && phase !== 'closing')}}"
      class="special-btn-wrap {{isHost ? '' : 'special-btn-wrap-alone'}}"
    >
      <view wx:if="{{specialMoveUsed || masterMode}}" class="special-btn special-btn-used">
        <text class="special-btn-line">特殊</text>
        <text class="special-btn-line">行动</text>
        <image class="special-btn-used-check" src="/assets/partnerMode/icon-special-used-check.svg" mode="aspectFit" />
      </view>
      <button wx:else class="special-btn" hover-class="none" data-intent="SPECIAL_MOVE" catchtap="emitIntent">
        <text class="special-btn-line">特殊</text>
        <text class="special-btn-line">行动</text>
      </button>
    </view>
    <view class="bottom-actions-gap" wx:if="{{(showSpecialMove || isCurrentPlayer) && isHost && phase !== 'discussion' && phase !== 'closing'}}"></view>
    <view class="statement-btn-wrap" wx:if="{{isHost}}" id="hostStatementBtn">
      <button
        class="statement-btn {{canStartStatement && !statementSwitching ? 'statement-btn-enabled' : ''}} {{statementSwitching ? 'statement-btn-loading' : ''}}"
        disabled="{{!canStartStatement || statementSwitching}}"
        loading="{{statementSwitching}}"
        hover-class="none"
        data-intent="START_STATEMENT"
        bindtap="emitIntent"
      >{{statementSwitching ? '进入中' : '开始表态'}}</button>
    </view>
  </view>
</view>


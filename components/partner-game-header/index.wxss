:host { display: block; flex-shrink: 0; }

.top-bar {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding-left: 30rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}
.top-bar-inner { display: flex; align-items: center; gap: 16rpx; width: 100%; box-sizing: border-box; }
.room-entry {
  border-radius: 9999rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.room-entry-icon { width: 100%; height: 100%; display: block; }
.problem-chip {
  flex: none;
  width: 432rpx;
  max-width: 432rpx;
  min-width: 0;
  min-height: 64rpx;
  padding: 10rpx 20rpx;
  background: #e9f5e9;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  box-sizing: border-box;
  z-index: 2;
}
.problem-chip-expanded { align-items: flex-start; z-index: 20; }
.problem-chip-tappable { cursor: pointer; }
.problem-chip-tappable:active { opacity: 0.82; }
.problem-icon { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-top: 2rpx; }
.problem-text-wrap { flex: 1; min-width: 0; position: relative; }
.problem-text {
  display: -webkit-box;
  width: 100%;
  font-size: 24rpx;
  color: #747474;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}
.problem-text-expanded { display: block; overflow: visible; text-overflow: unset; -webkit-line-clamp: unset; white-space: normal; }
.problem-text-measure {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  font-size: 24rpx;
  line-height: 1.2;
  word-break: break-all;
  white-space: normal;
  opacity: 0;
  pointer-events: none;
  z-index: -1;
}
.problem-text-empty { color: #a8c9a6; }

.flip-scene {
  width: 100%;
  perspective: 1200px;
  -webkit-perspective: 1200px;
}

.flip-scene.is-pressed {
  opacity: 0.92;
  transform: scale(0.98);
}

.flip-scene.is-animating {
  pointer-events: none;
}

.flip-card {
  position: relative;
  width: 100%;
  padding-top: 62.5%;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  background: transparent;
  transform: rotateY(0deg);
  -webkit-transform: rotateY(0deg);
}

.flip-card.flip-out {
  transition: transform 300ms ease-in-out;
  -webkit-transition: -webkit-transform 300ms ease-in-out;
  transform: rotateY(90deg);
  -webkit-transform: rotateY(90deg);
}

.flip-card.flip-in-start {
  transition: none;
  -webkit-transition: none;
  transform: rotateY(-90deg);
  -webkit-transform: rotateY(-90deg);
}

.flip-card.flip-in {
  transition: transform 300ms ease-in-out;
  -webkit-transition: -webkit-transform 300ms ease-in-out;
  transform: rotateY(0deg);
  -webkit-transform: rotateY(0deg);
}

.flip-face {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  overflow: visible;
}

.flip-img {
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
  background: transparent;
}

.flip-back-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #1f2430 0%, #3a4254 55%, #2a3140 100%);
  position: relative;
  pointer-events: none;
  border-radius: 24rpx;
}

.flip-back-pattern {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  bottom: 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(255, 255, 255, 0.22);
  background:
    repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.04) 0,
      rgba(255, 255, 255, 0.04) 12rpx,
      transparent 12rpx,
      transparent 24rpx
    );
}

.flip-back-title {
  position: relative;
  z-index: 1;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.flip-back-hint {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
}

.flip-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  pointer-events: none;
}

.flip-placeholder-text {
  color: #8a91a0;
  font-size: 26rpx;
}

<view
  class="star-rating star-rating-{{size}} {{disabled ? 'star-rating-disabled' : ''}} {{gesturing ? 'star-rating-gesturing' : ''}}"
  catchtouchstart="onTouchStart"
  catchtouchmove="onTouchMove"
  catchtouchend="onTouchEnd"
  catchtouchcancel="onTouchEnd"
>
  <view class="star-track">
    <view
      class="star-slot {{item.active ? 'star-slot-active' : ''}}"
      wx:for="{{stars}}"
      wx:key="index"
    >
      <image
        class="star-icon"
        src="/assets/partnerMode/icon-star-empty.png"
        mode="aspectFit"
      />
      <view class="star-fill-clip star-fill-{{item.fill}}">
        <image
          class="star-icon"
          src="/assets/partnerMode/icon-star-full.png"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>
</view>

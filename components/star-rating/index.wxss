.star-rating {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-width: 300rpx;
  height: 60rpx;
  padding: 0;
  box-sizing: border-box;
}

.star-rating-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.star-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 300rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.star-slot {
  position: relative;
  flex: 1 1 0;
  min-width: 60rpx;
  height: 60rpx;
}

.star-glyph {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 60rpx;
  height: 60rpx;
  margin-left: -30rpx;
  margin-top: -30rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 56rpx;
}

.star-fill-clip {
  position: absolute;
  left: 50%;
  top: 50%;
  height: 60rpx;
  margin-left: -30rpx;
  margin-top: -30rpx;
  overflow: hidden;
  pointer-events: none;
}

.star-fill-clip .star-glyph {
  left: 0;
  top: 0;
  margin-left: 0;
  margin-top: 0;
}

.star-fill-0 {
  width: 0;
}

.star-fill-50 {
  width: 30rpx;
}

.star-fill-100 {
  width: 60rpx;
}

.star-empty {
  color: #d8efd6;
}

.star-full {
  color: #5ec159;
}

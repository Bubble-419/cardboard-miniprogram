.star-rating {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-width: 300rpx;
  height: 60rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  border: none;
}

.star-rating-disabled {
  opacity: 0.55;
  pointer-events: none;
}

.star-track {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-width: 280rpx;
  height: 60rpx;
  box-sizing: border-box;
}

.star-slot {
  position: relative;
  flex: 1 1 0;
  min-width: 56rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(1);
  transform-origin: center center;
  transition: transform 140ms cubic-bezier(0.22, 1, 0.36, 1);
}

.star-slot-active {
  transform: scale(1.08);
  z-index: 1;
}

.star-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56rpx;
  height: 56rpx;
  margin-left: -28rpx;
  margin-top: -28rpx;
  display: block;
}

.star-fill-clip {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 56rpx;
  margin-left: -28rpx;
  margin-top: -28rpx;
  overflow: hidden;
  pointer-events: none;
  transition: width 150ms cubic-bezier(0.22, 1, 0.36, 1);
}

.star-fill-clip .star-icon {
  left: 0;
  top: 0;
  margin-left: 0;
  margin-top: 0;
}

.star-fill-0 {
  width: 0;
}

.star-fill-50 {
  width: 28rpx;
}

.star-fill-100 {
  width: 56rpx;
}

.star-rating-gesturing .star-fill-clip {
  transition: none;
}

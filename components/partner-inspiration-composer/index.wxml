<view
  class="inspiration-bar {{closing ? 'inspiration-bar-closing' : ''}} {{history ? 'inspiration-bar-history' : ''}} {{historyWithFooter ? 'inspiration-bar-history-with-footer' : ''}} {{safeBottom ? 'inspiration-bar-safe-bottom' : ''}} {{keyboardHeight > 0 ? 'inspiration-bar-keyboard-open' : ''}} {{inputFocused || keyboardHeight > 0 ? 'inspiration-bar-input-active' : ''}} {{hiddenByKeyboard ? 'inspiration-bar-kb-hidden' : ''}}"
  style="{{keyboardLiftStyle}}"
>
  <view
    class="insp-icon-wrap {{inputFocused || keyboardHeight > 0 ? 'insp-icon-wrap-disabled' : ''}}"
    catchtap="onOpenCenter"
    aria-disabled="{{inputFocused || keyboardHeight > 0}}"
  >
    <image class="insp-icon-img" src="/assets/partnerMode/icon-inspiration-gp.svg" mode="aspectFit" />
    <view class="insp-badge" wx:if="{{count > 0}}">
      <text class="insp-badge-num">{{count > 99 ? '99' : count}}</text>
    </view>
  </view>
  <view class="inspiration-composer {{draftPhotos.length ? 'inspiration-composer-with-photos' : ''}} {{inputFocused || keyboardHeight > 0 ? 'inspiration-composer-expanded' : ''}}">
    <scroll-view
      wx:if="{{draftPhotos.length}}"
      class="inspiration-photo-strip"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="inspiration-photo-strip-inner">
        <view
          class="inspiration-photo-thumb-wrap"
          wx:for="{{draftPhotos}}"
          wx:key="*this"
        >
          <image
            class="inspiration-photo-thumb"
            src="{{item}}"
            mode="aspectFill"
            catchtap="onPreviewPhoto"
            data-url="{{item}}"
          />
          <view
            class="inspiration-photo-remove"
            catchtap="onRemovePhoto"
            data-index="{{index}}"
          >×</view>
        </view>
      </view>
    </scroll-view>
    <view class="inspiration-row">
      <input
        class="inspiration-textarea"
        type="text"
        value="{{draftText}}"
        hold-keyboard="{{holdKeyboard}}"
        bindfocus="onFocus"
        bindblur="onBlur"
        bindinput="onInput"
        bindkeyboardheightchange="onKeyboardHeightChange"
        placeholder="记录您的灵感..."
        placeholder-class="inspiration-placeholder"
        maxlength="2000"
        confirm-type="done"
        adjust-position="{{false}}"
        cursor-spacing="24"
      />
      <view
        class="inspiration-action {{saving ? 'inspiration-action-disabled' : ''}}"
        catchtap="onActionTap"
      >
        <image
          class="inspiration-action-icon"
          src="{{hasText || draftPhotos.length ? '/assets/partnerMode/icon-insp-send.svg' : '/assets/partnerMode/icon-insp-plus.svg'}}"
          mode="aspectFit"
        />
      </view>
    </view>
  </view>
</view>

<view class="bg-card {{active ? 'is-active' : 'is-inactive'}}">
  <view class="card-top">
    <view class="type-badge">
      <text class="type-badge-text">{{typeInfo.label}}</text>
    </view>
    <view class="top-inner">
      <textarea
        class="card-textarea"
        placeholder="{{typeInfo.placeholder}}"
        value="{{value}}"
        maxlength="60"
        auto-height="true"
        bindinput="onInput"
      />
    </view>
  </view>

  <view class="card-bottom">
    <view class="bottom-header">
      <text class="bottom-title">{{typeInfo.title}}</text>
      <view class="next-btn" wx:if="{{!isLast}}" bindtap="onNext">
        <text class="next-text">{{typeInfo.nextText}}</text>
      </view>
    </view>
    <text class="desc">{{typeInfo.description}}</text>
  </view>
</view>

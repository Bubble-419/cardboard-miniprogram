/* ===== 卡片容器 ===== */
.bg-card {
  width: 100%;
  transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.34, 1.4, 0.64, 1);
  transform-origin: center bottom;
}

.is-active {
  opacity: 1;
  transform: scale(1);
}

.is-inactive {
  opacity: 0.45;
  transform: scale(0.9);
}

/* ===== 卡片视觉区 ===== */
.card-visual {
  width: 100%;
  height: 420rpx;
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
}

/* 白色底层 */
.card-bg-white {
  position: absolute;
  inset: 0;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 7rpx 18rpx 0 rgba(146, 165, 145, 0.2);
}

/* Union SVG 绿色边框叠加 */
.card-frame-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

/* 右上角 tab 类型标签 */
.card-type-label {
  position: absolute;
  top: 10rpx;
  right: 20rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #ffffff;
  z-index: 2;
  letter-spacing: 2rpx;
}

/* 水印图标：随输入区同样居中 */
.card-watermark {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 360rpx;
  height: 124rpx;
  z-index: 2;
  pointer-events: none;
  opacity: 0.85;
}

/* 输入区包裹：绝对定位，水平居中，略偏下 */
.card-input-wrap {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 18rpx;
  bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 向下偏移约 10% 的卡片高度，使视觉重心稍低 */
  padding-top: 142rpx;
  z-index: 3;
}

/* Textarea：本身高度自适应，外层 flex 确保垂直居中 */
.card-textarea {
  width: 80%;
  font-size: 40rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
  line-height: 1.35;
  background: transparent;
  /* 单行/多行均可，不撑满整个 wrap */
  min-height: 56rpx;
  max-height: 200rpx;
}

/* Placeholder 样式（需要 placeholder-class） */
.card-placeholder {
  color: #c9c9c9;
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.35;
}

/* ===== 说明面板 ===== */
.card-info {
  background: #ffffff;
  border-radius: 0 0 24rpx 24rpx;
  padding: 24rpx 36rpx 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(146, 165, 145, 0.18);
  margin-top: -6rpx;
  /* 防止说明文字过长撑出卡片边界 */
  overflow: hidden;
}

.info-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.info-define-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #5ec159;
  line-height: 1.4;
}

/* 下一步按钮 */
.next-btn {
  background: #5ec159;
  border-radius: 12rpx;
  padding: 8rpx 30rpx;
  flex-shrink: 0;
}

.next-btn-text {
  font-size: 26rpx;
  color: #ffffff;
  letter-spacing: 4rpx;
  line-height: 1.5;
}

/* 描述文字 */
.info-desc {
  /* “说明小字”字号略增大，但行间距更紧凑 */
  font-size: 26rpx;
  color: #979797;
  line-height: 1.38;
  text-align: justify;
  /* 限制最大展示高度：多出来的行不再撑开卡片 */
  max-height: 112rpx;
  overflow: hidden;
  word-break: break-all;
}

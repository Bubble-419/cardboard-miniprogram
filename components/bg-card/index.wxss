.bg-card {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(146, 165, 145, 0.2);
  overflow: hidden;
}

.is-inactive {
  opacity: 0.5;
}

.card-top {
  position: relative;
  padding: 16rpx;
}

.top-inner {
  height: 220rpx;
  border-radius: 24rpx;
  border: 8rpx solid #5ec159;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.type-badge {
  position: absolute;
  right: 28rpx;
  top: 16rpx;
  padding: 10rpx 18rpx;
  background-color: #5ec159;
  border-radius: 16rpx;
}

.type-badge-text {
  font-size: 26rpx;
  color: #ffffff;
  line-height: 1.2;
}

.placeholder {
  font-size: 54rpx;
  color: #c9c9c9;
  font-weight: 600;
  text-align: center;
  line-height: 1.1;
}

.value-text {
  font-size: 44rpx;
  color: #5a5a5a;
  font-weight: 600;
  text-align: center;
  line-height: 1.2;
  word-break: break-all;
}

.card-bottom {
  padding: 10rpx 20rpx 22rpx;
}

.bottom-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.bottom-title {
  font-size: 32rpx;
  color: #5ec159;
  font-weight: 600;
}

.next-btn {
  height: 54rpx;
  padding: 0 24rpx;
  background-color: #5ec159;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.next-text {
  font-size: 28rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.next-btn-disabled {
  background-color: #c0c0c0 !important;
  opacity: 0.7;
  pointer-events: none;
}

.desc {
  font-size: 24rpx;
  color: #979797;
  line-height: 1.3;
  text-align: justify;
}

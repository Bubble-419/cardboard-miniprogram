.user-list {
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 1;
}

.avatar-scroll {
  width: 100%;
  overflow: hidden;
}

.avatar-row {
  display: inline-flex;
  align-items: flex-start;
  gap: 6rpx;
  padding: 6rpx 4rpx 16rpx;
  box-sizing: border-box;
  min-width: 100%;
}

.avatar-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.avatar-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.avatar-frame-box {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-wrap {
  position: relative;
  z-index: 1;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  padding: 4rpx;
  box-sizing: border-box;
  background-color: #f2f2f2;
  box-shadow: inset 0 0 4rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.avatar-img {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background-color: #e8e8e8;
}

.partner-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-sizing: border-box;
  pointer-events: none;
}

.partner-ring-acting-outer {
  z-index: 2;
  border: 4rpx solid #c3e4c1;
}

.partner-ring-acting-inner {
  z-index: 3;
  border: 5rpx solid transparent;
  border-top-color: #5ec159;
  border-right-color: #5ec159;
  animation: acting-ring-spin 2.4s linear infinite;
}

.partner-ring-selected {
  z-index: 2;
  left: 4rpx;
  top: 4rpx;
  width: calc(100% - 8rpx);
  height: calc(100% - 8rpx);
  border: 2rpx solid #5ec159;
  box-shadow: 0 0 12rpx rgba(94, 193, 89, 0.55);
}

.acting-timer-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 4;
  pointer-events: none;
  opacity: 0;
}

.acting-timer-canvas-visible {
  opacity: 1;
}

.partner-ring-expiring {
  animation: acting-ring-expire-pulse 2s ease-in-out forwards;
}

.partner-ring-expiring-inner {
  animation: acting-ring-expire-spin 2s ease-out forwards;
}

.avatar-frame-expiring {
  z-index: 4;
}

.avatar-wrap-expiring {
  animation: acting-avatar-expire-pulse 2s ease-in-out forwards;
}

@keyframes acting-avatar-expire-pulse {
  0% {
    transform: scale(1);
  }
  /* 第一下 zeng~ */
  12% {
    transform: scale(1.1);
  }
  24% {
    transform: scale(1);
  }
  /* 第二下 zeng~ */
  42% {
    transform: scale(1.08);
  }
  56% {
    transform: scale(1);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes acting-ring-expire-pulse {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  12% {
    transform: scale(1.18);
    opacity: 0.75;
  }
  24% {
    transform: scale(1);
    opacity: 0.9;
  }
  42% {
    transform: scale(1.16);
    opacity: 0.65;
  }
  56% {
    transform: scale(1);
    opacity: 0.35;
  }
  100% {
    transform: scale(1);
    opacity: 0;
  }
}

@keyframes acting-ring-expire-spin {
  0% {
    transform: rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: rotate(200deg);
    opacity: 0;
  }
}

.me-indicator {
  width: 0;
  height: 0;
  margin-top: 2rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #5ec159;
  flex-shrink: 0;
}

.avatar-name-wrap {
  margin-top: 4rpx;
  text-align: center;
  max-width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-name {
  font-size: 22rpx;
  color: #333;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.avatar-name.avatar-me,
.avatar-name-me {
  color: #00a84a;
}

.avatar-name.avatar-me-line {
  display: block;
  white-space: normal;
}

.add-btn {
  width: 80rpx;
  height: 80rpx;
  margin-left: 4rpx;
  border-radius: 20rpx;
  background: #e9f5e9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.add-icon {
  width: 36rpx;
  height: 36rpx;
}

.fold .avatar-row {
  gap: 4rpx;
  padding: 4rpx 4rpx 16rpx;
}

.fold .avatar-frame-box {
  width: 80rpx;
  height: 80rpx;
}

/* Figma TopBar 5901:2166 — 40×40px 圆形，2px #FFF 描边，#E5E7EB 底色 */
.fold .avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  border: 4rpx solid #ffffff;
  background-color: #e5e7eb;
}

.fold .partner-ring-acting-outer {
  border-width: 3rpx;
}

.fold .partner-ring-acting-inner {
  border-width: 4rpx;
}

.fold .partner-ring-selected {
  left: 2rpx;
  top: 2rpx;
  width: calc(100% - 4rpx);
  height: calc(100% - 4rpx);
}

.fold .me-indicator {
  border-left-width: 8rpx;
  border-right-width: 8rpx;
  border-top-width: 10rpx;
  margin-top: 0;
}

.fold .add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.fold .add-icon {
  width: 30rpx;
  height: 30rpx;
}

/* 堆叠布局（TopBar 头像条，Figma 5901:2166） */
.layout-stack {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
}

.layout-stack .avatar-scroll {
  width: 100%;
  height: 80rpx;
}

.layout-stack .avatar-row-stack {
  display: inline-flex;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
  height: 80rpx;
}

.layout-stack .avatar-item {
  position: relative;
  z-index: 1;
  margin-left: 0;
}

.layout-stack .avatar-item + .avatar-item {
  margin-left: -16rpx;
}

.layout-stack .avatar-item-me {
  z-index: 10;
}

.layout-stack .avatar-item-indicator {
  z-index: 10;
}

.layout-stack .avatar-slot {
  position: relative;
  height: 80rpx;
  justify-content: center;
  padding-bottom: 0;
}

.layout-stack .me-indicator {
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 0;
}

.layout-stack .avatar-wrap {
  background-color: #e5e7eb;
  border: 4rpx solid #ffffff;
  box-shadow: none;
}

.layout-stack.fold .avatar-frame-box {
  width: 80rpx;
  height: 80rpx;
}

.layout-stack.fold .avatar-wrap {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
}

@keyframes acting-ring-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

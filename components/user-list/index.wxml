<view class="user-list {{showName ? 'show-name' : ''}} {{isFold ? 'fold' : ''}} {{layout === 'stack' ? 'layout-stack' : 'layout-scroll'}}">
  <scroll-view
    class="avatar-scroll"
    scroll-x="{{layout !== 'stack'}}"
    enable-flex="{{layout !== 'stack'}}"
    show-scrollbar="{{false}}"
    style="{{layout !== 'stack' ? (isFold ? 'height:120rpx;max-height:120rpx;' : 'height:160rpx;max-height:160rpx;') : ''}}"
  >
    <view class="avatar-row {{layout === 'stack' ? 'avatar-row-stack' : ''}}">
      <block wx:for="{{displayList}}" wx:key="id">
        <view
          class="avatar-item {{item.id == resolvedIndicatorUser ? 'avatar-item-indicator' : ''}}"
          bindtap="onAvatarTap"
          data-player-index="{{item.id}}"
        >
          <view class="avatar-slot">
            <view class="avatar-frame-box {{item.id == resolvedActingUser && actingFrameMode === 'expiring' ? 'avatar-frame-expiring' : ''}}">
              <view class="avatar-wrap {{item.id == resolvedActingUser && actingFrameMode === 'expiring' ? 'avatar-wrap-expiring' : ''}}">
                <image
                  class="avatar-img"
                  src="{{item.avatar || item.avatarImage || item.url || defaultAvatar}}"
                  mode="aspectFill"
                />
              </view>
              <block wx:if="{{item.id == resolvedActingUser && actingFrameMode === 'timer' && !suppressTimerCanvas}}">
                <canvas
                  type="2d"
                  id="actingTimerCanvas"
                  class="acting-timer-canvas acting-timer-canvas-visible"
                ></canvas>
              </block>
              <block wx:elif="{{item.id == resolvedActingUser && actingFrameMode === 'timer' && suppressTimerCanvas}}">
                <view class="partner-ring partner-ring-acting-outer"></view>
                <view class="partner-ring partner-ring-acting-inner"></view>
              </block>
              <block wx:elif="{{item.id == resolvedActingUser && actingFrameMode === 'expiring'}}">
                <view class="partner-ring partner-ring-acting-outer partner-ring-expiring"></view>
                <view class="partner-ring partner-ring-acting-inner partner-ring-expiring-inner"></view>
              </block>
              <block wx:elif="{{item.id == resolvedActingUser}}">
                <view class="partner-ring partner-ring-acting-outer"></view>
                <view class="partner-ring partner-ring-acting-inner"></view>
              </block>
              <view
                wx:elif="{{enableSelectedFrame && (item.id == resolvedSelectedUser || item.highlight)}}"
                class="partner-ring partner-ring-selected"
              ></view>
            </view>
            <image
              wx:if="{{item.id == resolvedIndicatorUser}}"
              class="me-indicator"
              src="/assets/partnerMode/avatar-arrow.svg"
              mode="aspectFit"
            />
          </view>
          <view class="avatar-name-wrap" wx:if="{{showName && layout !== 'stack' && (item.nickName != null || item.isMe)}}">
            <text class="avatar-name">{{item.nickName || '玩家' + item.id}}</text>
            <text class="avatar-name avatar-me avatar-me-line" wx:if="{{item.isMe}}">（我）</text>
          </view>
        </view>
      </block>
      <view class="avatar-item overflow-item" wx:if="{{overflowCount > 0}}">
        <view class="avatar-slot">
          <view class="avatar-frame-box">
            <view class="avatar-wrap overflow-wrap">
              <text class="overflow-text">+{{overflowCount}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="add-btn" wx:if="{{enableAdd}}" bindtap="onAddTap">
        <image class="add-icon" src="/assets/icons/add-icon.png" mode="aspectFit"></image>
      </view>
    </view>
  </scroll-view>
</view>

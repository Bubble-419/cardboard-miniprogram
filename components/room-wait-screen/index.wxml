<view class="container">
  <image class="bg-pattern" src="/assets/subAwait/bg-dotted-lines.svg" mode="widthFix" />
  <view class="content">
    <view class="hero-section">
      <image class="hero-image" src="{{waitHeroSrc}}" mode="widthFix" />
    </view>
    <view class="text-section">
      <text class="heading">{{model.mainText}}</text>
      <view class="desc-group">
        <text class="desc-line">{{model.subTextLine1}}</text>
        <text class="desc-line">{{model.subTextLine2}}</text>
      </view>
    </view>
    <view class="status-pill">
      <image class="status-icon" src="/assets/subAwait/icon-waiting.png" mode="aspectFit" />
      <text class="status-text">{{model.statusText}}</text>
    </view>
  </view>
</view>

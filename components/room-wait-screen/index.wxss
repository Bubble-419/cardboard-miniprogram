:host {
  display: block;
  min-height: 100vh;
}

.container {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background-color: #f7f9f5;
}

.bg-pattern {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  opacity: 0.4;
  pointer-events: none;
}

.content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: env(safe-area-inset-top);
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

.hero-section {
  width: 100%;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.hero-image {
  display: block;
  width: 100%;
  height: auto;
}

.text-section {
  width: 100%;
  padding: 0 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.heading {
  width: 100%;
  font-size: 56rpx;
  font-weight: 500;
  color: #2b2b2b;
  line-height: 72rpx;
  letter-spacing: -0.0268em;
  text-align: center;
}

.desc-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.desc-line {
  font-size: 32rpx;
  color: #909090;
  line-height: 48rpx;
  text-align: center;
}

.status-pill {
  margin-top: 72rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 56rpx;
  background-color: #edf6ec;
  border-radius: 9999rpx;
}

.status-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.status-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #6eba62;
  line-height: 56rpx;
  white-space: nowrap;
}

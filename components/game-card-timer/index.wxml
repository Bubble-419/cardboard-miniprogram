<view class="gct-wrap {{displayMode === 'timer' ? 'gct-wrap-timer-on' : ''}} {{displayMode === 'expiring' ? 'gct-wrap-expiring' : ''}} {{suppressCanvas && displayMode === 'timer' ? 'gct-wrap-suppressed' : ''}} {{borderVariant === 'master' ? 'gct-wrap-master' : ''}} {{borderVariant === 'sound' ? 'gct-wrap-sound' : ''}}">
  <canvas
    wx:if="{{displayMode === 'timer' && !suppressCanvas && borderVariant !== 'master' && borderVariant !== 'sound'}}"
    type="2d"
    id="gctCanvas"
    class="gct-canvas {{borderVisible ? 'gct-canvas-visible' : ''}}"
  ></canvas>
  <view
    wx:elif="{{displayMode === 'timer' && suppressCanvas && borderVariant !== 'master' && borderVariant !== 'sound'}}"
    class="gct-canvas-placeholder"
  ></view>
  <view
    wx:if="{{borderVariant === 'master' && displayMode !== 'expiring'}}"
    class="gct-master-frame"
    aria-hidden="true"
  >
    <view class="gct-master-corner gct-master-corner-tl"></view>
    <view class="gct-master-corner gct-master-corner-tr"></view>
    <view class="gct-master-corner gct-master-corner-br"></view>
    <view class="gct-master-corner gct-master-corner-bl"></view>
  </view>
  <canvas
    wx:if="{{borderVariant === 'sound' && displayMode !== 'expiring'}}"
    type="2d"
    id="gctSoundCanvas"
    class="gct-sound-canvas"
  ></canvas>
  <block wx:if="{{displayMode === 'expiring'}}">
    <view class="gct-expire-ring gct-expire-ripple gct-expire-ripple-1"></view>
    <view class="gct-expire-ring gct-expire-ripple gct-expire-ripple-2"></view>
    <view class="gct-expire-ring gct-expire-settle"></view>
  </block>
  <view class="gct-sound-warn" wx:if="{{borderVariant === 'sound' && soundTooLoud}}">声音过大，请降低音量</view>
  <view class="gct-inner">
    <slot></slot>
  </view>
</view>

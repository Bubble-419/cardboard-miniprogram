.gct-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border-radius: 28rpx;
}

/* 静止态：与 Figma #5848:3392 对齐的浅绿描边 */
.gct-wrap:not(.gct-wrap-timer-on):not(.gct-wrap-expiring):not(.gct-wrap-rainbow):not(.gct-wrap-sound) .gct-inner {
  border: 8rpx solid #b0e0ae;
}

.gct-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  opacity: 0;
}

.gct-canvas-visible {
  opacity: 1;
}

/* 引导蒙层期间用静态描边占位，避免原生 canvas 透出 */
.gct-canvas-placeholder {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 28rpx;
  border: 8rpx solid #5ec159;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 2;
}

.gct-inner {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  border-radius: 28rpx;
  background: #fff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0;
  box-sizing: border-box;
}

.gct-wrap-timer-on .gct-inner {
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 20rpx;
}

.gct-wrap-expiring {
  overflow: visible;
}

.gct-wrap-expiring .gct-inner {
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 20rpx;
}

/* Master：卡片外框彩虹描边（静止/倒计时都用 CSS，不走绿色 canvas） */
.gct-wrap-rainbow:not(.gct-wrap-expiring) {
  overflow: hidden;
  padding: 8rpx;
  background: linear-gradient(
    120deg,
    #ff5a7a 0%,
    #ffb347 18%,
    #ffe066 36%,
    #5ec159 54%,
    #4fc3f7 72%,
    #8b7cff 88%,
    #ff5a7a 100%
  );
  background-size: 240% 240%;
  animation: gct-rainbow-shift 4.5s linear infinite;
  box-sizing: border-box;
}

.gct-wrap-rainbow:not(.gct-wrap-expiring) .gct-inner {
  border: none;
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 20rpx;
}

/* 静默：底边声贝识别槽 + 青色外框 */
.gct-wrap-sound:not(.gct-wrap-expiring) {
  overflow: hidden;
  background: #3ec6c9;
  box-shadow: 0 0 18rpx rgba(62, 198, 201, 0.35);
}

.gct-wrap-sound:not(.gct-wrap-expiring) .gct-inner {
  border: none;
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 36rpx;
  border-radius: 20rpx;
}

.gct-sound-bars {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 6rpx;
  z-index: 3;
  height: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  pointer-events: none;
}

.gct-sound-bar {
  width: 8rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #7ef0f3 0%, #3ec6c9 100%);
  transition: height 0.18s ease-out;
}

.gct-sound-bar-1 { animation-delay: 0s; }
.gct-sound-bar-2 { animation-delay: 0.08s; }
.gct-sound-bar-3 { animation-delay: 0.16s; }
.gct-sound-bar-4 { animation-delay: 0.24s; }
.gct-sound-bar-5 { animation-delay: 0.1s; }
.gct-sound-bar-6 { animation-delay: 0.2s; }
.gct-sound-bar-7 { animation-delay: 0.04s; }
.gct-sound-bar-8 { animation-delay: 0.14s; }

@keyframes gct-rainbow-shift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.gct-expire-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 3;
}

/* 满圈收束：2s 内弹两下 zeng~zeng~，再落到浅绿描边 */
.gct-expire-settle {
  border: 8rpx solid #5ec159;
  animation: gct-expire-settle 2s ease-in-out forwards;
  z-index: 4;
  transform-origin: center center;
}

/* 涟漪描边：两下外扩淡出 */
.gct-expire-ripple {
  border: 4rpx solid rgba(94, 193, 89, 0.75);
  transform-origin: center center;
}

.gct-expire-ripple-1 {
  animation: gct-expire-ripple-double 2s ease-out forwards;
}

.gct-expire-ripple-2 {
  border-color: rgba(176, 224, 174, 0.9);
  animation: gct-expire-ripple-double 2s ease-out 0.12s forwards;
  opacity: 0;
}

@keyframes gct-expire-settle {
  0% {
    transform: scale(1);
    border-color: #5ec159;
    box-shadow: 0 0 0 0 rgba(94, 193, 89, 0.45);
    opacity: 1;
  }
  /* 第一下 zeng~ */
  12% {
    transform: scale(1.045);
    border-color: #5ec159;
    box-shadow: 0 0 0 12rpx rgba(94, 193, 89, 0.28);
  }
  24% {
    transform: scale(1);
    border-color: #5ec159;
    box-shadow: 0 0 0 0 rgba(94, 193, 89, 0.15);
  }
  /* 第二下 zeng~ */
  42% {
    transform: scale(1.04);
    border-color: #5ec159;
    box-shadow: 0 0 0 10rpx rgba(94, 193, 89, 0.24);
  }
  56% {
    transform: scale(1);
    border-color: #7ec97a;
    box-shadow: 0 0 0 0 rgba(176, 224, 174, 0.12);
  }
  100% {
    transform: scale(1);
    border-color: #b0e0ae;
    box-shadow: 0 0 0 0 rgba(94, 193, 89, 0);
    opacity: 1;
  }
}

@keyframes gct-expire-ripple-double {
  0% {
    transform: scale(1);
    opacity: 0.85;
  }
  12% {
    transform: scale(1.05);
    opacity: 0.35;
  }
  24% {
    transform: scale(1.02);
    opacity: 0;
  }
  42% {
    transform: scale(1);
    opacity: 0.75;
  }
  56% {
    transform: scale(1.06);
    opacity: 0.25;
  }
  70%,
  100% {
    transform: scale(1.08);
    opacity: 0;
  }
}

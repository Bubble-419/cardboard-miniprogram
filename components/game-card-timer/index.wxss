.gct-wrap {
  position: relative;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  border-radius: 28rpx;
}

/* 静止态：与 Figma #5848:3392 对齐的浅绿描边 */
.gct-wrap:not(.gct-wrap-timer-on):not(.gct-wrap-expiring) .gct-inner {
  border: 8rpx solid #b0e0ae;
}

.gct-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  opacity: 0;
}

.gct-canvas-visible {
  opacity: 1;
}

.gct-inner {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  border-radius: 28rpx;
  background: #fff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0;
  box-sizing: border-box;
}

.gct-wrap-timer-on .gct-inner {
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 20rpx;
}

.gct-wrap-expiring {
  overflow: visible;
}

.gct-wrap-expiring .gct-inner {
  left: 8rpx;
  top: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 20rpx;
}

.gct-expire-ring {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 3;
}

/* 满圈收束：深绿实线 → 浅绿，略带外扩柔光 */
.gct-expire-settle {
  border: 8rpx solid #5ec159;
  animation: gct-expire-settle 1.1s ease-out forwards;
  z-index: 4;
}

/* 涟漪描边：自卡片外缘轻轻扩开并淡出 */
.gct-expire-ripple {
  border: 4rpx solid rgba(94, 193, 89, 0.75);
  transform-origin: center center;
}

.gct-expire-ripple-1 {
  animation: gct-expire-ripple 1.1s ease-out forwards;
}

.gct-expire-ripple-2 {
  border-color: rgba(176, 224, 174, 0.9);
  animation: gct-expire-ripple 1.1s ease-out 0.12s forwards;
  opacity: 0;
}

@keyframes gct-expire-settle {
  0% {
    border-color: #5ec159;
    box-shadow: 0 0 0 0 rgba(94, 193, 89, 0.4);
    opacity: 1;
  }
  28% {
    border-color: #5ec159;
    box-shadow: 0 0 0 10rpx rgba(94, 193, 89, 0.22);
    opacity: 1;
  }
  70% {
    border-color: #7ec97a;
    box-shadow: 0 0 0 4rpx rgba(176, 224, 174, 0.18);
    opacity: 1;
  }
  100% {
    border-color: #b0e0ae;
    box-shadow: 0 0 0 0 rgba(94, 193, 89, 0);
    opacity: 1;
  }
}

@keyframes gct-expire-ripple {
  0% {
    transform: scale(1);
    opacity: 0.9;
  }
  100% {
    transform: scale(1.07);
    opacity: 0;
  }
}

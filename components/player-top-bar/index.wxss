.player-top-bar-wrap {
  width: 100%;
  box-sizing: border-box;
  flex-shrink: 0;
  /* padding-left 由 padLeftRpx 内联控制，默认 40rpx */
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  box-sizing: border-box;
}

.top-bar-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 100%;
  gap: 12rpx;
}

.room-entry,
.back-entry {
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.back-entry {
  min-width: 72rpx;
  min-height: 72rpx;
}

.room-entry:active,
.back-entry:active {
  opacity: 0.75;
}

.room-entry-icon {
  width: 100%;
  height: 100%;
  display: block;
}

.back-entry-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.avatar-group {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 100%;
  overflow: hidden;
}

/* 约束 user-list 宿主：避免按全部头像撑开后被裁切、内部无法横滑 */
.avatar-group > user-list,
.top-bar-user-list {
  flex: 1;
  min-width: 0;
  width: 100%;
  height: 100%;
}

.top-bar-right-spacer {
  flex-shrink: 0;
}

<view class="partner-avatar size-{{size}}">
  <view class="avatar-frame type-{{type}} {{isSelf ? 'is-self' : ''}}">
    <image
      class="avatar-img"
      src="{{src || defaultSrc}}"
      mode="aspectFill"
      lazy-load
    />
  </view>
  <image
    class="avatar-arrow"
    wx:if="{{showArrow}}"
    src="/assets/partnerMode/avatar-arrow.svg"
    mode="aspectFit"
  />
</view>
